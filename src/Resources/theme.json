{
  "name": "ViewsTheme",
  "author": "fyrst.dev",
  "views": ["@Storefront", "@ViewsTheme"],
  "style": [
    "app/storefront/src/scss/override.scss",
    "@StorefrontBootstrap",
    "app/storefront/src/scss/base.scss"
  ],
  "script": ["@Storefront", "app/storefront/dist/storefront/js/views-theme/views-theme.js"],
  "asset": ["app/storefront/src/assets"],
  "config": {
    "fields": {
      "sw-color-brand-primary": {
        "type": "color",
        "value": "#19BF56",
        "editable": true,
        "block": "colors",
        "order": 100
      },
      "sw-font-family-base": {
        "type": "text",
        "value": "'Figtree', sans-serif",
        "editable": true,
        "block": "typography",
        "order": 100
      },
      "sw-logo-desktop": {
        "type": "media",
        "value": "",
        "editable": true,
        "block": "media",
        "order": 100,
        "fullWidth": true
      },
      "sw-logo-tablet": {
        "type": "media",
        "value": "",
        "editable": true,
        "block": "media",
        "order": 200,
        "fullWidth": true
      },
      "sw-logo-mobile": {
        "type": "media",
        "value": "",
        "editable": true,
        "block": "media",
        "order": 300,
        "fullWidth": true
      },
      "sw-logo-share": {
        "type": "media",
        "value": "",
        "editable": true,
        "block": "media",
        "order": 400
      },
      "sw-logo-favicon": {
        "type": "media",
        "value": "",
        "editable": true,
        "block": "media",
        "order": 500
      }
    }
  }
}
