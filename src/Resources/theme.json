{
  "name": "ViewsTheme",
  "author": "fyrst.dev",
  "views": ["@Storefront", "@ViewsTheme"],
  "style": [
    "app/storefront/src/scss/override.scss",
    "@StorefrontBootstrap",
    "app/storefront/src/scss/base.scss"
  ],
  "script": ["@Storefront", "app/storefront/dist/storefront/js/views-theme/views-theme.js"],
  "asset": ["app/storefront/src/assets"],
  "icons": {
    "pack": "bold",
    "mode": "css"
  },
  "config": {
    "tabs": {
      "colors": {
        "label": {
          "en-GB": "Colors",
          "de-DE": "Farben"
        }
      },
      "typography": {
        "label": {
          "en-GB": "Typography",
          "de-DE": "Typografie"
        }
      },
      "media": {
        "label": {
          "en-GB": "Media",
          "de-DE": "Medien"
        }
      }
    },
    "fields": {
      "vi-primary": {
        "type": "color",
        "value": "#F87060",
        "editable": true,
        "custom": { "css": true },
        "scss": false,
        "tab": "colors",
        "block": "default",
        "order": 100
      },
      "vi-secondary": {
        "type": "color",
        "value": "#71816D",
        "editable": true,
        "custom": { "css": true },
        "scss": false,
        "tab": "colors",
        "block": "default",
        "order": 100
      },
      "vi-light": {
        "type": "color",
        "value": "#faf5ee",
        "editable": true,
        "custom": { "css": true },
        "scss": false,
        "tab": "colors",
        "block": "default",
        "order": 100
      },
      "vi-dark": {
        "type": "color",
        "value": "#2E282A",
        "editable": true,
        "custom": { "css": true },
        "scss": false,
        "tab": "colors",
        "block": "default",
        "order": 100
      },
      "vi-text-color": {
        "type": "color",
        "value": "#2E282A",
        "editable": true,
        "custom": { "css": true },
        "scss": false,
        "tab": "colors",
        "block": "default",
        "order": 200
