<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Class-backed UX components (#[AsTwigComponent]); without this, PHP is ignored -->
        <prototype namespace="Fyrst\ViewsTheme\Resources\views\components\"
                   resource="../views/components/**/*.php"
                   autowire="true"
                   autoconfigure="true"
                   public="false"/>

        <service id="Fyrst\ViewsTheme\Twig\ViIcon">
            <argument type="service" id="Fyrst\ViewsTheme\Service\ThemeParametersResolver"/>
            <argument type="service" id="request_stack"/>
            <tag name="twig.extension"/>
        </service>
        <service id="Fyrst\ViewsTheme\Twig\ViUtilities">
            <argument type="service" id="ux.twig_component.component_stack" on-invalid="null"/>
            <argument type="service" id="ux.twig_component.component_factory" on-invalid="null"/>
            <tag name="twig.extension"/>
        </service>
        <service id="Fyrst\ViewsTheme\Service\ThemeParametersResolver">
            <argument type="service" id="Shopware\Storefront\Theme\StorefrontPluginRegistry"/>
            <argument type="service" id="theme.repository"/>
        </service>

        <service id="Fyrst\ViewsTheme\Subscriber\ThemeConfigSubscriber">
            <argument type="service" id="Fyrst\ViewsTheme\Service\ThemeParametersResolver"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="Fyrst\ViewsTheme\Subscriber\CartContextSubscriber">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\SalesChannelContextAccessor">
            <argument type="service" id="request_stack"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer">
            <argument type="service" id="Symfony\UX\TwigComponent\ComponentRendererInterface"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="Shopware\Core\Content\Media\MediaUrlPlaceholderHandlerInterface"/>
            <argument type="service" id="Shopware\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\ProductListingGateway">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Listing\ProductListingRoute"/>
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Search\ProductSearchRoute"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\FilterRequestSelection"/>

        <service id="Fyrst\ViewsTheme\Service\FilterAvailabilityApplier"/>

        <service id="Fyrst\ViewsTheme\Service\FilterFacetResolver">
            <argument type="service" id="translator"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\FilterAggregationLoader">
            <argument type="service" id="Fyrst\ViewsTheme\Service\ProductListingGateway"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\FilterFacetPipeline">
            <argument type="service" id="Fyrst\ViewsTheme\Service\FilterFacetResolver"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\FilterAggregationLoader"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\FilterAvailabilityApplier"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\FilterRequestSelection"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\FilterOptionsPayloadBuilder">
            <argument type="service" id="Fyrst\ViewsTheme\Service\FilterFacetPipeline"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ProductListingGateway"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer"/>
        </service>

        <service id="Fyrst\ViewsTheme\Controller\VariantsGridController" public="true">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\LineItemFactoryRegistry"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\VariantsLoader"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="twig"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Fyrst\ViewsTheme\Controller\SearchOverlayController" public="true">
            <argument type="service" id="Symfony\UX\TwigComponent\ComponentRendererInterface"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer"/>
            <argument type="service" id="Shopware\Storefront\Page\Suggest\SuggestPageLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Fyrst\ViewsTheme\Controller\NavigationDrawerController" public="true">
            <argument type="service" id="Symfony\UX\TwigComponent\ComponentRendererInterface"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer"/>
            <argument type="service" id="Shopware\Storefront\Pagelet\Menu\Offcanvas\MenuOffcanvasPageletLoader"/>
            <argument type="service" id="Shopware\Storefront\Pagelet\Header\HeaderPageletLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Fyrst\ViewsTheme\Controller\NavigationFlyoutController" public="true">
            <argument type="service" id="Symfony\UX\TwigComponent\ComponentRendererInterface"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer"/>
            <argument type="service" id="Shopware\Core\Content\Category\Service\NavigationLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Fyrst\ViewsTheme\Controller\CartDrawerController" public="true">
            <argument type="service" id="Symfony\UX\TwigComponent\ComponentRendererInterface"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer"/>
            <argument type="service" id="Shopware\Storefront\Page\Checkout\Cart\CheckoutCartPageLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Fyrst\ViewsTheme\Service\VariantsLoader">
            <argument type="service" id="sales_channel.product.repository"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\ProductDetailUrlBuilder">
            <argument type="service" id="Shopware\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface"/>
            <argument type="service" id="request_stack"/>
        </service>

        <service id="Fyrst\ViewsTheme\Service\ProductPriceResolver"/>

        <service id="Fyrst\ViewsTheme\Controller\ListingController" public="true">
            <argument type="service" id="Symfony\UX\TwigComponent\ComponentRendererInterface"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ProductListingGateway"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\FilterOptionsPayloadBuilder"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Fyrst\ViewsTheme\Controller\FilterDrawerController" public="true">
            <argument type="service" id="Symfony\UX\TwigComponent\ComponentRendererInterface"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ProductListingGateway"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Fyrst\ViewsTheme\Service\ReviewPointsNormalizer"/>

        <service id="Fyrst\ViewsTheme\Service\ProductReviewGateway">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Review\ProductReviewLoader"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ReviewPointsNormalizer"/>
        </service>

        <service id="Fyrst\ViewsTheme\Subscriber\ReviewRequestSubscriber">
            <argument type="service" id="Fyrst\ViewsTheme\Service\ReviewPointsNormalizer"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Fyrst\ViewsTheme\Controller\ReviewController" public="true">
            <argument type="service" id="Symfony\UX\TwigComponent\ComponentRendererInterface"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ComponentHtmlRenderer"/>
            <argument type="service" id="Fyrst\ViewsTheme\Service\ProductReviewGateway"/>
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Review\ProductReviewSaveRoute"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Fyrst\ViewsTheme\Subscriber\ProductPageSubscriber">
            <argument type="service" id="Fyrst\ViewsTheme\Service\VariantsLoader"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="request_stack"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Fyrst\ViewsTheme\Subscriber\CheckoutConfirmPageSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="Fyrst\ViewsTheme\Subscriber\CheckoutOrderPlacedSubscriber">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="order.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
