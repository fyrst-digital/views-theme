{% props
    id = 'vi-dropdown-' ~ random(),
    placement = 'bottom-end',
    cva = {},
%}

{% set anchorName = '--' ~ id %}
{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['host', 'toggle']) %}

<div
    {{ vi_attrs('host').defaults({
        'data-component': 'ViewsTheme:Dropdown',
    }) }}
    class="{{ vi_class('host') }}"
>
    {% block toggle %}
        <twig:ViewsTheme:Button
            class="{{ vi_class('toggle') }}"
            {{ ...vi_attrs('toggle').defaults({
                type: 'button',
                color: 'none',
                size: 'md',
                icon: null,
                label: null,
                popovertarget: id,
                'aria-expanded': 'false',
                'aria-haspopup': 'true',
                'aria-controls': id,
                style: 'anchor-name: ' ~ anchorName,
            }).all() }}
        />
    {% endblock %}

    <div
        {{ attributes.defaults({
            id: id,
            popover: 'auto',
            tabindex: '-1',
            'data-placement': placement,
        }) }}
        class="{{ vi_class('root') }}"
        style="position-anchor: {{ anchorName }}"
    >
        {% block content %}{% endblock %}
    </div>
</div>
