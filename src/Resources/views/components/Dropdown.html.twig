{% props
    id = 'vi-dropdown-' ~ random(),
    placement = 'bottom-end',
    cva = {},
%}

{% set anchorName = '--' ~ id %}
{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    host: attributes.nested('host'),
    toggle: attributes.nested('toggle'),
} %}

<div
    {{ attrs.host.defaults({
        'data-component': 'ViewsTheme:Dropdown',
    }) }}
    class="{{ cx.host.apply() }}"
>
    {% block toggle %}
        <twig:ViewsTheme:Button
            class="{{ cx.toggle.apply() }}"
            {{ ...attrs.toggle.defaults({
                type: 'button',
                color: 'none',
                size: 'md',
                icon: null,
                label: null,
                popovertarget: id,
                'aria-expanded': 'false',
                'aria-haspopup': 'true',
                'aria-controls': id,
                style: 'anchor-name: ' ~ anchorName,
            }).all() }}
        />
    {% endblock %}

    <div
        {{ attributes.defaults({
            id: id,
            popover: 'auto',
            tabindex: '-1',
            'data-placement': placement,
        }) }}
        class="{{ cx.root.apply() }}"
        style="position-anchor: {{ anchorName }}"
    >
        {% block content %}{% endblock %}
    </div>
</div>
