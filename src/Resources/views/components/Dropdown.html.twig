{% props
    id = 'vi-dropdown-' ~ random(),
    placement = 'bottom-end',
    color = 'none',
    buttonSize = 'md',
    icon = null,
    label = null,
    cva = {},
%}

{% set anchorName = '--' ~ id %}
{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.nested('host').defaults({
        'data-component': 'ViewsTheme:Dropdown',
    }) }}
    class="{{ cx.host.apply() }}"
>
    {% block toggle %}
        <twig:ViewsTheme:Button
            class="{{ cx.toggle.apply() }}"
            {{ ...attributes.nested('toggle').defaults({
                type: 'button',
                color: color,
                size: buttonSize,
                icon: icon,
                label: label,
                popovertarget: id,
                'aria-expanded': 'false',
                'aria-haspopup': 'true',
                'aria-controls': id,
                style: 'anchor-name: ' ~ anchorName,
            }).all() }}
        />
    {% endblock %}

    <div
        {{ attributes.defaults({
            id: id,
            popover: 'auto',
            tabindex: '-1',
            'data-placement': placement,
        }) }}
        class="{{ cx.root.apply() }}"
        style="position-anchor: {{ anchorName }}"
    >
        {% block content %}{% endblock %}
    </div>
</div>
