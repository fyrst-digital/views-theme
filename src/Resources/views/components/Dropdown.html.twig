{% props
    id = null,
    placement = 'bottom-end',
    cva = {},
%}

{% set dropdownId = id ?? ('vi-dropdown-' ~ random()) %}
{% set anchorName = '--' ~ dropdownId %}
{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Dropdown',
        'data-placement': placement,
    }) }}
    class="{{ cx.root.apply({ placement: placement }) }}"
>
    <button
        {{ attributes.nested('toggle').defaults({
            type: 'button',
            popovertarget: dropdownId,
            'aria-expanded': 'false',
            'aria-haspopup': 'true',
            'aria-controls': dropdownId,
        }) }}
        class="{{ cx.toggle.apply() }}"
        style="anchor-name: {{ anchorName }}"
    >
        {% block toggle %}{% endblock %}
    </button>

    <div
        {{ attributes.nested('panel').defaults({
            id: dropdownId,
            popover: 'auto',
            tabindex: '-1',
            'data-placement': placement,
        }) }}
        class="{{ cx.panel.apply({ placement: placement }) }}"
        style="position-anchor: {{ anchorName }}"
    >
        {% block content %}{% endblock %}
    </div>
</div>
