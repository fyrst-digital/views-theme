{% extends '@Storefront/storefront/layout/navigation/flyout.html.twig' %}

{%
  set classes = vi_define_classes({
    categories: ['navigation-flyout-categories', 'categories-root'],
    teaser: ['navigation-flyout-teaser'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block layout_navigation_flyout_bar %}
{% endblock %}

{% block layout_navigation_flyout_categories %}
    <div {{ classes.categories | vi_attr_classes }}>
        {% block layout_navigation_flyout_categories_recoursion %}
            {{ parent() }}
        {% endblock %}
    </div>
{% endblock %}

{% block layout_navigation_flyout_teaser %}
    {% if category.media %}
        <div {{ classes.teaser | vi_attr_classes }}>
            {% block layout_navigation_flyout_teaser_image %}
                {{ parent() }}
            {% endblock %}

            {% block layout_navigation_flyout_teaser_content %}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}
