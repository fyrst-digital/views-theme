{#
    Required variables:
    - methodType
    - methodId
    - methodDisabled
    - methodMedia
    - methodMeta
    - selectedMethodId
#}

{% if methodType is not defined %}
    {% set methodType = 'payment' %}
{% endif %}

{%
  set classes = vi_define_classes({
    main: ['method-option', methodType ~ '-method'],
    input: ['method-option-input', methodType ~ '-method-input'],
    label: ['method-option-label', methodType ~ '-method-label'],
    image: ['method-option-image'],
    imageElement: ['method-option-image-element'],
    content: ['method-option-content'],
    name: ['method-option-name'],
    description: ['method-option-description'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_method_option %}
    <div {{ classes.main | vi_attr_classes }}>

        {% block component_method_option_input %}
            <input type="radio"
                id="{{ methodType }}Method{{ methodId }}"
                name="{{ methodType }}MethodId"
                value="{{ methodId }}"
                {% if methodId is same as(selectedMethodId) %}
                    checked="checked"
                {% endif %}
                {% if methodDisabled is same as(true) %}
                    disabled="disabled"
                {% endif %}
                {{ classes.input | vi_attr_classes }}>            
        {% endblock %}

        {% block component_method_option_label %}
            <label {{ classes.label | vi_attr_classes }}
                for="{{ methodType }}Method{{ methodId }}">

                {% block component_method_option_image %}
                    {% if methodMedia %}
                        <div {{ classes.image | vi_attr_classes }}>
                            {% sw_thumbnails 'method-option-image-thumbnails' with {
                                media: methodMedia,
                                sizes: {
                                    default: '100px'
                                },
                                attributes: {
                                    class: classes.imageElement|join(' '),
                                    alt: (payment.media.translated.alt ?: payment.translated.name),
                                    title: (payment.media.translated.title ?: payment.translated.name)
                                }
                            } %}
                        </div>
                    {% endif %}
                {% endblock %}

                {% block component_method_option_content %}
                    <div {{ classes.content | vi_attr_classes }}>

                        {% block component_method_option_name %}
                            {% set methodName = methodMeta.name %}
                            <div {{ classes.name | vi_attr_classes }}>
                                {{ methodName }}
                            </div>
                        {% endblock %}

                        {% block component_method_option_description %}
                            {% set methodDescription = methodMeta.description %}

                            {% if methodDescription %}
                                <div {{ classes.description | vi_attr_classes }}>
                                    {{ methodDescription }}
                                </div>
                            {% endif %}
                        {% endblock %}
                    </div>
                {% endblock %}
            </label>
        {% endblock %}
    </div>
{% endblock %}
