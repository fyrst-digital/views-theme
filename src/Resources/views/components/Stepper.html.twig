{% props
    items = [],
    cva = {},
%}

{% if items is not empty %}
    {% do vi_define_cva(cva) %}
    {% do vi_define_attrs(['track', 'list', 'item', 'line']) %}

    <nav
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block track %}
            <span
                {{ vi_attrs('track').defaults({
                    'aria-hidden': 'true',
                    style: '--vi-stepper-count: ' ~ (items|length),
                }) }}
                class="{{ vi_class('track') }}"
            ></span>
        {% endblock %}

        {% block list %}
            <ol
                {{ vi_attrs('list') }}
                class="{{ vi_class('list') }}"
            >
                {% for item in items %}
                    {% block item %}
                        <twig:ViewsTheme:Stepper:Item
                            class="{{ vi_class('item') }}"
                            {{ ...vi_attrs('item').defaults({
                                label: item.label|default(''),
                                url: item.url|default(null),
                                icon: item.icon|default(null),
                                active: item.active|default(false),
                                number: loop.index,
                            }).all() }}
                        />
                    {% endblock %}

                    {% if not loop.last %}
                        {% block line %}
                            <li
                                {{ vi_attrs('line').defaults({
                                    'aria-hidden': 'true',
                                }) }}
                                class="{{ vi_class('line') }}"
                            ></li>
                        {% endblock %}
                    {% endif %}
                {% endfor %}
            </ol>
        {% endblock %}
    </nav>
{% endif %}
