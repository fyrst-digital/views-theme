{% props
    address,
    defaultShipping = false,
    defaultBilling = false,
    defaultShippingAddress = null,
    defaultBillingAddress = null,
    cva = {},
%}

{% set isDefaultShipping = defaultShipping or (defaultShippingAddress and defaultShippingAddress.id == address.id) %}
{% set isDefaultBilling = defaultBilling or (defaultBillingAddress and defaultBillingAddress.id == address.id) %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['edit', 'delete', 'defaultBilling', 'defaultShipping']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block edit %}
        <twig:ViewsTheme:Button
            class="{{ vi_class('edit') }}"
            {{ ...vi_attrs('edit').defaults({
                type: 'link',
                href: path('frontend.account.address.edit.page', { addressId: address.id }),
                color: 'link',
                size: 'sm',
                icon: 'pencil-simple-line',
                label: 'account.addressesContentItemActionEdit'|trans|sw_sanitize,
                title: 'account.addressesContentItemActionEdit'|trans|striptags,
            }).all() }}
        />
    {% endblock %}

    {% block delete %}
        {% if not isDefaultShipping and not isDefaultBilling %}
            <form
                {{ vi_attrs('delete').defaults({
                    action: path('frontend.account.address.delete', { addressId: address.id }),
                    method: 'post',
                }) }}
                class="{{ vi_class('delete') }}"
            >
                <twig:ViewsTheme:Button
                    type="submit"
                    color="link"
                    size="sm"
                    icon="x"
                    label="{{ 'account.addressesContentItemActionDelete'|trans|sw_sanitize }}"
                    title="{{ 'account.addressesContentItemActionDelete'|trans|striptags }}"
                />
            </form>
        {% endif %}
    {% endblock %}

    {% block setDefaultBilling %}
        {% if not isDefaultBilling %}
            <form
                {{ vi_attrs('defaultBilling').defaults({
                    action: path('frontend.account.address.set-default-address', { type: 'billing', addressId: address.id }),
                    method: 'post',
                }) }}
                class="{{ vi_class('defaultBilling') }}"
            >
                <twig:ViewsTheme:Button
                    type="submit"
                    color="link"
                    size="sm"
                    label="{{ 'account.addressesSetAsDefaultBillingAction'|trans|sw_sanitize }}"
                    title="{{ 'account.addressesSetAsDefaultBillingAction'|trans|striptags }}"
                />
            </form>
        {% endif %}
    {% endblock %}

    {% block setDefaultShipping %}
        {% if not isDefaultShipping %}
            <form
                {{ vi_attrs('defaultShipping').defaults({
                    action: path('frontend.account.address.set-default-address', { type: 'shipping', addressId: address.id }),
                    method: 'post',
                }) }}
                class="{{ vi_class('defaultShipping') }}"
            >
                <twig:ViewsTheme:Button
                    type="submit"
                    color="link"
                    size="sm"
                    label="{{ 'account.addressesSetAsDefaultShippingAction'|trans|sw_sanitize }}"
                    title="{{ 'account.addressesSetAsDefaultShippingAction'|trans|striptags }}"
                    :disabled="address.country.shippingAvailable ? false : true"
                />
            </form>
        {% endif %}
    {% endblock %}
</div>
