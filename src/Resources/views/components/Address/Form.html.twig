{% props
    data = null,
    countries = null,
    page = null,
    formViolations = __context.formViolations|default(null),
    prefix = 'address',
    idPrefix = '',
    showNoShippingPostfix = false,
    disableNonShippableCountries = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['grid', 'street', 'postal', 'country', 'phone']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% if data and data.id|default(null) %}
        <input type="hidden" name="{{ prefix }}[id]" value="{{ data.id }}">
    {% endif %}

    <twig:ViewsTheme:Grid
        {{ ...vi_attrs('grid').defaults({
            columns: 'lg',
            gap: 'md',
        }).all() }}
    >
        <twig:block name="content">
            {% vi_block street %}
                <twig:ViewsTheme:Address:Input:Street
                    class="{{ vi_class('street') }}"
                    {{ ...vi_attrs('street').defaults({
                        data: data,
                        prefix: prefix,
                        idPrefix: idPrefix,
                        formViolations: formViolations,
                    }).all() }}
                />
            {% endvi_block %}

            {% vi_block postal %}
                <twig:ViewsTheme:Address:Input:Postal
                    class="{{ vi_class('postal') }}"
                    {{ ...vi_attrs('postal').defaults({
                        data: data,
                        prefix: prefix,
                        idPrefix: idPrefix,
                        formViolations: formViolations,
                    }).all() }}
                />
            {% endvi_block %}

            {% vi_block country %}
                <twig:ViewsTheme:Address:Input:Country
                    class="{{ vi_class('country') }}"
                    {{ ...vi_attrs('country').defaults({
                        data: data,
                        countries: countries,
                        page: page,
                        prefix: prefix,
                        idPrefix: idPrefix,
                        showNoShippingPostfix: showNoShippingPostfix,
                        disableNonShippableCountries: disableNonShippableCountries,
                        formViolations: formViolations,
                    }).all() }}
                />
            {% endvi_block %}

            {% vi_block phone %}
                <twig:ViewsTheme:Address:Input:Phone
                    class="{{ vi_class('phone') }}"
                    {{ ...vi_attrs('phone').defaults({
                        data: data,
                        prefix: prefix,
                        idPrefix: idPrefix,
                        formViolations: formViolations,
                    }).all() }}
                />
            {% endvi_block %}
        </twig:block>
    </twig:ViewsTheme:Grid>
</div>
