{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['accountType', 'accountTypeSelect', 'salutation', 'title', 'firstName', 'lastName', 'birthday', 'company']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block fields %}
        <twig:ViewsTheme:Grid columns="6" gap="3">

            <twig:block name="content">
            {% vi_block prepend %}{% endvi_block %}

            {% vi_block accountType %}
                {% if showAccountType %}
                    <twig:ViewsTheme:Form:Toggle
                        class="{{ vi_class('accountType') }}"
                        {{ ...vi_attrs('accountType').defaults({
                            value: businessType,
                            open: accountTypeValue == businessType,
                        }).all() }}
                    >
                        <twig:block name="control">
                            <twig:ViewsTheme:Grid columns="6" gap="3">
                                <twig:block name="content">
                                <twig:ViewsTheme:Form:Select
                                    class="{{ vi_class('accountTypeSelect') }}"
                                    {{ ...vi_attrs('accountTypeSelect').defaults({
                                        id: fields.accountType.id,
                                        name: fields.accountType.name,
                                        options: accountTypeOptions,
                                        value: accountTypeValue,
                                        disabled: companyAlways,
                                        validationRules: 'required',
                                        violationPath: fields.accountType.violationPath,
                                        autocomplete: 'off',
                                        label: 'account.personalTypeLabel'|trans|sw_sanitize,
                                    }).all() }}
                                />
                                </twig:block>
                            </twig:ViewsTheme:Grid>
                            {% if companyAlways %}
                                <input type="hidden" name="{{ fields.accountType.name }}" value="{{ businessType }}">
                            {% endif %}
                        </twig:block>
                        <twig:block name="content">
                            {% vi_block company %}
                                <twig:ViewsTheme:Address:PersonalCompany
                                    class="{{ vi_class('company') }}"
                                    {{ ...vi_attrs('company').defaults({
                                        data: data,
                                        prefix: prefix,
                                        idPrefix: idPrefix,
                                        showVat: showVat,
                                        formViolations: formViolations,
                                    }).all() }}
                                />
                            {% endvi_block %}
                        </twig:block>
                    </twig:ViewsTheme:Form:Toggle>
                {% elseif companyAlways %}
                    <input type="hidden" name="{{ fields.accountType.name }}" value="{{ businessType }}">
                    <twig:ViewsTheme:Address:PersonalCompany
                        class="{{ vi_class('company') }}"
                        {{ ...vi_attrs('company').defaults({
                            data: data,
                            prefix: prefix,
                            idPrefix: idPrefix,
                            showVat: showVat,
                            formViolations: formViolations,
                        }).all() }}
                    />
                {% endif %}
            {% endvi_block %}

            {% vi_block salutation %}
                {% if showSalutation %}
                    <twig:ViewsTheme:Form:Select
                        class="{{ vi_class('salutation') }}"
                        {{ ...vi_attrs('salutation').defaults({
                            id: fields.salutation.id,
                            name: fields.salutation.name,
                            options: salutationOptions,
                            value: fields.salutation.value,
                            violationPath: fields.salutation.violationPath,
                            formViolations: formViolations,
                            autocomplete: 'section-personal honorific-prefix',
                            label: 'account.personalSalutationLabel'|trans|sw_sanitize,
                        }).all() }}
                    />
                {% endif %}
            {% endvi_block %}

            {% vi_block title %}
                {% if showTitle %}
                    <twig:ViewsTheme:Form:Input
                        class="{{ vi_class('title') }}"
                        {{ ...vi_attrs('title').defaults({
                            id: fields.title.id,
                            name: fields.title.name,
                            value: fields.title.value,
                            violationPath: fields.title.violationPath,
                            formViolations: formViolations,
                            autocomplete: 'section-personal honorific-prefix',
                            label: 'account.personalTitleLabel'|trans|sw_sanitize,
                        }).all() }}
                    />
                {% endif %}
            {% endvi_block %}

            {% vi_block firstName %}
                <twig:ViewsTheme:Form:Input
                    class="{{ vi_class('firstName') }}"
                    {{ ...vi_attrs('firstName').defaults({
                        id: fields.firstName.id,
                        name: fields.firstName.name,
                        value: fields.firstName.value,
                        violationPath: fields.firstName.violationPath,
                        formViolations: formViolations,
                        validationRules: 'required',
                        autocomplete: 'section-personal given-name',
                        label: 'account.personalFirstNameLabel'|trans|sw_sanitize,
                    }).all() }}
                />
            {% endvi_block %}

            {% vi_block lastName %}
                <twig:ViewsTheme:Form:Input
                    class="{{ vi_class('lastName') }}"
                    {{ ...vi_attrs('lastName').defaults({
                        id: fields.lastName.id,
                        name: fields.lastName.name,
                        value: fields.lastName.value,
                        violationPath: fields.lastName.violationPath,
                        formViolations: formViolations,
                        validationRules: 'required',
                        autocomplete: 'section-personal family-name',
                        label: 'account.personalLastNameLabel'|trans|sw_sanitize,
                    }).all() }}
                />
            {% endvi_block %}

            {% vi_block birthday %}
                {% if showBirthday %}
                    <twig:ViewsTheme:Form:Birthday
                        class="{{ vi_class('birthday') }}"
                        {{ ...vi_attrs('birthday').defaults({
                            id: idPrefix ~ prefix ~ 'personalBirthday',
                            prefix: null,
                            day: fields.birthdayDay.value,
                            month: fields.birthdayMonth.value,
                            year: fields.birthdayYear.value,
                            validationRules: birthdayRequired ? 'required' : null,
                            formViolations: formViolations,
                            label: 'account.personalBirthdayLabel'|trans|sw_sanitize,
                        }).all() }}
                    />
                {% endif %}
            {% endvi_block %}

            {% vi_block append %}{% endvi_block %}
            </twig:block>
        </twig:ViewsTheme:Grid>
    {% endblock %}
</div>
