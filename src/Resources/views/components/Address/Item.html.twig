{% sw_extends '@Storefront/storefront/page/account/addressbook/address-item.html.twig' %}

{% set itemTag = 'li' %}

{% if defaultShipping %}
    {% set snippet = 'account.addressesTitleDefaultShippingAddress' %}
{% elseif defaultBilling %}
    {% set snippet = 'account.addressesTitleDefaultBillingAddress' %}
{% endif %}

{% set defaultAddressAction = null %}
{% set defaultAddressSnippet = null %}

{% if not defaultShipping %}
    {% set defaultAddressAction = path('frontend.account.address.set-default-address', { type: 'shipping', addressId: address.id }) %}
    {% set defaultAddressSnippet = 'account.addressesSetAsDefaultShippingAction'|trans|sw_sanitize %}
{% endif %}
{% if not defaultBilling %}
    {% set defaultAddressAction = path('frontend.account.address.set-default-address', { type: 'billing', addressId: address.id }) %}
    {% set defaultAddressSnippet = 'account.addressesSetAsDefaultBillingAction'|trans|sw_sanitize %}
{% endif %}

{% block address_item %}
    <{{ itemTag|raw }} data-ref="address-item">
        {% block address_item_body %}
            <div>
                {% block address_item_address %}
                    {{ parent() }}
                {% endblock %}

                {% block address_item_state %}
                    {% if defaultShipping or defaultBilling %}
                        <span>{{ snippet|trans|sw_sanitize }}</span>
                    {% endif %}
                {% endblock %}
            </div>
        {% endblock %}

        {% block address_item_footer %}
            <div>
                {% block address_item_actions %}
                    <div>
                        {% block address_item_action_edit_adress %}
                            <a href="{{ path('frontend.account.address.edit.page', { addressId: address.id }) }}">
                                {{ 'global.default.edit'|trans|sw_sanitize }}
                            </a>
                        {% endblock %}
                        {% block address_item_action_default_adress %}
                            {% if defaultAddressAction %}
                                <form action="{{ defaultAddressAction }}" method="post" style="display: contents;">
                                    <button type="submit" title="{{ defaultAddressSnippet }}">
                                        {{ defaultAddressSnippet }}
                                    </button>
                                </form>
                            {% endif %}
                        {% endblock %}
                        {% block address_item_action_delete_adress %}
                            {% if not (defaultShipping or defaultBilling) %}
                                <form
                                    action="{{ path('frontend.account.address.delete', { addressId: address.id }) }}"
                                    method="post"
                                    style="display: contents;"
                                >
                                    <button type="submit">
                                        {{ 'account.addressesContentItemActionDelete'|trans|sw_sanitize }}
                                    </button>
                                </form>
                            {% endif %}
                        {% endblock %}
                    </div>
                {% endblock %}
            </div>
        {% endblock %}
    </{{ itemTag|raw }}>
{% endblock %}

{% block address_item_dropdown_button %}
    <button
        type="button"
        id="{{ addressItemDropdownId }}"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        aria-label="{{ 'account.addressOptionsBtn'|trans|sw_sanitize }}"
    >
        {{ vi_icon('plus') }}
    </button>
{% endblock %}
