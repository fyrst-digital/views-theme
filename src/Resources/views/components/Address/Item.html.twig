{% props
    address,
    defaultShipping = false,
    defaultBilling = false,
    tag = 'li',
    cva = {},
%}

{% set badgeSnippet = defaultShipping
    ? 'account.addressesTitleDefaultShippingAddress'
    : (defaultBilling ? 'account.addressesTitleDefaultBillingAddress' : null) %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['body', 'badge', 'actions']) %}

<{{ tag|raw }}
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Address:Item',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block body %}
        <div
            {{ vi_attrs('body') }}
            class="{{ vi_class('body') }}"
        >
            {% block badge %}
                {% if badgeSnippet %}
                    <twig:ViewsTheme:Badge
                        class="{{ vi_class('badge') }}"
                        {{ ...vi_attrs('badge').defaults({
                            color: 'light',
                            size: 'sm',
                            pill: true,
                            label: badgeSnippet|trans|striptags,
                        }).all() }}
                    />
                {% endif %}
            {% endblock %}

            {% block address %}
                <twig:ViewsTheme:Address
                    :address="address"
                />
            {% endblock %}
        </div>
    {% endblock %}

    {% block actions %}
        <twig:ViewsTheme:Address:ItemActions
            class="{{ vi_class('actions') }}"
            {{ ...vi_attrs('actions').defaults({
                address: address,
                defaultShipping: defaultShipping,
                defaultBilling: defaultBilling,
            }).all() }}
        />
    {% endblock %}
</{{ tag|raw }}>
