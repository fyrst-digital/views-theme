{% props
    address,
    defaultShipping = false,
    defaultBilling = false,
    tag = 'li',
    cva = {},
%}

{% set badgeSnippet = defaultShipping
    ? 'account.addressesTitleDefaultShippingAddress'
    : (defaultBilling ? 'account.addressesTitleDefaultBillingAddress' : null) %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['body', 'badge', 'actions']) %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block body %}
        <div
            {{ vi_attrs('body') }}
            class="{{ vi_class('body') }}"
        >
            {% block address %}
                <twig:ViewsTheme:Address
                    :address="address"
                />
            {% endblock %}

            {% block badge %}
                {% if badgeSnippet %}
                    <p
                        {{ vi_attrs('badge') }}
                        class="{{ vi_class('badge') }}"
                    >
                        {{ badgeSnippet|trans|sw_sanitize }}
                    </p>
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}

    {% block actions %}
        <twig:ViewsTheme:Address:ItemActions
            class="{{ vi_class('actions') }}"
            {{ ...vi_attrs('actions').defaults({
                address: address,
                defaultShipping: defaultShipping,
                defaultBilling: defaultBilling,
            }).all() }}
        />
    {% endblock %}
</{{ tag|raw }}>
