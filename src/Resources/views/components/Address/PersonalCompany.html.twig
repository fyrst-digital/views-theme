{% props
    data = null,
    prefix = '',
    idPrefix = '',
    showVat = true,
    vatValue = null,
    formViolations = __context.formViolations|default(null),
    cva = {},
%}

{% set companyName = prefix ? prefix ~ '[company]' : 'company' %}
{% set departmentName = prefix ? prefix ~ '[department]' : 'department' %}
{% set vatName = prefix and prefix != 'billingAddress' ? prefix ~ '[vatIds][]' : 'vatIds[]' %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['company', 'department', 'vat']) %}

<twig:ViewsTheme:Grid
    {{ attributes }}
    class="{{ vi_class('root') }}"
    columns="6"
    gap="3"
>
    <twig:block name="content">
    {% block company %}
        <twig:ViewsTheme:Form:Input
            class="{{ vi_class('company') }} g-col-3"
            {{ ...vi_attrs('company').defaults({
                id: idPrefix ~ prefix ~ '-company',
                name: companyName,
                value: data ? data.company|default(null) : null,
                violationPath: prefix ? '/' ~ prefix ~ '/company' : '/company',
                formViolations: formViolations,
                validationRules: 'required',
                autocomplete: 'section-personal organization',
                label: 'address.companyNameLabel'|trans|sw_sanitize,
            }).all() }}
        />
    {% endblock %}

    {% block department %}
        <twig:ViewsTheme:Form:Input
            class="{{ vi_class('department') }} g-col-3"
            {{ ...vi_attrs('department').defaults({
                id: idPrefix ~ prefix ~ '-department',
                name: departmentName,
                value: data ? data.department|default(null) : null,
                violationPath: prefix ? '/' ~ prefix ~ '/department' : '/department',
                formViolations: formViolations,
                autocomplete: 'organization',
                label: 'address.companyDepartmentLabel'|trans|sw_sanitize,
            }).all() }}
        />
    {% endblock %}

    {% block vat %}
        {% if showVat %}
            <twig:ViewsTheme:Form:Input
                class="{{ vi_class('vat') }} g-col-3"
                {{ ...vi_attrs('vat').defaults({
                    id: idPrefix ~ prefix ~ '-vatIds',
                    name: vatName,
                    value: vatValue,
                    violationPath: '/vatIds',
                    formViolations: formViolations,
                    autocomplete: 'off',
                    label: 'address.companyVatLabel'|trans|sw_sanitize,
                }).all() }}
            />
        {% endif %}
    {% endblock %}
    </twig:block>
</twig:ViewsTheme:Grid>
