{% sw_extends '@Storefront/storefront/component/address/address-personal-company.html.twig' %}

{% deprecated 'ViewsTheme:Address:PersonalCompany is a legacy core sw_extends shell and is deprecated. Rewrite as pure UX (optional thin storefront bridge). See docs/conventions/components.md#extends-shells.' package="fyrst/views-theme" version="1.0.0" %}

{% props
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'row g-2 fields-company' },
}|replace_recursive(cva)) %}

{% block component_address_form_company_fields %}
    <div {{ attributes }} class="{{ vi_class('root') }}">
        {% block component_address_form_company_name %}
            {% sw_include '@Storefront/storefront/component/address/field/address-company-name-field.html.twig' with {
                additionalClass: 'col-12 field-company-name'
            } %}
        {% endblock %}

        {% block component_address_form_company_department %}
            {% sw_include '@Storefront/storefront/component/address/field/address-company-department-field.html.twig' with {
                additionalClass: 'col-sm-6 field-company-department'
            } %}
        {% endblock %}

        {# ludtwig-ignore twig-block-name-snake-case #}
        {% block component_address_form_company_vatId %}
            {% if prefix != 'shippingAddress' %}
                {% sw_include '@Storefront/storefront/component/address/address-personal-vat-id.html.twig' with {
                    vatIds: data.get('vatIds')
                } %}
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
