{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['company', 'department', 'vat']) %}

<twig:ViewsTheme:Grid
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        columns: 6,
        gap: '3',
    }).all() }}
>
    <twig:block name="content">
    {% block company %}
        <twig:ViewsTheme:Form:Input
            class="{{ vi_class('company') }}"
            {{ ...vi_attrs('company').defaults({
                id: fields.company.id,
                name: fields.company.name,
                value: fields.company.value,
                violationPath: fields.company.violationPath,
                formViolations: formViolations,
                validationRules: 'required',
                autocomplete: fields.company.autocomplete,
                label: 'address.companyNameLabel'|trans|sw_sanitize,
            }).all() }}
        />
    {% endblock %}

    {% block department %}
        <twig:ViewsTheme:Form:Input
            class="{{ vi_class('department') }}"
            {{ ...vi_attrs('department').defaults({
                id: fields.department.id,
                name: fields.department.name,
                value: fields.department.value,
                violationPath: fields.department.violationPath,
                formViolations: formViolations,
                autocomplete: fields.department.autocomplete,
                label: 'address.companyDepartmentLabel'|trans|sw_sanitize,
            }).all() }}
        />
    {% endblock %}

    {% block vat %}
        {% if showVat %}
            <twig:ViewsTheme:Form:Input
                class="{{ vi_class('vat') }}"
                {{ ...vi_attrs('vat').defaults({
                    id: fields.vat.id,
                    name: fields.vat.name,
                    value: fields.vat.value,
                    violationPath: fields.vat.violationPath,
                    formViolations: formViolations,
                    autocomplete: fields.vat.autocomplete,
                    label: 'address.companyVatLabel'|trans|sw_sanitize,
                }).all() }}
            />
        {% endif %}
    {% endblock %}
    </twig:block>
</twig:ViewsTheme:Grid>
