{% props
    address = null,
    postedData = null,
    data = postedData ?? address,
    typePrefix = '',
    changeBilling = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['fields', 'personal', 'form', 'hint', 'actions', 'submit']) %}

<twig:ViewsTheme:Form:Handler
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        action: path('frontend.account.addressbook'),
        method: 'post',
    }).all() }}
>
    <twig:block name="content">
        {% block hidden %}{% endblock %}

        {% block fields %}
            <div
                {{ vi_attrs('fields') }}
                class="{{ vi_class('fields') }}"
            >
                <twig:ViewsTheme:Address:Personal
                    class="{{ vi_class('personal') }}"
                    {{ ...vi_attrs('personal').defaults({
                        data: data,
                        prefix: 'address',
                        idPrefix: typePrefix,
                        page: page|default(null),
                    }).all() }}
                />
                <twig:ViewsTheme:Address:Form
                    class="{{ vi_class('form') }}"
                    {{ ...vi_attrs('form').defaults({
                        data: data,
                        prefix: 'address',
                        idPrefix: typePrefix,
                        page: page|default(null),
                        showNoShippingPostfix: true,
                        vatInputId: typePrefix ~ 'address-vatIds',
                    }).all() }}
                />
            </div>
        {% endblock %}

        {% block hint %}
            <p
                {{ vi_attrs('hint') }}
                class="{{ vi_class('hint') }}"
            >
                {{ 'general.requiredFields'|trans|sw_sanitize }}
            </p>
        {% endblock %}

        {% block actions %}
            <div
                {{ vi_attrs('actions') }}
                class="{{ vi_class('actions') }}"
            >
                <twig:ViewsTheme:Button
                    class="{{ vi_class('submit') }}"
                    {{ ...vi_attrs('submit').defaults({
                        type: 'submit',
                        color: 'primary',
                        label: 'account.addressSaveChange'|trans|sw_sanitize,
                    }).all() }}
                />
            </div>
        {% endblock %}
    </twig:block>
</twig:ViewsTheme:Form:Handler>
