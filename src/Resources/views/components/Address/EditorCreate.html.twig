{% props
    address = null,
    postedData = null,
    typePrefix = '',
    changeBilling = false,
    cva = {},
%}

{% set formData = postedData ?? address %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['form', 'fields', 'hint', 'actions']) %}

<twig:ViewsTheme:Form:Handler
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        action: path('frontend.account.addressbook'),
        method: 'post',
    }).all() }}
>
    <twig:block name="content">
        {% block hidden %}{% endblock %}

        {% block fields %}
            <div
                {{ vi_attrs('fields') }}
                class="{{ vi_class('fields') }}"
            >
                <twig:ViewsTheme:Address:Personal
                    :data="formData"
                    prefix="address"
                    :idPrefix="typePrefix"
                    :page="page|default(null)"
                />
                <twig:ViewsTheme:Address:Form
                    :data="formData"
                    prefix="address"
                    :idPrefix="typePrefix"
                    :page="page|default(null)"
                    :showNoShippingPostfix="true"
                    vatInputId="{{ typePrefix }}address-vatIds"
                />
            </div>
        {% endblock %}

        {% block hint %}
            <p
                {{ vi_attrs('hint') }}
                class="{{ vi_class('hint') }}"
            >
                {{ 'general.requiredFields'|trans|sw_sanitize }}
            </p>
        {% endblock %}

        {% block actions %}
            <div
                {{ vi_attrs('actions') }}
                class="{{ vi_class('actions') }}"
            >
                <twig:ViewsTheme:Button
                    type="submit"
                    color="primary"
                    label="{{ 'account.addressSaveChange'|trans|sw_sanitize }}"
                />
            </div>
        {% endblock %}
    </twig:block>
</twig:ViewsTheme:Form:Handler>
