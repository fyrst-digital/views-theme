{% props
    addressId,
    type = 'shipping',
    cva = {},
%}

{% do vi_define_cva(cva) %}

<twig:ViewsTheme:Button
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        type: 'button',
        color: 'dark',
        label: 'global.default.edit'|trans|sw_sanitize,
        size: 'sm',
        link: true,
        'data-component': 'ViewsTheme:Address:Manager:Edit',
        'data-component-options': {
            addressId: addressId,
            type: type,
        }|json_encode,
    }).all() }}
/>
