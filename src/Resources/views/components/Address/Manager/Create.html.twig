        icon: 'plus',
        label: 'account.addressCreateBtn'|trans|sw_sanitize,
        'data-component': 'ViewsTheme:Address:Manager:Create',
        'data-component-options': {
            type: type,
        }|json_encode,
    }).all() }}
/>
