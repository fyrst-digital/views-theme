{% do vi_define_cva(cva) %}

<div
    {{ attributes.defaults({
        role: selected ? false : 'listitem',
        'data-component': 'ViewsTheme:Address:Manager:Item',
        'data-component-options': {
            addressId: addressId,
            type: type,
            disabled: shippingBlocked,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    <twig:ViewsTheme:Form:Selection
        type="radio"
        id="{{ radioId }}"
        name="{{ type }}"
        value="{{ addressId }}"
        label="{{ name }}"
        description="{{ summary }}"
        :checked="selected"
        :disabled="shippingBlocked"
        :trailing="false"
    >
        <twig:block name="label">
            {% vi_block label %}
                {% if label is not empty %}
                    <span class="d-block fs-5 fw-semibold">{{ label }}</span>
                {% endif %}
            {% endvi_block %}
        </twig:block>
        <twig:block name="description">
            {% vi_block description %}
                {% if description is not empty %}
                    <span class="d-block fs-6 text-muted" id="{{ id }}-description">{{ description }}</span>
                {% endif %}
            {% endvi_block %}
        </twig:block>
        <twig:block name="trailing">
            {% vi_block trailing %}
                {% if isDefault %}
                    <twig:ViewsTheme:Badge
                        size="sm"
                        color="light"
                        label="{{ 'account.addressDefault'|trans|sw_sanitize }}"
                    />
                {% elseif not shippingBlocked %}
                    <twig:ViewsTheme:Address:Manager:Default
                        addressId="{{ addressId }}"
                        type="{{ name }}"
                    />
                {% endif %}
            {% endvi_block %}
        </twig:block>
    </twig:ViewsTheme:Form:Selection>
    {% if shippingBlocked %}
        <twig:ViewsTheme:Alert
            type="warning"
            :icon="false"
            content="{{ 'address.countryNoShippingAlert'|trans|sw_sanitize }}"
        />
    {% endif %}
</div>
