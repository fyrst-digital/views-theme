{% props
    type,
    current = null,
    available = [],
    activeId = null,
    defaultId = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['current', 'list']) %}

<section
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block current %}
        {% if current %}
            <twig:ViewsTheme:Address:Manager:Item:Hero
                class="{{ vi_class('current') }}"
                {{ ...vi_attrs('current').defaults({
                    address: current,
                    type: type,
                    selected: true,
                    activeId: activeId,
                    defaultId: defaultId,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block list %}
        <twig:ViewsTheme:Address:Manager:List
            class="{{ vi_class('list') }}"
            {{ ...vi_attrs('list').defaults({
                addresses: available,
                type: type,
                activeId: activeId,
                defaultId: defaultId,
            }).all() }}
        />
    {% endblock %}
</section>
