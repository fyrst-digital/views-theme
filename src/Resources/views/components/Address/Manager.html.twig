{% set panelTitle = title ?: ('viewsTheme.account.addressChoose'|trans|sw_sanitize) %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['panel', 'view']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Address:Manager',
        'data-component-options': {
            managerUrl: managerUrl,
            editorUrl: editorUrl,
            switchUrl: switchUrl,
            defaultUrl: defaultUrl,
            tab: tab,
            hideShipping: hideShipping,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        <twig:ViewsTheme:Modal
            id="vi-address-manager"
            label="{{ panelTitle|striptags }}"
        >
            <twig:block name="panel">
                <twig:ViewsTheme:Modal:Panel
                    title="{{ panelTitle }}"
                    :cva="{
                        body: 'vi-modal__body flex-grow-1 overflow-hidden d-flex flex-column',
                        footer: 'vi-modal__footer d-flex align-items-center justify-content-between gap-3 px-7 pt-6 pb-7 flex-shrink-0',
                    }"
                    {{ ...vi_attrs('panel').defaults({}).all() }}
                >
                    <twig:block name="content">
                        <twig:ViewsTheme:Address:Manager:View
                            class="{{ vi_class('view') }}"
                            {{ ...vi_attrs('view').defaults({
                                mode: mode,
                                title: panelTitle,
                                page: page,
                                tab: tab,
                                hideShipping: hideShipping,
                                shippingCurrent: shippingCurrent,
                                shippingAvailable: shippingAvailable,
                                billingCurrent: billingCurrent,
                                billingAvailable: billingAvailable,
                                activeShippingId: activeShippingId,
                                activeBillingId: activeBillingId,
                                defaultShippingId: defaultShippingId,
                                defaultBillingId: defaultBillingId,
                                redirectTo: redirectTo,
                                switchUrl: switchUrl,
                                editorAction: editorAction,
                                editorData: editorData,
                                formViolations: formViolations,
                                type: type,
                                submitLabel: submitLabel,
                                formId: formId,
                            }).all() }}
                        />
                    </twig:block>
                    <twig:block name="actions">
                        {% if mode is same as('editor') %}
                            <twig:ViewsTheme:Address:Manager:Back />
                            <twig:ViewsTheme:Button
                                type="submit"
                                color="primary"
                                class="fw-semibold"
                                form="{{ formId }}"
                                label="{{ submitLabel|default('account.addressSaveChange'|trans|sw_sanitize) }}"
                            />
                        {% else %}
                            <twig:ViewsTheme:Address:Manager:Dismiss />
                            <div class="{{ vi_class('actions') }}">
                                <twig:ViewsTheme:Address:Manager:Create />
                                <twig:ViewsTheme:Form:Handler
                                    id="vi-address-manager-switch"
                                    :action="switchUrl"
                                    method="post"
                                    :preventNative="true"
                                >
                                    <twig:block name="content">
                                        <input type="hidden" name="shippingAddressId" value="{{ activeShippingId }}">
                                        <input type="hidden" name="billingAddressId" value="{{ activeBillingId }}">
                                        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
                                        <twig:ViewsTheme:Button
                                            type="submit"
                                            color="primary"
                                            class="fw-semibold"
                                            label="{{ 'viewsTheme.account.addressApply'|trans|sw_sanitize }}"
                                        />
                                    </twig:block>
                                </twig:ViewsTheme:Form:Handler>
                            </div>
                        {% endif %}
                    </twig:block>
                </twig:ViewsTheme:Modal:Panel>
            </twig:block>
        </twig:ViewsTheme:Modal>
    {% endblock %}
</div>
