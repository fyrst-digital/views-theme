{% if formId is not defined %}
    {% set formId = 'confirmOrderForm' %}
{% endif %}

{% if showTosOptin is not defined %}
    {% set showTosOptin = true %}
{% endif %}

{% if tosSnippet is not defined %}
    {% set tosSnippet = 'checkout.confirmTermsText'|trans({
        '%url%': path('frontend.cms.page', { id: config('core.basicInformation.tosPage') })
    }) %}
{% endif %}

{%
  set classes = vi_define_classes({
    main: ['confirm-tos'],
    title: ['confirm-tos-title'],
    revocationNotice: ['revocation-notice'],
    control: ['form-check'],
    tosCheckbox: ['checkout-confirm-tos-checkbox', 'form-check-input'],
    tosLabel: ['checkout-confirm-tos-label', 'custom-control-label'],
    revocationCheckbox: ['checkout-confirm-revocation-checkbox', 'form-check-input'],
    revocationLabel: ['checkout-confirm-revocation-label', 'custom-control-label'],
    invalid: ['is-invalid'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_confirm_tos %}
    <div {{ classes.main | vi_attr_classes }}>
    
        {% block component_confirm_tos_header %}
            <div {{ classes.title | vi_attr_classes }}>
                {{ 'checkout.confirmTermsHeader'|trans|sw_sanitize }}
            </div>
        {% endblock %}

        {% block component_confirm_tos_revocation_notice %}
            <div {{ classes.revocationNotice | vi_attr_classes }}>
                {{ 'checkout.confirmRevocationNotice'|trans({
                    '%url%': path('frontend.cms.page', { id: config('core.basicInformation.revocationPage') })
                })|raw }}
            </div>
        {% endblock %}

        {% block component_confirm_tos_control %}
            {% if showTosOptin is same as(true) %}
                <div {{ classes.control | vi_attr_classes }}>
                    {% block component_confirm_tos_tos_control_checkbox %}
                        {% set tosCheckboxClasses = classes.tosCheckbox %}
                        {% if formViolations.getViolations('/tos') is not empty %}
                            {% set tosCheckboxClasses = tosCheckboxClasses|merge(classes.invalid) %}
                        {% endif %}
                        <input type="checkbox"
                            {{ tosCheckboxClasses | vi_attr_classes }}
                            required="required"
                            id="tos"
                            form="{{formId}}"
                            name="tos">
                    {% endblock %}

                    {% block component_confirm_tos_control_label %}
                        <label for="tos"
                                {{ classes.tosLabel | vi_attr_classes }}>
                            {{ tosSnippet|raw }}
                        </label>
                    {% endblock %}
                </div>
            {% else %}
                {{ tosSnippet|raw }}
                <input type="hidden" 
                    id="tos"
                    form="{{formId}}"
                    name="tos" 
                    value="1" />
            {% endif %}
        {% endblock %}

        {% block component_confirm_tos_revocation_control %}
            {% if page.showRevocation() %}
                <div {{ classes.control | vi_attr_classes }}>
                    {% block component_confirm_tos_revocation_control_checkbox %}
                        {% set revocationCheckboxClasses = classes.revocationCheckbox %}
                        {% if formViolations.getViolations('/revocation') is not empty %}
                            {% set revocationCheckboxClasses = revocationCheckboxClasses|merge(classes.invalid) %}
                        {% endif %}
                        <input type="checkbox"
                                {{ revocationCheckboxClasses | vi_attr_classes }}
                                required="required"
                                id="revocation"
                                form="{{formId}}"
                                name="revocation">
                    {% endblock %}

                    {% block component_confirm_tos_revocation_control_label %}
                        <label for="revocation"
                                {{ classes.revocationLabel | vi_attr_classes }}>
                            {{ 'checkout.confirmRevocationTerms'|trans() }}
                        </label>
                    {% endblock %}
                </div>
            {% endif %}
        {% endblock %}

    </div>
{% endblock %}
