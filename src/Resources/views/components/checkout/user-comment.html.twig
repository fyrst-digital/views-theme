{%
  set classes = vi_define_classes({
    title: ['checkout-user-comment-title'],
    control: ['checkout-user-comment-control'],
    label: ['form-label'],
    textarea: ['form-control'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_checkout_user_comment %}

    {% if title %}
        <div {{ classes.title | vi_attr_classes }}>
            {{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}
        </div>
    {% endif %}

    <div {{ classes.control | vi_attr_classes }}>
        {% block page_checkout_confirm_customer_comment_control_textfield_label %}
            <label {{ classes.label | vi_attr_classes }} for="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}">
                {{ 'checkout.customerCommentLabel'|trans|sw_sanitize }}
            </label>
        {% endblock %}

        {% block page_checkout_confirm_customer_comment_control_textfield %}
            <textarea {{ classes.textarea | vi_attr_classes }}
                        placeholder="{{ 'checkout.customerCommentPlaceholder'|trans|sw_sanitize }}"
                        id="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}"
                        form="confirmOrderForm"
                        name="{{ constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') }}"></textarea>
        {% endblock %}
    </div>
{% endblock %}
