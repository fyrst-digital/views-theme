{% set deliveryDate = deliveryDate|default(page.extensions.viewsTheme.deliveryDate|default({})) %}

{%
  set classes = vi_define_classes({
    container: [''],
    title: [''],
    input: {
      container: [],
      label: ['form-label'],
      date: ['form-control'],
      helpText: ['form-text'],
    }
  }, classes|default({}), replaceClasses|default(false))
%}

{%
  set options = {
    title: 'checkout.preferredDeliveryDate.title'|trans|sw_sanitize,
    label: 'checkout.preferredDeliveryDate.label'|trans|sw_sanitize,
    helpText: 'checkout.preferredDeliveryDate.helpText'|trans|sw_sanitize,
  }|merge(options|default({}))
%}

{% block component_checkout_delivery_date_selection %}
  {% if deliveryDate.active|default(false) %}
    <div {{ classes.container | vi_attr_classes }} data-component="delivery-date-selection">

      {% block component_checkout_delivery_date_selection_title %}
        {% if options.title is not same as(false) %}
          <div {{ classes.title | vi_attr_classes }}>
            {{ options.title }}
          </div>
        {% endif %}
      {% endblock %}

      {% block component_checkout_delivery_date_selection_control %}
        <div {{ classes.input.container | vi_attr_classes }}>

          {% block component_checkout_delivery_date_selection_label %}
            {% if options.label is not same as(false) %}
              <label {{ classes.input.label | vi_attr_classes }} for="PreferredDeliveryDate">
                {{ options.label }}
              </label>
            {% endif %}
          {% endblock %}

          {% block component_checkout_delivery_date_selection_input %}
            <input
              {{ classes.input.date | vi_attr_classes }}
              type="date"
              id="PreferredDeliveryDate"
              form="confirmOrderForm"
              name="viewsThemeDeliveryDate"
              min="{{ deliveryDate.min|default('') }}"
              max="{{ deliveryDate.max|default('') }}"
              value="">
          {% endblock %}

          {% block component_checkout_delivery_date_selection_help %}
            {% if options.helpText is not same as(false) %}
              <div {{ classes.input.helpText | vi_attr_classes }}>
                {{ options.helpText }}
              </div>
            {% endif %}
          {% endblock %}
        </div>
      {% endblock %}
    </div>
  {% endif %}
{% endblock %}