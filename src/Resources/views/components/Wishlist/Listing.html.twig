{% props
    searchResult = null,
    resultsUrl = null,
    aggregationsUrl = null,
    params = {},
    sidebar = false,
    boxLayout = 'wishlist',
    ariaLiveUpdates = true,
    disableEmptyFilter = false,
    referrerCategoryId = null,
    cva = {},
%}

{% do vi_define_cva({
    empty: { base: 'vi-wishlist-listing__empty wishlist-listing-empty-container' },
    emptyImage: { base: 'vi-wishlist-listing__empty-image wishlist-listing-empty' },
    header: { base: 'vi-wishlist-listing__header text-center wishlist-listing-header' },
    description: { base: 'vi-wishlist-listing__description text-center wishlist-listing-description' },
}|replace_recursive(cva)) %}
{% do vi_define_attrs(['description', 'empty', 'emptyImage', 'header']) %}

<twig:ViewsTheme:Product:Listing
    :searchResult="searchResult"
    :resultsUrl="resultsUrl"
    :aggregationsUrl="aggregationsUrl"
    :params="params"
    :sidebar="sidebar"
    :boxLayout="boxLayout"
    :ariaLiveUpdates="ariaLiveUpdates"
    :disableEmptyFilter="disableEmptyFilter"
    :referrerCategoryId="referrerCategoryId"
>
    <twig:block name="results">
        <twig:ViewsTheme:Product:Listing:Results
            :searchResult="searchResult"
            :boxLayout="boxLayout"
            :referrerCategoryId="referrerCategoryId"
        >
            <twig:block name="actions"></twig:block>

            <twig:block name="empty">
                <twig:ViewsTheme:Product:Listing:Empty
                    class="{{ vi_class('empty') }}"
                    {{ ...vi_attrs('empty').all() }}
                >
                    <twig:block name="content">
                        <img
                            src="{{ asset('bundles/viewstheme/illustrations/wishlist-empty.svg', 'asset') }}"
                            alt="{{ 'wishlist.wishlistEmptyDescription'|trans|striptags }}"
                            {{ vi_attrs('emptyImage') }}
                            class="{{ vi_class('emptyImage') }}"
                        >

                        <h1 {{ vi_attrs('header') }} class="{{ vi_class('header') }}">
                            {{ 'wishlist.wishlistEmptyHeader'|trans }}
                        </h1>
                        <p {{ vi_attrs('description') }} class="{{ vi_class('description') }}">
                            {{ 'wishlist.wishlistEmptyDescription'|trans }}
                        </p>
                    </twig:block>
                </twig:ViewsTheme:Product:Listing:Empty>
            </twig:block>
        </twig:ViewsTheme:Product:Listing:Results>
    </twig:block>
</twig:ViewsTheme:Product:Listing>
