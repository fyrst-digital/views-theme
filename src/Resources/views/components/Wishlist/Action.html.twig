{% props
    href = path('frontend.wishlist.page'),
    title = 'header.wishlist'|trans|striptags,
    label = 'header.wishlist'|trans|striptags,
    badgeId = 'wishlist-basket',
    liveId = 'wishlist-basket-live-area',
    widgetsOptions = {},
    storageOptions = {},
    size = 'md',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set liveClass = cx.live.apply() %}
{% set labelClass = cx.label.apply() %}
{% set buttonLabel = label is same as(false) ? null : label %}

<twig:ViewsTheme:Button
    class="{{ cx.root.apply({ size: size }) }}"
    label:class="{{ labelClass }}"
    {{ ...attributes.defaults({
        type: 'link',
        href: href,
        title: title,
        icon: 'heart',
        label: buttonLabel,
        color: 'none',
        size: size,
        'aria-labelledby': liveId,
    }).all() }}
>
    <twig:block name="prepend">
        <twig:ViewsTheme:Wishlist:Action:Badge
            :id="badgeId"
            :widgetsOptions="widgetsOptions"
            :storageOptions="storageOptions"
        />
    </twig:block>

    <twig:block name="append">
        <span
            id="{{ liveId }}"
            class="{{ liveClass }}"
            data-wishlist-live-area-text="{{ 'header.wishlistAriaLiveTemplate'|trans }}"
            aria-live="polite"
        ></span>
    </twig:block>
</twig:ViewsTheme:Button>
