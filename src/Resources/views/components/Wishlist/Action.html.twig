{% props
    href = path('frontend.wishlist.page'),
    title = 'header.wishlist'|trans|striptags,
    label = 'header.wishlist'|trans|striptags,
    widgetsOptions = {},
    storageOptions = {},
    size = 'md',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<a
    {{ attributes.defaults({
        href: href,
        title: title,
        'aria-labelledby': 'wishlist-basket-live-area',
    }).without('class').without('data-component-template') }}
    class="{{ cx.root.apply({ size: size }) }}"
>
    {% block badge %}
        <span
            {{ attributes.nested('badge').defaults({
                id: 'wishlist-basket',
                'data-wishlist-storage': 'true',
                'data-wishlist-storage-options': {
                    listPath: path('frontend.wishlist.product.list'),
                    mergePath: path('frontend.wishlist.product.merge'),
                    pageletPath: path('frontend.wishlist.product.merge.pagelet'),
                }|merge(storageOptions)|json_encode,
                'data-wishlist-widget': 'true',
                'data-wishlist-widget-options': {
                    showCounter: true,
                }|merge(widgetsOptions)|json_encode,
            }) }}
            class="{{ cx.badge.apply() }}"
        ></span>
    {% endblock %}

    {% block icon %}
        {{ vi_icon('heart', { class: cx.icon.apply({ size: size }) }) }}
    {% endblock %}

    {% block label %}
        {% if label is not same as(false) %}
            <span
                {{ attributes.nested('label') }}
                class="{{ cx.label.apply() }}"
            >
                {{ label }}
            </span>
        {% endif %}
    {% endblock %}

    {% block live_region %}
        <span
            {{ attributes.nested('live').defaults({
                id: 'wishlist-basket-live-area',
                'data-wishlist-live-area-text': 'header.wishlistAriaLiveTemplate'|trans,
                'aria-live': 'polite',
            }) }}
            class="{{ cx.live.apply() }}"
        ></span>
    {% endblock %}
</a>
