{% props
    id = 'wishlist-basket',
    count = 0,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<span
    {{ attributes.defaults({
        id: id,
        hidden: count < 1,
        'data-component': 'ViewsTheme:Wishlist:Action:Badge',
    }) }}
    class="{{ vi_class('root') }}"
>{% if count > 0 %}{{ count }}{% endif %}</span>
