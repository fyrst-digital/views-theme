{% props
    id = 'wishlist-basket',
    liveId = 'wishlist-basket-live-area',
    liveText = 'header.wishlistAriaLiveTemplate'|trans,
    count = 0,
    changedEvent = 'ViewsTheme:Wishlist:Changed',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<span
    {{ attributes.defaults({
        id: id,
        hidden: count < 1,
        'data-component': 'ViewsTheme:Wishlist:Action:Badge',
        'data-component-options': {
            changedEvent: changedEvent,
            liveId: liveId,
            liveText: liveText,
        }|json_encode,
    }) }}
    class="{{ cx.root.apply() }}"
>{% if count > 0 %}{{ count }}{% endif %}</span>
