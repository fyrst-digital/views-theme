{%
  set classes = vi_define_classes({
    item: ['order-item-summary-item'],
    label: ['order-item-summary-item-label'],
    value: ['order-item-summary-item-value'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_order_item_summary_item %}
    <div {{ classes.item | vi_attr_classes }}>

        {% block component_order_item_summary_item_label %}
            <div {{ classes.label | vi_attr_classes }}>
                {{ label|raw }}
            </div>
        {% endblock %}

        {% block component_order_item_summary_item_value %}
            <div {{ classes.value | vi_attr_classes }}>
                {{ value|raw }}
            </div>
        {% endblock %}
    </div>
{% endblock %}
