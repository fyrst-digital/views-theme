{
    root: {
        base: 'vi-line-item vi-line-item__promotion',
        variants: {
            layout: {
                stacked: 'd-grid gx-3 gy-2 align-items-center',
                grid: 'd-contents',
                table: 'd-grid align-items-center gap-3 gap-xl-4',
            },
        },
    },
    header: {
        base: 'vi-line-item__header d-flex align-items-start justify-content-between gap-2',
    },
    name: {
        base: 'vi-line-item__name min-w-0',
    },
    label: {
        base: 'vi-line-item__label',
    },
    image: {
        base: 'vi-line-item__image icon-size-5 d-flex align-items-center justify-content-center flex-shrink-0 bg-body-secondary',
        variants: {
            layout: {
                stacked: 'rounded-2 p-4',
                grid: 'rounded-2 p-4',
                table: 'rounded-1',
            },
        },
        defaultVariants: {
            layout: 'stacked',
        },
    },
    footer: {
        base: 'vi-line-item__footer',
        variants: {
            layout: {
                stacked: 'd-flex align-items-center gap-2',
                grid: 'd-flex d-xl-contents align-items-center gap-2',
            },
        },
    },
    price: {
        base: 'vi-line-item__price fw-semibold',
        variants: {
            layout: {
                stacked: 'flex-shrink-0 ms-auto ms-xl-0',
                grid: 'flex-shrink-0 ms-auto ms-xl-0',
                table: 'text-end',
            },
        },
    },
