{% props
    lineItem,
    tag = 'li',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set label = lineItem.label|trans|sw_sanitize %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block image %}
        <div
            {{ attributes.nested('image') }}
            class="{{ cx.image.apply() }}"
        >
            {{ vi_icon('tag') }}
        </div>
    {% endblock %}

    {% block content %}
        <div
            {{ attributes.nested('content') }}
            class="{{ cx.content.apply() }}"
        >
            {% block header %}
                <div
                    {{ attributes.nested('header') }}
                    class="{{ cx.header.apply() }}"
                >
                    {% block name %}
                        <div
                            {{ attributes.nested('name') }}
                            class="{{ cx.name.apply() }}"
                        >
                            <span
                                {{ attributes.nested('label') }}
                                class="{{ cx.label.apply() }}"
                            >
                                {{ label|raw }}
                            </span>
                        </div>
                    {% endblock %}
                </div>
            {% endblock %}

            {% block details %}
                <div
                    {{ attributes.nested('totalPrice') }}
                    class="{{ cx.totalPrice.apply() }}"
                >
                    {% if lineItem.payload.discountScope != 'delivery' %}
                        {{ lineItem.price.totalPrice|currency }}
                    {% endif %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
</{{ tag|raw }}>
