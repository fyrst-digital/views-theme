{% props
    lineItem,
    tag = 'li',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set label = lineItem.label|trans|sw_sanitize %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block image %}
        <div
            {{ attributes.nested('image') }}
            class="{{ cx.image.apply() }}"
        >
            {{ vi_icon('tag') }}
        </div>
    {% endblock %}

    {% block content %}
        <twig:ViewsTheme:LineItem:Content
            {{ ...attributes.nested('content').all() }}
        >
            <div
                {{ attributes.nested('header') }}
                class="{{ cx.header.apply() }}"
            >
                <div
                    {{ attributes.nested('name') }}
                    class="{{ cx.name.apply() }}"
                >
                    <span
                        {{ attributes.nested('label') }}
                        class="{{ cx.label.apply() }}"
                    >
                        {{ label|raw }}
                    </span>
                </div>
            </div>

            <twig:ViewsTheme:LineItem:Price
                {{ ...attributes.nested('price').defaults({
                    lineItem: lineItem,
                }).all() }}
            />
        </twig:ViewsTheme:LineItem:Content>
    {% endblock %}
</{{ tag|raw }}>
