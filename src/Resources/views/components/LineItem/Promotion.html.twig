{% props
    lineItem,
    tag = 'li',
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['image', 'content', 'header', 'name', 'label', 'price']) %}

{% set label = lineItem.label|trans|sw_sanitize %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block image %}
        <div
            {{ vi_attrs('image') }}
            class="{{ vi_class('image') }}"
        >
            {{ vi_icon('tag') }}
        </div>
    {% endblock %}

    {% block content %}
        <twig:ViewsTheme:LineItem:Content
            {{ ...vi_attrs('content').all() }}
        >
            <div
                {{ vi_attrs('header') }}
                class="{{ vi_class('header') }}"
            >
                <div
                    {{ vi_attrs('name') }}
                    class="{{ vi_class('name') }}"
                >
                    <span
                        {{ vi_attrs('label') }}
                        class="{{ vi_class('label') }}"
                    >
                        {{ label|raw }}
                    </span>
                </div>
            </div>

            <twig:ViewsTheme:LineItem:Price
                {{ ...vi_attrs('price').defaults({
                    lineItem: lineItem,
                }).all() }}
            />
        </twig:ViewsTheme:LineItem:Content>
    {% endblock %}
</{{ tag|raw }}>
