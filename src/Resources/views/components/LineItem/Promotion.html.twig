{% props
    lineItem,
    tag = 'li',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    image: attributes.nested('image'),
    content: attributes.nested('content'),
    header: attributes.nested('header'),
    name: attributes.nested('name'),
    label: attributes.nested('label'),
    price: attributes.nested('price'),
} %}

{% set label = lineItem.label|trans|sw_sanitize %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block image %}
        <div
            {{ attrs.image }}
            class="{{ cx.image.apply() }}"
        >
            {{ vi_icon('tag') }}
        </div>
    {% endblock %}

    {% block content %}
        <twig:ViewsTheme:LineItem:Content
            {{ ...attrs.content.all() }}
        >
            <div
                {{ attrs.header }}
                class="{{ cx.header.apply() }}"
            >
                <div
                    {{ attrs.name }}
                    class="{{ cx.name.apply() }}"
                >
                    <span
                        {{ attrs.label }}
                        class="{{ cx.label.apply() }}"
                    >
                        {{ label|raw }}
                    </span>
                </div>
            </div>

            <twig:ViewsTheme:LineItem:Price
                {{ ...attrs.price.defaults({
                    lineItem: lineItem,
                }).all() }}
            />
        </twig:ViewsTheme:LineItem:Content>
    {% endblock %}
</{{ tag|raw }}>
