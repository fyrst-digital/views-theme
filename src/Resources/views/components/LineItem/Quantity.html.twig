{% props
    lineItem,
    label = 'viewsTheme.lineItems.quantityLabel'|trans|sw_sanitize,
    cva = {},
%}

{% set quantityInformation = lineItem.quantityInformation %}

{% set DIGITAL_CONST = constant('Shopware\\Core\\Content\\Product\\ProductDefinition::TYPE_DIGITAL') %}
{% set isDigital = lineItem.payload.productType is defined and lineItem.payload.productType == DIGITAL_CONST %}
{% if feature('v6.8.0.0') %}
    {% set isDigital = isDigital or (quantityInformation and quantityInformation.maxPurchase === 1) %}
{% else %}
    {% set DOWNLOAD_STATE = constant('Shopware\\Core\\Content\\Product\\State::IS_DOWNLOAD') %}
    {% set isDigital = isDigital
        or (lineItem.states is defined and DOWNLOAD_STATE in lineItem.states)
        or (quantityInformation and quantityInformation.maxPurchase === 1) %}
{% endif %}

{% do vi_define_cva(cva) %}

<div
    {{ attributes }}
    class="{{ vi_class('root', { digital: isDigital }) }}"
>
    <span class="{{ vi_class('label') }}">{{ label }}</span>
    <span class="{{ vi_class('value') }}">{{ lineItem.quantity }}</span>
</div>
