{% props
    lineItem,
    cva = {},
%}

{% set features = lineItem.payload.features ?? [] %}
{% set cx = vi_cva_from_file(cva) %}

{% if features is not empty %}
    <ul
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% for feature in features %}
            <li {{ attributes.nested('item') }} class="{{ cx.item.apply() }}">
                {% if feature.label is defined %}
                    {{ feature.label|trans|sw_sanitize }}
                {% elseif feature.value is defined %}
                    {{ feature.value }}
                {% else %}
                    {{ feature }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
