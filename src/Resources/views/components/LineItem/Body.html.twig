{% props
    lineItem,
    deliveries = null,
    layout = 'stacked',
    cva = {},
%}

{% set options = lineItem.payload.options ?? [] %}
{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['variations', 'meta', 'features', 'deliveryDate']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block variations %}
        {% if options is not empty %}
            {% if layout is same as('table') %}
                <div
                    {{ vi_attrs('meta') }}
                    class="{{ vi_class('meta') }}"
                >
                    {% for variation in options %}
                        {% if not loop.first %}<span aria-hidden="true"> · </span>{% endif %}
                        {{ variation.option }}
                    {% endfor %}
                </div>
            {% else %}
                <twig:ViewsTheme:Product:Variations
                    class="{{ vi_class('variations') }}"
                    {{ ...vi_attrs('variations').defaults({
                        variations: options,
                    }).all() }}
                />
            {% endif %}
        {% endif %}
    {% endblock %}

    {% block features %}
        <twig:ViewsTheme:LineItem:Features
            {{ ...vi_attrs('features').defaults({
                lineItem: lineItem,
            }).all() }}
        />
    {% endblock %}

    {% block deliveryDate %}
        {% if config('core.cart.showDeliveryTime') %}
            <twig:ViewsTheme:LineItem:DeliveryDate
                {{ ...vi_attrs('deliveryDate').defaults({
                    lineItem: lineItem,
                    deliveries: deliveries,
                }).all() }}
            />
        {% endif %}
    {% endblock %}
</div>
