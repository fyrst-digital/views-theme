{% props
    lineItem,
    deliveries = null,
    cva = {},
%}

{% set options = lineItem.payload.options ?? [] %}
{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    variations: attributes.nested('variations'),
    features: attributes.nested('features'),
    deliveryDate: attributes.nested('deliveryDate'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block variations %}
        {% if options is not empty %}
            <twig:ViewsTheme:Product:Variations
                class="d-flex flex-wrap align-items-center gap-1 text-body-secondary small"
                {{ ...attrs.variations.defaults({
                    variations: options,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block features %}
        <twig:ViewsTheme:LineItem:Features
            {{ ...attrs.features.defaults({
                lineItem: lineItem,
            }).all() }}
        />
    {% endblock %}

    {% block deliveryDate %}
        {% if config('core.cart.showDeliveryTime') %}
            <twig:ViewsTheme:LineItem:DeliveryDate
                {{ ...attrs.deliveryDate.defaults({
                    lineItem: lineItem,
                    deliveries: deliveries,
                }).all() }}
            />
        {% endif %}
    {% endblock %}
</div>
