{% props
    lineItem,
    label = lineItem.label|trans|sw_sanitize,
    productLink = null,
    nestingLevel = 0,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['name']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block name %}
        <twig:ViewsTheme:Product:Name
            class="{{ vi_class('name') }}"
            {{ ...vi_attrs('name').defaults({
                name: label,
                url: productLink,
                showLink: productLink is not null,
            }).all() }}
        />
    {% endblock %}
</div>
