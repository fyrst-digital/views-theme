{% props
    lineItem,
    label = lineItem.label|trans|sw_sanitize,
    productLink = null,
    nestingLevel = 0,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block name %}
        <twig:ViewsTheme:Product:Name
            class="{{ cx.name.apply() }}"
            {{ ...attributes.nested('name').defaults({
                name: label,
                url: productLink,
                showLink: productLink is not null,
            }).all() }}
        />
    {% endblock %}
</div>
