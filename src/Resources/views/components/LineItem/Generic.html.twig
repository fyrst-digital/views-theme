{% props
    lineItem,
    showRemoveButton = true,
    showQuantitySelect = true,
    showPrice = true,
    nestingLevel = 0,
    deliveries = null,
    tag = 'li',
    layout = 'stacked',
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-line-item--generic' },
}) %}

{% block content %}
    <twig:ViewsTheme:LineItem:Product
        :lineItem="lineItem"
        :showRemoveButton="showRemoveButton"
        :showQuantitySelect="showQuantitySelect"
        :showPrice="showPrice"
        :nestingLevel="nestingLevel"
        :deliveries="deliveries"
        :tag="tag"
        :layout="layout"
        :cva="cva"
        class="{{ vi_class('root') }}"
        {{ ...attributes }}
    />
{% endblock %}
