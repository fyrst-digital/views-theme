{% props
    lineItem,
    showRemoveButton = true,
    showPrice = true,
    nestingLevel = 0,
    deliveries = null,
    tag = 'li',
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-line-item--generic' },
}|replace_recursive(cva)) %}

{% block content %}
    <twig:ViewsTheme:LineItem:Product
        :lineItem="lineItem"
        :showRemoveButton="showRemoveButton"
        :showPrice="showPrice"
        :nestingLevel="nestingLevel"
        :deliveries="deliveries"
        :tag="tag"
        class="{{ cx.root.apply() }}"
        {{ ...attributes }}
    />
{% endblock %}
