{% props
    lineItem,
    showPrice = true,
    nestingLevel = 0,
    showRemoveButton = true,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    price: attributes.nested('price'),
    quantity: attributes.nested('quantity'),
    quantityInput: attributes.nested('quantityInput'),
    remove: attributes.nested('remove'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block price %}
        <twig:ViewsTheme:LineItem:Price
            class="{{ cx.price.apply() }}"
            {{ ...attrs.price.defaults({
                lineItem: lineItem,
                showPrice: showPrice,
            }).all() }}
        />
    {% endblock %}

    {% block quantity %}
        <div
            {{ attrs.quantity }}
            class="{{ cx.quantity.apply() }}"
        >
            <twig:ViewsTheme:LineItem:Quantity
                {{ ...attrs.quantityInput.defaults({
                    lineItem: lineItem,
                    nestingLevel: nestingLevel,
                }).all() }}
            />

            {% block remove %}
                {% if showRemoveButton is same as(true) and lineItem.removable and nestingLevel < 1 %}
                    <twig:ViewsTheme:LineItem:Remove
                        class="{{ cx.remove.apply() }}"
                        {{ ...attrs.remove.defaults({
                            lineItem: lineItem,
                        }).all() }}
                    />
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}
</div>
