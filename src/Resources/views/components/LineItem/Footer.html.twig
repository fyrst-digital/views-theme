{% props
    lineItem,
    showPrice = true,
    nestingLevel = 0,
    showRemoveButton = true,
    showQuantitySelect = true,
    layout = 'stacked',
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['unitPrice', 'price', 'quantity', 'quantityInput', 'remove']) %}

<div
    {{ attributes.defaults({
        'data-layout': layout,
    }) }}
    class="{{ vi_class('root', { layout: layout }) }}"
>
    {% block quantity %}
        <twig:ViewsTheme:LineItem:Quantity
            class="{{ vi_class('quantity') }}"
            {{ ...vi_attrs('quantityInput').defaults({
                lineItem: lineItem,
                nestingLevel: nestingLevel,
                showQuantitySelect: showQuantitySelect,
            }).all() }}
        />
    {% endblock %}

    {% block remove %}
        {% if showRemoveButton is same as(true) and lineItem.removable and nestingLevel < 1 %}
            <twig:ViewsTheme:LineItem:Remove
                class="{{ vi_class('remove') }}"
                {{ ...vi_attrs('remove').defaults({
                    lineItem: lineItem,
                }).all() }}
            />
        {% elseif layout is same as('table') and showRemoveButton %}
            <span
                {{ vi_attrs('remove').defaults({
                    'aria-hidden': 'true',
                }) }}
                class="{{ vi_class('remove') }}"
            ></span>
        {% endif %}
    {% endblock %}

    {% block unitPrice %}
        {% if layout is same as('grid') %}
            <twig:ViewsTheme:LineItem:UnitPrice
                class="{{ vi_class('unitPrice') }}"
                {{ ...vi_attrs('unitPrice').defaults({
                    lineItem: lineItem,
                    showPrice: showPrice,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block price %}
        <twig:ViewsTheme:LineItem:Price
            class="{{ vi_class('price', { layout: layout }) }}"
            {{ ...vi_attrs('price').defaults({
                lineItem: lineItem,
                showPrice: showPrice,
            }).all() }}
        />
    {% endblock %}
</div>
