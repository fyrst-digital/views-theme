{% props
    lineItem,
    showPrice = true,
    nestingLevel = 0,
    showRemoveButton = true,
    showQuantitySelect = true,
    layout = 'stacked',
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['price', 'actions', 'quantity']) %}

{% set showActions = showQuantitySelect is same as(true)
    and showRemoveButton is same as(true)
    and nestingLevel < 1
    and lineItem.quantityInformation
    and lineItem.stackable
    and lineItem.removable %}

<div
    {{ attributes.defaults({
        'data-layout': layout,
    }) }}
    class="{{ vi_class('root', { layout: layout }) }}"
>
    {% if showActions %}
        {% block actions %}
            <twig:ViewsTheme:LineItem:Actions
                class="{{ vi_class('actions') }}"
                {{ ...vi_attrs('actions').defaults({
                    lineItem: lineItem,
                }).all() }}
            />
        {% endblock %}
    {% else %}
        {% block quantity %}
            <twig:ViewsTheme:LineItem:Quantity
                class="{{ vi_class('quantity') }}"
                {{ ...vi_attrs('quantity').defaults({
                    lineItem: lineItem,
                }).all() }}
            />
        {% endblock %}
    {% endif %}

    {% block price %}
        <twig:ViewsTheme:LineItem:Price
            class="{{ vi_class('price', { layout: layout }) }}"
            {{ ...vi_attrs('price').defaults({
                lineItem: lineItem,
                showPrice: showPrice,
            }).all() }}
        />
    {% endblock %}
</div>
