{% props
    lineItem,
    showRemoveButton = true,
    showPrice = true,
    nestingLevel = 0,
    deliveries = null,
    tag = 'li',
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-line-item--container' },
}|replace_recursive(cva)) %}

{% block content %}
    <twig:ViewsTheme:LineItem:Product
        :lineItem="lineItem"
        :showRemoveButton="showRemoveButton"
        :showPrice="showPrice"
        :nestingLevel="nestingLevel"
        :deliveries="deliveries"
        :tag="tag"
        class="{{ vi_class('root') }}"
        {{ ...attributes }}
    />
{% endblock %}
