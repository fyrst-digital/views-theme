{% props
    lineItem,
    label = null,
    redirectTo = 'frontend.checkout.cart.page',
    redirectParameters = null,
    formAction = null,
    displayMode = 'default',
    cva = {},
%}

{% set formAction = formAction is not null
    ? formAction
    : path('frontend.checkout.line-item.delete', { id: lineItem.id }) %}
{% set label = label is not null ? label : lineItem.label|trans|sw_sanitize %}
{% set loaderOptions = { skipLoadingIndicator: true } %}

{% set cx = vi_cva({
    root: {
        base: 'vi-line-item-remove',
        variants: {
            displayMode: {
                offcanvas: 'js-offcanvas-cart-remove-product',
                default: '',
            },
        },
    },
    button: { base: 'vi-line-item-remove__button btn btn-light btn-sm line-item-remove-button line-item-action' },
}|replace_recursive(cva)) %}

<form
    action="{{ formAction }}"
    method="post"
    data-form-submit-loader="true"
    data-form-submit-loader-options="{{ loaderOptions|json_encode }}"
    {{ attributes }}
    class="{{ cx.root.apply({ displayMode: displayMode }) }}"
>
    <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
    <input type="hidden" name="redirectParameters" value="{{ redirectParameters }}">

    {% block button %}
        <button
            type="submit"
            aria-label="{{ 'checkout.removeLineItem'|trans({ '%lineItemLabel%': label })|striptags }}"
            title="{{ 'global.default.remove'|trans }}"
            data-product-id="{{ lineItem.id }}"
            {{ attributes.nested('button') }}
            class="{{ cx.button.apply() }}"
        >
            {{ vi_icon('x') }}
        </button>
    {% endblock %}
</form>
