{% props
    lineItem,
    redirectTo = 'frontend.checkout.cart.page',
    redirectParameters = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    button: attributes.nested('button'),
} %}

<form
    {{ attributes.defaults({
        action: path('frontend.checkout.line-item.delete', { id: lineItem.id }),
        method: 'post',
        'data-component': 'ViewsTheme:LineItem:Remove',
        'data-component-options': {
            lineItemId: lineItem.id,
            removeEvent: 'ViewsTheme:Cart:Remove',
        }|json_encode,
    }) }}
    class="{{ cx.root.apply() }}"
>
    <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
    {% if redirectParameters is not null %}
        <input type="hidden" name="redirectParameters" value="{{ redirectParameters }}">
    {% endif %}

    {% block button %}
        <twig:ViewsTheme:Button
            class="{{ cx.button.apply() }}"
            {{ ...attrs.button.defaults({
                type: 'submit',
                icon: 'trash',
                color: 'link',
                size: 'sm',
                title: 'global.default.remove'|trans,
                'aria-label': 'checkout.removeLineItem'|trans({
                    '%lineItemLabel%': lineItem.label|trans|sw_sanitize,
                })|striptags,
            }).all() }}
        />
    {% endblock %}
</form>
