{% props
    lineItem,
    showRemoveButton = true,
    showPrice = true,
    nestingLevel = 0,
    deliveries = null,
    tag = 'li',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    cover: attributes.nested('cover'),
    content: attributes.nested('content'),
    header: attributes.nested('header'),
    body: attributes.nested('body'),
    footer: attributes.nested('footer'),
} %}

{% set label = lineItem.label|trans|sw_sanitize %}
{% set productLink = lineItem.type is same as('product')
    ? seoUrl('frontend.detail.page', { productId: lineItem.referencedId })
    : null %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block image %}
        <twig:ViewsTheme:Product:Cover
            class="{{ cx.image.apply() }}"
            image:class="w-100 h-100 object-fit-cover"
            placeholder:class="d-flex align-items-center justify-content-center w-100 h-100 bg-body-secondary text-body-secondary"
            {{ ...attrs.cover.defaults({
                id: lineItem.referencedId,
                name: label,
                cover: lineItem.cover ?? null,
                showLink: productLink is not null,
                url: productLink,
                sizes: { default: '100px' },
                tabindex: productLink is not null ? '-1' : null,
            }).all() }}
        />
    {% endblock %}

    {% block content %}
        <twig:ViewsTheme:LineItem:Content
            {{ ...attrs.content.all() }}
        >
            <twig:ViewsTheme:LineItem:Header
                {{ ...attrs.header.defaults({
                    lineItem: lineItem,
                    label: label,
                    productLink: productLink,
                    showRemoveButton: showRemoveButton,
                    nestingLevel: nestingLevel,
                }).all() }}
            />

            <twig:ViewsTheme:LineItem:Body
                {{ ...attrs.body.defaults({
                    lineItem: lineItem,
                    deliveries: deliveries,
                }).all() }}
            />

            <twig:ViewsTheme:LineItem:Footer
                {{ ...attrs.footer.defaults({
                    lineItem: lineItem,
                    showPrice: showPrice,
                    nestingLevel: nestingLevel,
                }).all() }}
            />
        </twig:ViewsTheme:LineItem:Content>
    {% endblock %}
</{{ tag|raw }}>
