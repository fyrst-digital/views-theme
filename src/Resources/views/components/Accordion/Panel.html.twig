{% props
    id = null,
    header = null,
    active = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['content']) %}

<div
    {{ attributes.defaults({
        id: id,
        role: 'region',
        'aria-labelledby': header,
        inert: not active,
        'data-component': 'ViewsTheme:Accordion:Panel',
        'data-component-options': {
            header: header,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    <div {{ vi_attrs('content') }} class="{{ vi_class('content') }}">
        {% block content %}{% endblock %}
    </div>
</div>
