{% props
    # Storefront captcha template: basicCaptcha | honeypot | googleReCaptchaV2 |
    # googleReCaptchaV3
    type,
    formId = 'form-' ~ random(),
%}

{% sw_include '@Storefront/storefront/component/captcha/%s.html.twig'|format(type)
    ignore missing
    with {
        additionalClass: null,
        formId: formId,
    }
%}
