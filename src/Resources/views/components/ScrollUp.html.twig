{% sw_extends '@Storefront/storefront/layout/scroll-up.html.twig' %}

{% deprecated 'ViewsTheme:ScrollUp is a legacy core sw_extends shell and is deprecated. Rewrite as pure UX (optional thin storefront bridge). See docs/conventions/components.md#extends-shells.' package="fyrst/views-theme" version="1.0.0" %}

{% props
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-scroll-up scroll-up-container position-fixed end-0 bottom-0' },
}|replace_recursive(cva)) %}

{% block layout_scroll_up_inner %}
    <div
        {{ attributes.defaults({
            'data-scroll-up': 'true',
        }) }}
        class="{{ vi_class('root') }}"
    >
        <div class="scroll-up-button js-scroll-up-button">
            <button type="submit" class="btn btn-primary rounded-pill p-3" aria-hidden="true">
                {{ vi_icon('caret-up') }}
            </button>
        </div>
    </div>
{% endblock %}
