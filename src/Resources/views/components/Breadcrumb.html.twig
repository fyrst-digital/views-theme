{% sw_extends '@Storefront/storefront/layout/breadcrumb.html.twig' %}

{% set iconOptions = iconOptions|default(themeParameters.icons|default({})) %}

{% block layout_breadcrumb_placeholder %}
    {% if key != breadcrumbKeys|last %}
        <div class="vi-breadcrumb__separator breadcrumb-placeholder" aria-hidden="true">
            {{ vi_icon('arrow-right', iconOptions) }}
        </div>
    {% endif %}
{% endblock %}
