{% if visible %}
    {% do vi_define_cva(cva) %}
    {% do vi_define_attrs(['list', 'separator', 'item']) %}

    {% block root %}
        <nav
            {{ attributes.defaults({
                'aria-label': 'breadcrumb',
            }) }}
            class="{{ vi_class('root') }}"
        >
            {% block list %}
                <ol
                    {{ vi_attrs('list') }}
                    class="{{ vi_class('list') }}"
                >
                    {% for item in items %}
                        {% block item %}
                            <twig:ViewsTheme:Breadcrumb:Item
                                class="{{ vi_class('item') }}"
                                {{ ...vi_attrs('item').defaults({
                                    name: item.name,
                                    href: item.href,
                                    active: item.active,
                                    folder: item.folder,
                                    openInNewTab: item.openInNewTab,
                                }).all() }}
                            />
                        {% endblock %}

                        {% if not loop.last %}
                            {% block separator %}
                                <li
                                    {{ vi_attrs('separator').defaults({
                                        'aria-hidden': 'true',
                                    }) }}
                                    class="{{ vi_class('separator') }}"
                                >
                                    {{ vi_icon(separatorIcon) }}
                                </li>
                            {% endblock %}
                        {% endif %}
                    {% endfor %}
                </ol>
            {% endblock %}
        </nav>
    {% endblock %}
{% endif %}
