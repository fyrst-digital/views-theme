{% set iconOptions = iconOptions|default(themeParameters.icons) %}

{%
  set classes = vi_define_classes({
    container: [],
    nav: ['nav', 'user-actions', 'flex-column'],
    action: ['nav-link', 'd-inline-flex'],
    footer: [],
    logoutAction: [],
  }, classes|default({}), replaceClasses|default(false))
%}

{% if userActions is not defined %}
  {%
    set userActions = {
        home: {
            route: 'frontend.account.home.page',
            label: 'account.overviewLink'|trans|striptags,
            icon: 'squares-four'
        },
        profile: {
            route: 'frontend.account.profile.page',
            label: 'account.profileLink'|trans|sw_sanitize,
            icon: 'pencil-simple-line'
        },
        address: {
            route: 'frontend.account.address.page',
            label: 'account.addressLink'|trans|sw_sanitize,
            icon: 'address-book'
        },
        orders: {
            route: 'frontend.account.order.page',
            label: 'account.ordersLink'|trans|sw_sanitize,
            icon: 'package'
        }
    }
  %}
{% endif %}

{% block component_account_user_actions %}
  <div
    {{ classes.container | vi_attr_classes }}
    data-component="account-user-actions">
    {% if userActions is not empty %}
      {% block component_account_user_actions_nav %}
        <nav {{ classes.nav | vi_attr_classes }}>
          {% for key, action in userActions %}
            {% block component_account_user_action %}
              {% if activeRoute is same as(action.route) %}
              {% endif %}
              <a
                {{ classes.action | vi_attr_classes }}
                href="{{path(action.route)}}"
                title="{{action.label}}"
                data-component="{{ 'account-user-action-' ~ key }}"
                aria-current="page">
                {% block component_account_user_action_icon %}
                  {% if action.icon is defined %}
                    {{ vi_icon(action.icon, iconOptions) }}
                  {% endif %}
                {% endblock %}

                {% block component_account_user_action_label %}
                  {{ action.label }}
                {% endblock %}
              </a>
            {% endblock %}
          {% endfor %}
        </nav>
      {% endblock %}
    {% endif %}

    {% block component_account_user_actions_footer %}
      <div {{ classes.footer | vi_attr_classes }}>
        {% block component_account_user_action_footer_logout %}
          <a
            href="{{ path('frontend.account.logout.page') }}"
            {{ classes.logoutAction | vi_attr_classes }}
            title="{{ 'account.logout'|trans|sw_sanitize }}"
            aria-current="page">
            {% block component_account_user_action_logout_icon -%}{%- endblock %}

            {% block component_account_user_action_logout_label %}
              {{ 'account.logout' | trans | sw_sanitize }}
            {% endblock %}
          </a>
        {% endblock %}
      </div>
    {% endblock %}
  </div>
{% endblock %}
