{% use '@Storefront/components/gallery-slider/thumbnails.html.twig' %}
{% use '@Storefront/components/gallery-slider/canvas.html.twig' %}

{%
  set classes = vi_define_classes({
    main: ['gallery-slider'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_gallery_slider %}
    <div {{ classes.main | vi_attr_classes }}
        data-component="gallery-slider">
        {{ block('component_gallery_slider_thumbnails') }}
        {{ block('component_gallery_slider_canvas') }}
    </div>
{% endblock %}
