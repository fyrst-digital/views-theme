{% sw_extends '@Storefront/storefront/component/review/review-form.html.twig' %}

{%
  set classes = vi_define_classes({
    rating: ['form-group', 'col-md-4', 'product-detail-review-form-rating'],
    label: ['form-label'],
    ratingInput: ['product-detail-review-form-rating-input'],
    star: ['product-detail-review-form-star'],
    starActive: ['product-detail-review-form-star', 'is-active'],
    radio: ['product-detail-review-form-radio'],
    starIcon: ['icon-review-star'],
    ratingText: ['h6', 'product-detail-review-form-rating-text'],
    ratingTextHidden: ['h6', 'product-detail-review-form-rating-text', 'd-none'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_review_form_rating %}
    <div {{ classes.rating | vi_attr_classes }}>
        <label for="#review-form-rating" {{ classes.label | vi_attr_classes }}>
            {{ 'detail.reviewFormRatingLabel'|trans|sw_sanitize }}{{ 'general.required'|trans|sw_sanitize }}
        </label>

        <div id="review-form-rating"
                {{ classes.ratingInput | vi_attr_classes }}
                data-rating-system="true">
            {% if data.get('points') is not empty %}
                {% set currentPoints = data.get('points')|number_format %}
            {% else %}
                {% set currentPoints = reviews.matrix.maxPoints %}
            {% endif %}

            {% set maxPoints = reviews.matrix.maxPoints %}

            {% for point in 1..maxPoints %}
                <label data-review-form-point="{{ point }}"
                        {{ (currentPoints >= point ? classes.starActive : classes.star) | vi_attr_classes }}>
                    <input {{ classes.radio | vi_attr_classes }}
                        type="radio"
                        name="points"
                        value="{{ point }}"
                        {% if currentPoints >= point %} checked="checked"{% endif %}>

                        <span {{ classes.starIcon | vi_attr_classes }}></span>
                </label>
            {% endfor %}
            {% for matrix in reviews.matrix.matrix %}
                <p {{ (currentPoints != matrix.points ? classes.ratingTextHidden : classes.ratingText) | vi_attr_classes }}
                    data-rating-text="{{ matrix.points }}">
                    {{ "detail.review#{matrix.points}PointRatingText"|trans|sw_sanitize }}
                </p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
