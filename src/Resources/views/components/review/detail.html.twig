{% sw_extends '@Storefront/storefront/component/review/review.html.twig' %}

{%
  set classes = vi_define_classes({
    listContent: ['product-detail-review-list-content'],
    formCollapse: ratingSuccess == -1
      ? ['collapse', 'multi-collapse', 'show']
      : ['collapse', 'multi-collapse'],
    form: ['product-detail-review-form'],
    login: ['product-detail-review-login'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_review_alert %}
    {% if ratingSuccess == 1 %}
        <twig:ViewsTheme:Alert
            type="success"
            content="{{ 'detail.reviewFormSuccessAlert'|trans|sw_sanitize }}"
        />
    {% elseif ratingSuccess == 2 %}
        <twig:ViewsTheme:Alert
            type="success"
            content="{{ 'detail.reviewFormSuccessUpdateAlert'|trans|sw_sanitize }}"
        />
    {% elseif ratingSuccess == -1 %}
        <twig:ViewsTheme:Alert
            type="danger"
            content="{{ 'detail.reviewFormErrorAlert'|trans|sw_sanitize }}"
        />
    {% endif %}
{% endblock %}

{% block component_review_list_empty %}
    <twig:ViewsTheme:Alert
        type="info"
        content="{{ 'detail.reviewListEmpty'|trans|sw_sanitize }}"
    />
{% endblock %}

{% block utilities_offcanvas_meta %}
{% endblock %}

{% block utilities_offcanvas %}
    {{ block('component_review_container') }}
{% endblock %}

{% block component_review_widget_container %}
    {% sw_include '@Storefront/components/review/widget.html.twig' %}
{% endblock %}

{% block component_review_list_content %}
    {% for review in reviews %}
        <div {{ classes.listContent | vi_attr_classes }}>
            {% sw_include '@Storefront/components/review/item.html.twig' %}
        </div>
    {% endfor %}
{% endblock %}

{% block component_review_form_container %}
    <div {{ classes.formCollapse | vi_attr_classes }}
            id="review-form">

        {% if context.customer and not context.customer.guest %}
            <div {{ classes.form | vi_attr_classes }}>
                {% sw_include '@Storefront/components/review/form.html.twig' %}
            </div>
        {% else %}
            <div {{ classes.login | vi_attr_classes }}>
                {% sw_include '@Storefront/storefront/component/review/review-login.html.twig' %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block component_review_list_action_language %}
{% endblock %}
