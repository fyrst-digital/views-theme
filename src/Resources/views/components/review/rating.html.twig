{% sw_extends '@Storefront/storefront/component/review/rating.html.twig' %}

{%
  set classes = vi_define_classes({
    main: ['product-review-rating', 'd-flex', 'flex-wrap', 'flex-row'],
    starFull: ['review-star', 'full'],
    starHalf: ['review-star', 'half'],
    starBlank: ['review-star', 'blank'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_review_rating_output %}
    <div {{ classes.main | vi_attr_classes }}>
        {% if full > 0 %}
            {% for star in range(1,full) %}
                <div {{ classes.starFull | vi_attr_classes }}>
                    {{vi_icon('star-fill')}}
                </div>
            {% endfor %}
        {% endif %}

        {% if half %}
            <div {{ classes.starHalf | vi_attr_classes }}>
                {{vi_icon('star-half-fill')}}
            </div>
        {% endif %}

        {% if blank > 0 %}
            {% for star in range(1,blank) %}
                <div {{ classes.starBlank | vi_attr_classes }}>
                    {{vi_icon('star')}}
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
