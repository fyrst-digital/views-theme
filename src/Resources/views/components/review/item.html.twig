{% sw_extends '@Storefront/storefront/component/review/review-item.html.twig' %}

{%
  set classes = vi_define_classes({
    points: ['col-md-auto', 'product-detail-review-item-points'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_review_item_info_points %}
    <div {{ classes.points | vi_attr_classes }}>
        {% sw_include '@Storefront/components/review/rating.html.twig' with {
            points: review.points
        } %}
    </div>
{% endblock %}
