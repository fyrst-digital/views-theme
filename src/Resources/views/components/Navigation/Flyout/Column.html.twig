{% props
    item,
    level = 0,
    maxDepth = 3,
    cva = {},
%}

{% set category = item.category %}
{% set name = category.translated.name %}
{% set isFolder = category.type == 'folder' %}
{% set children = item.children %}
{% set cx = vi_cva_from_file(cva) %}
{% set classes = {
    root: cx.root.apply(),
    heading: cx.heading.apply(),
    list: cx.list.apply(),
    item: cx.item.apply(),
} %}
{% set attrs = {
    heading: attributes.nested('heading'),
    list: attributes.nested('list'),
} %}

<div
    {{ attributes }}
    class="{{ classes.root }}"
>
    {% if isFolder %}
        <div
            {{ attrs.heading }}
            class="{{ classes.heading }}"
            title="{{ name }}"
        >
            {{ name }}
        </div>
    {% else %}
        <a
            {{ attrs.heading.defaults({
                href: category_url(category),
                title: name,
                target: category_linknewtab(category) ? '_blank' : null,
            }) }}
            class="{{ classes.heading }}"
        >
            {{ name }}
        </a>
    {% endif %}

    {% if children|length > 0 and level < maxDepth %}
        <ul
            {{ attrs.list }}
            class="{{ classes.list }}"
        >
            {% for child in children %}
                {% set childCat = child.category %}
                {% set childHasChildren = child.children|length > 0 %}
                {% set childSkipped = childCat.type == 'folder' and not childHasChildren %}

                {% if not childSkipped %}
                    <twig:ViewsTheme:Navigation:Flyout:Item
                        class="{{ classes.item }}"
                        :item="child"
                        :level="level + 1"
                        :maxDepth="maxDepth"
                    />
                {% endif %}
            {% endfor %}
        </ul>
    {% endif %}
</div>
