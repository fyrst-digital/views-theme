{% props
    category,
    image,
    cva = {},
%}

{% set name = category.translated.name %}
{% set isFolder = category.type == 'folder' %}
{% do vi_define_cva(cva, ['root', 'link', 'image']) %}
{% do vi_define_attrs(['link']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% if isFolder %}
        <div class="{{ vi_class('link') }}">
            {% sw_thumbnails 'navigation-flyout-teaser-image' with {
                media: image,
                sizes: { default: '320px' },
                attributes: {
                    class: vi_class('image'),
                    alt: (image.translated.alt ?: name),
                    title: (image.translated.title ?: name),
                    loading: 'lazy',
                },
            } %}
        </div>
    {% else %}
        <a
            {{ vi_attrs('link').defaults({
                href: category_url(category),
                title: name,
                target: category_linknewtab(category) ? '_blank' : null,
            }) }}
            class="{{ vi_class('link') }}"
        >
            {% sw_thumbnails 'navigation-flyout-teaser-image' with {
                media: image,
                sizes: { default: '320px' },
                attributes: {
                    class: vi_class('image'),
                    alt: (image.translated.alt ?: name),
                    title: (image.translated.title ?: name),
                    loading: 'lazy',
                },
            } %}
        </a>
    {% endif %}
</div>
