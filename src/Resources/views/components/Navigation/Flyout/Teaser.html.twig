{% props
    category,
    image,
    cva = {},
%}

{% set name = category.translated.name %}
{% set isFolder = category.type == 'folder' %}
{% set cx = vi_cva_from_file(cva) %}
{% set classes = {
    root: cx.root.apply(),
    link: cx.link.apply(),
    image: cx.image.apply(),
} %}
{% set attrs = {
    link: attributes.nested('link'),
} %}

<div
    {{ attributes }}
    class="{{ classes.root }}"
>
    {% if isFolder %}
        <div class="{{ classes.link }}">
            {% sw_thumbnails 'navigation-flyout-teaser-image' with {
                media: image,
                sizes: { default: '320px' },
                attributes: {
                    class: classes.image,
                    alt: (image.translated.alt ?: name),
                    title: (image.translated.title ?: name),
                    loading: 'lazy',
                },
            } %}
        </div>
    {% else %}
        <a
            {{ attrs.link.defaults({
                href: category_url(category),
                title: name,
                target: category_linknewtab(category) ? '_blank' : null,
            }) }}
            class="{{ classes.link }}"
        >
            {% sw_thumbnails 'navigation-flyout-teaser-image' with {
                media: image,
                sizes: { default: '320px' },
                attributes: {
                    class: classes.image,
                    alt: (image.translated.alt ?: name),
                    title: (image.translated.title ?: name),
                    loading: 'lazy',
                },
            } %}
        </a>
    {% endif %}
</div>
