{% props
    category,
    menuUrl = path('frontend.views-theme.navigation.drawer.menu'),
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    start: attributes.nested('start'),
    back: attributes.nested('back'),
    showAll: attributes.nested('showAll'),
    end: attributes.nested('end'),
    active: attributes.nested('active'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        {% block start %}
            <div
                {{ attrs.start }}
                class="{{ cx.start.apply() }}"
            >        
                <twig:ViewsTheme:Navigation:Drawer:Back
                    class="btn btn-sm"
                    icon:class="icon-size-2"
                    {{ ...attrs.back.defaults({
                        showLabel: false,
                        category: category,
                        menuUrl: menuUrl,
                    }).all() }}
                />
                <twig:ViewsTheme:Navigation:Drawer:ShowAll
                    class="btn btn-sm"
                    icon:class="icon-size-2"
                    {{ ...attrs.showAll.defaults({
                        showLabel: false,
                        menuUrl: menuUrl,
                    }).all() }}
                />
            </div>
        {% endblock %}
        {% block end %}
            <div
                {{ attrs.end }}
                class="{{ cx.end.apply() }}"
            >       
                <twig:ViewsTheme:Navigation:Drawer:Active
                    class="btn btn-sm"
                    {{ ...attrs.active.defaults({
                        category: category,
                    }).all() }}
                />
            </div>
        {% endblock %}
    {% endblock %}
</div>
