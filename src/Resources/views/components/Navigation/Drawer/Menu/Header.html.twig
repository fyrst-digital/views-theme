{% props
    category,
    menuUrl = path('frontend.views-theme.navigation.drawer.menu'),
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        {% block start %}
            <div
                {{ attributes.nested('start') }}
                class="{{ cx.start.apply() }}"
            >        
                <twig:ViewsTheme:Navigation:Drawer:Back
                    class="btn btn-sm"
                    icon:class="icon-size-2"
                    {{ ...attributes.nested('back').defaults({
                        showLabel: false,
                        category: category,
                        menuUrl: menuUrl,
                    }).all() }}
                />
                <twig:ViewsTheme:Navigation:Drawer:ShowAll
                    class="btn btn-sm"
                    icon:class="icon-size-2"
                    {{ ...attributes.nested('showAll').defaults({
                        showLabel: false,
                        menuUrl: menuUrl,
                    }).all() }}
                />
            </div>
        {% endblock %}
        {% block end %}
            <div
                {{ attributes.nested('end') }}
                class="{{ cx.end.apply() }}"
            >       
                <twig:ViewsTheme:Navigation:Drawer:Active
                    class="btn btn-sm"
                    {{ ...attributes.nested('active').defaults({
                        category: category,
                    }).all() }}
                />
            </div>
        {% endblock %}
    {% endblock %}
</div>
