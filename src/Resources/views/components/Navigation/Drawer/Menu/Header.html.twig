{% props
    category,
    menuUrl = path('frontend.views-theme.navigation.drawer.menu'),
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['start', 'back', 'showAll', 'end', 'active']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% block start %}
            <div
                {{ vi_attrs('start') }}
                class="{{ vi_class('start') }}"
            >        
                <twig:ViewsTheme:Navigation:Drawer:Back
                    class="btn btn-sm"
                    icon:class="icon-size-2"
                    {{ ...vi_attrs('back').defaults({
                        showLabel: false,
                        category: category,
                        menuUrl: menuUrl,
                    }).all() }}
                />
                <twig:ViewsTheme:Navigation:Drawer:ShowAll
                    class="btn btn-sm"
                    icon:class="icon-size-2"
                    {{ ...vi_attrs('showAll').defaults({
                        showLabel: false,
                        menuUrl: menuUrl,
                    }).all() }}
                />
            </div>
        {% endblock %}
        {% block end %}
            <div
                {{ vi_attrs('end') }}
                class="{{ vi_class('end') }}"
            >       
                <twig:ViewsTheme:Navigation:Drawer:Active
                    class="btn btn-sm"
                    {{ ...vi_attrs('active').defaults({
                        category: category,
                    }).all() }}
                />
            </div>
        {% endblock %}
    {% endblock %}
</div>
