{% props
    item,
    activeId = null,
    menuUrl = path('frontend.views-theme.navigation.drawer.menu'),
    image = null,
    cva = {},
%}

{% set category = item.category %}
{% set isActive = activeId and category.id == activeId %}
{% set hasChildren = category.visibleChildCount > 0 %}
{% set name = category.translated.name %}
{% set isFolder = category.type == 'folder' %}
{% set drillUrl = path('frontend.views-theme.navigation.drawer.menu', { navigationId: category.id }) %}
{% set cx = vi_cva_from_file(cva) %}
{% set classes = {
    root: cx.root.apply(),
    link: cx.link.apply({ active: isActive }),
    image: cx.image.apply(),
    label: cx.label.apply(),
    drill: cx.drill.apply(),
    icon: cx.icon.apply(),
} %}
{% set attrs = {
    link: attributes.nested('link'),
    drill: attributes.nested('drill'),
} %}

<li
    {{ attributes }}
    class="{{ classes.root }}"
>
    <a
        {{ attrs.link.defaults({
            href: not isFolder ? category_url(category) : '#',
            title: name,
            'aria-current': isActive ? 'page' : null,
            target: not isFolder and category_linknewtab(category) ? '_blank' : null,
        }) }}
        class="{{ classes.link }}"
    >
        {% block image %}
            {% if image %}
                {% sw_thumbnails 'navigation-drawer-item-image' with {
                    media: image,
                    sizes: { default: '64px' },
                    attributes: {
                        class: classes.image,
                        alt: (image.translated.alt ?: name),
                        title: (image.translated.title ?: name),
                        loading: 'lazy',
                    },
                } %}
            {% endif %}
        {% endblock %}

        {% block label %}
            <span class="{{ classes.label }}">{{ name }}</span>
        {% endblock %}
    </a>

    {% block drill %}
        {% if hasChildren %}
            <twig:ViewsTheme:Navigation:Drawer:Drill
                class="{{ classes.drill }}"
                {{ ...attrs.drill.defaults({
                    href: drillUrl,
                    url: drillUrl,
                    title: name,
                    'aria-label': name,
                }).all() }}
            >
                {{ vi_icon('caret-right', {
                    class: classes.icon
                }) }}
            </twig:ViewsTheme:Navigation:Drawer:Drill>
        {% endif %}
    {% endblock %}
</li>
