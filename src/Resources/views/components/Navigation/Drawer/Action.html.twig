{% props
    size = 'md',
    drawerUrl = path('frontend.views-theme.navigation.drawer'),
    cva = {},
%}

{% do vi_define_cva(cva) %}

<twig:ViewsTheme:Button
    class="{{ vi_class('root', { size: size }) }}"
    {{ ...attributes.defaults({
        type: 'button',
        icon: 'list',
        color: 'none',
        size: size,
        'aria-label': 'general.menuLink'|trans|striptags,
        'aria-haspopup': 'dialog',
        'aria-controls': 'vi-navigation-drawer',
        'aria-expanded': 'false',
        'data-component': 'ViewsTheme:Navigation:Drawer:Action',
        'data-component-options': {
            drawerUrl: drawerUrl,
        }|json_encode,
    }).all() }}
/>
