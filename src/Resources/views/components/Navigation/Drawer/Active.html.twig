{% props
    category,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<a
    {{ attributes.defaults({
        href: category_url(category),
        title: category.translated.name,
        target: category_linknewtab(category) ? '_blank' : null,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {{ category.translated.name }}
</a>
