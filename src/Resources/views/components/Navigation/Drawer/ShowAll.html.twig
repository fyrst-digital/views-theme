{% props
    menuUrl = path('frontend.views-theme.navigation.drawer.menu'),
    showLabel = true,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set rootClass = cx.root.apply() %}
{% set iconClass = cx.icon.apply() %}

<twig:ViewsTheme:Navigation:Drawer:Drill
    class="{{ rootClass }}"
    {{ ...attributes.defaults({
        href: menuUrl,
        title: 'viewsTheme.navigationDrawer.showAll'|trans|striptags,
        direction: 'back',
    }).all() }}
>
    {{ vi_icon('list', {
        class: iconClass
    }) }}
    {% if showLabel is same as(true) %}
        <span class="{{ cx.label.apply() }}">
            {{ 'viewsTheme.navigationDrawer.showAll'|trans|sw_sanitize }}
        </span>
    {% endif %}
</twig:ViewsTheme:Navigation:Drawer:Drill>
