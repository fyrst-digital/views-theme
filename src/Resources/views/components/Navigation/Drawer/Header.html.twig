{% props
    wishlist = config('core.cart.wishlistEnabled'),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['wishlist', 'account']) %}

<twig:ViewsTheme:Drawer:Header
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({}).all() }}
>
    <twig:block name="title">
        <div class="{{ vi_class('title') }}">
            {% vi_block action_prepend %}{% endvi_block %}

            {% vi_block action_wishlist %}
                {% if wishlist %}
                    <twig:ViewsTheme:Wishlist:Action
                        class="{{ vi_class('wishlist') }}"
                        label:class="{{ vi_class('wishlistLabel') }}"
                        {{ ...vi_attrs('wishlist').defaults({
                            badgeId: 'vi-navigation-drawer-wishlist-basket',
                            liveId: 'vi-navigation-drawer-wishlist-live',
                            'aria-labelledby': 'vi-navigation-drawer-wishlist-live',
                        }).all() }}
                    />
                {% endif %}
            {% endvi_block %}

            {% vi_block action_account %}
                <twig:ViewsTheme:Account:Action
                    class="{{ vi_class('account') }}"
                    toggle:label:class="{{ vi_class('accountLabel') }}"
                    {{ ...vi_attrs('account').defaults({
                        placement: 'bottom-center',
                    }).all() }}
                />
            {% endvi_block %}

            {% vi_block action_append %}{% endvi_block %}
        </div>
    </twig:block>
</twig:ViewsTheme:Drawer:Header>
