{% props
    navigation,
    menuUrl = path('frontend.views-theme.navigation.drawer.menu'),
    cva = {},
%}

{% set activeId = shopware.navigation.id ?? context.salesChannel.navigationCategoryId %}
{% set isRoot = activeId == context.salesChannel.navigationCategoryId %}
{% set children = navigation.getChildren(activeId) %}
{% set active = navigation.active %}
{% do vi_define_cva(cva, ['root', 'scroll', 'level', 'list']) %}
{% do vi_define_attrs(['scroll', 'level', 'header', 'list']) %}

{% set navigationImageIds = [] %}
{% if children %}
    {% for treeItem in children.tree %}
        {% set itemCustomFields = treeItem.category.translated.customFields|default({}) %}
        {% set navigationImageId = itemCustomFields.vi_navigation_image ?? null %}
        {% if navigationImageId %}
            {% set navigationImageIds = navigationImageIds|merge([navigationImageId]) %}
        {% endif %}
    {% endfor %}
{% endif %}
{% set navigationImages = navigationImageIds is not empty
    ? searchMedia(navigationImageIds, context.context)
    : null %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Navigation:Drawer:Menu',
    }) }}
    class="{{ vi_class('root') }}"
>
    <twig:ViewsTheme:Scroll:Area
        class="{{ vi_class('scroll') }}"
        {{ ...vi_attrs('scroll').all() }}
    >
        <div
            {{ vi_attrs('level').defaults({
                'data-level': '',
            }) }}
            class="{{ vi_class('level') }}"
        >
            {% if not isRoot and active %}
                <twig:ViewsTheme:Navigation:Drawer:Menu:Header
                    {{ ...vi_attrs('header').defaults({
                        category: active,
                        menuUrl: menuUrl,
                    }).all() }}
                />
            {% endif %}

            <ul
                {{ vi_attrs('list') }}
                class="{{ vi_class('list') }}">
                {% if children %}
                    {% for item in children.tree %}
                        {% set hasChildren = item.category.visibleChildCount > 0 %}

                        {% if item.category.type != 'folder' or hasChildren %}
                            {% set itemCustomFields = item.category.translated.customFields|default({}) %}
                            {% set imageId = itemCustomFields.vi_navigation_image ?? null %}
                            {% set image = imageId and navigationImages ? navigationImages.get(imageId) : null %}
                            <twig:ViewsTheme:Navigation:Drawer:Item
                                :item="item"
                                :activeId="activeId"
                                :menuUrl="menuUrl"
                                :image="image"
                            />
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </ul>
        </div>
    </twig:ViewsTheme:Scroll:Area>
</div>
