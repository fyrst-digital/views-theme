{% props
    navigation,
    menuUrl = path('frontend.views-theme.navigation.drawer.menu'),
    cva = {},
%}

{% set activeId = shopware.navigation.id ?? context.salesChannel.navigationCategoryId %}
{% set isRoot = activeId == context.salesChannel.navigationCategoryId %}
{% set children = navigation.getChildren(activeId) %}
{% set active = navigation.active %}
{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Navigation:Drawer:Menu',
    }) }}
    class="{{ cx.root.apply() }}"
>
    <div
        {{ attributes.nested('level').defaults({
            'data-level': '',
        }) }}
        class="{{ cx.level.apply() }}"
    >
        {% if not isRoot and active %}
            <twig:ViewsTheme:Navigation:Drawer:ShowAll :menuUrl="menuUrl" />
            <twig:ViewsTheme:Navigation:Drawer:Active :category="active" />
            <twig:ViewsTheme:Navigation:Drawer:Back
                :category="active"
                :menuUrl="menuUrl"
            />
        {% else %}
            <div {{ attributes.nested('headline') }} class="{{ cx.headline.apply() }}">
                {{ 'general.categories'|trans|sw_sanitize }}
            </div>
        {% endif %}

        <ul {{ attributes.nested('list') }} class="{{ cx.list.apply() }}">
            {% if not isRoot and active and active.type != 'folder' %}
                <twig:ViewsTheme:Navigation:Drawer:ShowActive :category="active" />
            {% endif %}

            {% if children %}
                {% for item in children.tree %}
                    {% set hasChildren = item.category.visibleChildCount > 0 %}

                    {% if item.category.type != 'folder' or hasChildren %}
                        <twig:ViewsTheme:Navigation:Drawer:Item
                            :item="item"
                            :activeId="activeId"
                            :menuUrl="menuUrl"
                        />
                    {% endif %}
                {% endfor %}
            {% endif %}
        </ul>
    </div>
</div>
