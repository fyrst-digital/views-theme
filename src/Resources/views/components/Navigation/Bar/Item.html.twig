{% props
    item,
    hasChildren = false,
    cva = {},
%}

{% set category = item.category %}
{% set name = category.translated.name %}
{% set isFolder = category.type == 'folder' %}
{% set flyoutId = 'vi-navigation-flyout-' ~ category.id %}
{% set cx = vi_cva_from_file(cva) %}
{% set classes = {
    root: cx.root.apply(),
    link: cx.link.apply(),
    label: cx.label.apply(),
    caret: cx.caret.apply(),
} %}
{% set attrs = {
    link: attributes.nested('link'),
} %}

{# UX ComponentAttributes: null becomes true — use false to omit #}
{% set triggerDefaults = {
    title: name,
}|merge(hasChildren ? {
    'data-flyout-trigger': '',
    'data-navigation-id': category.id,
    'data-flyout-url': path('frontend.views-theme.navigation.flyout', { navigationId: category.id }),
    'aria-haspopup': 'true',
    'aria-expanded': 'false',
    'aria-controls': flyoutId,
} : {}) %}

<li
    {{ attributes.defaults({
        'data-navigation-id': category.id,
    }) }}
    class="{{ classes.root }}"
>
    {% if isFolder %}
        <button
            type="button"
            {{ attrs.link.defaults(triggerDefaults) }}
            class="{{ classes.link }}"
        >
            <span class="{{ classes.label }}">{{ name }}</span>
            {% if hasChildren %}
                {{ vi_icon('caret-down', { class: classes.caret }) }}
            {% endif %}
        </button>
    {% else %}
        <a
            {{ attrs.link.defaults(triggerDefaults|merge({
                href: category_url(category),
            })|merge(category_linknewtab(category) ? { target: '_blank' } : {})) }}
            class="{{ classes.link }}"
        >
            <span class="{{ classes.label }}">{{ name }}</span>
            {% if hasChildren %}
                {{ vi_icon('caret-down', { class: classes.caret }) }}
            {% endif %}
        </a>
    {% endif %}
</li>
