{% props
    item,
    hasChildren = false,
    cva = {},
%}

{% set category = item.category %}
{% set name = category.translated.name %}
{% set isFolder = category.type == 'folder' %}
{% set flyoutId = 'vi-navigation-flyout-' ~ category.id %}
{% do vi_define_cva(cva, ['root', 'link', 'label', 'caret']) %}
{% do vi_define_attrs(['link']) %}

{# UX ComponentAttributes: null becomes true — use false to omit #}
{% set triggerDefaults = {
    title: name,
}|merge(hasChildren ? {
    'data-flyout-trigger': '',
    'data-navigation-id': category.id,
    'data-flyout-url': path('frontend.views-theme.navigation.flyout', { navigationId: category.id }),
    'aria-haspopup': 'true',
    'aria-expanded': 'false',
    'aria-controls': flyoutId,
} : {}) %}

<li
    {{ attributes.defaults({
        'data-navigation-id': category.id,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% if isFolder %}
        <button
            type="button"
            {{ vi_attrs('link').defaults(triggerDefaults) }}
            class="{{ vi_class('link') }}"
        >
            <span class="{{ vi_class('label') }}">{{ name }}</span>
            {% if hasChildren %}
                {{ vi_icon('caret-down', { class: vi_class('caret') }) }}
            {% endif %}
        </button>
    {% else %}
        <a
            {{ vi_attrs('link').defaults(triggerDefaults|merge({
                href: category_url(category),
            })|merge(category_linknewtab(category) ? { target: '_blank' } : {})) }}
            class="{{ vi_class('link') }}"
        >
            <span class="{{ vi_class('label') }}">{{ name }}</span>
            {% if hasChildren %}
                {{ vi_icon('caret-down', { class: vi_class('caret') }) }}
            {% endif %}
        </a>
    {% endif %}
</li>
