{% props
    navigation,
    category = null,
    maxDepth = 3,
    cva = {},
%}

{% set rootCategory = category ?? navigation.active %}
{% set name = rootCategory ? rootCategory.translated.name : '' %}
{% set flyoutId = rootCategory ? 'vi-navigation-flyout-' ~ rootCategory.id : 'vi-navigation-flyout' %}
{% set cx = vi_cva_from_file(cva) %}
{% set gridClass = cx.grid.apply() %}

{% set rootCustomFields = rootCategory ? (rootCategory.translated.customFields|default({})) : {} %}
{% set teaserImageId = rootCustomFields.vi_navigation_image ?? null %}
{% set teaserImages = teaserImageId
    ? searchMedia([teaserImageId], context.context)
    : null %}
{% set teaserImage = teaserImageId and teaserImages ? teaserImages.get(teaserImageId) : null %}

<div
    {{ attributes.defaults({
        id: flyoutId,
        'data-component': 'ViewsTheme:Navigation:Flyout',
        'data-open': 'false',
        'data-navigation-id': rootCategory ? rootCategory.id : null,
        role: 'region',
        'aria-label': name,
    }) }}
    class="{{ cx.root.apply() }}"
>
    <twig:ViewsTheme:Navigation:Flyout:Grid
        class="{{ gridClass }}"
        :navigation="navigation"
        :category="rootCategory"
        :teaserImage="teaserImage"
        :maxDepth="maxDepth"
        {{ ...attributes.nested('grid').all() }}
    />
</div>
