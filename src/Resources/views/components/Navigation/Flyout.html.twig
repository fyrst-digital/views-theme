{% props
    navigation,
    category = navigation.active,
    maxDepth = 3,
    widthAnchor = '--vi-navigation-bar',
    cva = {},
%}

{% set name = category ? category.translated.name : '' %}
{% set flyoutId = category ? 'vi-navigation-flyout-' ~ category.id : 'vi-navigation-flyout' %}
{% set teaserImage = category and category.media ? category.media : null %}
{% set hasTeaser = teaserImage is not null %}
{% do vi_define_cva(cva, ['root', 'columns', 'teaser']) %}
{% do vi_define_attrs(['columns', 'teaser']) %}

<div
    {{ attributes.defaults({
        id: flyoutId,
        popover: 'manual',
        'data-component': 'ViewsTheme:Navigation:Flyout',
        'data-navigation-id': category ? category.id : null,
        'data-has-teaser': hasTeaser ? 'true' : 'false',
        role: 'region',
        'aria-label': name,
        style: '--vi-flyout-width-anchor: ' ~ widthAnchor,
    }) }}
    class="{{ vi_class('root', { teaser: hasTeaser }) }}"
>
    {% block content %}

        {% block columns %}
            <div
                {{ vi_attrs('columns') }}
                class="{{ vi_class('columns') }}"
            >
                {% for treeItem in navigation.tree %}
                    {% set cat = treeItem.category %}
                    {% set hasChildren = treeItem.children|length > 0 %}
                    {% set itemSkipped = cat.type == 'folder' and not hasChildren %}

                    {% if not itemSkipped %}
                        <twig:ViewsTheme:Navigation:Flyout:Column
                            :item="treeItem"
                            :level="0"
                            :maxDepth="maxDepth"
                        />
                    {% endif %}
                {% endfor %}
            </div>
        {% endblock %}

        {% block teaser %}
            {% if hasTeaser and category %}
                <twig:ViewsTheme:Navigation:Flyout:Teaser
                    class="{{ vi_class('teaser') }}"
                    {{ ...vi_attrs('teaser').defaults({
                        category: category,
                        image: teaserImage,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}
    {% endblock %}
</div>
