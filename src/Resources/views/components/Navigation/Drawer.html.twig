{% props
    navigation,
    languages = null,
    currencies = null,
    menuUrl = path('frontend.views-theme.navigation.drawer.menu'),
    label = 'general.menuLink'|trans|striptags,
    wishlist = config('core.cart.wishlistEnabled'),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['panel']) %}

<twig:ViewsTheme:Drawer
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        id: 'vi-navigation-drawer',
        side: 'start',
        label: label,
    }).all() }}
>
    <twig:block name="panel">
        <twig:ViewsTheme:Drawer:Panel
            {{ ...vi_attrs('panel').defaults({
                side: 'start',
            }).all() }}
        >
            <twig:block name="header">
                <twig:ViewsTheme:Drawer:Header>
                    <twig:block name="title">
                        <div class="{{ vi_class('title') }}">
                            {% if wishlist %}
                                <twig:ViewsTheme:Wishlist:Action
                                    class="position-relative"
                                    label:class="fs-6"
                                    badgeId="vi-navigation-drawer-wishlist-basket"
                                    liveId="vi-navigation-drawer-wishlist-live"
                                    aria-labelledby="vi-navigation-drawer-wishlist-live"
                                />
                            {% endif %}

                            <twig:ViewsTheme:Account:Action
                                class="mt-2 p-0 vi-account__dropdown"
                                placement="bottom-center"
                                toggle:label:class="fs-6"
                            />
                        </div>
                    </twig:block>
                </twig:ViewsTheme:Drawer:Header>
            </twig:block>
            <twig:ViewsTheme:Navigation:Drawer:Menu
                :navigation="navigation"
                :menuUrl="menuUrl"
            />
            <twig:block name="footer">
                {% set languageCount = languages and languages.count is defined ? languages.count : (languages|default([])|length) %}
                {% set currencyCount = currencies and currencies.count is defined ? currencies.count : (currencies|default([])|length) %}
                {% if languageCount > 1 or currencyCount > 1 %}
                    <div class="{{ vi_class('footer') }}">
                        <twig:ViewsTheme:Language:Action
                            :languages="languages"
                            placement="top-start"
                        />
                        <twig:ViewsTheme:Currency:Action
                            :currencies="currencies"
                            placement="top-start"
                        />
                    </div>
                {% endif %}
            </twig:block>
        </twig:ViewsTheme:Drawer:Panel>
    </twig:block>
</twig:ViewsTheme:Drawer>
