{% sw_extends '@Storefront/components/footer/column.html.twig' %}

{%
  set classes = vi_define_classes({
    headlineLink: ['footer-headline-link'],
    list: ['footer-link-list'],
    item: ['footer-link-item'],
    link: ['footer-link'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_footer_column_headline_title %}
  {% if navigation.category.type == 'folder' %}
    {{ navigation.category.translated.name }}
  {% else %}
    <a
      href="{{ category_url(navigation.category) }}"
      {% if category_linknewtab(navigation.category) %}
        target="_blank"
      {% endif %}
      {{ classes.headlineLink | vi_attr_classes }}
      title="{{ navigation.category.translated.name }}">
      {{ navigation.category.translated.name }}
    </a>
  {% endif %}
{% endblock %}

{% block component_footer_column_content %}
  <ul {{ classes.list | vi_attr_classes }}>
    {% for treeItem in navigation.children %}
      {% set category = treeItem.category %}
      {% set name = category.translated.name %}

      <li {{ classes.item | vi_attr_classes }}>
        {% if category.type == 'folder' %}
          <div>{{ name }}</div>
        {% else %}
          <a
            {{ classes.link | vi_attr_classes }}
            href="{{ category_url(category) }}"
            {% if category_linknewtab(category) %}
              target="_blank"
            {% endif %}
            title="{{ name }}">
            {{ name }}
          </a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endblock %}
