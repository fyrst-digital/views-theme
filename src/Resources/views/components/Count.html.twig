{% props
    count = 0,
    changedEvent,
    countKey = null,
    liveId = null,
    liveText = '%counter%',
    cva = {},
%}

{% do vi_define_cva(cva) %}

<span
    {{ attributes.defaults({
        hidden: count < 1,
        'data-component': 'ViewsTheme:Count',
        'data-component-options': {
            changedEvent: changedEvent,
            countKey: countKey,
            liveId: liveId,
            liveText: liveText,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>{% if count > 0 %}{{ count }}{% endif %}</span>
