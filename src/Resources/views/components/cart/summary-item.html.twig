{%
  set classes = vi_define_classes({
    item: ['cart-summary-item'],
    label: ['cart-summary-item-label'],
    value: ['cart-summary-item-value'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_cart_summary_item %}
    <dl {{ classes.item | vi_attr_classes }}>
        {% block component_cart_summary_label %}
            <dt {{ classes.label | vi_attr_classes }}>
                {{ label|raw }}
            </dt>
        {% endblock %}
        {% block component_cart_summary_value %}
            <dd {{ classes.value | vi_attr_classes }}>
                {{ value }}
            </dd>
        {% endblock %}
    </dl>
{% endblock %}
