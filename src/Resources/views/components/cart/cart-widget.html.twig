{% extends '@Storefront/storefront/layout/header/actions/cart-widget.html.twig' %}

{%
  set classes = vi_define_classes({
    badge: ['header-action-badge', 'position-absolute', 'top-0', 'start-100', 'translate-middle', 'badge', 'rounded-pill'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block layout_header_actions_cart_widget %}

    {% block component_cart_widget_icon %}
        {{vi_icon('shopping-cart-simple')}}
    {% endblock %}

    {% block component_cart_widget_badge %}
        {% if page.cart.lineItems|length > 0 %}
            <span {{ classes.badge | vi_attr_classes }}>
                {{ page.cart.lineItems|length }}
            </span>
        {% endif %}
    {% endblock %}
{% endblock %}
