{% set iconOptions = iconOptions|default(themeParameters.icons) %}

{%
  set classes = vi_define_classes({
    form: [
    ],
    label: [
      'visually-hidden',
    ],
    inputGroup: [
      'input-group',
    ],
    input: [
      'form-control',
    ],
    submit: [
      'btn',
      'btn-secondary',
    ],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_promotion_form %}
  <form
    action="{{ path('frontend.checkout.promotion.add') }}"
    {{ classes.form | vi_attr_classes }}
    data-component="promotion-form"
    method="post">
    {% block component_promotion_redirect %}
      <input
        type="hidden"
        name="redirectTo"
        value="frontend.cart.offcanvas">
    {% endblock %}

    {% block component_promotion_input_group %}
      {% block component_promotion_label %}
        <label
          {{ classes.label | vi_attr_classes }}
          for="addPromotionOffcanvasCartInput">
          {{ 'checkout.addPromotionLabel' | trans | sw_sanitize }}
        </label>
      {% endblock %}

      <div {{ classes.inputGroup | vi_attr_classes }}>
        {% block component_promotion_input %}
          <input
            type="text"
            name="code"
            {{ classes.input | vi_attr_classes }}
            id="addPromotionOffcanvasCartInput"
            placeholder="{{ 'checkout.addPromotionPlaceholder'|trans|striptags }}"
            aria-label="{{ 'checkout.addPromotionLabel'|trans|striptags }}"
            aria-describedby="addPromotionOffcanvasCart"
            required="required">
        {% endblock %}

        {% block component_promotion_submit %}
          <button
            {{ classes.submit | vi_attr_classes }}
            type="submit"
            id="addPromotionOffcanvasCart">
            {{ vi_icon('ticket', iconOptions) }}
          </button>
        {% endblock %}
      </div>
    {% endblock %}
  </form>
{% endblock %}
