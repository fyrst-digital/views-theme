{% set iconOptions = iconOptions|default(themeParameters.icons) %}

{%
  set classes = vi_define_classes({
    form: [
      'shipping-calculation-form',
    ],
    trigger: [
      'btn',
      'btn-light',
      'cart-shipping-costs-btn',
      'shipping-calculation-toogle-btn',
    ],
    collapse: [
      'collapse',
    ],
    selects: [
      'shipping-calculation-selects',
    ],
    formGroup: [
      'form-group',
    ],
    label: [
      'form-label',
    ],
    select: [
      'form-select',
    ],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_shipping_calculation %}
  <form
    name="precalc"
    method="post"
    action="{{ path('frontend.checkout.configure') }}"
    {{ classes.form | vi_attr_classes }}
    data-form-auto-submit="true">
    {% block component_shipping_calculation_trigger %}
      {% set PHYSICAL_STATE = constant('Shopware\\Core\\Content\\Product\\State::IS_PHYSICAL') %}
      {% if page.cart.lineItems.hasLineItemWithState(PHYSICAL_STATE) %}
        <a
          {{ classes.trigger | vi_attr_classes }}
          data-bs-toggle="collapse"
          href="#collapseShippingCost"
          role="button"
          aria-expanded="false"
          aria-controls="collapseExample">
          {{ 'checkout.shippingCosts' | trans | sw_sanitize }}

          {% block component_shipping_calculation_trigger_icon %}
            {{ vi_icon('caret-down', iconOptions) }}
          {% endblock %}
        </a>
      {% endif %}
    {% endblock %}

    {% block component_shipping_calculation_form_group %}
      <div {{ classes.collapse | vi_attr_classes }} id="collapseShippingCost">
        <div {{ classes.selects | vi_attr_classes }}>
          {% block component_shipping_calculation_country %}
            {% if not context.customer %}
              <div {{ classes.formGroup | vi_attr_classes }}>
                <label {{ classes.label | vi_attr_classes }} for="countryId">
                  {{- 'checkout.shippingCountry' | trans | sw_sanitize -}}
                </label>
                <select
                  {{ classes.select | vi_attr_classes }}
                  type="text"
                  id="countryId"
                  name="countryId">
                  {% for country in page.countries %}
                    <option
                      value="{{ country.id }}"
                      {{ country.id == context.shippingLocation.country.id ? 'selected="selected"' : '' }}>
                      {{ country.translated.name }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endif %}
          {% endblock %}

          {% block component_shipping_calculation_payment_method %}
            <div {{ classes.formGroup | vi_attr_classes }}>
              <label
                {{ classes.label | vi_attr_classes }}
                for="paymentMethodId">
                {{- 'checkout.paymentMethod' | trans | sw_sanitize -}}
              </label>
              <select
                {{ classes.select | vi_attr_classes }}
                type="text"
                id="paymentMethodId"
                name="paymentMethodId">
                {% if context.paymentMethod.id not in page.paymentMethods.ids %}
                  <option
                    value="{{ context.paymentMethod.id }}"
                    selected="selected"
                    disabled="disabled">
                    {{ context.paymentMethod.translated.name }}
                    {{ 'checkout.notAvailableSuffix' | trans | sw_sanitize }}
                  </option>
                {% endif %}
                {% for payment in page.paymentMethods %}
                  <option
                    value="{{ payment.id }}"
                    {% if payment.id == context.paymentMethod.id %}
                      selected="selected"
                    {% endif %}>
                    {{ payment.translated.name }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endblock %}

          {% block component_shipping_calculation_shipping_method %}
            <div {{ classes.formGroup | vi_attr_classes }}>
              <label
                {{ classes.label | vi_attr_classes }}
                for="shippingMethodId">
                {{- 'checkout.shippingMethod' | trans | sw_sanitize -}}
              </label>
              <select
                {{ classes.select | vi_attr_classes }}
                type="text"
                id="shippingMethodId"
                name="shippingMethodId">
                {% if context.shippingMethod.id not in page.shippingMethods.ids %}
                  <option
                    value="{{ context.shippingMethod.id }}"
                    selected="selected"
                    disabled="disabled">
                    {{ context.shippingMethod.translated.name }}
                    {{ 'checkout.notAvailableSuffix' | trans | sw_sanitize }}
                  </option>
                {% endif %}
                {% for shipping in page.shippingMethods %}
                  <option
                    value="{{ shipping.id }}"
                    {% if shipping.id == context.shippingMethod.id %}
                      selected="selected"
                    {% endif %}>
                    {{ shipping.translated.name }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endblock %}

          <input
            type="hidden"
            name="redirectTo"
            value="frontend.checkout.cart.page">
        </div>
      </div>
    {% endblock %}
  </form>
{% endblock %}
