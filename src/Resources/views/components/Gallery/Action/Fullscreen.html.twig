{% props
    ids = [],
    overlayUrl = path('frontend.views-theme.gallery.fullscreen'),
    cva = {},
%}

{% do vi_define_cva(cva) %}

<twig:ViewsTheme:Control
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        label: 'viewsTheme.gallery.fullscreenOpen'|trans|striptags,
        'aria-haspopup': 'dialog',
        'aria-controls': 'vi-gallery-fullscreen',
        'aria-expanded': 'false',
        'data-component': 'ViewsTheme:Gallery:Action:Fullscreen',
        'data-component-options': {
            overlayUrl: overlayUrl,
            ids: ids,
        }|json_encode,
    }).all() }}
>
    <twig:block name="content">
        {% vi_block icon %}
            {{ vi_icon('arrows-out') }}
        {% endvi_block %}
    </twig:block>
</twig:ViewsTheme:Control>
