{% do vi_define_cva(cva, ['root', 'tiered', 'price', 'tax']) %}
{% do vi_define_attrs(['tiered', 'price', 'tax']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block tiered %}
        {% if showTieredBlock %}
            <twig:ViewsTheme:Product:Price:Tiered
                class="{{ vi_class('tiered') }}"
                {{ ...vi_attrs('tiered').defaults({
                    product: product,
                    prices: product.calculatedPrices,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block price %}
        <twig:ViewsTheme:Product:Price
            class="{{ vi_class('price') }}"
            {{ ...vi_attrs('price').defaults({
                product: product,
                showPrice: showPrice,
            }).all() }}
        />
    {% endblock %}

    {% block tax %}
        {% if showTaxNote %}
            <twig:ViewsTheme:Product:Price:Tax
                class="{{ vi_class('tax') }}"
                {{ ...vi_attrs('tax').all() }}
            />
        {% endif %}
    {% endblock %}
</div>
