{% props
    productId,
    showText = false,
    size = 'md',
    color = 'light',
    appearance = null,
    icon = 'heart',
    iconActive = 'heart-fill',
    cva = {},
%}

{% if productId is not empty %}
    {% set addLabel = 'listing.addToWishlist'|trans|sw_sanitize %}
    {% set removeLabel = 'listing.removeFromWishlist'|trans|sw_sanitize %}
    {% set buttonLabel = showText is same as(true) ? addLabel : null %}

    {% set cx = vi_cva_from_file(cva) %}

    <twig:ViewsTheme:Button
        class="{{ cx.root.apply({ appearance: appearance }) }}"
        {{ ...attributes.defaults({
            type: 'button',
            icon: icon,
            label: buttonLabel,
            color: color,
            size: size,
            title: addLabel,
            'aria-pressed': 'false',
            'aria-label': addLabel,
            'data-component': 'ViewsTheme:Product:Action:Wishlist',
            'data-component-options': {
                productId: productId,
                showText: showText is same as(true),
                texts: {
                    add: addLabel,
                    remove: removeLabel,
                },
                icons: {
                    add: icon,
                    remove: iconActive,
                },
                toggleEvent: 'ViewsTheme:Wishlist:Toggle',
                changedEvent: 'ViewsTheme:Wishlist:Changed',
            }|json_encode,
        }).all() }}
    />
{% endif %}
