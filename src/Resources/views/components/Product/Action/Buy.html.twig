{% do vi_define_cva({
    root: { base: 'vi-product-action-buy d-flex flex-row flex-wrap gap-2' },
    button: { base: 'vi-product-action-buy__button col' },
    quantityInput: { base: 'col-auto' },
}|replace_recursive(cva)) %}
{% do vi_define_attrs(['button', 'quantityInput']) %}

<form
    {{ attributes.defaults({
        action: path('frontend.checkout.line-item.add'),
        method: 'post',
        id: formId,
        'data-component': 'ViewsTheme:Product:Action:Buy',
        'data-component-options': {
            addEvent: 'ViewsTheme:Cart:Add',
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block parameter %}
        <twig:ViewsTheme:Product:Action:BuyParameter
            :product="product"
            :showQuantity="showQuantityField"
        />
    {% endblock %}

    {% block quantity %}
        {% if showQuantityField %}
            <twig:ViewsTheme:QuantityInput
                class="{{ vi_class('quantityInput') }}"
                {{ ...vi_attrs('quantityInput').defaults({
                    inputName: 'lineItems[' ~ product.id ~ '][quantity]',
                    quantity: product.minPurchase,
                    minQuantity: product.minPurchase,
                    maxQuantity: product.calculatedMaxPurchase,
                    purchaseSteps: product.purchaseSteps,
                    unit: productUnit,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block button %}
        <twig:ViewsTheme:Button
            class="{{ vi_class('button') }}"
            {{ ...vi_attrs('button').defaults({
                type: 'submit',
                icon: 'handbag',
                label: 'listing.boxAddProduct'|trans|sw_sanitize,
                color: 'primary',
                size: 'md',
                title: 'listing.boxAddProduct'|trans|sw_sanitize,
            }).all() }}
        />
    {% endblock %}
</form>
