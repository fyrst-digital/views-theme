{% props
    product,
    formAction = path('frontend.checkout.line-item.add'),
    formId = null,
    showQuantity = true,
    buyLabel = 'listing.boxAddProduct'|trans|sw_sanitize,
    buyIcon = 'handbag',
    buyColor = 'primary',
    buySize = 'md',
    cva = {},
%}

{% set resolvedFormId = formId is not null ? formId : 'ProductBuyForm' ~ product.id %}
{% set DIGITAL_CONST = constant('Shopware\\Core\\Content\\Product\\ProductDefinition::TYPE_DIGITAL') %}
{% set allowsQuantity = not product.type is defined
    or product.type != DIGITAL_CONST
    or (product.type == DIGITAL_CONST and product.maxPurchase !== 1) %}
{% set showQuantityField = allowsQuantity and showQuantity is same as(true) %}

{% set productUnit = false %}
{% if product.translated.packUnit %}
    {% if product.minPurchase > 1 and product.translated.packUnitPlural %}
        {% set productUnit = product.translated.packUnitPlural %}
    {% elseif product.translated.packUnit %}
        {% set productUnit = product.translated.packUnit %}
    {% endif %}
{% endif %}

{% set cx = vi_cva({
    root: { base: 'vi-product-action-buy' },
    button: { base: 'vi-product-action-buy__button' },
}|replace_recursive(cva)) %}

<form
    {{ attributes.defaults({
        action: formAction,
        method: 'post',
        id: resolvedFormId,
        'data-component': 'ViewsTheme:Product:Action:Buy',
        'data-component-options': {
            addEvent: 'ViewsTheme:Cart:Add',
        }|json_encode,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block parameter %}
        <twig:ViewsTheme:Product:Action:BuyParameter
            :product="product"
            :showQuantity="showQuantityField"
        />
    {% endblock %}

    {% block quantity %}
        {% if showQuantityField %}
            <twig:ViewsTheme:QuantityInput
                inputName="lineItems[{{ product.id }}][quantity]"
                :quantity="product.minPurchase"
                :minQuantity="product.minPurchase"
                :maxQuantity="product.calculatedMaxPurchase"
                :purchaseSteps="product.purchaseSteps"
                :unit="productUnit"
            />
        {% endif %}
    {% endblock %}

    {% block button %}
        <twig:ViewsTheme:Button
            class="{{ cx.button.apply() }}"
            {{ ...attributes.nested('button').defaults({
                type: 'submit',
                icon: buyIcon,
                label: buyLabel,
                color: buyColor,
                size: buySize,
                title: buyLabel,
            }).all() }}
        />
    {% endblock %}
</form>
