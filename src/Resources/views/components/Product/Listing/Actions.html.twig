{% props
    searchResult = null,
    paginationSearchQuery = '',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['pagination', 'sorting']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block pagination %}
        <twig:ViewsTheme:Pagination
            class="{{ vi_class('pagination') }}"
            {{ ...vi_attrs('pagination').defaults({
                entities: searchResult,
                location: 'top',
                searchQuery: paginationSearchQuery,
            }).all() }}
        />
    {% endblock %}

    {% block sorting %}
        <twig:ViewsTheme:Sorting
            class="{{ vi_class('sorting') }}"
            {{ ...vi_attrs('sorting').defaults({
                current: searchResult.sorting,
                sortings: searchResult.availableSortings,
            }).all() }}
        />
    {% endblock %}
</div>
