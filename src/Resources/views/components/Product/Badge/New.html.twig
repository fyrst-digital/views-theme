{% props
    label = 'listing.boxLabelNew'|trans|sw_sanitize,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% block content %}
    <twig:ViewsTheme:Badge
        class="{{ cx.root.apply() }}"
        {{ ...attributes.defaults({
            type: 'new',
            label: label,
        }).all() }}
    />
{% endblock %}
