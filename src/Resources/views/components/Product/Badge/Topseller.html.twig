{% props
    label = 'listing.boxLabelTopseller'|trans|sw_sanitize,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% block content %}
    <twig:ViewsTheme:Badge
        class="{{ vi_class('root') }}"
        {{ ...attributes.defaults({
            type: 'topseller',
            label: label,
        }).all() }}
    />
{% endblock %}
