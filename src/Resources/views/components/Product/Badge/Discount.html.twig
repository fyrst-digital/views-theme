{% props
    percentage = null,
    label = percentage is not null ? (percentage|number_format(0) ~ ' %') : null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% block content %}
    <twig:ViewsTheme:Badge
        class="{{ vi_class('root') }}"
        {{ ...attributes.defaults({
            type: 'discount',
            label: label,
        }).all() }}
    />
{% endblock %}
