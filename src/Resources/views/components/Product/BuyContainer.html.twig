{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget.html.twig' %}

{#
  Buy widget composition under components/. Extends core buy-widget.
  Not a pure UX tag component — include path only.
#}

{% props
    cva = {},
%}

{% set options = {
    productHeader: {},
    prices: {
        showPrice: false,
        showTaxNote: true,
    },
    showBuyForm: true,
    showActions: true,
}|merge(options|default({})) %}

{% set variantsGrid = page.extensions.viewsTheme.variantsGrid|default(null) %}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    reviews: attributes.nested('reviews'),
    reviewLabel: attributes.nested('reviewLabel'),
    reviewLink: attributes.nested('reviewLink'),
    prices: attributes.nested('prices'),
    actions: attributes.nested('actions'),
} %}

{% block buy_widget_data %}
    {% block buy_widget_data_rich_snippet_url %}
        {{ parent() }}
    {% endblock %}

    {% block buy_widget_data_rich_snippet_price_range %}
        {{ parent() }}
    {% endblock %}

    {% block buy_widget_data_rich_snippet_price_currency %}
        {{ parent() }}
    {% endblock %}

    {% block buy_widget_header %}
        <twig:ViewsTheme:Product:Header :product="product" />
    {% endblock %}

    {% block buy_widget_reviews %}
        {% if product.ratingAverage > 0 and totalReviews > 0 and config('core.listing.showReview') %}
            {% if remoteClickOptions is not defined %}
                {% set remoteClickOptions = {
                    selector: '#review-tab-' ~ product.id,
                    scrollToElement: true,
                    excludedViewports: ['XS'],
                } %}
            {% endif %}

            {% if reviewTabHref is not defined %}
                {% set reviewTabHref = '#review-tab-' ~ product.id ~ '-pane' %}
            {% endif %}

            <div {{ attrs.reviews }} class="{{ cx.reviews.apply() }}">
                <twig:ViewsTheme:Review:Rating :points="product.ratingAverage" />
                <div {{ attrs.reviewLabel }} class="{{ cx.reviewLabel.apply() }}">
                    {{ 'detail.reviewLabelText'|trans({'%average%': product.ratingAverage})|sw_sanitize }}
                    <a
                        {{ attrs.reviewLink.defaults({
                            'data-bs-toggle': 'tab',
                            'data-off-canvas-tabs': 'true',
                            'data-remote-click': 'true',
                            'data-remote-click-options': remoteClickOptions|json_encode,
                            href: reviewTabHref,
                            'aria-controls': 'review-tab-pane',
                        }) }}
                        class="{{ cx.reviewLink.apply() }}"
                    >
                        {{ totalReviews }}
                        {{ 'detail.reviewLinkText'|trans({'%count%': totalReviews})|sw_sanitize }}
                    </a>
                </div>
            </div>
        {% endif %}
    {% endblock %}

    {% block component_product_buy_container_prices %}
        <div {{ attrs.prices }} class="{{ cx.prices.apply() }}">
            {% block buy_widget_price %}
                {% if options.prices.showTieredPrices|default(true) and product.calculatedPrices.count > 1 %}
                    <twig:ViewsTheme:Product:Price:Tiered
                        :product="product"
                        :prices="product.calculatedPrices"
                    />
                {% endif %}
                <twig:ViewsTheme:Product:Price
                    :product="product"
                    :showPrice="options.prices.showPrice|default(false)"
                />
                {% if options.prices.showTaxNote|default(true) %}
                    <twig:ViewsTheme:Product:Price:Tax />
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}

    {% block buy_widget_delivery_informations %}
        {{ parent() }}
    {% endblock %}
{% endblock %}

{% block buy_widget_configurator_include %}
    {% if not (config('ViewsTheme.config.variantsGridActive') and variantsGrid and variantsGrid.variants.count > 0) %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block buy_widget_buy_form %}
    {% block component_product_buy_container_variants_grid %}
        {% if config('ViewsTheme.config.variantsGridActive') and variantsGrid and variantsGrid.variants.count > 0 %}
            <twig:ViewsTheme:VariantsGrid:Container
                :variants="variantsGrid.variants"
                :groups="variantsGrid.groups"
                :pagination="variantsGrid.pagination"
                :pageParameter="variantsGrid.pageParameter"
                :parentId="variantsGrid.parentId"
            />
        {% endif %}
    {% endblock %}

    {% block component_product_buy_container_buy_form %}
        {% if product.active
            and options.showBuyForm is same as(true)
            and not (config('ViewsTheme.config.variantsGridActive') and variantsGrid and variantsGrid.variants.count > 0)
        %}
            <twig:ViewsTheme:Product:Action:Buy :product="product" />
        {% endif %}
    {% endblock %}

    {% block component_product_buy_container_actions %}
        {% set productActions = {
            wishlist: config('core.cart.wishlistEnabled'),
        } %}

        {% block component_product_buy_container_actions_container %}
            {% if options.showActions is same as(true) %}
                <div {{ attrs.actions }} class="{{ cx.actions.apply() }}">
                    {% block component_product_buy_container_action_prepend %}{% endblock %}

                    {% block component_product_buy_container_wishlist %}
                        {% if productActions.wishlist %}
                            <twig:ViewsTheme:Product:Action:Wishlist
                                :productId="product.id"
                                :showText="true"
                                size="sm"
                            />
                        {% endif %}
                    {% endblock %}

                    {% block component_product_buy_container_action_append %}{% endblock %}
                </div>
            {% endif %}
        {% endblock %}
    {% endblock %}
{% endblock %}

{% block buy_widget_wishlist %}{% endblock %}
