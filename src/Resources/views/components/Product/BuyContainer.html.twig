{% do vi_define_cva(cva, [
    'root',
    'header',
    'reviews',
    'prices',
    'delivery',
    'configurator',
    'buy',
    'actions',
    'orderNumber',
    'orderNumberLabel',
    'orderNumberValue',
]) %}
{% do vi_define_attrs([
    'header',
    'reviews',
    'prices',
    'delivery',
    'configurator',
    'buy',
    'actions',
    'orderNumber',
    'orderNumberLabel',
    'orderNumberValue',
]) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }} {{ rootElementClass }}"
>
    {% block header %}
        {% if showHeader %}
            <twig:ViewsTheme:Product:Header
                class="{{ vi_class('header') }}"
                {{ ...vi_attrs('header').defaults({
                    product: product,
                    nameShowLink: false,
                    nameTag: 'h1',
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block reviews %}
        <twig:ViewsTheme:Product:Reviews
            class="{{ vi_class('reviews') }}"
            {{ ...vi_attrs('reviews').defaults({
                product: product,
                totalReviews: totalReviews,
                showReviews: showReviews,
            }).all() }}
        />
    {% endblock %}

    {% block prices %}
        <twig:ViewsTheme:Product:Prices
            class="{{ vi_class('prices') }}"
            {{ ...vi_attrs('prices').defaults({
                product: product,
                showPrice: showPrice,
                showTieredPrices: showTieredPrices,
                showTaxNote: showTaxNote,
            }).all() }}
        />
    {% endblock %}

    {% block delivery %}
        {% if showDelivery %}
            <div {{ vi_attrs('delivery') }} class="{{ vi_class('delivery') }}">
                {% sw_include '@Storefront/storefront/component/delivery-information.html.twig' %}
            </div>
        {% endif %}
    {% endblock %}

    {% block configurator %}
        {% if showConfiguratorBlock %}
            <div {{ vi_attrs('configurator') }} class="{{ vi_class('configurator') }}">
                {% sw_include '@Storefront/storefront/component/buy-widget/configurator.html.twig' %}
            </div>
        {% endif %}
    {% endblock %}

    {% block buy %}
        {% if useVariantsGrid %}
            <twig:ViewsTheme:VariantsGrid:Container
                :variants="variantsGrid.variants"
                :groups="variantsGrid.groups"
                :pagination="variantsGrid.pagination"
                :pageParameter="variantsGrid.pageParameter"
                :parentId="variantsGrid.parentId"
            />
        {% elseif showBuyFormBlock %}
            <twig:ViewsTheme:Product:Action:Buy
                class="{{ vi_class('buy') }}"
                {{ ...vi_attrs('buy').defaults({
                    product: product,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block actions %}
        {% if showActions %}
            <twig:ViewsTheme:Product:Actions
                class="{{ vi_class('actions') }}"
                {{ ...vi_attrs('actions').defaults({
                    product: product,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block orderNumber %}
        {% if showOrderNumberBlock %}
            <div {{ vi_attrs('orderNumber') }} class="{{ vi_class('orderNumber') }}">
                <span {{ vi_attrs('orderNumberLabel') }} class="{{ vi_class('orderNumberLabel') }}">
                    {{ 'detail.productNumberLabel'|trans|sw_sanitize }}
                </span>
                <span {{ vi_attrs('orderNumberValue') }} class="{{ vi_class('orderNumberValue') }}">
                    {{ product.productNumber }}
                </span>
            </div>
        {% endif %}
    {% endblock %}
</div>
