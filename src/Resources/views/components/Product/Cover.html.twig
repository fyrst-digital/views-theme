{% props
    id = null,
    name = null,
    cover = null,
    displayMode = 'standard',
    sizes = {},
    showLink = true,
    url = null,
    tag = 'div',
    cva = {},
%}

{% set coverUrl = url is not null
    ? url
    : (id is not null ? seoUrl('frontend.detail.page', { productId: id }) : null) %}
{% set linked = showLink is same as(true) and coverUrl is not null %}
{% set rootTag = linked ? 'a' : tag %}

{% set cx = vi_cva({
    root: { base: 'vi-product-cover is-' ~ displayMode },
    image: { base: 'vi-product-cover__image rounded-3 w-100 d-block' },
    video: { base: 'vi-product-cover__video' },
    placeholder: { base: 'vi-product-cover__placeholder' },
}|replace_recursive(cva)) %}

<{{ rootTag|raw }}
    {{ attributes.defaults({
        href: linked ? coverUrl : null,
        title: linked ? name : null,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block media %}
        {% if cover and cover.url and cover.isSpatialObject() == false %}
            {% set mediaAttrs = {
                title: (cover.translated.title ?: name),
            } %}

            {% if cover.getMediaType().getName() === 'VIDEO' %}
                {% if config('core.listing.autoplayVideoInListing') %}
                    {% set mediaAttrs = mediaAttrs|merge({
                        autoplay: true,
                        loop: true,
                        class: cx.video.apply(),
                    }) %}
                {% endif %}

                {% block video %}
                    {% sw_include '@Storefront/storefront/utilities/video.html.twig' with {
                        media: cover,
                        attributes: mediaAttrs,
                    } %}
                {% endblock %}
            {% else %}
                {% set mediaAttrs = mediaAttrs|merge({
                    alt: (cover.translated.alt ?: name),
                    loading: 'lazy',
                    class: cx.image.apply(),
                }) %}

                {% if displayMode == 'cover' or displayMode == 'contain' %}
                    {% set mediaAttrs = mediaAttrs|merge({ 'data-object-fit': displayMode }) %}
                {% endif %}

                {% block image %}
                    {% sw_thumbnails 'product-image-thumbnails' with {
                        media: cover,
                        sizes: sizes,
                        attributes: mediaAttrs,
                    } %}
                {% endblock %}
            {% endif %}
        {% else %}
            {% block placeholder %}
                <div
                    {{ attributes.nested('placeholder') }}
                    class="{{ cx.placeholder.apply() }}"
                    aria-hidden="true"
                >
                    {{ vi_icon('placeholder') }}
                </div>
            {% endblock %}
        {% endif %}
    {% endblock %}
</{{ rootTag|raw }}>
