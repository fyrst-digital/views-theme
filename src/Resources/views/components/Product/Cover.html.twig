{% set cx = vi_cva_from_file(cva) %}

<{{ rootTag|raw }}
    {{ attributes.defaults({
        href: linked ? url : null,
        title: linked ? name : null,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block prepend %}{% endblock %}

    {% block media %}
        {% if cover and cover.url and cover.isSpatialObject() == false %}
            {% set mediaAttrs = {
                title: (cover.translated.title ?: name),
            } %}

            {% if cover.getMediaType().getName() === 'VIDEO' %}
                {% if config('core.listing.autoplayVideoInListing') %}
                    {% set mediaAttrs = mediaAttrs|merge({
                        autoplay: true,
                        loop: true,
                        class: cx.video.apply(),
                    }) %}
                {% endif %}

                {% block video %}
                    {% sw_include '@Storefront/storefront/utilities/video.html.twig' with {
                        media: cover,
                        attributes: mediaAttrs,
                    } %}
                {% endblock %}
            {% else %}
                {% set mediaAttrs = mediaAttrs|merge({
                    alt: (cover.translated.alt ?: name),
                    loading: 'lazy',
                    class: cx.image.apply(),
                }) %}

                {% block image %}
                    {% sw_thumbnails 'product-image-thumbnails' with {
                        media: cover,
                        sizes: sizes,
                        attributes: mediaAttrs,
                    } %}
                {% endblock %}
            {% endif %}
        {% else %}
            {% block placeholder %}
                <div
                    {{ attributes.nested('placeholder') }}
                    class="{{ cx.placeholder.apply() }}"
                    aria-hidden="true"
                >
                    {{ vi_icon('placeholder') }}
                </div>
            {% endblock %}
        {% endif %}
    {% endblock %}

    {% block append %}{% endblock %}
</{{ rootTag|raw }}>
