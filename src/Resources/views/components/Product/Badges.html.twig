{% if visible %}
    {% set cx = vi_cva_from_file(cva) %}

    <span
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% block discount %}
            {% if showDiscount %}
                <twig:ViewsTheme:Product:Badge:Discount
                    class="{{ cx.discount.apply() }}"
                    {{ ...attributes.nested('discount').defaults({
                        percentage: discountPercent,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block topseller %}
            {% if showTopseller %}
                <twig:ViewsTheme:Product:Badge:Topseller
                    class="{{ cx.topseller.apply() }}"
                    {{ ...attributes.nested('topseller').all() }}
                />
            {% endif %}
        {% endblock %}

        {% block new %}
            {% if showNew %}
                <twig:ViewsTheme:Product:Badge:New
                    class="{{ cx.new.apply() }}"
                    {{ ...attributes.nested('new').all() }}
                />
            {% endif %}
        {% endblock %}
    </span>
{% endif %}
