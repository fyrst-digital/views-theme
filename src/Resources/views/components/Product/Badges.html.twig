{% if visible %}
    {% do vi_define_cva(cva) %}

    {% do vi_define_attrs(['discount', 'topseller', 'new']) %}

    <span
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block discount %}
            {% if showDiscount %}
                <twig:ViewsTheme:Badge
                    class="{{ vi_class('discount') }}"
                    {{ ...vi_attrs('discount').defaults({
                        label: discountPercent|number_format(0) ~ ' %',
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block topseller %}
            {% if showTopseller %}
                <twig:ViewsTheme:Badge
                    class="{{ vi_class('topseller') }}"
                    {{ ...vi_attrs('topseller').defaults({
                        label: 'listing.boxLabelTopseller'|trans|sw_sanitize,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block new %}
            {% if showNew %}
                <twig:ViewsTheme:Badge
                    class="{{ vi_class('new') }}"
                    {{ ...vi_attrs('new').defaults({
                        label: 'listing.boxLabelNew'|trans|sw_sanitize,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}
    </span>
{% endif %}
