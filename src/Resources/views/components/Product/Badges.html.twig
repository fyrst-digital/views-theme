{% if visible %}
    {% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    discount: attributes.nested('discount'),
    topseller: attributes.nested('topseller'),
    new: attributes.nested('new'),
} %}

    <span
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% block discount %}
            {% if showDiscount %}
                <twig:ViewsTheme:Product:Badge:Discount
                    class="{{ cx.discount.apply() }}"
                    {{ ...attrs.discount.defaults({
                        percentage: discountPercent,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block topseller %}
            {% if showTopseller %}
                <twig:ViewsTheme:Product:Badge:Topseller
                    class="{{ cx.topseller.apply() }}"
                    {{ ...attrs.topseller.all() }}
                />
            {% endif %}
        {% endblock %}

        {% block new %}
            {% if showNew %}
                <twig:ViewsTheme:Product:Badge:New
                    class="{{ cx.new.apply() }}"
                    {{ ...attrs.new.all() }}
                />
            {% endif %}
        {% endblock %}
    </span>
{% endif %}
