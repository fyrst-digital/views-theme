{% if visible %}
    {% do vi_define_cva(cva) %}

    {% do vi_define_attrs(['discount', 'topseller', 'new']) %}

    <span
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block discount %}
            {% if showDiscount %}
                <twig:ViewsTheme:Product:Badge:Discount
                    class="{{ vi_class('discount') }}"
                    {{ ...vi_attrs('discount').defaults({
                        percentage: discountPercent,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block topseller %}
            {% if showTopseller %}
                <twig:ViewsTheme:Product:Badge:Topseller
                    class="{{ vi_class('topseller') }}"
                    {{ ...vi_attrs('topseller').all() }}
                />
            {% endif %}
        {% endblock %}

        {% block new %}
            {% if showNew %}
                <twig:ViewsTheme:Product:Badge:New
                    class="{{ vi_class('new') }}"
                    {{ ...vi_attrs('new').all() }}
                />
            {% endif %}
        {% endblock %}
    </span>
{% endif %}
