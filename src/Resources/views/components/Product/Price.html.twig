{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['prefix', 'unit', 'listPrice', 'reference', 'average']) %}

{% block price %}
    {% if showPrice and price %}
        <div
            {{ attributes }}
            class="{{ vi_class('root') }}"
        >
            {% block prefix %}
                {% if showFromPrefix %}
                    <span
                        {{ vi_attrs('prefix') }}
                        class="{{ vi_class('prefix') }}"
                    >
                        {{ 'listing.listingTextFrom'|trans|sw_sanitize }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block unit %}
                <span
                    {{ vi_attrs('unit') }}
                    class="{{ vi_class('unit', { hasListPrice: hasListPrice }) }}"
                >
                    {{ price.unitPrice|currency }}
                </span>
            {% endblock %}

            {% block listPrice %}
                {% if hasListPrice %}
                    <span
                        {{ vi_attrs('listPrice') }}
                        class="{{ vi_class('listPrice') }}"
                    >
                        {{ price.listPrice.price|currency }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block reference %}
                {% if hasReferencePrice %}
                    <span
                        {{ vi_attrs('reference') }}
                        class="{{ vi_class('reference') }}"
                    >
                        {{ price.referencePrice.price|currency }} /
                        {{ price.referencePrice.referenceUnit }}&nbsp;
                        {{ price.referencePrice.unitName }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block average %}
                {% if hasRegulationPrice %}
                    <span
                        {{ vi_attrs('average') }}
                        class="{{ vi_class('average') }}"
                    >
                        {{ 'general.listPricePreviously'|trans({'%price%': price.regulationPrice.price|currency }) }}
                    </span>
                {% endif %}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}
