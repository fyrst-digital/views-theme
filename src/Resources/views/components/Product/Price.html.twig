{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    prefix: attributes.nested('prefix'),
    unit: attributes.nested('unit'),
    listPrice: attributes.nested('listPrice'),
    reference: attributes.nested('reference'),
    average: attributes.nested('average'),
} %}

{% block price %}
    {% if showPrice and price %}
        <div
            {{ attributes }}
            class="{{ cx.root.apply() }}"
        >
            {% block prefix %}
                {% if showFromPrefix %}
                    <span
                        {{ attrs.prefix }}
                        class="{{ cx.prefix.apply() }}"
                    >
                        {{ 'listing.listingTextFrom'|trans|sw_sanitize }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block unit %}
                <span
                    {{ attrs.unit }}
                    class="{{ cx.unit.apply({ hasListPrice: hasListPrice }) }}"
                >
                    {{ price.unitPrice|currency }}
                </span>
            {% endblock %}

            {% block listPrice %}
                {% if hasListPrice %}
                    <span
                        {{ attrs.listPrice }}
                        class="{{ cx.listPrice.apply() }}"
                    >
                        {{ price.listPrice.price|currency }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block reference %}
                {% if hasReferencePrice %}
                    <span
                        {{ attrs.reference }}
                        class="{{ cx.reference.apply() }}"
                    >
                        {{ price.referencePrice.price|currency }} /
                        {{ price.referencePrice.referenceUnit }}&nbsp;
                        {{ price.referencePrice.unitName }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block average %}
                {% if hasRegulationPrice %}
                    <span
                        {{ attrs.average }}
                        class="{{ cx.average.apply() }}"
                    >
                        {{ 'general.listPricePreviously'|trans({'%price%': price.regulationPrice.price|currency }) }}
                    </span>
                {% endif %}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}
