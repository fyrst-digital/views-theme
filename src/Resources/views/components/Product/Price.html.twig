{% props
    product,
    showPrice = true,
    showTieredPrices = true,
    showTaxNote = false,
    cva = {},
%}

{% set price = product.calculatedPrice %}
{% set prices = product.calculatedPrices %}
{% set displayFromVariants = false %}

{% if product.variantListingConfig.displayParent and product.parentId === null %}
    {% set displayFromVariants = price.unitPrice !== product.calculatedCheapestPrice.unitPrice %}
    {% set price = product.calculatedCheapestPrice %}
{% endif %}

{% if prices.count > 0 %}
    {% set price = prices.last %}
{% endif %}

{% set hasListPrice = price.listPrice and price.listPrice.percentage > 0 %}

{% set cx = vi_cva_from_file(cva) %}

{% block tiered %}
    {% if prices.count > 1 and showTieredPrices is same as(true) %}
        <twig:ViewsTheme:Product:Price:Tiered
            class="{{ cx.tiered.apply() }}"
            {{ ...attributes.nested('tiered').defaults({
                product: product,
                prices: prices,
            }).all() }}
        />
    {% endif %}
{% endblock %}

{% block price %}
    {% if showPrice is same as(true) %}
        <div
            {{ attributes }}
            class="{{ cx.root.apply() }}"
        >
            {% block prefix %}
                {% if prices.count > 1 or displayFromVariants %}
                    <span
                        {{ attributes.nested('prefix') }}
                        class="{{ cx.prefix.apply() }}"
                    >
                        {{ 'listing.listingTextFrom'|trans|sw_sanitize }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block unit %}
                <span
                    {{ attributes.nested('unit') }}
                    class="{{ cx.unit.apply() }}{{ hasListPrice ? ' text-danger' : '' }}"
                >
                    {{ price.unitPrice|currency }}
                </span>
            {% endblock %}

            {% block listPrice %}
                {% if hasListPrice %}
                    <span
                        {{ attributes.nested('listPrice') }}
                        class="{{ cx.listPrice.apply() }}"
                    >
                        {{ price.listPrice.price|currency }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block reference %}
                {% if price.referencePrice is not null %}
                    <span
                        {{ attributes.nested('reference') }}
                        class="{{ cx.reference.apply() }}"
                    >
                        {{ price.referencePrice.price|currency }} /
                        {{ price.referencePrice.referenceUnit }}&nbsp;
                        {{ price.referencePrice.unitName }}
                    </span>
                {% endif %}
            {% endblock %}

            {% block average %}
                {% if price.regulationPrice.price is not null %}
                    <span
                        {{ attributes.nested('average') }}
                        class="{{ cx.average.apply() }}"
                    >
                        {{ 'general.listPricePreviously'|trans({'%price%': price.regulationPrice.price|currency }) }}
                    </span>
                {% endif %}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}

{% block tax %}
    {% if showTaxNote is same as(true) %}
        <twig:ViewsTheme:Product:Price:Tax
            class="{{ cx.tax.apply() }}"
            {{ ...attributes.nested('tax').all() }}
        />
    {% endif %}
{% endblock %}
