{% props
    product,
    href = null,
    showQuantity = false,
    cva = {},
%}

{% set isAvailable = not product.isCloseout or (product.stock >= product.minPurchase) %}
{% set displayFrom = product.calculatedPrices.count > 1 %}
{% set displayBuyButton = isAvailable and not displayFrom and product.childCount <= 0 %}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['buy', 'detail']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block prepend %}{% endblock %}

    {% block content %}
        {% if displayBuyButton and config('core.listing.allowBuyInListing') %}
            {% block buy %}
                <twig:ViewsTheme:Product:Action:Buy
                    class="{{ vi_class('buy') }}"
                    {{ ...vi_attrs('buy').defaults({
                        product: product,
                        showQuantity: showQuantity,
                    }).all() }}
                />
            {% endblock %}
        {% else %}
            {% block detail %}
                <twig:ViewsTheme:Product:Action:Detail
                    class="{{ vi_class('detail') }}"
                    {{ ...vi_attrs('detail').defaults({
                        product: product,
                        href: href,
                    }).all() }}
                />
            {% endblock %}
        {% endif %}
    {% endblock %}

    {% block append %}{% endblock %}
</div>
