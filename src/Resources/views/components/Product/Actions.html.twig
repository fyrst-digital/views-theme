{% do vi_define_cva(cva, ['root', 'wishlist']) %}
{% do vi_define_attrs(['wishlist']) %}

{% if wishlistEnabled %}
    <div
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block prepend %}{% endblock %}

        {% block wishlist %}
            <twig:ViewsTheme:Product:Action:Wishlist
                class="{{ vi_class('wishlist') }}"
                {{ ...vi_attrs('wishlist').defaults({
                    productId: productId,
                    showText: true,
                    size: 'sm',
                }).all() }}
            />
        {% endblock %}

        {% block append %}{% endblock %}
    </div>
{% endif %}
