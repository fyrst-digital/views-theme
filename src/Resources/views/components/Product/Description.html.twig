{% props
    product = null,
    description = product ? product.translated.description|default('') : '',
    outputTags = true,
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-product-description' },
}|replace_recursive(cva)) %}

<div
    {{ attributes.defaults({
        itemprop: 'description',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% if outputTags is same as(true) %}
        {{ description|raw }}
    {% else %}
        {{ description|striptags }}
    {% endif %}
</div>
