{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['results']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Product:Listing',
        'data-component-options': componentOptions|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block results %}
        <twig:ViewsTheme:Product:Listing:Results
            class="{{ vi_class('results') }}"
            {{ ...vi_attrs('results').defaults({
                searchResult: searchResult,
                boxLayout: boxLayout,
                listingColumns: listingColumns,
                referrerCategoryId: referrerCategoryId,
            }).all() }}
        />
    {% endblock %}
</div>
