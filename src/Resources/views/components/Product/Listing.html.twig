{% sw_extends '@Storefront/storefront/component/product/listing.html.twig' %}

{#
  Product listing under components/. Extends core listing for pagination/sorting.
  Not a pure UX tag component — include path or theme inheritance only.
#}

{% props
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-product-listing js-listing-wrapper' },
    actions: { base: 'vi-product-listing__actions' },
    empty: { base: 'vi-product-listing__empty' },
}|replace_recursive(cva)) %}

{% block element_product_listing_pagination_nav_actions %}
    <div
        {{ attributes.nested('actions') }}
        class="{{ cx.actions.apply() }}"
    >
        {% block element_product_listing_pagination_nav_top %}
            {% sw_include '@Storefront/storefront/component/pagination.html.twig' with {
                entities: searchResult,
                fallbackUrl: paginationFallbackUrl,
                paginationLocation: 'top',
            } %}
        {% endblock %}

        {% block element_product_listing_sorting %}
            {% sw_include '@Storefront/storefront/component/sorting.html.twig' with {
                current: searchResult.sorting,
                sortings: searchResult.availableSortings,
            } %}
        {% endblock %}
    </div>
{% endblock %}

{% block element_product_listing_row %}
    {% if searchResult.total > searchResult.limit %}
        {% set ariaLiveText = 'listing.filterPanelAriaLivePaginated'|trans({
            '%count%': searchResult.elements|length,
            '%total%': searchResult.total,
        })|sw_sanitize %}
    {% else %}
        {% set ariaLiveText = 'listing.filterPanelAriaLive'|trans({'%count%': searchResult.total})|sw_sanitize %}
    {% endif %}

    <div
        {{ attributes.defaults({
            'data-aria-live-text': ariaLiveText,
            role: searchResult.total > 0 ? 'list' : null,
        }) }}
        class="{{ cx.root.apply() }}"
    >
        {% if searchResult.total > 0 %}
            {% block element_product_listing_col %}
                {% for product in searchResult %}
                    {% block element_product_listing_box %}
                        <twig:ViewsTheme:Product:Box:Base
                            :product="product"
                            :layout="boxLayout"
                            :displayMode="displayMode"
                        />
                    {% endblock %}
                {% endfor %}
            {% endblock %}
        {% else %}
            {% block element_product_listing_col_empty %}
                <div {{ attributes.nested('empty') }} class="{{ cx.empty.apply() }}">
                    {% block element_product_listing_col_empty_alert %}
                        <twig:ViewsTheme:Alert
                            type="info"
                            content="{{ 'listing.emptyResultMessage'|trans|sw_sanitize }}"
                            announceOnLoad
                        />
                    {% endblock %}
                </div>
            {% endblock %}
        {% endif %}
    </div>
{% endblock %}
