{% do vi_define_cva(cva, ['root', 'title', 'group']) %}
{% do vi_define_attrs(['title', 'group']) %}

{% if visible %}
    <form
        {{ attributes.defaults({
            'data-component': 'ViewsTheme:Product:Configurator',
            'data-component-options': {
                configuratorId: configuratorId,
                switchUrl: switchUrl,
                selected: selected,
            }|json_encode,
        }) }}
        class="{{ vi_class('root') }}"
    >
        {% block title %}
            <div {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
                {{ 'viewsTheme.configurator.title'|trans({'%count%': groups|length})|sw_sanitize }}
            </div>
        {% endblock %}

        {% block groups %}
            {% for group in groups %}
                {% block group %}
                    <twig:ViewsTheme:Product:Configurator:Group
                        class="{{ vi_class('group') }}"
                        {{ ...vi_attrs('group').defaults({
                            group: group,
                            product: product,
                            elementId: elementId,
                            configuratorId: configuratorId,
                        }).all() }}
                    />
                {% endblock %}
            {% endfor %}
        {% endblock %}
    </form>
{% endif %}
