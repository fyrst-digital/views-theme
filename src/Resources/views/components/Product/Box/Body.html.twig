{% props
    product,
    showDescription = true,
    cva = {},
%}

{% if showDescription is same as(true) %}
    {% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    description: attributes.nested('description'),
} %}

    <div
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% block description %}
            <twig:ViewsTheme:Product:Description
                class="{{ cx.description.apply() }}"
                {{ ...attrs.description.defaults({
                    product: product,
                    outputTags: false,
                }).all() }}
            />
        {% endblock %}
    </div>
{% endif %}
