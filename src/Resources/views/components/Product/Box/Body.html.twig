{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['variations', 'description']) %}

{% if visible %}
    <div
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block variations %}
            {% if showVariationsBlock %}
                <twig:ViewsTheme:Product:Variations
                    class="{{ vi_class('variations') }}"
                    {{ ...vi_attrs('variations').defaults({
                        product: product,
                        variations: variations,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block description %}
            {% if showDescription is same as(true) %}
                <twig:ViewsTheme:Product:Description
                    class="{{ vi_class('description') }}"
                    {{ ...vi_attrs('description').defaults({
                        product: product,
                        outputTags: false,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}
    </div>
{% endif %}
