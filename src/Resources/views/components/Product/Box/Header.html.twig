{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['rating', 'name']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block rating %}
        {% if showRatingBlock %}
            <twig:ViewsTheme:Review:Rating
                class="{{ vi_class('rating') }}"
                {{ ...vi_attrs('rating').defaults({
                    points: product.ratingAverage,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block name %}
        <twig:ViewsTheme:Product:Name
            class="{{ vi_class('name') }}"
            {{ ...vi_attrs('name').defaults({
                product: product,
                url: href,
            }).all() }}
        />
    {% endblock %}
</div>
