{% props
    product,
    href = null,
    showRating = true,
    showVariations = true,
    cva = {},
%}

{% set displayParent = product.variantListingConfig.displayParent and product.parentId === null %}
{% set showVariationsBlock = not displayParent and product.variation and showVariations is same as(true) %}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block rating %}
        {% if showRating is same as(true)
            and config('core.listing.showReview')
            and product.ratingAverage
        %}
            <twig:ViewsTheme:Review:Rating
                class="{{ cx.rating.apply() }}"
                {{ ...attributes.nested('rating').defaults({
                    points: product.ratingAverage,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block name %}
        <twig:ViewsTheme:Product:Name
            class="{{ cx.name.apply() }}"
            {{ ...attributes.nested('name').defaults({
                product: product,
                url: href,
            }).all() }}
        />
    {% endblock %}

    {% block variations %}
        {% if showVariationsBlock %}
            <twig:ViewsTheme:Product:Variations
                class="{{ cx.variations.apply() }}"
                {{ ...attributes.nested('variations').defaults({
                    product: product,
                    variations: product.variation,
                }).all() }}
            />
        {% endif %}
    {% endblock %}
</div>
