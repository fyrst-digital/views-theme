{% props
    product,
    layout = 'default',
    displayMode = 'standard',
    sizes = {
        xs: '500px',
        sm: '315px',
        md: '390px',
        lg: '350px',
        xl: '280px',
    },
    showDescription = true,
    showVariations = true,
    showPrice = true,
    showActions = true,
    priceShowPrice = true,
    priceShowTieredPrices = true,
    priceShowTaxNote = false,
    referrerCategoryId = null,
    cva = {},
%}

{% set id = product.id %}
{% set name = product.translated.name %}
{% set brand = product.manufacturer.translated.name|default('') %}
{% set price = product.calculatedPrice.unitPrice %}
{% set cover = product.cover.media %}
{% set displayParent = product.variantListingConfig.displayParent and product.parentId === null %}
{% set isAvailable = not product.isCloseout or (product.stock >= product.minPurchase) %}
{% set displayFrom = product.calculatedPrices.count > 1 %}
{% set displayBuyButton = isAvailable and not displayFrom and product.childCount <= 0 %}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults({
        'data-product-information': { id: id, name: name, brand: brand, price: price }|json_encode,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block image %}
        <div
            {{ attributes.nested('image') }}
            class="{{ cx.image.apply() }}"
        >
            {% block image_prepend %}{% endblock %}

            {% block badges %}
                <twig:ViewsTheme:Product:Badges :product="product" />
            {% endblock %}

            {% block cover %}
                <twig:ViewsTheme:Product:Cover
                    :id="id"
                    :name="name"
                    :cover="cover"
                    :displayMode="displayMode"
                    :sizes="sizes"
                />
            {% endblock %}

            {% block wishlist %}
                {% if config('core.cart.wishlistEnabled') %}
                    <twig:ViewsTheme:Product:Action:Wishlist
                        :productId="id"
                        :showText="false"
                        class="product-box-wishlist-action"
                    />
                {% endif %}
            {% endblock %}

            {% block image_append %}{% endblock %}
        </div>
    {% endblock %}

    {% block content %}
        <div
            {{ attributes.nested('content') }}
            class="{{ cx.content.apply() }}"
        >
            {% block header %}
                <div class="vi-product-box__header">
                    {% block rating %}
                        {% if config('core.listing.showReview') and product.ratingAverage %}
                            <twig:ViewsTheme:Review:Rating :points="product.ratingAverage" />
                        {% endif %}
                    {% endblock %}

                    {% block name %}
                        <twig:ViewsTheme:Product:Name :product="product" />
                    {% endblock %}
                </div>
            {% endblock %}

            {% block body %}
                {% set showBody = (not displayParent and product.variation and showVariations is same as(true))
                    or (showDescription is same as(true)) %}

                {% if showBody %}
                    <div
                        {{ attributes.nested('body') }}
                        class="{{ cx.body.apply() }}"
                    >
                        {% block variations %}
                            {% if not displayParent and product.variation and showVariations is same as(true) %}
                                <twig:ViewsTheme:Product:Variations
                                    :product="product"
                                    :variations="product.variation"
                                />
                            {% endif %}
                        {% endblock %}

                        {% block description %}
                            {% if showDescription is same as(true) %}
                                <twig:ViewsTheme:Product:Description
                                    :product="product"
                                    :outputTags="false"
                                />
                            {% endif %}
                        {% endblock %}
                    </div>
                {% endif %}
            {% endblock %}

            {% block footer %}
                <div
                    {{ attributes.nested('footer') }}
                    class="{{ cx.footer.apply() }}"
                >
                    {% block price %}
                        {% if showPrice is same as(true) %}
                            <twig:ViewsTheme:Product:Price
                                :product="product"
                                :showPrice="priceShowPrice"
                                :showTieredPrices="priceShowTieredPrices"
                                :showTaxNote="priceShowTaxNote"
                            />
                        {% endif %}
                    {% endblock %}

                    {% block actions %}
                        {% if showActions is same as(true) %}
                            <div
                                {{ attributes.nested('actions') }}
                                class="{{ cx.actions.apply() }}"
                            >
                                {% block actions_prepend %}{% endblock %}

                                {% if displayBuyButton and config('core.listing.allowBuyInListing') %}
                                    {% block action_buy %}
                                        <twig:ViewsTheme:Product:Action:Buy :product="product" />
                                    {% endblock %}
                                {% else %}
                                    {% block action_details %}
                                        <a
                                            {{ attributes.nested('details').defaults({
                                                href: seoUrl('frontend.detail.page', { productId: id }),
                                            }) }}
                                            class="{{ cx.details.apply() }}"
                                        >
                                            {{ 'listing.boxProductDetails'|trans|sw_sanitize }}
                                        </a>
                                    {% endblock %}
                                {% endif %}

                                {% block actions_append %}{% endblock %}
                            </div>
                        {% endif %}
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
</div>
