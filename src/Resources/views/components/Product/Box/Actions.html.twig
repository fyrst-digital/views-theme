{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['buy', 'detail']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block prepend %}{% endblock %}

    {% block content %}
        {% if displayBuyButton %}
            {% block buy %}
                <twig:ViewsTheme:Product:Action:Buy
                    class="{{ vi_class('buy') }}"
                    {{ ...vi_attrs('buy').defaults({
                        'product': product,
                        'showQuantity': showQuantity,
                        'button:size': 'sm',
                        'button:label': false,
                        'button:square': true,
                        'button:pill': true,
                    }).all() }}
                />
            {% endblock %}
        {% else %}
            {% block detail %}
                <twig:ViewsTheme:Product:Action:Detail
                    class="{{ vi_class('detail') }}"
                    {{ ...vi_attrs('detail').defaults({
                        'product': product,
                        'href': href,
                        'size': 'sm',
                        'label': false,
                        'square': true,
                        'pill': true,
                    }).all() }}
                />
            {% endblock %}
        {% endif %}
    {% endblock %}

    {% block append %}{% endblock %}
</div>
