{% props
    product,
    layout = 'default',
    displayMode = 'standard',
    cva = {},
%}

{% set resolvedLayout = layout is empty or layout is same as('standard') ? 'default' : layout %}

{% set sizes = {
    xs: '500px',
    sm: '315px',
    md: '390px',
    lg: '350px',
    xl: '280px',
} %}

{% if resolvedLayout == 'image' %}
    {% set sizes = {
        xs: '500px',
        sm: '500px',
        md: '390px',
        lg: '350px',
        xl: '280px',
    } %}
{% endif %}

{% block box %}
    {# Only default layout is implemented; other layouts fall back to Default. #}
    <twig:ViewsTheme:Product:Box:Default
        :product="product"
        :layout="resolvedLayout"
        :displayMode="displayMode"
        :sizes="sizes"
        :cva="cva"
    />
{% endblock %}
