{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    container: attributes.nested('container'),
    price: attributes.nested('price'),
    tax: attributes.nested('tax'),
    variations: attributes.nested('variations'),
    actions: attributes.nested('actions'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        
        <div
            {{ attrs.container }}
            class="{{ cx.container.apply() }}"
            >
            {% block price %}
                {% if showPrice is same as(true) %}
                    <twig:ViewsTheme:Product:Price
                        class="{{ cx.price.apply() }}"
                        {{ ...attrs.price.defaults({
                            product: product,
                            showPrice: priceShowPrice,
                        }).all() }}
                    />
                    {% if priceShowTaxNote %}
                        <twig:ViewsTheme:Product:Price:Tax
                            {{ ...attrs.tax.all() }}
                        />
                    {% endif %}
                {% endif %}
            {% endblock %}

            {% block variations %}
                {% if showVariationsBlock %}
                    <twig:ViewsTheme:Product:Variations
                        class="{{ cx.variations.apply() }}"
                        {{ ...attrs.variations.defaults({
                            product: product,
                            variations: variations,
                        }).all() }}
                    />
                {% endif %}
            {% endblock %}
        </div>

        {% block actions %}
            {% if showActions is same as(true) %}
                <twig:ViewsTheme:Product:Box:Actions
                    class="{{ cx.actions.apply() }}"
                    {{ ...attrs.actions.defaults({
                        product: product,
                        href: href,
                        showQuantity: showQuantity,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}
    {% endblock %}
</div>
