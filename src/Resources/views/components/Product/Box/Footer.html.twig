{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['container', 'price', 'tax', 'actions']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        
        <div
            {{ vi_attrs('container') }}
            class="{{ vi_class('container') }}"
            >
            {% block price %}
                {% if showPrice is same as(true) %}
                    <twig:ViewsTheme:Product:Price
                        class="{{ vi_class('price') }}"
                        {{ ...vi_attrs('price').defaults({
                            product: product,
                            showPrice: priceShowPrice,
                            'unit:class': 'fs-4',
                        }).all() }}
                    />
                    {% if priceShowTaxNote %}
                        <twig:ViewsTheme:Product:Price:Tax
                            {{ ...vi_attrs('tax').all() }}
                        />
                    {% endif %}
                {% endif %}
            {% endblock %}
        </div>

        {% block actions %}
            {% if showActions is same as(true) %}
                <twig:ViewsTheme:Product:Box:Actions
                    class="{{ vi_class('actions') }}"
                    {{ ...vi_attrs('actions').defaults({
                        product: product,
                        href: href,
                        showQuantity: showQuantity,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}
    {% endblock %}
</div>
