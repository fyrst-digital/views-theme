{% props
    product = null,
    variations = null,
    cva = {},
%}

{% set resolvedVariations = variations is not null ? variations : product.variation|default([]) %}
{% set cx = vi_cva({
    root: { base: 'vi-product-variations' },
    item: { base: 'vi-product-variations__item' },
}|replace_recursive(cva)) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% for variation in resolvedVariations %}
        <div
            {{ attributes.nested('item') }}
            class="{{ cx.item.apply() }}"
        >
            {{ variation.group }}:
            {{ variation.option }}
        </div>
    {% endfor %}
</div>
