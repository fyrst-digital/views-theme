{% props
    product = null,
    variations = product ? product.variation|default([]) : [],
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-product-variations' },
    item: { base: 'vi-product-variations__item' },
}|replace_recursive(cva)) %}

{% if variations is not empty %}
    <div
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% for variation in variations %}
            <div
                {{ attributes.nested('item') }}
                class="{{ cx.item.apply() }}"
            >
                {{ variation.group }}:
                {{ variation.option }}
            </div>
        {% endfor %}
    </div>
{% endif %}
