{% props
    product = null,
    variations = product ? product.variation|default([]) : [],
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-product-variations d-flex flex-row flex-wrap gap-1' },
    item: { base: 'vi-product-variations__item' },
}|replace_recursive(cva)) %}
{% set attrs = {
    item: attributes.nested('item')
} %}
{% set classes = {
    item: cx.item.apply()
} %}

{% if variations is not empty %}
    <div
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% for variation in variations %}
            <twig:ViewsTheme:Badge
                class="{{ classes.item }}"
                {{ ...attrs.item.defaults({
                    color: 'light',
                    size: 'sm',
                    label: variation.option ,
                }).all() }}
            />
        {% endfor %}
    </div>
{% endif %}
