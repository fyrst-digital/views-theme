{% props
    product = null,
    showLink = true,
    url = null,
    name = null,
    tag = 'div',
    cva = {},
%}

{% set productName = name is not null ? name : (product ? product.translated.name : null) %}
{% set productUrl = url is not null
    ? url
    : (product ? seoUrl('frontend.detail.page', { productId: product.id }) : null) %}
{% set linked = showLink is same as(true) and productUrl is not null %}
{% set cx = vi_cva({
    root: { base: 'vi-product-name d-inline-flex align-items-center fw-semibold' },
    link: { base: 'vi-product-name__link link-dark link-offset-2 link-underline-opacity-25 link-underline-opacity-50-hover' },
}|replace_recursive(cva)) %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% if linked %}
        <a
            {{ attributes.nested('link').defaults({
                href: productUrl,
                title: productName,
            }) }}
            class="{{ cx.link.apply() }}"
        >
            {{ productName|raw }}
        </a>
    {% else %}
        {{ productName|raw }}
    {% endif %}
</{{ tag|raw }}>
