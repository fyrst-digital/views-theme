{% props
    product = null,
    showLink = true,
    url = product ? seoUrl('frontend.detail.page', { productId: product.id }) : null,
    name = product ? product.translated.name : null,
    tag = 'div',
    cva = {},
%}

{% set linked = showLink is same as(true) and url is not null %}
{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['link']) %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% if linked %}
        <a
            {{ vi_attrs('link').defaults({
                href: url,
                title: name,
            }) }}
            class="{{ vi_class('link') }}"
        >
            {{ name|raw }}
        </a>
    {% else %}
        {{ name|raw }}
    {% endif %}
</{{ tag|raw }}>
