{% props
    product = null,
    showLink = true,
    url = product ? seoUrl('frontend.detail.page', { productId: product.id }) : null,
    name = product ? product.translated.name : null,
    tag = 'div',
    cva = {},
%}

{% set linked = showLink is same as(true) and url is not null %}
{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    link: attributes.nested('link'),
} %}

<{{ tag|raw }}
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% if linked %}
        <a
            {{ attrs.link.defaults({
                href: url,
                title: name,
            }) }}
            class="{{ cx.link.apply() }}"
        >
            {{ name|raw }}
        </a>
    {% else %}
        {{ name|raw }}
    {% endif %}
</{{ tag|raw }}>
