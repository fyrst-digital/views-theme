{% props
    product,
    layout = 'default',
    displayMode = 'standard',
    sizes = null,
    showDescription = true,
    showVariations = true,
    showPrice = true,
    showActions = true,
    priceShowPrice = true,
    priceShowTieredPrices = false,
    priceShowTaxNote = null,
    referrerCategoryId = null,
    cva = {},
%}

{% set resolvedLayout = layout is empty or layout is same as('standard') ? 'default' : layout %}
{% set resolvedDisplayMode = resolvedLayout is same as('image') and displayMode is same as('standard')
    ? 'cover'
    : displayMode %}

{% set resolvedSizes = sizes is not null ? sizes : {
    xs: '500px',
    sm: '315px',
    md: '390px',
    lg: '350px',
    xl: '280px',
    xxl: '280px',
} %}
{% if sizes is null and resolvedLayout is same as('image') %}
    {% set resolvedSizes = {
        xs: '500px',
        sm: '500px',
        md: '390px',
        lg: '350px',
        xl: '280px',
        xxl: '280px',
    } %}
{% endif %}

{% set id = product.id %}
{% set name = product.translated.name %}
{% set brand = product.manufacturer.translated.name|default('') %}
{% set price = product.calculatedPrice.unitPrice %}
{% set cover = product.cover.media %}
{% set searchTerm = page.searchTerm|default(null) %}
{% set routeArguments = product.childCount > 0 and searchTerm
    ? { productId: id, search: searchTerm }
    : { productId: id } %}
{% if referrerCategoryId %}
    {% set routeArguments = routeArguments|merge({ referrerCategoryId: referrerCategoryId }) %}
{% endif %}
{% set productUrl = seoUrl('frontend.detail.page', routeArguments) %}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults({
        'data-product-information': { id: id, name: name, brand: brand, price: price }|json_encode,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block image %}
        <twig:ViewsTheme:Product:Cover
            :id="id"
            :name="name"
            :cover="cover"
            :displayMode="resolvedDisplayMode"
            :sizes="resolvedSizes"
            :url="productUrl"
            class="product-image-wrapper"
        >
            <twig:block name="prepend">
                <twig:ViewsTheme:Product:Badges :product="product" />
            </twig:block>

            <twig:block name="append">
                {% if config('core.cart.wishlistEnabled') %}
                    <twig:ViewsTheme:Product:Action:Wishlist
                        :productId="id"
                        :showText="false"
                        appearance="circle"
                    />
                {% endif %}
            </twig:block>
        </twig:ViewsTheme:Product:Cover>
    {% endblock %}

    {% block content %}
        <div
            {{ attributes.nested('content') }}
            class="{{ cx.content.apply() }}"
        >
            {% block header %}
                <twig:ViewsTheme:Product:Box:Header
                    class="{{ cx.header.apply() }}"
                    {{ ...attributes.nested('header').defaults({
                        product: product,
                        href: productUrl,
                    }).all() }}
                />
            {% endblock %}

            {% block body %}
                <twig:ViewsTheme:Product:Box:Body
                    class="{{ cx.body.apply() }}"
                    {{ ...attributes.nested('body').defaults({
                        product: product,
                        showVariations: showVariations,
                        showDescription: showDescription,
                    }).all() }}
                />
            {% endblock %}

            {% block footer %}
                <twig:ViewsTheme:Product:Box:Footer
                    class="{{ cx.footer.apply() }}"
                    {{ ...attributes.nested('footer').defaults({
                        product: product,
                        href: productUrl,
                        showPrice: showPrice,
                        showActions: showActions,
                        priceShowPrice: priceShowPrice,
                        priceShowTieredPrices: priceShowTieredPrices,
                        priceShowTaxNote: priceShowTaxNote,
                        showQuantity: false,
                    }).all() }}
                />
            {% endblock %}
        </div>
    {% endblock %}
</div>
