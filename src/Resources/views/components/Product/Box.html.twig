{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['content', 'header', 'body', 'footer']) %}

<div
    {{ attributes.defaults({
        'data-product-information': { id: id, name: name, brand: brand, price: price }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block image %}
        <twig:ViewsTheme:Product:Cover
            :product="product"
            :sizes="sizes"
            :referrerCategoryId="referrerCategoryId"
        >
            <twig:block name="prepend">
                <twig:ViewsTheme:Product:Badges 
                    class="position-absolute m-4"
                    topseller:size="sm"
                    topseller:color="dark"
                    :topseller:pill="true"
                    discount:size="sm"
                    discount:color="danger"
                    :discount:pill="true"
                    :product="product" />
            </twig:block>

            <twig:block name="append">
                {% if wishlistEnabled %}
                    <twig:ViewsTheme:Product:Action:Wishlist
                        :productId="id"
                        :showText="false"
                        appearance="circle"
                        class="position-absolute end-0 top-0 m-4"
                    />
                {% endif %}
            </twig:block>
        </twig:ViewsTheme:Product:Cover>
    {% endblock %}

    {% block content %}
        <div
            {{ vi_attrs('content') }}
            class="{{ vi_class('content') }}"
        >
            {% block header %}
                <twig:ViewsTheme:Product:Box:Header
                    class="{{ vi_class('header') }}"
                    {{ ...vi_attrs('header').defaults({
                        product: product,
                        referrerCategoryId: referrerCategoryId,
                    }).all() }}
                />
            {% endblock %}

            {% block body %}
                <twig:ViewsTheme:Product:Box:Body
                    class="{{ vi_class('body') }}"
                    {{ ...vi_attrs('body').defaults({
                        product: product,
                        showDescription: showDescription,
                        showVariations: showVariations,
                    }).all() }}
                />
            {% endblock %}

            {% block footer %}
                <twig:ViewsTheme:Product:Box:Footer
                    class="{{ vi_class('footer') }}"
                    {{ ...vi_attrs('footer').defaults({
                        product: product,
                        showPrice: showPrice,
                        showActions: showActions,
                        priceShowPrice: priceShowPrice,
                        priceShowTaxNote: priceShowTaxNote,
                        showQuantity: false,
                        referrerCategoryId: referrerCategoryId,
                    }).all() }}
                />
            {% endblock %}
        </div>
    {% endblock %}
</div>
