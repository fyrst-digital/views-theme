{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'carousel', 'item', 'box']) %}

{% set total = items|length %}

<div
    {{ attributes.defaults({
        style: itemWidth ? '--vi-carousel-item-w: ' ~ itemWidth : false,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block title %}
        {% if title %}
            <h2 {{ vi_attrs('title') }} class="{{ vi_class('title') }}">{{ title }}</h2>
        {% endif %}
    {% endblock %}

    {% block carousel %}
        <twig:ViewsTheme:Carousel
            class="{{ vi_class('carousel') }}"
            {{ ...vi_attrs('carousel').defaults({
                label: title ?: 'component.cms.productGallery.ariaLabel'|trans({ '%total%': total })|striptags,
            }).all() }}
        >
            {% for product in items %}
                <twig:ViewsTheme:Carousel:Item
                    class="{{ vi_class('item') }}"
                    :index="loop.index0"
                    :total="total"
                    {{ ...vi_attrs('item').all() }}
                >
                    <twig:ViewsTheme:Product:Box
                        class="{{ vi_class('box') }}"
                        :product="product"
                        {{ ...vi_attrs('box').defaults({
                            layout: boxLayout,
                            sizes: sizes,
                            referrerCategoryId: referrerCategoryId,
                        }).all() }}
                    />
                </twig:ViewsTheme:Carousel:Item>
            {% endfor %}
        </twig:ViewsTheme:Carousel>
    {% endblock %}
</div>
