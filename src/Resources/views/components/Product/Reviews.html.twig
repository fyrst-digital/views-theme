{% do vi_define_cva(cva, ['root', 'rating', 'label', 'link']) %}
{% do vi_define_attrs(['rating', 'label', 'link']) %}

{% if visible %}
    <div
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block rating %}
            <twig:ViewsTheme:Review:Rating
                class="{{ vi_class('rating') }}"
                {{ ...vi_attrs('rating').defaults({
                    points: average,
                }).all() }}
            />
        {% endblock %}

        {% block label %}
            <div {{ vi_attrs('label') }} class="{{ vi_class('label') }}">
                {{ 'detail.reviewLabelText'|trans({'%average%': average})|sw_sanitize }}
                {% block link %}
                    <a
                        {{ vi_attrs('link').defaults({
                            'data-bs-toggle': 'tab',
                            'data-off-canvas-tabs': 'true',
                            'data-remote-click': 'true',
                            'data-remote-click-options': remoteClickOptions|json_encode,
                            href: reviewTabHref,
                            'aria-controls': 'review-tab-pane',
                        }) }}
                        class="{{ vi_class('link') }}"
                    >
                        {{ totalReviews }}
                        {{ 'detail.reviewLinkText'|trans({'%count%': totalReviews})|sw_sanitize }}
                    </a>
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endif %}
