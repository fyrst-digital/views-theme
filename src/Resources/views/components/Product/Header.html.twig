{% props
    product,
    nameShowLink = true,
    nameTag = 'div',
    defaultBaseClasses = 'vi-product-header',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}

<div
    data-ref="header"
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block prepend %}{% endblock %}

    {% block breadcrumb %}
        {% if feature('v6.8.0.0') or feature('BREADCRUMB_REWORK') %}
            {% sw_include '@ViewsTheme/components/Breadcrumb.html.twig' with {
                context: context,
                breadcrumb: page.breadcrumb,
            } only %}
        {% else %}
            {% sw_include '@ViewsTheme/components/Breadcrumb.html.twig' with {
                context: context,
                categoryId: shopware.navigation.id,
            } only %}
        {% endif %}
    {% endblock %}

    {% block name %}
        <twig:ViewsTheme:Product:Name
            :product="product"
            :showLink="nameShowLink"
            :tag="nameTag"
        />
    {% endblock %}

    {% block append %}{% endblock %}
</div>
