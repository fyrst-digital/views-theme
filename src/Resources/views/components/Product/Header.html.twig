{% props
    product,
    showManufacturer = true,
    showSku = false,
    cva = {},
%}

{% do vi_define_cva(cva, ['root', 'manufacturer', 'name', 'sku']) %}
{% do vi_define_attrs(['manufacturer', 'name', 'sku']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block prepend %}{% endblock %}

    {% block manufacturer %}
        {% if showManufacturer %}
            <twig:ViewsTheme:Product:Manufacturer
                class="{{ vi_class('manufacturer') }}"
                {{ ...vi_attrs('manufacturer').defaults({
                    product: product,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block name %}
        <twig:ViewsTheme:Product:Name
            class="{{ vi_class('name') }}"
            {{ ...vi_attrs('name').defaults({
                product: product,
                showLink: true,
                tag: 'div',
            }).all() }}
        />
    {% endblock %}

    {% block sku %}
        {% if showSku %}
            <twig:ViewsTheme:Product:SKU
                class="{{ vi_class('sku') }}"
                {{ ...vi_attrs('sku').defaults({
                    product: product,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block append %}{% endblock %}
</div>
