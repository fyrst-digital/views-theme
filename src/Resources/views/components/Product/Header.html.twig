{% props
    product,
    nameShowLink = true,
    nameTag = 'div',
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-product-header' },
}|replace_recursive(cva)) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block prepend %}{% endblock %}

    {% block breadcrumb %}
        {% set id = null %}
        {% if product.seoCategory and product.seoCategory.id %}
            {% set id = product.seoCategory.id %}
        {% elseif shopware.navigation.id is defined and shopware.navigation.id %}
            {% set id = shopware.navigation.id %}
        {% endif %}

        {% if id %}
            <twig:ViewsTheme:Breadcrumb :categoryId="id" />
        {% endif %}
    {% endblock %}


    {% block name %}
        <twig:ViewsTheme:Product:Name
            :product="product"
            :showLink="nameShowLink"
            :tag="nameTag"
        />
    {% endblock %}

    {% block append %}{% endblock %}
</div>
