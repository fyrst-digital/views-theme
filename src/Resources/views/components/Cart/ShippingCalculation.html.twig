{% props
    page,
    redirectTo = 'frontend.checkout.cart.page',
    size = 'sm',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set summaryClass = cx.summary.apply() %}
{% set summaryLabel = 'checkout.shippingCosts'|trans|sw_sanitize %}

<form
    {{ attributes.defaults({
        name: 'precalc',
        method: 'post',
        action: path('frontend.checkout.configure'),
        'data-component': 'ViewsTheme:Cart:ShippingCalculation',
        'data-component-options': {
            configureEvent: 'ViewsTheme:Cart:Configure',
        }|json_encode,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block panel %}
        {% set PHYSICAL_STATE = constant('Shopware\\Core\\Content\\Product\\State::IS_PHYSICAL') %}
        {% if page.cart.lineItems.hasLineItemWithState(PHYSICAL_STATE) %}
            <details {{ attributes.nested('details') }} class="{{ cx.details.apply() }}">
                <twig:ViewsTheme:Button
                    class="{{ summaryClass }}"
                    {{ ...attributes.nested('summary').defaults({
                        tag: 'summary',
                        label: summaryLabel,
                        icon: 'caret-down',
                        color: 'secondary',
                        size: size,
                        justify: 'center',
                    }).all() }}
                />

                <div {{ attributes.nested('selects') }} class="{{ cx.selects.apply() }}">
                    {% block country %}
                        <twig:ViewsTheme:Cart:ShippingCalculation:Country
                            class="{{ cx.country.apply() }}"
                            {{ ...attributes.nested('country').defaults({
                                countries: page.countries,
                                size: size,
                            }).all() }}
                        />
                    {% endblock %}

                    {% block payment_method %}
                        <twig:ViewsTheme:Cart:ShippingCalculation:PaymentMethod
                            class="{{ cx.payment.apply() }}"
                            {{ ...attributes.nested('payment').defaults({
                                paymentMethods: page.paymentMethods,
                                size: size,
                            }).all() }}
                        />
                    {% endblock %}

                    {% block shipping_method %}
                        <twig:ViewsTheme:Cart:ShippingCalculation:ShippingMethod
                            class="{{ cx.shipping.apply() }}"
                            {{ ...attributes.nested('shipping').defaults({
                                shippingMethods: page.shippingMethods,
                                size: size,
                            }).all() }}
                        />
                    {% endblock %}

                    <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
                </div>
            </details>
        {% endif %}
    {% endblock %}
</form>
