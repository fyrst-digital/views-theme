{% props
    page,
    redirectTo = 'frontend.checkout.cart.page',
    size = 'sm',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set classes = {
    root: cx.root.apply(),
    details: cx.details.apply(),
    summary: cx.summary.apply(),
    selection: cx.selection.apply(),
} %}
{% set summaryLabel = 'checkout.shippingCosts'|trans|sw_sanitize %}

<form
    {{ attributes.defaults({
        name: 'precalc',
        method: 'post',
        action: path('frontend.checkout.configure'),
        'data-component': 'ViewsTheme:Cart:ShippingCalculation',
        'data-component-options': {
            configureEvent: 'ViewsTheme:Cart:Configure',
        }|json_encode,
    }) }}
    class="{{ classes.root }}"
>
    {% block panel %}
        {% set PHYSICAL_STATE = constant('Shopware\\Core\\Content\\Product\\State::IS_PHYSICAL') %}
        {% if page.cart.lineItems.hasLineItemWithState(PHYSICAL_STATE) %}
            <details {{ attributes.nested('details') }} class="{{ classes.details }}">
                <twig:ViewsTheme:Button
                    class="{{ classes.summary }}"
                    {{ ...attributes.nested('summary').defaults({
                        tag: 'summary',
                        label: summaryLabel,
                        icon: 'caret-down',
                        color: 'secondary',
                        size: size,
                        justify: 'center',
                    }).all() }}
                />

                {% block selection %}
                    <twig:ViewsTheme:Cart:ShippingCalculation:Selection
                        class="{{ classes.selection }}"
                        {{ ...attributes.nested('selection').defaults({
                            page: page,
                            redirectTo: redirectTo,
                            size: size,
                        }).all() }}
                    />
                {% endblock %}
            </details>
        {% endif %}
    {% endblock %}
</form>
