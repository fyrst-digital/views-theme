{% props
    page,
    redirectTo = 'frontend.checkout.cart.page',
    cva = {},
%}

{% do vi_define_cva(cva, ['root', 'details', 'summary', 'selection']) %}
{% do vi_define_attrs(['details', 'summary', 'selection']) %}

<form
    {{ attributes.defaults({
        name: 'precalc',
        method: 'post',
        action: path('frontend.checkout.configure'),
        'data-component': 'ViewsTheme:Cart:ShippingCalculation',
        'data-component-options': {
            configureEvent: 'ViewsTheme:Cart:Configure',
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block panel %}
        {% set PHYSICAL_STATE = constant('Shopware\\Core\\Content\\Product\\State::IS_PHYSICAL') %}
        {% if page.cart.lineItems.hasLineItemWithState(PHYSICAL_STATE) %}
            <details {{ vi_attrs('details') }} class="{{ vi_class('details') }}">
                <twig:ViewsTheme:Button
                    class="{{ vi_class('summary') }}"
                    {{ ...vi_attrs('summary').defaults({
                        tag: 'summary',
                        label: 'checkout.shippingCosts'|trans|sw_sanitize,
                        icon: 'caret-down',
                        color: 'secondary',
                        size: 'sm',
                        justify: 'center',
                    }).all() }}
                />

                {% block selection %}
                    <twig:ViewsTheme:Cart:ShippingCalculation:Selection
                        class="{{ vi_class('selection') }}"
                        {{ ...vi_attrs('selection').defaults({
                            page: page,
                            redirectTo: redirectTo,
                        }).all() }}
                    />
                {% endblock %}
            </details>
        {% endif %}
    {% endblock %}
</form>
