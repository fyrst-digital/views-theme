{% props
    redirectTo = 'frontend.cart.offcanvas',
    defaultBaseClasses = 'vi-cart-promotion-form',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set labelAttributes = attributes.nested('label') %}
{% set inputGroupAttributes = attributes.nested('inputGroup') %}
{% set inputAttributes = attributes.nested('input') %}
{% set submitAttributes = attributes.nested('submit') %}

<form
    action="{{ path('frontend.checkout.promotion.add') }}"
    method="post"
    data-ref="promotion-form"
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block redirect %}
        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
    {% endblock %}

    {% block input_group %}
        {% block label %}
            <label
                for="addPromotionOffcanvasCartInput"
                {{ labelAttributes.defaults({
                    class: 'vi-cart-promotion-form__label visually-hidden',
                }) }}
            >
                {{ 'checkout.addPromotionLabel'|trans|sw_sanitize }}
            </label>
        {% endblock %}

        <div
            {{ inputGroupAttributes.defaults({
                class: 'vi-cart-promotion-form__input-group input-group',
            }) }}
        >
            {% block input %}
                <input
                    type="text"
                    name="code"
                    id="addPromotionOffcanvasCartInput"
                    placeholder="{{ 'checkout.addPromotionPlaceholder'|trans|striptags }}"
                    aria-label="{{ 'checkout.addPromotionLabel'|trans|striptags }}"
                    aria-describedby="addPromotionOffcanvasCart"
                    required="required"
                    {{ inputAttributes.defaults({
                        class: 'vi-cart-promotion-form__input form-control',
                    }) }}
                >
            {% endblock %}

            {% block submit %}
                <button
                    type="submit"
                    id="addPromotionOffcanvasCart"
                    {{ submitAttributes.defaults({
                        class: 'vi-cart-promotion-form__submit btn btn-secondary',
                    }) }}
                >
                    {{ vi_icon('ticket') }}
                </button>
            {% endblock %}
        </div>
    {% endblock %}
</form>
