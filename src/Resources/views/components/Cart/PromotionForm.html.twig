{% props
    redirectTo = 'frontend.checkout.cart.page',
    inputId = 'vi-cart-promotion-input-' ~ random(),
    submitId = 'vi-cart-promotion-submit-' ~ random(),
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set submitClass = cx.submit.apply() %}
{% set submitTitle = 'checkout.addPromotionLabel'|trans|striptags %}
{% set parentAttributes = attributes %}

<form
    {{ attributes.defaults({
        action: path('frontend.checkout.promotion.add'),
        method: 'post',
        'data-component': 'ViewsTheme:Cart:PromotionForm',
        'data-component-options': {
            promoteEvent: 'ViewsTheme:Cart:Promote',
        }|json_encode,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block redirect %}
        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
    {% endblock %}

    {% block field %}
        <twig:ViewsTheme:Form:Input:Group
            class="{{ cx.field.apply() }}"
            label:class="visually-hidden"
            {{ ...attributes.nested('field').defaults({
                id: inputId,
                name: 'code',
                label: 'checkout.addPromotionLabel'|trans|sw_sanitize,
                placeholder: 'checkout.addPromotionPlaceholder'|trans|striptags,
                validationRules: 'required',
            }).all() }}
        >
            <twig:block name="append">
                <twig:ViewsTheme:Button
                    class="{{ submitClass }}"
                    {{ ...parentAttributes.nested('submit').defaults({
                        type: 'submit',
                        id: submitId,
                        title: submitTitle,
                        color: 'secondary',
                        icon: 'ticket',
                    }).all() }}
                />
            </twig:block>
        </twig:ViewsTheme:Form:Input:Group>
    {% endblock %}
</form>
