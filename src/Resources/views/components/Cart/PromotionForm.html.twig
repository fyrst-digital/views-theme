{% props
    redirectTo = 'frontend.cart.offcanvas',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<form
    {{ attributes.defaults({
        action: path('frontend.checkout.promotion.add'),
        method: 'post',
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block redirect %}
        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
    {% endblock %}

    {% block input_group %}
        {% block label %}
            <label
                {{ attributes.nested('label').defaults({
                    for: 'addPromotionOffcanvasCartInput',
                }) }}
                class="{{ cx.label.apply() }}"
            >
                {{ 'checkout.addPromotionLabel'|trans|sw_sanitize }}
            </label>
        {% endblock %}

        <div {{ attributes.nested('inputGroup') }} class="{{ cx.inputGroup.apply() }}">
            {% block input %}
                <input
                    {{ attributes.nested('input').defaults({
                        type: 'text',
                        name: 'code',
                        id: 'addPromotionOffcanvasCartInput',
                        placeholder: 'checkout.addPromotionPlaceholder'|trans|striptags,
                        'aria-label': 'checkout.addPromotionLabel'|trans|striptags,
                        'aria-describedby': 'addPromotionOffcanvasCart',
                        required: 'required',
                    }) }}
                    class="{{ cx.input.apply() }}"
                >
            {% endblock %}

            {% block submit %}
                <button
                    {{ attributes.nested('submit').defaults({
                        type: 'submit',
                        id: 'addPromotionOffcanvasCart',
                    }) }}
                    class="{{ cx.submit.apply() }}"
                >
                    {{ vi_icon('ticket') }}
                </button>
            {% endblock %}
        </div>
    {% endblock %}
</form>
