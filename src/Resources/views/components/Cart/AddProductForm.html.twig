{% props
    redirectTo = 'frontend.checkout.cart.page',
    defaultBaseClasses = 'vi-cart-add-product-form add-product-form',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set labelAttributes = attributes.nested('label') %}
{% set inputGroupAttributes = attributes.nested('inputGroup') %}
{% set inputAttributes = attributes.nested('input') %}
{% set submitAttributes = attributes.nested('submit') %}

<form
    action="{{ path('frontend.checkout.product.add-by-number') }}"
    method="post"
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block redirect %}
        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
    {% endblock %}

    {% block label %}
        <label
            for="addProductInput"
            {{ labelAttributes.defaults({
                class: 'vi-cart-add-product-form__label visually-hidden',
            }) }}
        >
            {{ 'checkout.addProductLabel'|trans|sw_sanitize }}
        </label>
    {% endblock %}

    {% block input_group %}
        <div
            {{ inputGroupAttributes.defaults({
                class: 'vi-cart-add-product-form__input-group input-group',
            }) }}
        >
            {% block input %}
                <input
                    type="text"
                    name="number"
                    id="addProductInput"
                    placeholder="{{ 'checkout.addProductPlaceholder'|trans|striptags }}"
                    aria-label="{{ 'checkout.addProductLabel'|trans|striptags }}"
                    aria-describedby="addProductButton"
                    required="required"
                    {{ inputAttributes.defaults({
                        class: 'vi-cart-add-product-form__input form-control',
                    }) }}
                >
            {% endblock %}

            {% block submit %}
                <button
                    type="submit"
                    aria-labelledby="addProductInput"
                    id="addProductButton"
                    {{ submitAttributes.defaults({
                        class: 'vi-cart-add-product-form__submit btn btn-secondary',
                    }) }}
                >
                    {{ vi_icon('plus') }}
                </button>
            {% endblock %}
        </div>
    {% endblock %}
</form>
