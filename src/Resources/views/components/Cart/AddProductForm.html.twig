{% props
    redirectTo = 'frontend.checkout.cart.page',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    label: attributes.nested('label'),
    inputGroup: attributes.nested('inputGroup'),
    input: attributes.nested('input'),
    submit: attributes.nested('submit'),
} %}

<form
    {{ attributes.defaults({
        action: path('frontend.checkout.product.add-by-number'),
        method: 'post',
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block redirect %}
        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
    {% endblock %}

    {% block label %}
        <label
            {{ attrs.label.defaults({
                for: 'addProductInput',
            }) }}
            class="{{ cx.label.apply() }}"
        >
            {{ 'checkout.addProductLabel'|trans|sw_sanitize }}
        </label>
    {% endblock %}

    {% block input_group %}
        <div {{ attrs.inputGroup }} class="{{ cx.inputGroup.apply() }}">
            {% block input %}
                <input
                    {{ attrs.input.defaults({
                        type: 'text',
                        name: 'number',
                        id: 'addProductInput',
                        placeholder: 'checkout.addProductPlaceholder'|trans|striptags,
                        'aria-label': 'checkout.addProductLabel'|trans|striptags,
                        'aria-describedby': 'addProductButton',
                        required: 'required',
                    }) }}
                    class="{{ cx.input.apply() }}"
                >
            {% endblock %}

            {% block submit %}
                <button
                    {{ attrs.submit.defaults({
                        type: 'submit',
                        'aria-labelledby': 'addProductInput',
                        id: 'addProductButton',
                    }) }}
                    class="{{ cx.submit.apply() }}"
                >
                    {{ vi_icon('plus') }}
                </button>
            {% endblock %}
        </div>
    {% endblock %}
</form>
