{% props
    redirectTo = 'frontend.checkout.cart.page',
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-cart-add-product-form add-product-form' },
    label: { base: 'vi-cart-add-product-form__label visually-hidden' },
    inputGroup: { base: 'vi-cart-add-product-form__input-group input-group' },
    input: { base: 'vi-cart-add-product-form__input form-control' },
    submit: { base: 'vi-cart-add-product-form__submit btn btn-secondary' },
}|replace_recursive(cva)) %}

<form
    action="{{ path('frontend.checkout.product.add-by-number') }}"
    method="post"
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block redirect %}
        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
    {% endblock %}

    {% block label %}
        <label
            for="addProductInput"
            {{ attributes.nested('label') }}
            class="{{ cx.label.apply() }}"
        >
            {{ 'checkout.addProductLabel'|trans|sw_sanitize }}
        </label>
    {% endblock %}

    {% block input_group %}
        <div {{ attributes.nested('inputGroup') }} class="{{ cx.inputGroup.apply() }}">
            {% block input %}
                <input
                    type="text"
                    name="number"
                    id="addProductInput"
                    placeholder="{{ 'checkout.addProductPlaceholder'|trans|striptags }}"
                    aria-label="{{ 'checkout.addProductLabel'|trans|striptags }}"
                    aria-describedby="addProductButton"
                    required="required"
                    {{ attributes.nested('input') }}
                    class="{{ cx.input.apply() }}"
                >
            {% endblock %}

            {% block submit %}
                <button
                    type="submit"
                    aria-labelledby="addProductInput"
                    id="addProductButton"
                    {{ attributes.nested('submit') }}
                    class="{{ cx.submit.apply() }}"
                >
                    {{ vi_icon('plus') }}
                </button>
            {% endblock %}
        </div>
    {% endblock %}
</form>
