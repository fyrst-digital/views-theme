{% props
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% set flashes = app.flashes %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Cart:Flashes',
        hidden: flashes is empty,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% for type, messages in flashes %}
            <twig:ViewsTheme:Alert
                :type="type"
                :list="messages"
                announceOnLoad
                :ariaLive="type == 'danger' ? 'assertive' : 'polite'"
            />
        {% endfor %}
    {% endblock %}
</div>
