{% props
    page,
    pageUrl = path('frontend.views-theme.cart.page'),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['flashes', 'heading', 'items', 'aside']) %}

{% set cart = page.cart %}
{% set productsQuantity = cart.lineItems|length %}
{% set isEmpty = productsQuantity < 1 %}
{% set meta = isEmpty ? {} : { items: { label: 'checkout.itemCounter'|trans({'%count%': productsQuantity})|striptags } } %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Cart:Page',
        'data-component-options': {
            pageUrl: pageUrl,
            changedEvent: 'ViewsTheme:Cart:Changed',
            flashesComponent: 'ViewsTheme:Cart:Flashes',
            headingComponent: 'ViewsTheme:Cart:Heading',
            itemsComponent: 'ViewsTheme:LineItems:Table',
            asideComponent: 'ViewsTheme:Cart:Page:Aside',
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block flashes %}
        <twig:ViewsTheme:Cart:Flashes
            class="{{ vi_class('flashes') }}"
            {{ ...vi_attrs('flashes').defaults({
                clientError: true,
            }).all() }}
        />
    {% endblock %}

    {% block heading %}
        <twig:ViewsTheme:Page:Title
            class="{{ vi_class('heading') }}"
            {{ ...vi_attrs('heading').defaults({
                'data-component': 'ViewsTheme:Cart:Heading',
                heading: 'checkout.cartHeader'|trans|striptags,
                meta: meta,
            }).all() }}
        />
    {% endblock %}

    {% block items %}
        <twig:ViewsTheme:LineItems:Table
            class="{{ vi_class('items', { empty: isEmpty }) }}"
            {{ ...vi_attrs('items').defaults({
                cart: cart,
            }).all() }}
        />
    {% endblock %}

    {% block aside %}
        {% if not isEmpty %}
            <twig:ViewsTheme:Cart:Page:Aside
                class="{{ vi_class('aside') }}"
                {{ ...vi_attrs('aside').defaults({
                    page: page,
                }).all() }}
            />
        {% endif %}
    {% endblock %}
</div>
