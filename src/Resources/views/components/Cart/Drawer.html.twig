{% props
    page,
    itemsUrl = path('frontend.views-theme.cart.drawer.items'),
    summaryUrl = path('frontend.views-theme.cart.drawer.summary'),
    headingUrl = path('frontend.views-theme.cart.drawer.heading'),
    label = 'checkout.cartTitle'|trans|striptags,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set cart = page.cart %}
{% set productsQuantity = cart.lineItems|length %}
{% set isEmpty = productsQuantity < 1 %}

<twig:ViewsTheme:Drawer
    class="{{ cx.root.apply() }}"
    {{ ...attributes.defaults({
        id: 'vi-cart-drawer',
        side: 'end',
        label: label,
    }).all() }}
>
    <twig:block name="panel">
        <twig:ViewsTheme:Drawer:Panel
            {{ ...attributes.nested('panel').defaults({
                side: 'end',
            }).all() }}
        >
            <twig:block name="header">
                <twig:ViewsTheme:Drawer:Header>
                    <twig:block name="title">
                        <twig:ViewsTheme:Cart:Drawer:Heading :productsQuantity="productsQuantity" />
                    </twig:block>
                </twig:ViewsTheme:Drawer:Header>
            </twig:block>

            <twig:block name="content">
                <twig:ViewsTheme:Cart:Drawer:Body
                    :page="page"
                    :itemsUrl="itemsUrl"
                    :summaryUrl="summaryUrl"
                    :headingUrl="headingUrl"
                    :isEmpty="isEmpty"
                />
            </twig:block>
        </twig:ViewsTheme:Drawer:Panel>
    </twig:block>
</twig:ViewsTheme:Drawer>
