{% props
    paymentMethods,
    selectedId = context.paymentMethod.id,
    selectedName = context.paymentMethod.translated.name,
    id = 'vi-cart-paymentMethodId',
    size = 'sm',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set selectOptions = [] %}

{% if selectedId not in paymentMethods.ids %}
    {% set selectOptions = selectOptions|merge([{
        value: selectedId,
        label: selectedName ~ ' ' ~ ('checkout.notAvailableSuffix'|trans|sw_sanitize),
        disabled: true,
    }]) %}
{% endif %}

{% for payment in paymentMethods %}
    {% set selectOptions = selectOptions|merge([{
        value: payment.id,
        label: payment.translated.name,
    }]) %}
{% endfor %}

<twig:ViewsTheme:Form:Select
    class="{{ cx.root.apply() }}"
    {{ ...attributes.defaults({
        id: id,
        name: 'paymentMethodId',
        label: 'checkout.paymentMethod'|trans|sw_sanitize,
        size: size,
        options: selectOptions,
        value: selectedId,
    }).all() }}
/>
