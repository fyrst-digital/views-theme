{% props
    label = 'checkout.summaryShipping'|trans|sw_sanitize,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<button
    {{ attributes.defaults({
        type: 'button',
        'data-component': 'ViewsTheme:Cart:ShippingCalculation:Open',
        'data-component-options': {
            shippingCalculationComponentName: 'ViewsTheme:Cart:ShippingCalculation',
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block label %}
        {{ label|raw }}
    {% endblock %}
</button>
