{% props
    shippingMethods,
    selectedId = context.shippingMethod.id,
    selectedName = context.shippingMethod.translated.name,
    id = 'vi-cart-shippingMethodId',
    size = 'sm',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% set selectOptions = [] %}

{% if selectedId not in shippingMethods.ids %}
    {% set selectOptions = selectOptions|merge([{
        value: selectedId,
        label: selectedName ~ ' ' ~ ('checkout.notAvailableSuffix'|trans|sw_sanitize),
        disabled: true,
    }]) %}
{% endif %}

{% for shipping in shippingMethods %}
    {% set selectOptions = selectOptions|merge([{
        value: shipping.id,
        label: shipping.translated.name,
    }]) %}
{% endfor %}

<twig:ViewsTheme:Form:Select
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        id: id,
        name: 'shippingMethodId',
        label: 'checkout.shippingMethod'|trans|sw_sanitize,
        size: size,
        options: selectOptions,
        value: selectedId,
    }).all() }}
/>
