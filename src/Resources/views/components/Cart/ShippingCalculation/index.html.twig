{% props
    page,
    iconOptions = null,
    defaultBaseClasses = 'vi-cart-shipping-calculation shipping-calculation-form',
    defaultVariants = {},
%}

{% set iconOptions = iconOptions|default(themeParameters.icons|default({})) %}
{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set triggerAttributes = attributes.nested('trigger') %}
{% set collapseAttributes = attributes.nested('collapse') %}
{% set selectsAttributes = attributes.nested('selects') %}
{% set formGroupAttributes = attributes.nested('formGroup') %}
{% set labelAttributes = attributes.nested('label') %}
{% set selectAttributes = attributes.nested('select') %}

<form
    name="precalc"
    method="post"
    action="{{ path('frontend.checkout.configure') }}"
    data-form-auto-submit="true"
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block trigger %}
        {% set PHYSICAL_STATE = constant('Shopware\\Core\\Content\\Product\\State::IS_PHYSICAL') %}
        {% if page.cart.lineItems.hasLineItemWithState(PHYSICAL_STATE) %}
            <a
                data-bs-toggle="collapse"
                href="#collapseShippingCost"
                role="button"
                aria-expanded="false"
                aria-controls="collapseExample"
                {{ triggerAttributes.defaults({
                    class: 'vi-cart-shipping-calculation__trigger btn btn-light cart-shipping-costs-btn shipping-calculation-toogle-btn',
                }) }}
            >
                {{ 'checkout.shippingCosts'|trans|sw_sanitize }}
                {{ vi_icon('caret-down', iconOptions) }}
            </a>
        {% endif %}
    {% endblock %}

    {% block form_group %}
        <div
            id="collapseShippingCost"
            {{ collapseAttributes.defaults({
                class: 'vi-cart-shipping-calculation__collapse collapse',
            }) }}
        >
            <div
                {{ selectsAttributes.defaults({
                    class: 'vi-cart-shipping-calculation__selects shipping-calculation-selects',
                }) }}
            >
                {% block country %}
                    {% if not context.customer %}
                        <div
                            {{ formGroupAttributes.defaults({
                                class: 'vi-cart-shipping-calculation__group form-group',
                            }) }}
                        >
                            <label
                                for="countryId"
                                {{ labelAttributes.defaults({ class: 'vi-cart-shipping-calculation__label form-label' }) }}
                            >
                                {{ 'checkout.shippingCountry'|trans|sw_sanitize }}
                            </label>
                            <select
                                type="text"
                                id="countryId"
                                name="countryId"
                                {{ selectAttributes.defaults({
                                    class: 'vi-cart-shipping-calculation__select form-select',
                                }) }}
                            >
                                {% for country in page.countries %}
                                    <option
                                        value="{{ country.id }}"
                                        {{ country.id == context.shippingLocation.country.id ? 'selected="selected"' : '' }}
                                    >
                                        {{ country.translated.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                {% endblock %}

                {% block payment_method %}
                    <div
                        {{ formGroupAttributes.defaults({
                            class: 'vi-cart-shipping-calculation__group form-group',
                        }) }}
                    >
                        <label
                            for="paymentMethodId"
                            {{ labelAttributes.defaults({ class: 'vi-cart-shipping-calculation__label form-label' }) }}
                        >
                            {{ 'checkout.paymentMethod'|trans|sw_sanitize }}
                        </label>
                        <select
                            type="text"
                            id="paymentMethodId"
                            name="paymentMethodId"
                            {{ selectAttributes.defaults({
                                class: 'vi-cart-shipping-calculation__select form-select',
                            }) }}
                        >
                            {% if context.paymentMethod.id not in page.paymentMethods.ids %}
                                <option value="{{ context.paymentMethod.id }}" selected="selected" disabled="disabled">
                                    {{ context.paymentMethod.translated.name }}
                                    {{ 'checkout.notAvailableSuffix'|trans|sw_sanitize }}
                                </option>
                            {% endif %}
                            {% for payment in page.paymentMethods %}
                                <option
                                    value="{{ payment.id }}"
                                    {% if payment.id == context.paymentMethod.id %}selected="selected"{% endif %}
                                >
                                    {{ payment.translated.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                {% endblock %}

                {% block shipping_method %}
                    <div
                        {{ formGroupAttributes.defaults({
                            class: 'vi-cart-shipping-calculation__group form-group',
                        }) }}
                    >
                        <label
                            for="shippingMethodId"
                            {{ labelAttributes.defaults({ class: 'vi-cart-shipping-calculation__label form-label' }) }}
                        >
                            {{ 'checkout.shippingMethod'|trans|sw_sanitize }}
                        </label>
                        <select
                            type="text"
                            id="shippingMethodId"
                            name="shippingMethodId"
                            {{ selectAttributes.defaults({
                                class: 'vi-cart-shipping-calculation__select form-select',
                            }) }}
                        >
                            {% if context.shippingMethod.id not in page.shippingMethods.ids %}
                                <option value="{{ context.shippingMethod.id }}" selected="selected" disabled="disabled">
                                    {{ context.shippingMethod.translated.name }}
                                    {{ 'checkout.notAvailableSuffix'|trans|sw_sanitize }}
                                </option>
                            {% endif %}
                            {% for shipping in page.shippingMethods %}
                                <option
                                    value="{{ shipping.id }}"
                                    {% if shipping.id == context.shippingMethod.id %}selected="selected"{% endif %}
                                >
                                    {{ shipping.translated.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                {% endblock %}

                <input type="hidden" name="redirectTo" value="frontend.checkout.cart.page">
            </div>
        </div>
    {% endblock %}
</form>
