{% props
    countries,
    selectedId = context.shippingLocation.country.id,
    id = 'vi-cart-countryId',
    size = 'sm',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% set selectOptions = [] %}

{% for country in countries %}
    {% set selectOptions = selectOptions|merge([{
        value: country.id,
        label: country.translated.name,
    }]) %}
{% endfor %}

{% if not context.customer %}
    <twig:ViewsTheme:Form:Select
        class="{{ vi_class('root') }}"
        {{ ...attributes.defaults({
            id: id,
            name: 'countryId',
            label: 'checkout.shippingCountry'|trans|sw_sanitize,
            size: size,
            options: selectOptions,
            value: selectedId,
        }).all() }}
    />
{% endif %}
