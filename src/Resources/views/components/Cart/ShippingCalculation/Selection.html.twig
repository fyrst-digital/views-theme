{% props
    page,
    redirectTo = 'frontend.checkout.cart.page',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    country: attributes.nested('country'),
    payment: attributes.nested('payment'),
    shipping: attributes.nested('shipping'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block country %}
        <twig:ViewsTheme:Cart:ShippingCalculation:Country
            class="{{ cx.country.apply() }}"
            {{ ...attrs.country.defaults({
                countries: page.countries,
                size: 'sm',
            }).all() }}
        />
    {% endblock %}

    {% block payment_method %}
        <twig:ViewsTheme:Cart:ShippingCalculation:PaymentMethod
            class="{{ cx.payment.apply() }}"
            {{ ...attrs.payment.defaults({
                paymentMethods: page.paymentMethods,
                size: 'sm',
            }).all() }}
        />
    {% endblock %}

    {% block shipping_method %}
        <twig:ViewsTheme:Cart:ShippingCalculation:ShippingMethod
            class="{{ cx.shipping.apply() }}"
            {{ ...attrs.shipping.defaults({
                shippingMethods: page.shippingMethods,
                size: 'sm',
            }).all() }}
        />
    {% endblock %}

    <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
</div>
