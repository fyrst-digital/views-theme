{% props
    summary,
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'fs-5' },
    label: { base: 'fw-medium text-muted' },
    value: { base: 'fw-semibold' },
}|replace_recursive(cva)) %}

<twig:ViewsTheme:Cart:Summary:Item
    class="{{ vi_class('root') }}"
    label:class="{{ vi_class('label') }}"
    value:class="{{ vi_class('value') }}"
    {{ ...attributes.defaults({
        label: 'checkout.subtotalAmount'|trans|sw_sanitize,
        value: summary.price.positionPrice|currency,
    }).all() }}
/>
