{% props
    label,
    value,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<dl
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block label %}
        <dt {{ attributes.nested('label') }} class="{{ cx.label.apply() }}">
            {{ label|raw }}
        </dt>
    {% endblock %}

    {% block value %}
        <dd {{ attributes.nested('value') }} class="{{ cx.value.apply() }}">
            {{ value }}
        </dd>
    {% endblock %}
</dl>
