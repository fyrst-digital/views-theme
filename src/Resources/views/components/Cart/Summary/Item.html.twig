{% props
    label,
    value,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['label', 'value']) %}

<dl
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block label %}
        <dt {{ vi_attrs('label') }} class="{{ vi_class('label') }}">
            {{ label|raw }}
        </dt>
    {% endblock %}

    {% block value %}
        <dd {{ vi_attrs('value') }} class="{{ vi_class('value') }}">
            {{ value }}
        </dd>
    {% endblock %}
</dl>
