{% props
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['cart', 'checkout']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% block cart %}
            <twig:ViewsTheme:Cart:Action:Cart
                class="{{ vi_class('cart') }}"
                {{ ...vi_attrs('cart').defaults({
                    color: 'white',
                }).all() }}
            />
        {% endblock %}

        {% block checkout %}
            <twig:ViewsTheme:Cart:Action:Checkout
                class="{{ vi_class('checkout') }}"
                {{ ...vi_attrs('checkout').defaults({}).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
