{% props
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    cart: attributes.nested('cart'),
    checkout: attributes.nested('checkout'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        {% block cart %}
            <twig:ViewsTheme:Cart:Action:Cart
                class="{{ cx.cart.apply() }}"
                {{ ...attrs.cart.defaults({
                    color: 'white',
                }).all() }}
            />
        {% endblock %}

        {% block checkout %}
            <twig:ViewsTheme:Cart:Action:Checkout
                class="{{ cx.checkout.apply() }}"
                {{ ...attrs.checkout.defaults({}).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
