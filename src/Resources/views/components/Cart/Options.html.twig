{% props
    page,
    redirectTo = 'frontend.checkout.cart.page',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    shipping: attributes.nested('shipping'),
    promotion: attributes.nested('promotion'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        {% block shipping %}
            <twig:ViewsTheme:Cart:ShippingCalculation
                class="{{ cx.shipping.apply() }}"
                {{ ...attrs.shipping.defaults({
                    page: page,
                    redirectTo: redirectTo,
                }).all() }}
            />
        {% endblock %}

        {% block promotion %}
            <twig:ViewsTheme:Cart:PromotionForm
                class="{{ cx.promotion.apply() }}"
                {{ ...attrs.promotion.defaults({
                    redirectTo: redirectTo,
                }).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
