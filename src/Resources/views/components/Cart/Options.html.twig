{% props
    page,
    redirectTo = 'frontend.checkout.cart.page',
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['shipping', 'promotion']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% block shipping %}
            <twig:ViewsTheme:Cart:ShippingCalculation
                class="{{ vi_class('shipping') }}"
                {{ ...vi_attrs('shipping').defaults({
                    page: page,
                    redirectTo: redirectTo,
                }).all() }}
            />
        {% endblock %}

        {% block promotion %}
            <twig:ViewsTheme:Cart:PromotionForm
                class="{{ vi_class('promotion') }}"
                {{ ...vi_attrs('promotion').defaults({
                    redirectTo: redirectTo,
                }).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
