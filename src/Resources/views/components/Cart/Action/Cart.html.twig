{% props
    href = path('frontend.checkout.cart.page'),
    label = 'viewsTheme.cart.cart'|trans|sw_sanitize,
    title = 'viewsTheme.cart.cart'|trans|striptags,
    # Button color, see Button.html.twig
    color = 'light',
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% block content %}
    <twig:ViewsTheme:Button
        class="{{ vi_class('root') }}"
        {{ ...attributes.defaults({
            type: 'link',
            href: href,
            label: label,
            title: title,
            color: color,
        }).all() }}
    />
{% endblock %}
