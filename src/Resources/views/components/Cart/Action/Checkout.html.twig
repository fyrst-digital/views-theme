{% props
    href = path('frontend.checkout.confirm.page'),
    label = 'viewsTheme.cart.checkout'|trans|sw_sanitize,
    title = 'viewsTheme.cart.checkout'|trans|striptags,
    color = 'primary',
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% block content %}
    <twig:ViewsTheme:Button
        class="{{ vi_class('root') }}"
        {{ ...attributes.defaults({
            type: 'link',
            href: href,
            label: label,
            title: title,
            color: color,
        }).all() }}
    />
{% endblock %}
