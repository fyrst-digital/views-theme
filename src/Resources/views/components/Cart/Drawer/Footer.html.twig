{% props
    page,
    cva = {},
%}

{% do vi_define_cva(cva, ['label', 'root', 'summary', 'summaryNote']) %}
{% set cart = page.cart %}
{% do vi_define_attrs(['label', 'summaryNote']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Cart:Drawer:Footer',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block summary %}
        <div class="{{ vi_class('summary') }}">
            <twig:ViewsTheme:Cart:Summary 
                :summary="cart"
                :showGrandTotal="false"
                :showNetTotal="false"
                :showTax="false">
                <twig:block name="total">
                    {% if showTotal is not same as(false) %}
                        <twig:ViewsTheme:Cart:Summary:Item
                            label="{{ 'checkout.subtotalAmount'|trans|sw_sanitize }}"
                            value="{{ summary.price.positionPrice|currency }}"
                            class="fs-4"
                            label:class="fw-semibold"
                            value:class="fw-semibold"
                        />
                    {% endif %}
                </twig:block>
                <twig:block name="shippings">
                    {% if summary.deliveries is defined and showShipping is not same as(false) %}
                        {% for delivery in summary.deliveries %}
                            <twig:ViewsTheme:Cart:Summary:Item
                                label="{{ 'checkout.summaryShipping'|trans|sw_sanitize }}"
                                value="{{ delivery.shippingCosts.totalPrice|currency }}"
                                class="fs-5"
                                label:class="fw-medium"
                                value:class="fw-medium"
                            >
                                <twig:block name="label">
                                    <dt {{ vi_attrs('label') }} class="{{ vi_class('label') }}">
                                        <twig:ViewsTheme:Cart:ShippingCalculation:Open
                                            label="{{ 'checkout.summaryShipping'|trans|sw_sanitize }}"
                                        />
                                    </dt>
                                </twig:block>
                            </twig:ViewsTheme:Cart:Summary:Item>
                        {% endfor %}
                    {% endif %}
                </twig:block>
            </twig:ViewsTheme:Cart:Summary>

            <div
                {{ vi_attrs('summaryNote').defaults({}) }}
                class="{{ vi_class('summaryNote') }}">
                {{ 'viewsTheme.cart.summaryNote'|trans|sw_sanitize }}
                {% if summary.price.taxStatus == 'gross' %}
                    {{ 'general.grossTaxInformation'|trans|sw_sanitize }}
                {% else %}
                    {{ 'general.netTaxInformation'|trans|sw_sanitize }}
                {% endif %}
            </div>
        </div>
    {% endblock %}

    {% block options %}
        <twig:ViewsTheme:Cart:Options 
            :page="page" />
    {% endblock %}

    {% block actions %}
        <twig:ViewsTheme:Cart:Actions />
    {% endblock %}
</div>
