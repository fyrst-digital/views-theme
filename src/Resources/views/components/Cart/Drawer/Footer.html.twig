{% props
    page,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set cart = page.cart %}
{% set isEmpty = cart.lineItems|length < 1 %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Cart:Drawer:Footer',
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% if not isEmpty %}
        {% block summary %}
            <twig:ViewsTheme:Cart:Summary :summary="cart" />
        {% endblock %}

        {% block options %}
            <twig:ViewsTheme:Cart:Options :page="page" />
        {% endblock %}

        {% block actions %}
            <twig:ViewsTheme:Cart:Actions />
        {% endblock %}
    {% endif %}
</div>
