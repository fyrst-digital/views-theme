{% props
    cart,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['empty', 'list']) %}

{% set isEmpty = cart.lineItems|length < 1 %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Cart:Drawer:Items',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% if isEmpty %}
        {% block empty %}
            <twig:ViewsTheme:Cart:Empty
                {{ ...vi_attrs('empty').all() }}
            />
        {% endblock %}
    {% else %}
        {% block list %}
            <ul {{ vi_attrs('list') }} class="{{ vi_class('list') }}">
                {% for lineItem in cart.lineItems %}
                    <twig:ViewsTheme:LineItem
                        :lineItem="lineItem"
                        :deliveries="cart.deliveries"
                        :showRemoveButton="true"
                        class="{{ vi_class('item') }}"
                    />
                {% endfor %}
            </ul>
        {% endblock %}
    {% endif %}
</div>
