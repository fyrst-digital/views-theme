{% props
    size = 'md', # md
    drawerUrl = path('frontend.views-theme.cart.drawer'),
    templateId = 'vi-cart-drawer-template',
    openOnActions = ['add'],
    count = context.extensions.cart.lineItems|default([])|length,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<twig:ViewsTheme:Button
    class="{{ vi_class('root', { size: size }) }}"
    {{ ...attributes.defaults({
        type: 'button',
        icon: 'handbag',
        color: 'none',
        size: size,
        title: 'checkout.cartTitle'|trans|striptags,
        'aria-label': 'checkout.cartTitle'|trans|striptags,
        'aria-haspopup': 'dialog',
        'aria-controls': 'vi-cart-drawer',
        'aria-expanded': 'false',
        'data-component': 'ViewsTheme:Cart:Drawer:Action',
        'data-component-options': {
            templateId: templateId,
            openOnActions: openOnActions,
            changedEvent: 'ViewsTheme:Cart:Changed',
        }|json_encode,
    }).all() }}
>
    <twig:block name="prepend">
        <twig:ViewsTheme:Count
            class="vi-cart-drawer-action__badge"
            :count="count"
            changedEvent="ViewsTheme:Cart:Changed"
            countKey="cartCount"
        />
    </twig:block>
</twig:ViewsTheme:Button>

{# Data-free drawer shell: the Action clones it on open; Body shows the loader and fetches the cart #}
<template id="{{ templateId }}">
    <twig:ViewsTheme:Cart:Drawer :drawerUrl="drawerUrl" />
</template>
