{% props
    count = 0,
    changedEvent = 'ViewsTheme:Cart:Changed',
    cva = {},
%}

{% do vi_define_cva(cva) %}

<span
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Cart:Drawer:Action:Badge',
        'data-component-options': {
            changedEvent: changedEvent,
        }|json_encode,
        hidden: count < 1,
    }) }}
    class="{{ vi_class('root') }}"
>{% if count > 0 %}{{ count }}{% endif %}</span>
