{% props
    page = null, # null → pending: loader, then JS fetches drawerUrl and fills the body
    drawerUrl = path('frontend.views-theme.cart.drawer'),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['alert', 'flashes', 'items', 'shipping', 'loading', 'spinner']) %}

{% set pending = page is null %}
{% set cart = pending ? null : page.cart %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Cart:Drawer:Body',
        'data-component-options': {
            drawerUrl: drawerUrl,
            changedEvent: 'ViewsTheme:Cart:Changed',
            flashesComponent: 'ViewsTheme:Cart:Flashes',
            headingComponent: 'ViewsTheme:Cart:Drawer:Heading',
            itemsComponent: 'ViewsTheme:Cart:Items',
            shippingComponent: 'ViewsTheme:Cart:Shipping',
            footerComponent: 'ViewsTheme:Cart:Drawer:Footer',
            drawerSelector: '#vi-cart-drawer',
            bodyComponent: 'ViewsTheme:Cart:Drawer:Body',
            pending: pending,
        }|json_encode,
        'aria-busy': pending ? 'true' : false,
    }) }}
    class="{{ vi_class('root') }}"
>
    {# Flashes consume the session bag: never in the pending shell, which ships with every page #}
    {% if not pending %}
        {% block flashes %}
            <twig:ViewsTheme:Cart:Flashes
                class="{{ vi_class('flashes') }}"
                {{ ...vi_attrs('flashes').all() }}
            />
        {% endblock %}
    {% endif %}

    {% block alert %}
        <div
            {{ vi_attrs('alert').defaults({
                role: 'alert',
                hidden: true,
                'data-fallback': 'error.message-default'|trans|striptags,
            }) }}
            class="{{ vi_class('alert') }}"
        ></div>
    {% endblock %}

    {% if pending %}
        {% block loading %}
            <div
                {{ vi_attrs('loading') }}
                class="{{ vi_class('loading') }}"
            >
                <twig:ViewsTheme:Spinner {{ ...vi_attrs('spinner').all() }} />
            </div>
        {% endblock %}
    {% else %}
    {% block content %}
        <twig:ViewsTheme:Cart:Items
            class="{{ vi_class('items') }}"
            {{ ...vi_attrs('items').defaults({
                cart: cart,
                layout: 'stacked',
            }).all() }}
        />
    {% endblock %}

    {% block shipping %}
        {% if config('ViewsTheme.config.checkoutShippingCalculationActive') %}
            <twig:ViewsTheme:Cart:Shipping
                {{ ...vi_attrs('shipping').defaults({
                    page: page,
                    cva: {
                        root: { base: 'vi-cart-shipping d-flex flex-column gap-4 min-w-0 overflow-clip bg-white p-4 flex-shrink-0' },
                    },
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block footer %}
        {% if cart.lineItems|length >= 1 %}
            <twig:ViewsTheme:Cart:Drawer:Footer :page="page" />
        {% endif %}
    {% endblock %}
    {% endif %}
</div>
