{% props
    productsQuantity = 0,
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-cart-drawer-header btn offcanvas-close js-offcanvas-close' },
    content: { base: 'vi-cart-drawer-header__content' },
    quantity: { base: 'vi-cart-drawer-header__quantity badge rounded-pill text-bg-light' },
}|replace_recursive(cva)) %}

<button
    type="button"
    data-ref="drawer-header"
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        <div {{ attributes.nested('content') }} class="{{ cx.content.apply() }}">
            {% block title %}
                <span>{{ 'checkout.cartHeader'|trans|sw_sanitize }}</span>
            {% endblock %}

            {% block quantity %}
                {% if productsQuantity > 0 %}
                    <span {{ attributes.nested('quantity') }} class="{{ cx.quantity.apply() }}">
                        {{ 'checkout.itemCounter'|trans({'%count%': productsQuantity})|sw_sanitize }}
                    </span>
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}

    {% block close_icon %}
        {{ vi_icon('x') }}
    {% endblock %}
</button>
