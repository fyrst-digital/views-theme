{% props
    productsQuantity = 0,
    countDisplay = 'badge',
    titleTag = 'div',
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-cart-heading cart-heading d-flex flex-row flex-wrap' },
    title: { base: 'vi-cart-heading__title cart-heading-title' },
    countBadge: { base: 'vi-cart-heading__count-badge cart-heading-products badge rounded-pill text-bg-light' },
    countInline: { base: 'vi-cart-heading__count-inline' },
}|replace_recursive(cva)) %}

{% set attrs = {
    title: attributes.nested('title'),
    countInline: attributes.nested('countInline'),
    countBadge: attributes.nested('countBadge'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block title %}
        <{{ titleTag|raw }}
            {{ attrs.title }}
            class="{{ cx.title.apply() }}"
        >
            {{ 'checkout.cartHeader'|trans|sw_sanitize }}
            {% if productsQuantity > 0 and countDisplay is same as('inline') %}
                <span {{ attrs.countInline }} class="{{ cx.countInline.apply() }}">
                    ({{ 'checkout.itemCounter'|trans({'%count%': productsQuantity})|sw_sanitize }})
                </span>
            {% endif %}
        </{{ titleTag|raw }}>
    {% endblock %}

    {% block products %}
        {% if productsQuantity > 0 and countDisplay is same as('badge') %}
            <span {{ attrs.countBadge }} class="{{ cx.countBadge.apply() }}">
                {{ 'checkout.itemCounter'|trans({'%count%': productsQuantity})|sw_sanitize }}
            </span>
        {% endif %}
    {% endblock %}
</div>
