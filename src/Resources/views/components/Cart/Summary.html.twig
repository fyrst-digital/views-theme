{% props
    summary,
    showTotal = true,
    showShipping = true,
    showGrandTotal = true,
    showNetTotal = true,
    showTax = true,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['total', 'shipping', 'divider', 'grand', 'net', 'tax']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% block prepend %}{% endblock %}

        {% block total %}
            {% if showTotal is not same as(false) %}
                <twig:ViewsTheme:Cart:Summary:Total
                    {{ ...vi_attrs('total').defaults({
                        summary: summary,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block shippings %}
            {% if summary.deliveries is defined and showShipping is not same as(false) %}
                {% for delivery in summary.deliveries %}
                    <twig:ViewsTheme:Cart:Summary:Shipping
                        {{ ...vi_attrs('shipping').all() }}
                        :delivery="delivery"
                    />
                {% endfor %}
            {% endif %}
        {% endblock %}

        {% block grand_total %}
            {% if showGrandTotal is not same as(false) %}
                {% block grand_total_divider %}
                    <twig:ViewsTheme:Divider
                        class="{{ vi_class('divider') }}"
                        {{ ...vi_attrs('divider').all() }}
                    />
                {% endblock %}
                <twig:ViewsTheme:Cart:Summary:GrandTotal
                    {{ ...vi_attrs('grand').defaults({
                        summary: summary,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block net_total %}
            {% if showNetTotal is not same as(false) %}
                <twig:ViewsTheme:Cart:Summary:NetTotal
                    {{ ...vi_attrs('net').defaults({
                        summary: summary,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block taxes %}
            {% if showTax is not same as(false) %}
                {% set taxes = summary.price.calculatedTaxes %}
                {% if taxes is empty %}
                    {% set taxes = [{ taxRate: 0, tax: 0 }] %}
                {% endif %}
                {% for taxItem in taxes %}
                    <twig:ViewsTheme:Cart:Summary:Tax
                        {{ ...vi_attrs('tax').all() }}
                        :taxItem="taxItem"
                    />
                {% endfor %}
            {% endif %}
        {% endblock %}

        {% block append %}{% endblock %}
    {% endblock %}
</div>
