{% props
    summary,
    showTotal = true,
    showShipping = true,
    showGrandTotal = true,
    showNetTotal = true,
    showTax = true,
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-cart-summary cart-summary' },
    list: { base: 'vi-cart-summary__list cart-summary-list' },
}|replace_recursive(cva)) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block list %}
        <div
            {{ attributes.nested('list') }}
            class="{{ cx.list.apply() }}"
        >
            {% block total %}
                {% if showTotal is not same as(false) %}
                    <twig:ViewsTheme:Cart:SummaryItem
                        label="{{ 'checkout.subtotalAmount'|trans|sw_sanitize }}"
                        value="{{ summary.price.positionPrice|currency }}"
                        class="summary-item-total"
                    />
                {% endif %}
            {% endblock %}

            {% block shippings %}
                {% if summary.deliveries is defined and showShipping is not same as(false) %}
                    {% for delivery in summary.deliveries %}
                        <twig:ViewsTheme:Cart:SummaryItem
                            label="{{ 'checkout.summaryShipping'|trans|sw_sanitize }}"
                            value="{{ delivery.shippingCosts.totalPrice|currency }}"
                            class="summary-item-shipping"
                        />
                    {% endfor %}
                {% endif %}
            {% endblock %}

            {% block grand_total %}
                {% if showGrandTotal is not same as(false) %}
                    <twig:ViewsTheme:Cart:SummaryItem
                        label="{{ 'checkout.summaryTotalPrice'|trans|sw_sanitize }}"
                        value="{{ summary.price.totalPrice|currency }}"
                        class="summary-item-grand-total"
                    />
                {% endif %}
            {% endblock %}

            {% block net_total %}
                {% if showNetTotal is not same as(false) %}
                    <twig:ViewsTheme:Cart:SummaryItem
                        label="{{ 'checkout.summaryNetPrice'|trans|sw_sanitize }}"
                        value="{{ summary.price.netPrice|currency }}"
                        class="summary-item-net-total"
                    />
                {% endif %}
            {% endblock %}

            {% block taxes %}
                {% if showTax is not same as(false) %}
                    {% for taxItem in summary.price.calculatedTaxes %}
                        <twig:ViewsTheme:Cart:SummaryItem
                            label="{{ 'checkout.summaryTax'|trans({ '%rate%': taxItem.taxRate })|sw_sanitize }}"
                            value="{{ taxItem.tax|currency }}"
                            class="summary-item-tax-total"
                        />
                    {% endfor %}
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}
</div>
