{%
  set classes = vi_define_classes({
    main: [
      'd-flex',
      'flex-wrap',
      'align-items-center',
      'gap-3',
      'py-3',
      'z-5',
    ],
    menu: [
      'col',
      'd-flex',
      'justify-content-start',
      'align-items-center',
    ],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_header_main %}
  <div
    {{ classes.main | vi_attr_classes }}
    data-component="header-main">
    {% block component_header_main_menu %}
      <div
        {{ classes.container | vi_attr_classes }}
        data-component="header-menu">
        {% sw_include '@Storefront/components/header/action/menu.html.twig' %}
      </div>
    {% endblock %}

    {% block component_header_main_logo %}
      {% sw_include '@Storefront/components/header/logo.html.twig' %}
    {% endblock %}

    {% block component_header_main_actions %}
      {% sw_include '@Storefront/components/header/actions.html.twig' %}
    {% endblock %}

    {% block component_header_main_search %}
      {% sw_include '@Storefront/components/header/search.html.twig' %}
    {% endblock %}
  </div>
{% endblock %}
