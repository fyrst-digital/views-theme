{% import '@ViewsTheme/components/icon/icon.html.twig' as Icon %}

{%
  set classes = vi_define_classes({
    container: [
      'col',
      'd-flex',
      'justify-content-start',
      'align-items-center',
    ],
    menu: [
      'btn',
      'btn-equal',
    ],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_header_menu %}
  <div
    {{ classes.container | vi_attr_classes }}
    data-component="header-menu">
    <button
      {{ classes.menu | vi_attr_classes }}
      type="button"
      data-off-canvas-menu="true"
      data-component="header-action-menu"
      aria-label="{{ 'general.menuLink'|trans|striptags }}">
      {{ Icon.render('list', iconStyle) }}
    </button>
  </div>
{% endblock %}
