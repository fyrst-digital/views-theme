{%
  set classes = vi_define_classes({
    actions: [
      'col',
      'd-flex',
      'justify-content-end',
      'align-items-center',
    ],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_header_actions %}
  <div
    {{ classes.actions | vi_attr_classes }}
    data-component="header-actions">
    {% block component_header_actions_start %}{% endblock %}
    {% block component_header_actions_cart %}
      {%
        sw_include '@Storefront/components/header/action/cart.html.twig' with {
          classes: {
            action: ['btn', 'btn-equal', 'rounded-pill']
          }
        }
      %}
    {% endblock %}
    {% block component_header_actions_end %}{% endblock %}
  </div>
{% endblock %}
