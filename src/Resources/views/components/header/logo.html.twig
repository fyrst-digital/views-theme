{%
  set classes = vi_define_classes({
    logo: [
      'col-auto',
      'd-inline-flex'
    ],
    logoText: [],
    logoImage: [],
  }, classes|default({}), replaceClasses|default(false))
%}

{% set element = element|default('a') %}
{% set textLogo = textLogo|default(null) %}

{% block component_header_logo %}
  <{{ element|raw }}
    {% if element is same as('a') %}
      href="{{ path('frontend.home.page') }}"
      title="{{ 'header.logoLink'|trans|striptags }}"
    {% endif %}
    {{ classes.logo | vi_attr_classes }}
    data-component="header-logo">
    {% if textLogo is not empty %}
      {% block component_header_logo_text %}
        <span
          {{ classes.logoText | vi_attr_classes }}>
          {{ textLogo | raw }}
        </span>
      {% endblock %}
    {% else %}
      {% block component_header_logo_image %}
        <picture style="display: contents;">
          {% block component_header_logo_image_tablet %}
            {% if theme_config('sw-logo-tablet') and theme_config('sw-logo-tablet') != theme_config('sw-logo-desktop') %}
              <source
                srcset="{{ theme_config('sw-logo-tablet')|sw_encode_url }}"
                media="(min-width: {{ theme_config('breakpoint.md') }}px) and (max-width: {{ theme_config('breakpoint.lg') - 1 }}px)">
            {% endif %}
          {% endblock %}

          {% block component_header_logo_image_mobile %}
            {% if theme_config('sw-logo-mobile') and theme_config('sw-logo-mobile') != theme_config('sw-logo-desktop') %}
              <source
                srcset="{{ theme_config('sw-logo-mobile')|sw_encode_url }}"
                media="(max-width: {{ theme_config('breakpoint.md') - 1 }}px)">
            {% endif %}
          {% endblock %}

          {% block component_header_logo_image_default %}
            {% if theme_config('sw-logo-desktop') %}
              <img
                src="{{ theme_config('sw-logo-desktop')|sw_encode_url }}"
                alt="{{ 'header.logoLink'|trans|striptags }}"
                {{ classes.logoImage | vi_attr_classes }}>
            {% endif %}
          {% endblock %}
        </picture>
      {% endblock %}
    {% endif %}
  </{{ element|raw }}>
{% endblock %}
