{% sw_extends '@Storefront/storefront/layout/header/search.html.twig' %}

{%
  set classes = vi_define_classes({
    collapse: ['collapse', 'header-search-collapse', 'd-flex', 'flex-row', 'flex-wrap', 'align-items-center'],
    search: ['header-search'],
    form: ['header-search-form'],
    container: ['header-search-container', 'd-flex', 'flex-row', 'flex-wrap', 'gap-2'],
    inputGroup: ['input-group', 'header-search-input-group'],
    input: ['form-control', 'header-search-input'],
    submitButton: ['btn', 'header-search-btn'],
    closeButton: ['btn', 'header-search-close'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block layout_header_search %}
    <div {{ classes.collapse | vi_attr_classes }}
        id="searchCollapse">

        <div {{ classes.search | vi_attr_classes }}>

            {% block layout_header_search_form %}
                <form action="{{ path('frontend.search.page') }}"
                    method="get"
                    data-search-widget="true"
                    data-search-widget-options="{{ searchWidgetOptions|json_encode }}"
                    data-url="{{ path('frontend.search.suggest') }}?search="
                    {{ classes.form | vi_attr_classes }}>

                    <div {{ classes.container | vi_attr_classes }}>
                        {% block layout_header_search_input_group %}
                            <div {{ classes.inputGroup | vi_attr_classes }}>
                                {% block layout_header_search_input %}
                                    <input type="search"
                                        name="search"
                                        {{ classes.input | vi_attr_classes }}
                                        autocomplete="off"
                                        autocapitalize="off"
                                        placeholder="{{ 'header.searchPlaceholder'|trans|striptags }}"
                                        aria-label="{{ 'header.searchPlaceholder'|trans|striptags }}"
                                        value="{{ page.searchTerm }}">
                                {% endblock %}

                                {% block layout_header_search_button %}
                                    <button type="submit"
                                        {{ classes.submitButton | vi_attr_classes }}
                                        aria-label="{{ 'header.searchButton'|trans|striptags }}">
                                        {% block layout_header_search_button_icon %}
                                            {{vi_icon('magnifying-glass')}}
                                        {% endblock %}
                                    </button>
                                {% endblock %}
                            </div>
                        {% endblock %}

                        {% block layout_header_search_close %}
                            <button {{ classes.closeButton | vi_attr_classes }}
                                data-header-search="close">
                                {% block layout_header_search_close_icon %}
                                    {{vi_icon('x')}}
                                {% endblock %}
                            </button>
                        {% endblock %}
                    </div>

                </form>
            {% endblock %}
        </div>
    </div>
{% endblock %}
