{% set iconOptions = iconOptions|default(themeParameters.icons) %}
{%
  set wishlistStorageOptions = {
      listPath: path('frontend.wishlist.product.list'),
      mergePath: path('frontend.wishlist.product.merge'),
      pageletPath: path('frontend.wishlist.product.merge.pagelet'),
  }
%}
{% set wishlistWidgetOptions = { showCounter: showCounter } %}
{%
  set classes = vi_define_classes({
    action: [],
    badge: ['badge', 'bg-primary', 'header-wishlist-badge'],
    srOnly: ['visually-hidden'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_header_action_wishlist %}
  <a
    {{ classes.action | vi_attr_classes }}
    data-component="header-action-wishlist"
    href="{{ path('frontend.wishlist.page') }}"
    title="{{ 'header.wishlist'|trans|striptags }}"
    aria-labelledby="wishlist-basket-live-area">
    {% block component_header_action_wishlist_badge %}
      <span
        {{ classes.badge | vi_attr_classes }}
        id="wishlist-basket"
        data-wishlist-storage="true"
        data-wishlist-storage-options="{{ wishlistStorageOptions|json_encode }}"
        data-wishlist-widget="true"
        data-wishlist-widget-options="{{ wishlistWidgetOptions|json_encode }}"></span>
    {% endblock %}
    {% block component_header_action_wishlist_icon %}
      {{ vi_icon('heart', iconOptions) }}
    {% endblock %}
    {% block component_header_action_wishlist_live_region %}
      <span
        {{ classes.srOnly | vi_attr_classes }}
        id="wishlist-basket-live-area"
        data-wishlist-live-area-text="{{ 'header.wishlistAriaLiveTemplate'|trans }}"
        aria-live="polite"></span>
    {% endblock %}
  </a>
{% endblock %}
