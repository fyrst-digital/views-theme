{% set iconOptions = iconOptions|default(themeParameters.icons) %}

{%
  set classes = vi_define_classes({
    main: ['dropdown'],
    action: [],
    dropdown: {},
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_header_action_account %}
  <div {{ classes.main | vi_attr_classes }}>
    {% block component_header_action_account_toggle %}
      <button
        {{ classes.action | vi_attr_classes }}
        type="button"
        id="accountWidget"
        data-component="header-action-account"
        data-bs-toggle="dropdown"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="{{ 'account.myAccount'|trans|striptags }}"
        title="{{ 'account.myAccount'|trans|striptags }}">
        {{ vi_icon('user', iconOptions) }}
      </button>
    {% endblock %}

    {% block component_header_action_account_dropdown %}
      {%
        sw_include '@Storefront/components/account/dropdown.html.twig' with {
          classes: classes.dropdown
        }
      %}
    {% endblock %}
  </div>
{% endblock %}
