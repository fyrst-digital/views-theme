{% props
    role = null,
    gap = false,
    columns = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<div
    {{ attributes.defaults({
        role: role,
    }) }}
    class="{{ vi_class('root', { gap: gap }|merge(columns is null ? {} : { columns: columns })) }}"
>

    {% block content %}{% endblock %}
</div>
