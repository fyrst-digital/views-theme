{% props
    role = null,
    gap = false, # false | sm | md | lg | custom
    # 1 | 1-sm:3 | 1-md:2 | 1-md:6 | 1-md:12 | 1-md:12-lg:1 | 1-xl:6 | 1-lg:8 | 1-lg:12 | custom
    columns = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<div
    {{ attributes.defaults({
        role: role ?: false,
    }) }}
    class="{{ vi_class('root', { gap: gap }|merge(columns is null ? {} : { columns: columns })) }}"
>

    {% block content %}{% endblock %}
</div>
