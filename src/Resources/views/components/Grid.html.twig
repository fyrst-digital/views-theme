{% props
    role = null,
    gap = false,
    columns = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<div
    {{ attributes.defaults({
        role: role,
        style: columns is not empty ? '--vi-grid-cols: ' ~ columns : false,
    }) }}
    class="{{ vi_class('root', { gap: gap }) }}"
>

    {% block content %}{% endblock %}
</div>
