{% props
    type = 'info',
    dismissible = false,
    heading = null,
    content = null,
    list = [],
    icon = true,
    announceOnLoad = false,
    ariaLive = 'polite',
    cva = {},
%}

{% if type is same as('error') %}
    {% set type = 'danger' %}
{% endif %}

{% set cx = vi_cva_from_file(cva) %}

{% set iconAttributes = attributes.nested('icon') %}
{% set contentAttributes = attributes.nested('content') %}
{% set headingAttributes = attributes.nested('heading') %}
{% set listAttributes = attributes.nested('list') %}
{% set dismissAttributes = attributes.nested('dismiss') %}

{% set alertAriaJsOptions = { ariaLive: ariaLive } %}
{% set iconName = 'x' %}
{% if type is same as('danger') %}
    {% set iconName = 'x-circle' %}
{% elseif type is same as('warning') %}
    {% set iconName = 'warning' %}
{% elseif type is same as('info') %}
    {% set iconName = 'info' %}
{% elseif type is same as('success') %}
    {% set iconName = 'check' %}
{% endif %}

<div
    {{ attributes.defaults({
        role: 'alert',
        'aria-live': ariaLive,
    }) }}
    class="{{ cx.root.apply({ type: type, dismissible: dismissible }) }}"
    {% if announceOnLoad %}
        data-alert-aria="true"
        data-alert-aria-options="{{ alertAriaJsOptions|json_encode }}"
    {% endif %}
>
    {% block icon %}
        {% if icon is not same as(false) and icon is not same as('false') %}
            <div {{ iconAttributes }} class="{{ cx.icon.apply() }}">
                {% block icon_element %}
                    {{ vi_icon(iconName) }}
                {% endblock %}
            </div>
        {% endif %}
    {% endblock %}

    {% block content_container %}
        <div {{ contentAttributes }} class="{{ cx.content.apply() }}">
            {% block heading %}
                {% if heading %}
                    <div {{ headingAttributes }} class="{{ cx.heading.apply() }}">
                        {{ heading }}
                    </div>
                {% endif %}
            {% endblock %}

            {% block content %}
                {% if list|length > 1 %}
                    <ul {{ listAttributes }} class="{{ cx.list.apply() }}">
                        {% for entry in list %}
                            <li>{{ entry|sw_sanitize }}</li>
                        {% endfor %}
                    </ul>
                {% elseif list|length == 1 %}
                    {% for entry in list %}
                        {{ entry|sw_sanitize }}
                    {% endfor %}
                {% elseif content is not null %}
                    {{ content|sw_sanitize }}
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}

    {% block dismiss %}
        {% if dismissible %}
            <button
                type="button"
                {{ dismissAttributes.defaults({
                    'data-bs-dismiss': 'alert',
                    'aria-label': 'global.default.close'|trans|striptags,
                }) }}
                class="{{ cx.dismiss.apply() }}"
            >
                <span aria-hidden="true"></span>
            </button>
        {% endif %}
    {% endblock %}
</div>
