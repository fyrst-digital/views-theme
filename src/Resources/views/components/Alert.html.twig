{% props
    type = 'info',
    dismissible = false,
    heading = null,
    content = null,
    list = [],
    icon = true,
    announceOnLoad = false,
    ariaLive = 'polite',
    cva = {},
%}

{% set alertType = type is same as('error') ? 'danger' : type %}
{% set cx = vi_cva_from_file(cva) %}
{% set alertAriaJsOptions = { ariaLive: ariaLive } %}
{% set iconName = 'x' %}
{% if alertType is same as('danger') %}
    {% set iconName = 'x-circle' %}
{% elseif alertType is same as('warning') %}
    {% set iconName = 'warning' %}
{% elseif alertType is same as('info') %}
    {% set iconName = 'info' %}
{% elseif alertType is same as('success') %}
    {% set iconName = 'check' %}
{% endif %}

<div
    {{ attributes.defaults({
        role: 'alert',
        'aria-live': ariaLive,
        'data-alert-aria': announceOnLoad ? 'true' : false,
        'data-alert-aria-options': announceOnLoad ? alertAriaJsOptions|json_encode : false,
    }) }}
    class="{{ cx.root.apply({ type: alertType, dismissible: dismissible }) }}"
>
    {% block icon %}
        {% if icon is not same as(false) and icon is not same as('false') %}
            <div {{ attributes.nested('icon') }} class="{{ cx.icon.apply() }}">
                {% block icon_element %}
                    {{ vi_icon(iconName) }}
                {% endblock %}
            </div>
        {% endif %}
    {% endblock %}

    {% block content_container %}
        <div {{ attributes.nested('content') }} class="{{ cx.content.apply() }}">
            {% block heading %}
                {% if heading %}
                    <div {{ attributes.nested('heading') }} class="{{ cx.heading.apply() }}">
                        {{ heading }}
                    </div>
                {% endif %}
            {% endblock %}

            {% block content %}
                {% if list|length > 1 %}
                    <ul {{ attributes.nested('list') }} class="{{ cx.list.apply() }}">
                        {% for entry in list %}
                            <li>{{ entry|sw_sanitize }}</li>
                        {% endfor %}
                    </ul>
                {% elseif list|length == 1 %}
                    {% for entry in list %}
                        {{ entry|sw_sanitize }}
                    {% endfor %}
                {% elseif content is not null %}
                    {{ content|sw_sanitize }}
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}

    {% block dismiss %}
        {% if dismissible %}
            <button
                {{ attributes.nested('dismiss').defaults({
                    type: 'button',
                    'data-bs-dismiss': 'alert',
                    'aria-label': 'global.default.close'|trans|striptags,
                }) }}
                class="{{ cx.dismiss.apply() }}"
            >
                <span aria-hidden="true"></span>
            </button>
        {% endif %}
    {% endblock %}
</div>
