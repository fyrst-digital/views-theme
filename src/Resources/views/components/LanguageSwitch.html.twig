{% props
    position = 'top-bar',
    showFlagLabel = true,
    languages = null,
    activeLanguageId = null,
    cva = {},
%}

{% set resolvedLanguages = languages is not null ? languages : (header.languages|default(page.header.languages|default([]))) %}
{% set resolvedActiveLanguageId = activeLanguageId is not null ? activeLanguageId : (context.context.languageId|default(page.header.activeLanguage.id|default(null))) %}
{% set cx = vi_cva_from_file(cva) %}

{% set activeLanguage = null %}
{% for language in resolvedLanguages %}
    {% if language.id is same as(resolvedActiveLanguageId) %}
        {% set activeLanguage = language %}
    {% endif %}
{% endfor %}
{% if activeLanguage is null and resolvedLanguages|length > 0 %}
    {% set activeLanguage = resolvedLanguages|first %}
{% endif %}

{% set isoCode = activeLanguage and activeLanguage.translationCode
    ? activeLanguage.translationCode.code|lower|split('-')
    : [''] %}
{% set languageCode = isoCode[0] %}

<form
    {{ attributes.defaults({
        method: 'post',
        action: path('frontend.checkout.switch-language'),
        'data-form-auto-submit': 'true',
        'data-form-add-dynamic-redirect': 'true',
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        <div {{ attributes.nested('menu') }} class="{{ cx.menu.apply() }}">
            {% block button %}
                <button
                    {{ attributes.nested('button').defaults({
                        type: 'button',
                        id: 'languagesDropdown-' ~ position,
                        'data-bs-toggle': 'dropdown',
                        'aria-haspopup': 'true',
                        'aria-expanded': 'false',
                    }) }}
                    class="{{ cx.button.apply() }}"
                >
                    {% block flag %}
                        <div {{ attributes.nested('flag') }} class="{{ cx.flag.apply() }}">
                            {% if activeLanguage and activeLanguage.translationCode %}
                                {% block flag_icon %}
                                    <img
                                        {{ attributes.nested('flagIcon').defaults({
                                            src: asset('bundles/viewstheme/flags/' ~ activeLanguage.translationCode.code ~ '.svg', 'asset'),
                                            alt: '',
                                        }) }}
                                        class="{{ cx.flagIcon.apply() }}"
                                    >
                                {% endblock %}
                            {% endif %}

                            {% block flag_label %}
                                {% if showFlagLabel %}
                                    <span {{ attributes.nested('flagLabel') }} class="{{ cx.flagLabel.apply() }}">
                                        {{ languageCode|upper }}
                                    </span>
                                {% endif %}
                            {% endblock %}
                        </div>
                    {% endblock %}
                </button>
            {% endblock %}

            {% block dropdown %}
                <div
                    {{ attributes.nested('dropdown').defaults({
                        'aria-labelledby': 'languagesDropdown-' ~ position,
                    }) }}
                    class="{{ cx.dropdown.apply() }}"
                >
                    {% for language in resolvedLanguages %}
                        {% block item %}
                            {% set isActive = language.id is same as(resolvedActiveLanguageId) %}
                            <div
                                {{ (isActive ? attributes.nested('itemChecked') : attributes.nested('item')).defaults({
                                    title: language.translated.name|default(language.name),
                                }) }}
                                class="{{ isActive ? cx.itemChecked.apply() : cx.item.apply() }}"
                            >
                                <label
                                    {{ attributes.nested('itemLabel').defaults({
                                        for: position ~ '-' ~ language.id,
                                    }) }}
                                    class="{{ cx.itemLabel.apply() }}"
                                >
                                    <input
                                        {{ attributes.nested('itemRadio').defaults({
                                            id: position ~ '-' ~ language.id,
                                            value: language.id,
                                            name: 'languageId',
                                            type: 'radio',
                                            checked: isActive ? true : null,
                                        }) }}
                                        class="{{ cx.itemRadio.apply() }}"
                                    >

                                    {% if language.translationCode %}
                                        {% block item_icon %}
                                            <img
                                                {{ attributes.nested('itemIcon').defaults({
                                                    src: asset('bundles/viewstheme/flags/' ~ language.translationCode.code ~ '.svg', 'asset'),
                                                    alt: '',
                                                }) }}
                                                class="{{ cx.itemIcon.apply() }}"
                                            >
                                        {% endblock %}
                                    {% endif %}

                                    {% block item_label %}
                                        {{ language.name }}
                                    {% endblock %}
                                </label>
                            </div>
                        {% endblock %}
                    {% endfor %}
                </div>
            {% endblock %}
        </div>

        {% if position == 'offcanvas' %}
            <input name="redirectParameters[offcanvas]" type="hidden" value="menu">
        {% endif %}
    {% endblock %}
</form>
