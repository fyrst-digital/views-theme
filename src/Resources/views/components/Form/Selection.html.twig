{% props
    type = 'radio',
    id = 'vi-form-selection-' ~ random(),
    name = null,
    label = null,
    description = null,
    trailing = null,
    value = '1',
    checked = false,
    disabled = false,
    validationRules = null,
    violationPath = null,
    error = false,
    formViolations = __context.formViolations|default(null),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['label', 'description', 'trailing']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% set control = attributes.all()|merge({
        tag: 'label',
        class: 'flex-fill min-w-0',
        id: id,
        name: name,
        label: label,
        description: description,
        value: value,
        checked: checked,
        disabled: disabled,
        validationRules: validationRules,
        violationPath: violationPath,
        error: error,
        formViolations: formViolations,
    }) %}

    {% if type == 'checkbox' %}
        <twig:ViewsTheme:Form:Checkbox {{ ...control }}>
            <twig:block name="label">
                {% vi_block label %}
                    {% if label is not empty %}
                        <span
                            {{ vi_attrs('label') }}
                            class="{{ vi_class('label') }}"
                        >
                            {{ label|raw }}
                        </span>
                    {% endif %}
                {% endvi_block %}
            </twig:block>
            <twig:block name="description">
                {% vi_block description %}
                    {% if description is not empty %}
                        <span
                            {{ vi_attrs('description').defaults({
                                id: id ~ '-description',
                            }) }}
                            class="{{ vi_class('description') }}"
                        >
                            {{ description }}
                        </span>
                    {% endif %}
                {% endvi_block %}
            </twig:block>
        </twig:ViewsTheme:Form:Checkbox>
    {% else %}
        <twig:ViewsTheme:Form:Radio {{ ...control }}>
            <twig:block name="label">
                {% vi_block label %}
                    {% if label is not empty %}
                        <span
                            {{ vi_attrs('label') }}
                            class="{{ vi_class('label') }}"
                        >
                            {{ label|raw }}
                        </span>
                    {% endif %}
                {% endvi_block %}
            </twig:block>
            <twig:block name="description">
                {% vi_block description %}
                    {% if description is not empty %}
                        <span
                            {{ vi_attrs('description').defaults({
                                id: id ~ '-description',
                            }) }}
                            class="{{ vi_class('description') }}"
                        >
                            {{ description }}
                        </span>
                    {% endif %}
                {% endvi_block %}
            </twig:block>
        </twig:ViewsTheme:Form:Radio>
    {% endif %}

    {% set trailingContent %}
        {%- block trailing -%}
            {{ trailing }}
        {%- endblock -%}
    {% endset %}
    {% if trailingContent|trim is not empty %}
        <span
            {{ vi_attrs('trailing') }}
            class="{{ vi_class('trailing') }}"
        >
            {{ trailingContent|raw }}
        </span>
    {% endif %}
</div>
