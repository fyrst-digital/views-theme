{% props
    type = 'radio',
    id = 'vi-form-selection-' ~ random(),
    name = null,
    label = null,
    description = null,
    trailing = null,
    value = '1',
    checked = false,
    disabled = false,
    validationRules = null,
    violationPath = null,
    error = false,
    formViolations = __context.formViolations|default(null),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['trailing']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% set control = {
        radio: 'ViewsTheme:Form:Radio',
        checkbox: 'ViewsTheme:Form:Checkbox',
    }[type]|default('ViewsTheme:Form:Radio') %}

    {{ component(control, attributes.all()|merge({
        tag: 'label',
        class: 'flex-fill min-w-0',
        id: id,
        name: name,
        label: label,
        description: description,
        value: value,
        checked: checked,
        disabled: disabled,
        validationRules: validationRules,
        violationPath: violationPath,
        error: error,
        formViolations: formViolations,
    })) }}

    {% block trailing %}
        {% if trailing is not empty %}
            <span
                {{ vi_attrs('trailing') }}
                class="{{ vi_class('trailing') }}"
            >
                {{ trailing }}
            </span>
        {% endif %}
    {% endblock %}
</div>
