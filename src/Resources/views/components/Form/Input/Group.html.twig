{% props
    id = null,
    name = null,
    type = 'text',
    label = null,
    value = null,
    placeholder = null,
    autocomplete = null,
    minlength = null,
    maxlength = null,
    disabled = false,
    size = 'md',
    description = null,
    validationRules = null,
    violationPath = null,
    error = false,
    formViolations = __context.formViolations|default(null),
    cva = {},
%}

{% set feedbackId = id ~ '-feedback' %}
{% set descriptionId = id ~ '-description' %}
{% set isRequired = validationRules is not empty and 'required' in validationRules %}
{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    label: attributes.nested('label'),
    required: attributes.nested('required'),
    group: attributes.nested('group'),
    input: attributes.nested('input'),
    description: attributes.nested('description'),
    feedback: attributes.nested('feedback'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block label %}
        {% if label %}
            <label
                {{ attrs.label.defaults({
                    for: id,
                }) }}
                class="{{ cx.label.apply() }}"
            >
                {{ label|raw }}

                {% if isRequired %}
                    <span
                        {{ attrs.required.defaults({
                            'aria-hidden': 'true',
                        }) }}
                        class="{{ cx.required.apply() }}"
                    >
                        {{ 'general.required'|trans|sw_sanitize }}
                    </span>
                {% endif %}
            </label>
        {% endif %}
    {% endblock %}

    {% block group %}
        <div
            {{ attrs.group }}
            class="{{ cx.group.apply({ size: size }) }}"
        >
            {% block prepend %}{% endblock %}

            {% block input %}
                <twig:ViewsTheme:Form:Input
                    class="{{ cx.input.apply() }}"
                    {{ ...attrs.input.defaults({
                        type: type,
                        id: id,
                        name: name,
                        value: value,
                        size: size,
                        placeholder: placeholder,
                        autocomplete: autocomplete,
                        minlength: minlength,
                        maxlength: maxlength,
                        disabled: disabled,
                        validationRules: validationRules,
                        violationPath: violationPath,
                        error: error,
                        formViolations: formViolations,
                        label: false,
                        description: null,
                    }).all() }}
                >
                    <twig:block name="feedback"></twig:block>
                </twig:ViewsTheme:Form:Input>
            {% endblock %}

            {% block append %}{% endblock %}
        </div>
    {% endblock %}

    {% block description %}
        {% if description is not empty %}
            <small
                {{ attrs.description.defaults({
                    id: descriptionId,
                }) }}
                class="{{ cx.description.apply() }}"
            >
                {{ description }}
            </small>
        {% endif %}
    {% endblock %}

    {% block feedback %}
        <div
            {{ attrs.feedback.defaults({
                id: feedbackId,
            }) }}
            class="{{ cx.feedback.apply() }}"
        >
            {% block feedback_violations %}
                {% if violationPath is not empty and formViolations and formViolations.getViolations(violationPath) is not empty %}
                    {% sw_include '@Storefront/storefront/utilities/form-violation.html.twig' with {
                        formViolations: formViolations,
                        violationPath: violationPath,
                    } %}
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}
</div>
