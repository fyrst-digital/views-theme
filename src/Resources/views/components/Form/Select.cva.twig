{
    root: {
        base: 'form-group d-flex flex-wrap',
        variants: {
            layout: {
                stacked: 'flex-column',
                bar: 'flex-row align-items-center gap-2',
            },
        },
    },
    label: {
        base: 'form-label d-inline-flex align-items-center gap-1 mb-0',
        variants: {
            size: {
                sm: 'fs-6',
            },
            layout: {
                bar: 'm-0',
            },
        },
    },
    required: {
        base: 'form-required-label',
    },
    select: {
        base: 'form-select appearance-none cursor-pointer',
        variants: {
            invalid: {
                true: 'is-invalid',
            },
            placeholder: {
                true: 'is-placeholder',
            },
            size: {
                sm: 'form-select-sm',
                md: '',
                lg: 'form-select-lg',
            },
            layout: {
                stacked: '',
                bar: 'col',
            },
        },
    },
    description: {
        base: 'form-text',
    },
    feedback: {
        base: 'form-field-feedback',
    },
}
