{
    root: {
        base: 'form-group d-flex flex-wrap',
        variants: {
            layout: {
                stacked: 'flex-column',
                bar: 'flex-row align-items-center gap-2',
            },
        },
    },
    label: { 
        base: 'form-label',
        variants: {
            size: {
                sm: 'fs-6',
            },
            layout: {
                bar: 'm-0',
            }
        } 
    },
    required: { 
        base: 'form-required-label' 
    },
    select: {
        base: 'form-select cursor-pointer',
        variants: {
            invalid: {
                true: 'is-invalid',
            },
            size: {
                sm: 'form-select-sm',
                md: '',
                lg: 'form-select-lg',
            },
            layout: {
                bar: 'col',
            }
        },
    },
    description: { 
        base: 'form-text' 
    },
    feedback: { 
        base: 'form-field-feedback' 
    },
}
