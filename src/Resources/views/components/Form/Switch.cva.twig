{
    root: { base: 'form-check form-switch' },
    input: {
        base: 'form-check-input cursor-pointer',
        variants: {
            invalid: {
                true: 'is-invalid',
            },
        },
    },
    label: { 
        base: 'form-check-label',
        variants: {
            disabled: {
                true: 'opacity-50'
            }, 
        },
    },
    description: { base: 'form-text' },
    feedback: { base: 'form-field-feedback' },
}
