{% props
    action = null,
    method = 'post',
    preventNative = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<form
    {{ attributes.defaults({
        action: action is not empty ? action : false,
        method: method,
        'data-component': 'ViewsTheme:Form:Handler',
        'data-component-options': {
            preventNative: preventNative,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block content %}{% endblock %}
</form>
