{% props
    group, # Webflare\ViewsTheme\Struct\CookieGroupView
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['row', 'switch', 'title', 'toggle', 'panel', 'entries', 'description', 'entry', 'entrySwitch', 'entryDescription']) %}

{# Required cookies are on and cannot be switched off #}
{% set required = group.required %}
{# Names are translated in PHP but still plugin / snippet text; Form:Switch prints `label|raw` #}
{% set name = group.name|sw_sanitize %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Cookie:Manager:Group',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% if group.entries is empty %}
        {# The group is a cookie itself #}
        {% block cookie %}
            <div {{ vi_attrs('row') }} class="{{ vi_class('row') }}">
                <div {{ vi_attrs('entry') }} class="{{ vi_class('entry') }}">
                    <twig:ViewsTheme:Form:Switch
                        class="{{ vi_class('entrySwitch') }}"
                        {{ ...vi_attrs('entrySwitch').defaults({
                            id: group.id,
                            name: 'cookie',
                            value: group.cookie,
                            label: name,
                            checked: required,
                            disabled: required,
                            cva: { label: vi_class('title') },
                            'input:aria-describedby': group.description ? group.id ~ '-description' : false,
                        }).all() }}
                    />

                    {% if group.description %}
                        <p
                            {{ vi_attrs('description').defaults({ id: group.id ~ '-description' }) }}
                            class="{{ vi_class('description') }}"
                        >
                            {{ group.description|sw_sanitize }}
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endblock %}
    {% else %}
        {# The group root draws the divider; the item must not add a second one #}
        <twig:ViewsTheme:Accordion:Item :cva="{ root: 'vi-accordion__item' }">
            <twig:block name="header">
                <div {{ vi_attrs('row') }} class="{{ vi_class('row') }}">
                    {% vi_block switch %}
                        {#
                            Group switch: toggles every cookie of the group. A plain checkbox (no
                            role="switch"), so its indeterminate state is announced as "mixed".
                        #}
                        <twig:ViewsTheme:Form:Switch
                            class="{{ vi_class('switch') }}"
                            {{ ...vi_attrs('switch').defaults({
                                id: group.id,
                                name: 'group',
                                label: name,
                                checked: required,
                                disabled: required,
                                cva: { label: vi_class('title') },
                                'input:role': false,
                            }).all() }}
                        />
                    {% endvi_block %}

                    <twig:ViewsTheme:Accordion:Header
                        {{ ...vi_attrs('toggle').defaults({
                            id: group.id ~ '-toggle',
                            panel: group.id ~ '-panel',
                            'aria-label': 'general.expand'|trans|striptags ~ ': ' ~ group.name|striptags,
                            cva: { root: vi_class('toggle') },
                        }).all() }}
                    />
                </div>
            </twig:block>

            <twig:block name="panel">
                {# Slot around the whole panel: inside Accordion:Panel it would be two hosts deep #}
                {% vi_block entries %}
                    <twig:ViewsTheme:Accordion:Panel
                        {{ ...vi_attrs('panel').defaults({
                            id: group.id ~ '-panel',
                            header: group.id ~ '-toggle',
                        }).all() }}
                    >
                        <twig:block name="content">
                            <div {{ vi_attrs('entries') }} class="{{ vi_class('entries') }}">
                                {% if group.description %}
                                    <p {{ vi_attrs('description') }} class="{{ vi_class('description') }}">
                                        {{ group.description|sw_sanitize }}
                                    </p>
                                {% endif %}

                                {% for entry in group.entries %}
                                    <div {{ vi_attrs('entry') }} class="{{ vi_class('entry') }}">
                                        <twig:ViewsTheme:Form:Switch
                                            class="{{ vi_class('entrySwitch') }}"
                                            {{ ...vi_attrs('entrySwitch').defaults({
                                                id: entry.id,
                                                name: 'cookie',
                                                value: entry.cookie,
                                                label: entry.name|sw_sanitize,
                                                checked: required,
                                                disabled: required,
                                                'input:aria-describedby': entry.description ? entry.id ~ '-description' : false,
                                            }).all() }}
                                        />

                                        {% if entry.description %}
                                            <p
                                                {{ vi_attrs('entryDescription').defaults({ id: entry.id ~ '-description' }) }}
                                                class="{{ vi_class('entryDescription') }}"
                                            >
                                                {{ entry.description|sw_sanitize }}
                                            </p>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </twig:block>
                    </twig:ViewsTheme:Accordion:Panel>
                {% endvi_block %}
            </twig:block>
        </twig:ViewsTheme:Accordion:Item>
    {% endif %}
</div>
