{% sw_extends '@Storefront/storefront/layout/cookie/cookie-configuration-group.html.twig' %}

{% props
    cookieGroup = null,
    themeIconConfig = null,
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-cookie-configuration-group offcanvas-cookie-group border-bottom py-3' },
    entries: { base: 'vi-cookie-configuration-group__entries offcanvas-cookie-entries d-flex flex-column' },
}|replace_recursive(cva)) %}

{% set attrs = {
    entries: attributes.nested('entries'),
} %}

{% block cookie_configuration_group %}
    {% if cookieGroup.cookie is defined or cookieGroup.entries is defined %}
        <div {{ attributes }} class="{{ cx.root.apply() }}">
            {% sw_include '@Storefront/storefront/layout/cookie/cookie-configuration-parent.html.twig' with {
                parent: cookieGroup,
            } only %}

            {% if cookieGroup.snippet_description %}
                <div>{{ cookieGroup.snippet_description|trans|sw_sanitize }}</div>
            {% endif %}

            {% if cookieGroup.entries is not empty or cookieGroup.snippet_description is defined %}
                <div {{ attrs.entries }} class="{{ cx.entries.apply() }}">
                    {% for entry in cookieGroup.entries %}
                        {% sw_include '@Storefront/storefront/layout/cookie/cookie-configuration-child.html.twig' with {
                            child: entry,
                            isRequired: cookieGroup.isRequired,
                        } only %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
