{% sw_extends '@Storefront/storefront/utilities/offcanvas.html.twig' %}

{% props
    cva = {},
%}

{% set cx = vi_cva({
    header: { base: 'vi-offcanvas__header offcanvas-header border-bottom' },
    title: { base: 'vi-offcanvas__title offcanvas-header-content fw-semibold fs-5' },
    close: { base: 'vi-offcanvas__close btn btn-light offcanvas-close js-offcanvas-close' },
    root: { base: 'vi-cookie-configuration offcanvas-cookie' },
    description: { base: 'vi-cookie-configuration__description offcanvas-cookie-description' },
    list: { base: 'vi-cookie-configuration__list offcanvas-cookie-list' },
}|replace_recursive(cva)) %}

{% block utilities_offcanvas_header %}
    <div {{ attributes.nested('header') }} class="{{ cx.header.apply() }}">
        <div {{ attributes.nested('title') }} class="{{ cx.title.apply() }}">
            {{ 'cookie.headline'|trans|sw_sanitize }}
        </div>
        <button
            type="button"
            {{ attributes.nested('close') }}
            class="{{ cx.close.apply() }}"
            title="{{ 'general.offcanvasCloseMenu'|trans|sw_sanitize }}"
            aria-label="{{ 'general.offcanvasCloseMenu'|trans|sw_sanitize }}"
        >
            {{ vi_icon('x') }}
        </button>
    </div>
{% endblock %}

{% block utilities_offcanvas_content %}
    <div {{ attributes }} class="{{ cx.root.apply() }}">
        <div {{ attributes.nested('description') }} class="{{ cx.description.apply() }}">
            <p>
                {{ 'cookie.messageText'|trans({
                    '%url%': path('frontend.cms.page', { id: config('core.basicInformation.privacyPage') }),
                })|raw }}
            </p>
            <div class="row align-items-center h6 offcanvas-cookie-header">
                <div class="col">{{ 'cookie.configuration'|trans|sw_sanitize }}</div>
            </div>
        </div>

        <div {{ attributes.nested('list') }} class="{{ cx.list.apply() }}">
            {% for cookieGroup in cookieGroups %}
                {% component 'ViewsTheme:Cookie:ConfigurationGroup' with {
                    themeIconConfig: themeIconConfig,
                    cookieGroup: cookieGroup,
                } only %}{% endcomponent %}
            {% endfor %}
        </div>

        {% if config('core.basicInformation.acceptAllCookies') %}
            <div class="d-grid mb-2">
                <button type="submit" class="btn btn-primary btn-block js-offcanvas-cookie-accept-all">
                    {{ 'cookie.acceptAll'|trans|sw_sanitize }}
                </button>
            </div>
        {% endif %}

        <div class="d-flex flex-wrap py-3">
            <button type="submit" class="btn btn-lg btn-success js-offcanvas-cookie-submit">
                {{ vi_icon('check') }}
                {{ 'cookie.save'|trans|sw_sanitize }}
            </button>
        </div>
    </div>
{% endblock %}
