{% sw_extends '@Storefront/storefront/utilities/offcanvas.html.twig' %}

{% block utilities_offcanvas_header %}
    <div class="vi-offcanvas__header offcanvas-header border-bottom">
        <div class="vi-offcanvas__title offcanvas-header-content fw-semibold fs-5">
            {{ 'cookie.headline'|trans|sw_sanitize }}
        </div>
        <button
            type="button"
            class="vi-offcanvas__close btn btn-light offcanvas-close js-offcanvas-close"
            title="{{ 'general.offcanvasCloseMenu'|trans|sw_sanitize }}"
            aria-label="{{ 'general.offcanvasCloseMenu'|trans|sw_sanitize }}"
        >
            {{ vi_icon('x') }}
        </button>
    </div>
{% endblock %}

{% block utilities_offcanvas_content %}
    <div class="vi-cookie-configuration offcanvas-cookie">
        <div class="vi-cookie-configuration__description offcanvas-cookie-description">
            <p>
                {{ 'cookie.messageText'|trans({
                    '%url%': path('frontend.cms.page', { id: config('core.basicInformation.privacyPage') }),
                })|raw }}
            </p>
            <div class="row align-items-center h6 offcanvas-cookie-header">
                <div class="col">{{ 'cookie.configuration'|trans|sw_sanitize }}</div>
            </div>
        </div>

        <div class="vi-cookie-configuration__list offcanvas-cookie-list">
            {% for cookieGroup in cookieGroups %}
                {% sw_include '@ViewsTheme/components/Cookie/ConfigurationGroup.html.twig' with {
                    themeIconConfig: themeIconConfig,
                    cookieGroup: cookieGroup,
                } only %}
            {% endfor %}
        </div>

        {% if config('core.basicInformation.acceptAllCookies') %}
            <div class="d-grid mb-2">
                <button type="submit" class="btn btn-primary btn-block js-offcanvas-cookie-accept-all">
                    {{ 'cookie.acceptAll'|trans|sw_sanitize }}
                </button>
            </div>
        {% endif %}

        <div class="d-flex flex-wrap py-3">
            <button type="submit" class="btn btn-lg btn-success js-offcanvas-cookie-submit">
                {{ vi_icon('check') }}
                {{ 'cookie.save'|trans|sw_sanitize }}
            </button>
        </div>
    </div>
{% endblock %}
