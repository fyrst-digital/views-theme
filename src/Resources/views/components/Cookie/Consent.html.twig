{% props
    featureName = 'wishlist', # snippet scope: cookie.{featureName}.title | description | accept | login
    cookieName = 'wishlist-enabled',
    loginUrl = path('frontend.account.login.page'),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['panel', 'body', 'description', 'actions', 'accept', 'login', 'cancel', 'preferences']) %}

{% set title = ('cookie.' ~ featureName ~ '.title')|trans|striptags %}

<twig:ViewsTheme:Drawer
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        id: 'vi-cookie-drawer',
        side: 'start',
        label: title,
    }).all() }}
>
    <twig:block name="panel">
        <twig:ViewsTheme:Drawer:Panel
            {{ ...vi_attrs('panel').defaults({
                side: 'start',
                title: title,
            }).all() }}
        >
            <div
                {{ vi_attrs('body').defaults({
                    'data-component': 'ViewsTheme:Cookie:Consent',
                    'data-component-options': {
                        cookieName: cookieName,
                        loginUrl: loginUrl,
                    }|json_encode,
                }) }}
                class="{{ vi_class('body') }}"
            >
                <p {{ vi_attrs('description') }} class="{{ vi_class('description') }}">
                    {{ ('cookie.' ~ featureName ~ '.description')|trans({ '%cookieName%': cookieName })|sw_sanitize }}
                </p>

                <div {{ vi_attrs('actions') }} class="{{ vi_class('actions') }}">
                    <twig:ViewsTheme:Button
                        class="{{ vi_class('accept') }}"
                        {{ ...vi_attrs('accept').defaults({
                            type: 'button',
                            name: 'action',
                            value: 'accept',
                            color: 'primary',
                            label: ('cookie.' ~ featureName ~ '.accept')|trans|striptags,
                        }).all() }}
                    />

                    <twig:ViewsTheme:Button
                        class="{{ vi_class('login') }}"
                        {{ ...vi_attrs('login').defaults({
                            type: 'button',
                            name: 'action',
                            value: 'login',
                            color: 'primary',
                            label: ('cookie.' ~ featureName ~ '.login')|trans|striptags,
                        }).all() }}
                    />

                    <twig:ViewsTheme:Button
                        class="{{ vi_class('cancel') }}"
                        {{ ...vi_attrs('cancel').defaults({
                            type: 'button',
                            name: 'action',
                            value: 'cancel',
                            color: 'secondary',
                            label: 'global.default.cancel'|trans|striptags,
                        }).all() }}
                    />
                </div>

                <twig:ViewsTheme:Button
                    class="{{ vi_class('preferences') }}"
                    {{ ...vi_attrs('preferences').defaults({
                        type: 'button',
                        name: 'action',
                        value: 'preferences',
                        color: 'link',
                        label: 'cookie.headline'|trans|striptags,
                    }).all() }}
                />
            </div>
        </twig:ViewsTheme:Drawer:Panel>
    </twig:block>
</twig:ViewsTheme:Drawer>
