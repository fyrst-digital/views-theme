{% set iconOptions = iconOptions|default(themeParameters.icons) %}

{% if type is same as('error') %}
  {% set type = 'danger' %}
{% endif %}

{%
  set classes = vi_define_classes({
    alert: [
      'd-flex',
      'flex-wrap',
      'align-items-center',
      'gap-3',
      'alert',
    ],
    iconContainer: [
      'alert-icon-container',
      'fs-5',
      'd-flex',
      'col-auto',
    ],
    contentContainer: [
      'alert-content-container',
      'col',
    ],
    heading: [
      'alert-heading',
      'h5',
    ],
    alertList: [
      'alert-list',
    ],
    dismissButton: [
      'btn-close',
    ],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
    variants: {
      type: {
        danger:  { alert: ['alert-danger'] },
        warning: { alert: ['alert-warning'] },
        info:    { alert: ['alert-info'] },
        success: { alert: ['alert-success'] },
      },
      dismissible: {
        true: { alert: ['alert-dismissible', 'fade', 'show'] },
      },
    },
    props: {
      type: type|default(null),
      dismissible: dismissible|default(false),
    },
  })
%}

{%
  set alertAriaJsOptions = {
    ariaLive: ariaLive,
  }
%}

{% if ariaLive is not defined %}
  {% set ariaLive = 'polite' %}
{% endif %}

{% block component_alert %}
  <div
    {% if announceOnLoad %}
      data-alert-aria="true"
      data-alert-aria-options="{{ alertAriaJsOptions|json_encode }}"
    {% endif %}
    role="alert"
    aria-live="{{ ariaLive }}"
    {{ classes.alert | vi_attr_classes }}>
    {% block component_alert_icon %}
      {% set iconName = 'x' %}

      {% if icon != 'false' %}
        <div {{ classes.iconContainer | vi_attr_classes }}>
          {% if type is same as('danger') %}
            {% set iconName = 'x-circle' %}
          {% elseif type is same as('warning') %}
            {% set iconName = 'warning' %}
          {% elseif type is same as('info') %}
            {% set iconName = 'info' %}
          {% elseif type is same as('success') %}
            {% set iconName = 'check' %}
          {% endif %}

          {% block component_alert_icon_element %}
            {{ vi_icon(iconName, iconOptions) }}
          {% endblock %}
        </div>
      {% endif %}
    {% endblock %}

    {% block component_alert_content_container %}
      <div {{ classes.contentContainer | vi_attr_classes }}>
        {% block component_alert_heading %}
          {% if heading %}
            <div {{ classes.heading | vi_attr_classes }}>
              {{ heading }}
            </div>
          {% endif %}
        {% endblock %}

        {% block component_alert_content %}
          {% if list|length > 1 %}
            <ul {{ classes.alertList | vi_attr_classes }}>
              {% for entry in list %}
                <li>{{ entry | sw_sanitize }}</li>
              {% endfor %}
            </ul>
          {% elseif list|length == 1 %}
            {% for entry in list %}
              {{ entry | sw_sanitize }}
            {% endfor %}
          {% else %}
            {{ content | sw_sanitize }}
          {% endif %}
        {% endblock %}
      </div>
    {% endblock %}

    {% block component_alert_dismissible %}
      {% if dismissible %}
        <button
          type="button"
          {{ classes.dismissButton | vi_attr_classes }}
          data-bs-dismiss="alert"
          aria-label="{{ 'global.default.close'|trans|striptags }}">
          <span aria-hidden="true"></span>
        </button>
      {% endif %}
    {% endblock %}
  </div>
{% endblock %}
