{% set variations = variations|default(product.variation) %}

{%
  set classes = vi_define_classes({
    container: [],
    item: [],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_product_variations %}
  <div {{ classes.container | vi_attr_classes }}>
    {% for variation in product.variation %}
      <div {{ classes.item | vi_attr_classes }}>
        {{ variation.group }}:
        {{ variation.option }}
      </div>
    {% endfor %}
  </div>
{% endblock %}
