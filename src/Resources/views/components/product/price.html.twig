{% set price = product.calculatedPrice %}
{% set prices = product.calculatedPrices %}

{% if product.variantListingConfig.displayParent and product.parentId === null %}
  {% set displayFromVariants = price.unitPrice !== product.calculatedCheapestPrice.unitPrice %}
  {% set price = product.calculatedCheapestPrice %}
{% endif %}

{% set referencePrice = price.referencePrice %}

{% if prices.count > 0 %}
  {% set price = prices.last %}
{% endif %}

{%
  set priceOptions = {
    showTaxNote: false,
    taxUrl: path('frontend.cms.page', { id: config('core.basicInformation.shippingPaymentInfoPage') }),
    taxText: context.taxState == 'gross' ? 'general.grossTaxInformation'|trans|sw_sanitize : 'general.netTaxInformation'|trans|sw_sanitize
  }|merge(priceOptions|default({}))
%}

{%
  set classes = vi_define_classes({
    price: [],
    prefix: [],
    unit: [],
    reference: [],
    average: [],
    tax: [],
    taxAction: [],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_product_price %}
  <div
    {{ classes.price | vi_attr_classes }}
    data-component="product-price">
    {% block component_product_price_prefix %}
      {% if prices.count > 1 or displayFromVariants %}
        <span
          {{ classes.prefix | vi_attr_classes }}
          data-component="product-price-prefix">
          {{ 'listing.listingTextFrom' | trans | sw_sanitize }}
        </span>
      {% endif %}
    {% endblock %}
    {% block component_product_price_unit %}
      <span
        {{ classes.unit | vi_attr_classes }}
        data-component="product-price-unit">
        {{ price.unitPrice | currency }}
      </span>
    {% endblock %}
    {% block component_product_price_reference %}
      {% if price.referencePrice is not null %}
        <span
          {{ classes.reference | vi_attr_classes }}
          data-component="product-price-reference">
          {{ price.referencePrice.price | currency }} /
          {{ price.referencePrice.referenceUnit }}&nbsp;
          {{ price.referencePrice.unitName }}
        </span>
      {% endif %}
    {% endblock %}
    {% block component_product_price_average %}
      {% if price.regulationPrice.price is not null %}
        <span
          {{ classes.average | vi_attr_classes }}
          data-component="product-price-average">
          {{ 'general.listPricePreviously'|trans({'%price%': price.regulationPrice.price|currency }) }}
        </span>
      {% endif %}
    {% endblock %}
  </div>
{% endblock %}

{% block component_product_price_tax %}
  {% if priceOptions.showTaxNote is same as(true) %}
    <div
      {{ classes.tax | vi_attr_classes }}
      data-component="product-price-tax">
      {% block component_product_price_tax_link %}
        <button
          {{ classes.taxAction | vi_attr_classes }}
          type="button"
          data-ajax-modal="true"
          data-url="{{ priceOptions.taxUrl }}"
          aria-haspopup="dialog">
          {{ priceOptions.taxText }}
        </button>
      {% endblock %}
    </div>
  {% endif %}
{% endblock %}
