{%
  set options = {
    showLink: true,
    url: seoUrl('frontend.detail.page', {productId: product.id}),
    name: product.translated.name,
    tag: 'div'
  }|merge(options|default({}))
%}

{%
  set classes = vi_define_classes({
    container: [],
    link: [],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_product_name %}
  <{{ options.tag|raw }}
    {{ classes.container | vi_attr_classes }}
    data-component="product-name">
    {% if options.showLink is same as(true) %}
      <a
        {{ classes.link | vi_attr_classes }}
        href="{{ options.url }}"
        title="{{ options.name }}"
        data-component="product-name-link">
        {{ options.name }}
      </a>
    {% else %}
      {{ options.name }}
    {% endif %}
  </{{ options.tag|raw }}>
{% endblock %}
