{% set productId = product.id %}

{% block component_product_action_buy_parameter_redirect_input %}
  {# fallback redirect back to detail page is deactivated via js #}
  <input
    type="hidden"
    name="redirectTo"
    value="frontend.detail.page">

  <input
    type="hidden"
    name="redirectParameters"
    data-redirect-parameters="true"
    value="{{ {productId: productId}|json_encode }}">
{% endblock %}

{% block component_product_action_buy_parameter_info %}
  <input
    type="hidden"
    name="lineItems[{{ productId }}][id]"
    value="{{ productId }}">
  <input
    type="hidden"
    name="lineItems[{{ productId }}][referencedId]"
    value="{{ productId }}">
  <input
    type="hidden"
    name="lineItems[{{ productId }}][type]"
    value="product">
  <input
    type="hidden"
    name="lineItems[{{ productId }}][stackable]"
    value="1">
  <input
    type="hidden"
    name="lineItems[{{ productId }}][removable]"
    value="1">
{% endblock %}

{% block component_product_action_buy_parameter_quantity %}
  {% if not showQuantity %}
    <input
      type="hidden"
      name="lineItems[{{ productId }}][quantity]"
      value="{{ product.minPurchase }}">
  {% endif %}
{% endblock %}

{% block component_product_action_buy_parameter_meta %}
  <input
    type="hidden"
    name="product-name"
    value="{{ product.translated.name }}">
{% endblock %}
