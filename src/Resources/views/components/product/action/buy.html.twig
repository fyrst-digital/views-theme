{% set formAction = path('frontend.checkout.line-item.add') %}
{% set buyLabel = buyLabel|default('listing.boxAddProduct' | trans | sw_sanitize) %}
{% set buyIcon = buyIcon|default('handbag') %}
{% set iconOptions = iconOptions|default(themeParameters.icons) %}
{%
  set classes = vi_define_classes({
    form: [],
    actionBuy: [],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_product_action_buy %}
  {# @var product \Shopware\Core\Content\Product\SalesChannel\SalesChannelProductEntity #}
  <form
    action="{{ formAction }}"
    method="post"
    id="{{'ProductBuyForm' ~ id}}"
    {{ classes.form | vi_attr_classes }}
    data-component="product-buy"
    data-add-to-cart="true">
    {% block component_product_action_form %}
      {% block component_product_action_buy_redirect_input %}
        {# fallback redirect back to detail page is deactivated via js #}
        <input
          type="hidden"
          name="redirectTo"
          value="frontend.detail.page">

        <input
          type="hidden"
          name="redirectParameters"
          data-redirect-parameters="true"
          value="{{ {productId: id}|json_encode }}">
      {% endblock %}

      {% block component_product_action_buy_info %}
        <input
          type="hidden"
          name="lineItems[{{ id }}][id]"
          value="{{ id }}">
        <input
          type="hidden"
          name="lineItems[{{ id }}][referencedId]"
          value="{{ id }}">
        <input
          type="hidden"
          name="lineItems[{{ id }}][type]"
          value="product">
        <input
          type="hidden"
          name="lineItems[{{ id }}][stackable]"
          value="1">
        <input
          type="hidden"
          name="lineItems[{{ id }}][removable]"
          value="1">
        <input
          type="hidden"
          name="lineItems[{{ id }}][quantity]"
          value="{{ product.minPurchase }}">
      {% endblock %}

      {% block component_product_action_buy_meta %}
        <input
          type="hidden"
          name="product-name"
          value="{{ product.translated.name }}">
      {% endblock %}

      {% block component_product_action_buy_button %}
        <button
          {{ classes.actionBuy | vi_attr_classes }}
          data-component="product-buy-action">
          {% block component_product_action_buy_button_icon %}
            {{ vi_icon(buyIcon, iconOptions) }}
          {% endblock %}
          {% block component_product_action_buy_button_label %}
            {# @deprecated tag:v6.8.0 - Block page_product_detail_product_buy_button_label will be removed. Use component_product_action_buy_button_label instead. The default content will remain. #}
            {{ buyLabel }}
          {% endblock %}
        </button>
      {% endblock %}
    {% endblock %}
  </form>
{% endblock %}
