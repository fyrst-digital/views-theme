{% sw_extends '@Storefront/components/line-item/base.html.twig' %}

{% block component_line_item_image_element %}
  {% sw_include '@Storefront/storefront/component/line-item/element/image.html.twig' %}
{% endblock %}

{% block component_line_item_name_content %}
  {% set productLink = null %}
  {% set label = lineItem.label|trans|sw_sanitize %}

  {% if lineItem.type is same as('product') %}
    {% set productLink = seoUrl('frontend.detail.page', { productId: lineItem.referencedId }) %}
  {% endif %}

  {% if productLink is not null %}
    <a
      href="{{ productLink }}"
      {{ classes.label | vi_attr_classes }}
      title="{{ label }}">
      {{ label | raw }}
    </a>
  {% else %}
    <span {{ classes.label | vi_attr_classes }}>
      {{ label | raw }}
    </span>
  {% endif %}
{% endblock %}

{% block component_line_item_actions_inner %}
  {% block component_line_item_action_wishlist %}
    {% if config('core.cart.wishlistEnabled') %}
      {%
        sw_include '@Storefront/components/product/action/wishlist.html.twig' with {
            showText: false,
            size: 'sm',
            productId: lineItem.referencedId,
            classes: {
                action: ['line-item-action']
            }
        }
      %}
    {% endif %}
  {% endblock %}

  {% block component_line_item_action_delete %}
    {% if showRemoveButton is same as(true) and lineItem.removable and nestingLevel < 1 %}
      {% sw_include '@Storefront/components/line-item/element/remove.html.twig' %}
    {% endif %}
  {% endblock %}
{% endblock %}

{% block component_line_item_details %}
  {% block component_line_item_product_body %}
    <div {{ classes.body | vi_attr_classes }}>
      {% block component_line_item_product_variants %}
        {% if lineItem.payload.options is not empty %}
          {% sw_include '@Storefront/storefront/component/line-item/element/variant-characteristics.html.twig' %}
        {% endif %}
      {% endblock %}

      {% block component_line_item_product_features %}
        {% if lineItem.payload.features is not empty %}
          {%
            sw_include '@Storefront/storefront/component/product/feature/list.html.twig' with {
                features: lineItem.payload.features
            }
          %}
        {% endif %}
      {% endblock %}

      {% block component_line_item_product_delivery_time %}
        {% if config('core.cart.showDeliveryTime') %}
          {% sw_include '@Storefront/components/line-item/element/delivery-date.html.twig' %}
        {% endif %}
      {% endblock %}
    </div>
  {% endblock %}

  {% block component_line_item_product_footer -%}
    <div {{ classes.footer | vi_attr_classes }}>
      {% block component_line_item_product_quantity %}
        <div {{ classes.quantity | vi_attr_classes }}>
          {% sw_include '@Storefront/components/line-item/element/quantity.html.twig' %}
        </div>
      {% endblock %}

      {% block component_line_item_product_total_price %}
        {% if lineItemOptions.showPrice is same as(true) %}
          <div {{ classes.totalPrice | vi_attr_classes }}>
            {# Shipping costs discounts always have a price of 0, which might be confusing, therefore we do not show those #}
            {% if lineItem.payload.discountScope != 'delivery' %}
              {{ lineItem.price.totalPrice | currency }}
            {% endif %}
          </div>
        {% endif %}
      {% endblock %}
    </div>
  {% endblock %}
{% endblock %}

{% block component_line_item_main %}
  {{ parent() }}
{% endblock %}
