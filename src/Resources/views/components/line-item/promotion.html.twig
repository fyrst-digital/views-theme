{% sw_extends '@Storefront/components/line-item/base.html.twig' %}

{%
  set classes = {
    image: ['line-item-img', 'discount-icon'],
    label: ['line-item-label', 'discount-name'],
    totalPrice: ['line-item-total-price'],
  }
%}
{% set replaceClasses = ['label', 'image', 'totalPrice'] %}

{% block component_line_item_image_element %}
    <div {{ classes.image | vi_attr_classes }}>
        {{vi_icon('tag')}}
    </div>
{% endblock %}

{% block component_line_item_name_content %}
    {% set label = lineItem.label|trans|sw_sanitize %}

    <span {{ classes.label | vi_attr_classes }}>
        {{ label|raw }}
    </span>
{% endblock %}

{% block component_line_item_details %}
    <div {{ classes.totalPrice | vi_attr_classes }}>
        {# Shipping costs discounts always have a price of 0, which might be confusing, therefore we do not show those #}
        {% if lineItem.payload.discountScope != 'delivery' %}
            {{ lineItem.price.totalPrice|currency }}
        {% endif %}
    </div>
{% endblock %}
