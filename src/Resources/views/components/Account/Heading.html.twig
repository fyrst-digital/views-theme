{% props
    title,
    intro = null,
    titleTag = 'h1',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'intro']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block title %}
        <{{ titleTag|raw }}
            {{ vi_attrs('title') }}
            class="{{ vi_class('title') }}"
        >
            {{ title }}
        </{{ titleTag|raw }}>
    {% endblock %}

    {% block intro %}
        {% if intro %}
            <p
                {{ vi_attrs('intro') }}
                class="{{ vi_class('intro') }}"
            >
                {{ intro }}
            </p>
        {% endif %}
    {% endblock %}
</div>
