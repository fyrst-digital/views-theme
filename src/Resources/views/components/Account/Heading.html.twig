{% props
    title,
    intro = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['intro']) %}

<twig:ViewsTheme:Page:Title
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        heading: title,
    }).all() }}
>
    <twig:block name="description">
        {% if intro %}
            <p
                {{ vi_attrs('intro') }}
                class="{{ vi_class('intro') }}"
            >
                {{ intro }}
            </p>
        {% endif %}
    </twig:block>
</twig:ViewsTheme:Page:Title>
