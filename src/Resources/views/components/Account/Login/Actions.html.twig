{% props
    recoverUrl = seoUrl('frontend.account.recover.page'),
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    login: attributes.nested('login'),
    recovery: attributes.nested('recovery'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        {% block login %}
            <twig:ViewsTheme:Button
                class="{{ cx.login.apply() }}"
                {{ ...attrs.login.defaults({
                    type: 'submit',
                    color: 'primary',
                    label: 'account.loginSubmit'|trans|sw_sanitize,
                }).all() }}
            />
        {% endblock %}

        {% block recovery %}
            <twig:ViewsTheme:Button
                class="{{ cx.recovery.apply() }}"
                {{ ...attrs.recovery.defaults({
                    type: 'link',
                    color: 'link',
                    size: 'sm',
                    href: recoverUrl,
                    label: 'account.loginPasswordRecover'|trans|sw_sanitize,
                }).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
