{% props
    recoverUrl = seoUrl('frontend.account.recover.page'),
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['login', 'recovery']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% block login %}
            <twig:ViewsTheme:Button
                class="{{ vi_class('login') }}"
                {{ ...vi_attrs('login').defaults({
                    type: 'submit',
                    color: 'primary',
                    label: 'account.loginSubmit'|trans|sw_sanitize,
                }).all() }}
            />
        {% endblock %}

        {% block recovery %}
            <twig:ViewsTheme:Button
                class="{{ vi_class('recovery') }}"
                {{ ...vi_attrs('recovery').defaults({
                    type: 'link',
                    color: 'link',
                    size: 'sm',
                    href: recoverUrl,
                    label: 'account.loginPasswordRecover'|trans|sw_sanitize,
                }).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
