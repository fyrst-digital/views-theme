{% props
    editable = false,
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-account-personal-card card account-card-personal' },
    body: { base: 'vi-account-personal-card__body card-body' },
    title: { base: 'vi-account-personal-card__title card-title' },
    actions: { base: 'vi-account-personal-card__actions card-actions' },
}|replace_recursive(cva)) %}
{% do vi_define_attrs(['actions', 'body', 'title']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    <div
        {{ vi_attrs('body') }}
        class="{{ vi_class('body') }}"
    >
        {% block title %}
            <h4
                {{ vi_attrs('title') }}
                class="{{ vi_class('title') }}"
            >
                {{ 'account.overviewProfileHeader'|trans|sw_sanitize }}
            </h4>
        {% endblock %}

        {% block profile %}
            <div>
                {% if context.customer.salutation
                    and context.customer.salutation.salutationKey != 'not_specified'
                %}
                    {{ context.customer.salutation.translated.displayName }}
                {% endif %}
                {% if context.customer.title %}
                    {{ context.customer.title }}<br>
                {% endif %}
                {{ context.customer.firstName }}
                {{ context.customer.lastName }}
            </div>
        {% endblock %}

        {% block company %}{% endblock %}

        {% block email %}
            <div>{{ context.customer.email }}</div>
        {% endblock %}

        {% block actions %}
            <div
                {{ vi_attrs('actions') }}
                class="{{ vi_class('actions') }}"
            >
                {% block actions_content %}{% endblock %}
            </div>
        {% endblock %}
    </div>
</div>
