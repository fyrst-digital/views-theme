{% props
    activeRoute = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<twig:ViewsTheme:Dropdown
    class="{{ vi_class('root') }}"
    toggle:class="{{ vi_class('toggle') }}"
    {{ ...attributes.defaults({
        placement: 'bottom-end',
        'toggle:icon': 'user',
        'toggle:label': 'account.myAccount'|trans|striptags,
        'toggle:color': 'none',
        'toggle:size': 'md',
        'toggle:aria-label': 'account.myAccount'|trans|striptags,
        'toggle:title': 'account.myAccount'|trans|striptags,
        'toggle:aria-haspopup': 'dialog',
    }).all() }}
>
    <twig:ViewsTheme:Account:Menu :activeRoute="activeRoute" />
</twig:ViewsTheme:Dropdown>
