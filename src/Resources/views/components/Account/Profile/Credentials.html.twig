{% props
    customer = context.customer,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'mail']) %}

<section
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block title %}
        <h2
            {{ vi_attrs('title') }}
            class="{{ vi_class('title') }}"
        >
            {{ 'account.profileCredentialsTitle'|trans|sw_sanitize }}
        </h2>
    {% endblock %}

    {% block mail %}
        <p
            {{ vi_attrs('mail') }}
            class="{{ vi_class('mail') }}"
        >
            <span class="{{ vi_class('mailLabel') }}">{{ 'account.profileCurrentMail'|trans|sw_sanitize }}</span>
            <span class="{{ vi_class('mailValue') }}">{{ customer.email|decodeIdnEmail }}</span>
        </p>
    {% endblock %}
</section>
