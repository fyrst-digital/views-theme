{% props
    formViolations = __context.formViolations|default(null),
    passwordMinLength = config('core.loginRegistration.passwordMinLength'),
    cva = {},
%}

{% set passwordDescription = passwordMinLength != 0
    ? 'account.personalPasswordDescription'|trans({ '%minLength%': passwordMinLength })|sw_sanitize
    : null %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'form', 'newPassword', 'confirm', 'note', 'current', 'hint', 'submit']) %}

<section
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block title %}
        <h3
            {{ vi_attrs('title') }}
            class="{{ vi_class('title') }}"
        >
            {{ 'account.profilePasswordTitle'|trans|sw_sanitize }}
        </h3>
    {% endblock %}

    {% block form %}
        <twig:ViewsTheme:Form:Handler
            class="{{ vi_class('form') }}"
            {{ ...vi_attrs('form').defaults({
                id: 'profilePasswordForm',
                action: path('frontend.account.profile.password.save'),
                method: 'post',
            }).all() }}
        >
            <twig:block name="content">
                <twig:ViewsTheme:Grid gap="sm">
                    <twig:block name="content">
                        <twig:ViewsTheme:Form:Input
                            class="{{ vi_class('newPassword') }}"
                            {{ ...vi_attrs('newPassword').defaults({
                                type: 'password',
                                id: 'newPassword',
                                name: 'password[newPassword]',
                                description: passwordDescription,
                                autocomplete: 'new-password',
                                violationPath: '/newPassword',
                                formViolations: formViolations,
                                validationRules: 'required,minLength',
                                minlength: passwordMinLength,
                                label: 'account.profilePasswordCreateNew'|trans|sw_sanitize,
                            }).all() }}
                        />
                        <twig:ViewsTheme:Form:Input
                            class="{{ vi_class('confirm') }}"
                            {{ ...vi_attrs('confirm').defaults({
                                type: 'password',
                                id: 'newPasswordConfirmation',
                                name: 'password[newPasswordConfirm]',
                                autocomplete: 'new-password',
                                violationPath: '/passwordConfirmation',
                                formViolations: formViolations,
                                validationRules: 'required',
                                confirmFor: 'newPassword',
                                label: 'account.personalPasswordConfirmationLabel'|trans|sw_sanitize,
                            }).all() }}
                        />
                    </twig:block>
                </twig:ViewsTheme:Grid>

                <p
                    {{ vi_attrs('note') }}
                    class="{{ vi_class('note') }}"
                >
                    {{ 'account.profileConfirmPassword'|trans|sw_sanitize }}
                </p>

                <twig:ViewsTheme:Form:Input
                    class="{{ vi_class('current') }}"
                    {{ ...vi_attrs('current').defaults({
                        type: 'password',
                        id: 'passwordCurrent',
                        name: 'password[password]',
                        autocomplete: 'current-password',
                        violationPath: '/password',
                        formViolations: formViolations,
                        validationRules: 'required',
                        label: 'account.profilePasswordCurrent'|trans|sw_sanitize,
                    }).all() }}
                />

                <p
                    {{ vi_attrs('hint') }}
                    class="{{ vi_class('hint') }}"
                >
                    {{ 'general.requiredFields'|trans|sw_sanitize }}
                </p>

                {% vi_block submit %}
                    <twig:ViewsTheme:Button
                        class="{{ vi_class('submit') }}"
                        {{ ...vi_attrs('submit').defaults({
                            type: 'submit',
                            color: 'primary',
                            label: 'account.profileSaveChanges'|trans|sw_sanitize,
                            title: 'account.profileSaveChanges'|trans|striptags,
                        }).all() }}
                    />
                {% endvi_block %}
            </twig:block>
        </twig:ViewsTheme:Form:Handler>
    {% endblock %}
</section>
