{% sw_extends '@Storefront/storefront/component/account/login.html.twig' %}

{% props
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-account-login-card card login-card' },
    header: { base: 'vi-account-login-card__header card-header login-card-header' },
    body: { base: 'vi-account-login-card__body card-body login-card-body' },
}|replace_recursive(cva)) %}

{% set attrs = {
    header: attributes.nested('header'),
    body: attributes.nested('body'),
} %}

{% block component_account_login %}
    <div {{ attributes }} class="{{ cx.root.apply() }}">
        {% block component_account_login_header %}
            {% if cardTitle %}
                <h4 {{ attrs.header }} class="{{ cx.header.apply() }}">
                    {{ cardTitle }}
                </h4>
            {% endif %}
        {% endblock %}

        {% block component_account_login_form %}
            <div {{ attrs.body }} class="{{ cx.body.apply() }}">
                <twig:ViewsTheme:Account:Login
                    :loginError="loginError|default(false)"
                    :errorSnippet="errorSnippet|default(null)"
                    :waitTime="waitTime|default(null)"
                    :redirectTo="redirectTo|default(null)"
                    :redirectParameters="redirectParameters|default(null)"
                    :description="showDescription|default(false) ? 'account.loginFormDescription'|trans|sw_sanitize : false"
                />
            </div>
        {% endblock %}
    </div>
{% endblock %}
