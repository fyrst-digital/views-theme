{% props
    page,
    data = null,
    formViolations = __context.formViolations|default(null),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['heading', 'register']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block heading %}
        <twig:ViewsTheme:Account:Heading
            class="{{ vi_class('heading') }}"
            {{ ...vi_attrs('heading').defaults({
                title: page.group.translated.registrationTitle|default('account.registerPersonalHeader'|trans|sw_sanitize),
                intro: page.group.translated.registrationIntroduction|default(null),
            }).all() }}
        />
    {% endblock %}

    {% block register %}
        <twig:ViewsTheme:Account:Register
            class="{{ vi_class('register') }}"
            {{ ...vi_attrs('register').defaults({
                page: page,
                data: data,
                formViolations: formViolations,
                requestedGroupId: page.group.id,
                onlyCompanyRegistration: page.group.translated.registrationOnlyCompanyRegistration|default(false),
                cardTitle: false,
            }).all() }}
        />
    {% endblock %}
</div>
