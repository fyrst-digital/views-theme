{% props
    activeRoute = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults(context.customer ? {} : {
        role: 'dialog',
        'aria-label': 'account.myAccount'|trans|striptags,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% if context.customer %}
        {% block user_actions %}
            <twig:ViewsTheme:Account:UserActions :activeRoute="activeRoute" />
        {% endblock %}
    {% else %}
        {% block login_form %}
            <twig:ViewsTheme:Account:LoginForm class="p-6" />
        {% endblock %}

        {% block register_divider %}
            <div
                {{ attributes.nested('divider') }}
                class="{{ cx.divider.apply() }}"
            >
                <div
                    {{ attributes.nested('dividerLabel') }}
                    class="{{ cx.dividerLabel.apply() }}"
                >
                    {{ 'account.newCustomerLabel'|trans|sw_sanitize }}
                </div>
            </div>
        {% endblock %}

        {% block footer %}
            <div
                {{ attributes.nested('footer') }}
                class="{{ cx.footer.apply() }}"
            >
                <a
                    {{ attributes.nested('register').defaults({
                        href: path('frontend.account.login.page'),
                        title: 'account.orRegisterLink'|trans|striptags,
                    }) }}
                    class="{{ cx.register.apply() }}"
                >
                    {{ 'account.orRegisterLink'|trans|sw_sanitize }}
                </a>
            </div>
        {% endblock %}
    {% endif %}
</div>
