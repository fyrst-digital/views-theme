{% props
    email = null,
    emailConfirmation = null,
    requireEmailConfirmation = false,
    requirePasswordConfirmation = false,
    passwordMinLength = 0,
    passwordDescription = '',
    formViolations = __context.formViolations|default(null),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['email', 'emailConfirm', 'password', 'passwordConfirm']) %}

<twig:ViewsTheme:Grid
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        columns: 6,
        gap: '3',
    }).all() }}
>
    <twig:block name="content">
        <twig:ViewsTheme:Form:Input
            class="{{ vi_class('email') }}"
            {{ ...vi_attrs('email').defaults({
                type: 'email',
                id: 'personalMail',
                name: 'email',
                value: email,
                violationPath: '/email',
                formViolations: formViolations,
                validationRules: 'required,email',
                autocomplete: 'section-personal email',
                label: 'account.personalMailLabel'|trans|sw_sanitize,
            }).all() }}
        />
        {% if requireEmailConfirmation %}
            <twig:ViewsTheme:Form:Input
                class="{{ vi_class('emailConfirm') }}"
                {{ ...vi_attrs('emailConfirm').defaults({
                    type: 'email',
                    id: 'personalMailConfirmation',
                    name: 'emailConfirmation',
                    value: emailConfirmation,
                    violationPath: '/email',
                    formViolations: formViolations,
                    validationRules: 'required,email',
                    confirmFor: 'personalMail',
                    confirmMessage: 'account.personalMailConfirmationLabel'|trans|sw_sanitize,
                    autocomplete: 'section-personal email',
                    label: 'account.personalMailConfirmationLabel'|trans|sw_sanitize,
                }).all() }}
            />
        {% endif %}
        <twig:ViewsTheme:Form:Input
            class="{{ vi_class('password') }}"
            {{ ...vi_attrs('password').defaults({
                type: 'password',
                id: 'personalPassword',
                name: 'password',
                violationPath: '/password',
                formViolations: formViolations,
                validationRules: 'required',
                minlength: passwordMinLength > 0 ? passwordMinLength : null,
                autocomplete: 'new-password',
                description: passwordDescription,
                label: 'account.personalPasswordLabel'|trans|sw_sanitize,
            }).all() }}
        />
        {% if requirePasswordConfirmation %}
            <twig:ViewsTheme:Form:Input
                class="{{ vi_class('passwordConfirm') }}"
                {{ ...vi_attrs('passwordConfirm').defaults({
                    type: 'password',
                    id: 'personalPasswordConfirmation',
                    name: 'passwordConfirmation',
                    violationPath: '/passwordConfirmation',
                    formViolations: formViolations,
                    validationRules: 'required',
                    confirmFor: 'personalPassword',
                    confirmMessage: 'account.personalPasswordConfirmationLabel'|trans|sw_sanitize,
                    autocomplete: 'new-password',
                    label: 'account.personalPasswordConfirmationLabel'|trans|sw_sanitize,
                }).all() }}
            />
        {% endif %}
    </twig:block>
</twig:ViewsTheme:Grid>
