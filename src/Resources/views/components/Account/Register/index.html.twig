{% sw_extends '@Storefront/storefront/component/account/register.html.twig' %}

{%
  set classes = vi_define_classes({
    card: ['card', 'register-card'],
    header: ['card-header', 'register-card-header'],
    form: ['register-form'],
    personal: ['register-personal', 'grid', 'gap-3', 'card-body', 'border-bottom'],
    guestCol: ['g-col-12'],
    guestControl: ['form-check', 'register-guest-control', 'py-2', 'fw-semibold'],
    guestInput: ['form-check-input'],
    guestLabel: ['custom-control-label'],
    emailField: ['g-col-12'],
    emailConfirmField: ['g-col-12'],
    passwordField: ['g-col-12', 'field-user-password', 'js-form-field-toggle-guest-mode'],
    passwordConfirmField: ['g-col-12', 'field-user-password-confirmation', 'js-form-field-toggle-guest-mode'],
    address: ['register-address'],
    billing: ['register-billing', 'card-body', 'border-bottom'],
    billingTitle: ['card-title'],
    billingFields: ['grid', 'gap-3'],
    shippingToggle: ['card-body', 'd-flex', 'flex-column', 'gap-3'],
    differentShipping: ['form-check', 'register-different-shipping', 'fw-semibold'],
    shipping: ['register-shipping', 'js-form-field-toggle-shipping-address', 'd-none'],
    shippingTitle: ['card-title'],
    shippingFields: ['grid', 'gap-3'],
    privacyBody: ['card-body'],
    requiredInfo: ['form-text', 'register-required-info'],
    submit: ['register-submit', 'card-footer', 'd-flex', 'flex-row', 'flex-wrap', 'align-items-center', 'justify-content-end'],
    submitButton: ['btn', 'btn-primary', 'btn-lg'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_account_register %}
  <div {{ classes.card | vi_attr_classes }}>
    {% block component_account_register_header %}
      {% if cardTitle %}
        <h4 {{ classes.header | vi_attr_classes }}>
          {{ cardTitle }}
        </h4>
      {% endif %}
    {% endblock %}

    {% block component_account_register_form %}
      <form
        action="{{ path('frontend.account.register.save') }}"
        {{ classes.form | vi_attr_classes }}
        method="post"
        data-form-submit-loader="true"
        data-form-validation="true">
        {% block component_account_register_redirect %}
          {{ parent() }}
        {% endblock %}

        {% block component_account_register_create_account %}
          {{ parent() }}
        {% endblock %}

        {% block component_account_register_form_action %}
          {{ parent() }}
        {% endblock %}

        {% block component_account_register_personal %}
          <div {{ classes.personal | vi_attr_classes }}>
            {% block component_account_register_personal_fields %}
              {% block component_account_register_personal_address_fields %}
                {% if feature('v6.7.0.0') %}
                  {% set prefix = 'billingAddress' %}
                {% endif %}

                {%
                  sw_include '@ViewsTheme/components/Address/Personal/index.html.twig' with {
                      prefix: prefix,
                      showBirthdayField: config('core.loginRegistration.showBirthdayField'),
                      accountType: data.get('accountType')
                  }
                %}
              {% endblock %}

              {% block component_account_register_company_fields %}
                {%
                  sw_include '@ViewsTheme/components/Address/PersonalCompany/index.html.twig' with {
                      prefix: 'billingAddress',
                      address: data.get('billingAddress')
                  }
                %}
              {% endblock %}

              {% block component_account_register_guest_mode_fields %}
                {% if guestMode.active is same as(true) %}
                  <div {{ classes.guestCol | vi_attr_classes }}>
                    <div {{ classes.guestControl | vi_attr_classes }}>
                      {% block page_checkout_register_personal_guest_input %}
                        <input
                          type="checkbox"
                          {{ classes.guestInput | vi_attr_classes }}
                          name="createCustomerAccount"
                          {% if guestMode.default is same as(true) %}
                            checked
                          {% endif %}
                          value="true"
                          id="personalGuest"
                          {% if config('core.loginRegistration.createCustomerAccountDefault') == 1 %}
                            checked="checked"
                          {% endif %}
                          data-form-field-toggle="true"
                          data-form-field-toggle-target=".js-form-field-toggle-guest-mode"
                          data-form-field-toggle-value="true">
                      {% endblock %}

                      {% block page_checkout_register_personal_guest_label %}
                        <label
                          {{ classes.guestLabel | vi_attr_classes }}
                          for="personalGuest">
                          {{
                            'checkout.registerCustomermodeLabel'
                            | trans
                            | sw_sanitize
                          }}
                        </label>
                      {% endblock %}
                    </div>
                  </div>
                {% endif %}
              {% endblock %}

              {% block component_account_register_personal_account_fields %}
                  {% block component_account_register_personal_mail %}
                    {%
                      sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                          type: 'email',
                          label: 'account.personalMailLabel'|trans|sw_sanitize,
                          id: 'personalMail',
                          name: 'email',
                          value: data.get('email'),
                          autocomplete: 'section-personal email',
                          violationPath: '/email',
                          validationRules: 'required,email',
                          additionalClass: classes.emailField | vi_classes,
                      }
                    %}
                  {% endblock %}
                  {% block component_account_register_personal_mail_confirmation %}
                    {% if config('core.loginRegistration.requireEmailConfirmation') %}
                      {%
                        sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                            type: 'email',
                            label: 'account.personalMailConfirmationLabel'|trans|sw_sanitize,
                            id: 'personalMailConfirmation',
                            name: 'emailConfirmation',
                            value: data.get('emailConfirmation'),
                            autocomplete: 'section-personal email',
                            violationPath: '/email',
                            validationRules: 'confirmation,required,email',
                            additionalClass: classes.emailConfirmField | vi_classes,
                        }
                      %}
                    {% endif %}
                  {% endblock %}
                  {% block component_account_register_personal_password %}
                      {% set passwordFieldDescription = '' %}

                      {% if config('core.loginRegistration.passwordMinLength') != 0 %}
                          {% set passwordFieldDescription = 'account.personalPasswordDescription'|trans({
                              '%minLength%': config('core.loginRegistration.passwordMinLength')
                          })|sw_sanitize %}
                      {% endif %}

                      {% block component_account_register_personal_password_input %}
                          {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                              type: 'password',
                              label: 'account.personalPasswordLabel'|trans|sw_sanitize,
                              id: 'personalPassword',
                              name: 'password',
                              autocomplete: 'new-password',
                              description: passwordFieldDescription,
                              violationPath: '/password',
                              validationRules: 'required,minLength',
                              minlength: config('core.loginRegistration.passwordMinLength'),
                              additionalClass: classes.passwordField | vi_classes,
                          } %}
                      {% endblock %}
                  {% endblock %}
                  {% block component_account_register_personal_password_confirmation %}
                    {% if config('core.loginRegistration.requirePasswordConfirmation') %}
                      {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                          type: 'password',
                          label: 'account.personalPasswordConfirmationLabel'|trans|sw_sanitize,
                          id: 'personalPasswordConfirmation',
                          name: 'passwordConfirmation',
                          autocomplete: 'new-password',
                          violationPath: '/passwordConfirmation',
                          validationRules: 'required,confirmation',
                          additionalClass: classes.passwordConfirmField | vi_classes,
                      } %}
                    {% endif %}
                  {% endblock %}
                </div>
              {% endblock %}
            {% endblock %}
        {% endblock %}

        {% block component_account_register_address %}
          <div {{ classes.address | vi_attr_classes }}>
            {% block component_account_register_address_fields %}
              {% block component_account_register_address_billing %}
                <div {{ classes.billing | vi_attr_classes }}>
                  {% block component_account_register_address_billing_header %}
                    <h5 {{ classes.billingTitle | vi_attr_classes }}>
                      {{
                        'account.registerAddressBillingHeader'
                        | trans
                        | sw_sanitize
                      }}
                    </h5>
                  {% endblock %}

                  {% block component_account_register_address_billing_fields %}
                    <div {{ classes.billingFields | vi_attr_classes }}>
                      {%
                        sw_include '@ViewsTheme/components/Address/Form/index.html.twig' with {
                            prefix: 'billingAddress',
                            data: data.get('billingAddress'),
                            showNoShippingPostfix: true,
                        }
                      %}
                    </div>
                  {% endblock %}
                </div>
              {% endblock %}

              {% block component_account_register_address_different_shipping %}
                <div {{ classes.shippingToggle | vi_attr_classes }}>
                  {% block component_account_register_address_different_shipping_control %}
                    <div {{ classes.differentShipping | vi_attr_classes }}>
                      {% block component_account_register_address_different_shipping_input %}
                        {{ parent() }}
                      {% endblock %}

                      {% block component_account_register_address_different_shipping_label %}
                        {{ parent() }}
                      {% endblock %}
                    </div>
                  {% endblock %}

                  {% block component_account_register_address_shipping %}
                    <div {{ classes.shipping | vi_attr_classes }}>
                      {% block component_account_register_address_shipping_header %}
                        <h5 {{ classes.shippingTitle | vi_attr_classes }}>
                          {{
                            'account.registerAddressShippingHeader'
                            | trans
                            | sw_sanitize
                          }}
                        </h5>
                      {% endblock %}

                      {% block component_account_register_address_shipping_fields %}
                        <div {{ classes.shippingFields | vi_attr_classes }}>
                          {% block component_account_register_address_shipping_fields_personal %}
                            {%
                              sw_include '@ViewsTheme/components/Address/Personal/index.html.twig' with {
                                  prefix: 'shippingAddress',
                                  data: data.get('shippingAddress'),
                                  hideCustomerTypeSelect: false,
                                  customToggleTarget: true,
                                  accountType: data.get('shippingAddress').get('accountType')
                              }
                            %}
                          {% endblock %}

                          {% block component_account_register_address_shipping_fields_company %}
                            {%
                              sw_include '@ViewsTheme/components/Address/PersonalCompany/index.html.twig' with {
                                  prefix: 'shippingAddress',
                                  customToggleTarget: true,
                                  address: data.get('shippingAddress')
                              }
                            %}
                          {% endblock %}

                          {% block component_account_register_address_shipping_fields_address %}
                            {%
                              sw_include '@ViewsTheme/components/Address/Form/index.html.twig' with {
                                  prefix: 'shippingAddress',
                                  data: data.get('shippingAddress'),
                                  showNoShippingPostfix: true,
                                  disableNonShippableCountries: true,
                              }
                            %}
                          {% endblock %}
                        </div>
                      {% endblock %}
                    </div>
                  {% endblock %}
                </div>
              {% endblock %}
            {% endblock %}
          </div>
        {% endblock %}

        {% block component_account_register_captcha %}
          {{ parent() }}
        {% endblock %}

        <div {{ classes.privacyBody | vi_attr_classes }}>
          {% block component_account_register_privacy %}
            {% sw_include '@Storefront/storefront/component/privacy-notice.html.twig' %}
          {% endblock %}

          {% block component_account_register_required_fields %}
            <div {{ classes.requiredInfo | vi_attr_classes }}>
              {{ 'general.requiredFields' | trans | sw_sanitize }}
            </div>
          {% endblock %}
        </div>

        {% block component_account_register_footer %}
          <div {{ classes.submit | vi_attr_classes }}>
            {% block component_account_register_submit %}
              <button
                type="submit"
                {{ classes.submitButton | vi_attr_classes }}>
                {{ 'account.registerSubmit' | trans | sw_sanitize }}
              </button>
            {% endblock %}
          </div>
        {% endblock %}
      </form>
    {% endblock %}
  </div>
{% endblock %}
