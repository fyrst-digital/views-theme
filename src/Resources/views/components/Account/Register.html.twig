{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['header', 'form', 'personal', 'credentials', 'billing', 'billingForm', 'shippingToggle', 'shippingPersonal', 'shippingForm', 'footer', 'privacy', 'submit']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block header %}
        {% if cardTitle %}
            <h2 {{ vi_attrs('header') }} class="{{ vi_class('header') }}">
                {{ cardTitle }}
            </h2>
        {% endif %}
    {% endblock %}

    {% block form %}
        <twig:ViewsTheme:Form:Handler
            class="{{ vi_class('form') }}"
            {{ ...vi_attrs('form').defaults({
                action: path('frontend.account.register.save'),
                method: 'post',
            }).all() }}
        >
            <twig:block name="content">
                <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
                <input
                    type="hidden"
                    name="redirectParameters"
                    value="{{ redirectParameters is iterable ? redirectParameters|json_encode : redirectParameters }}"
                >
                <input type="hidden" name="errorRoute" value="{{ errorRoute }}">
                <input
                    type="hidden"
                    name="errorParameters"
                    value="{{ errorParameters is iterable ? errorParameters|json_encode : errorParameters }}"
                >

                {% if not guestSelectable %}
                    <input type="hidden" name="createCustomerAccount" value="1">
                {% endif %}
                {% if requestedGroupId %}
                    <input type="hidden" name="requestedGroupId" value="{{ requestedGroupId }}">
                {% endif %}

                {% block personal %}
                    <twig:ViewsTheme:Address:Personal
                        class="{{ vi_class('personal') }}"
                        {{ ...vi_attrs('personal').defaults({
                            data: billingAddress,
                            salutations: salutations,
                            page: page,
                            prefix: 'billingAddress',
                            accountType: accountType,
                            showBirthdayField: showBirthdayField,
                            onlyCompanyRegistration: onlyCompanyRegistration,
                            showVat: true,
                            formViolations: formViolations,
                        }).all() }}
                    >
                    <twig:block name="append">
                        {% vi_block account %}
                            <twig:ViewsTheme:Account:Register:Credentials
                                class="{{ vi_class('credentials') }}"
                                {{ ...vi_attrs('credentials').defaults({
                                    email: email,
                                    emailConfirmation: emailConfirmation,
                                    requireEmailConfirmation: requireEmailConfirmation,
                                    requirePasswordConfirmation: requirePasswordConfirmation,
                                    passwordMinLength: passwordMinLength,
                                    passwordDescription: passwordDescription,
                                    guestSelectable: guestSelectable,
                                    createAccountChecked: createAccountChecked,
                                    formViolations: formViolations,
                                }).all() }}
                            />
                        {% endvi_block %}
                    </twig:block>
                </twig:ViewsTheme:Address:Personal>
                {% endblock %}

                {% block billing %}
                    <fieldset {{ vi_attrs('billing') }} class="{{ vi_class('billing') }}">
                        <legend class="{{ vi_class('sectionTitle') }}">
                            {{ 'account.registerAddressBillingHeader'|trans|sw_sanitize }}
                        </legend>
                        <twig:ViewsTheme:Address:Form
                            class="{{ vi_class('billingForm') }}"
                            {{ ...vi_attrs('billingForm').defaults({
                                data: billingAddress,
                                countries: countries,
                                page: page,
                                prefix: 'billingAddress',
                                showNoShippingPostfix: true,
                                formViolations: formViolations,
                                vatInputId: 'billingAddress-vatIds',
                            }).all() }}
                        />
                    </fieldset>
                {% endblock %}

                {% block shipping %}
                    <twig:ViewsTheme:Form:Toggle
                        class="{{ vi_class('shippingToggle') }}"
                        {{ ...vi_attrs('shippingToggle').defaults({
                            value: '1',
                            open: differentShipping,
                        }).all() }}
                    >
                        <twig:block name="control">
                            <twig:ViewsTheme:Form:Switch
                                id="differentShippingAddress"
                                name="differentShippingAddress"
                                value="1"
                                :checked="differentShipping"
                                label="{{ 'account.registerDifferentShipping'|trans|sw_sanitize }}"
                            />
                        </twig:block>
                        <twig:block name="content">
                            <fieldset>
                                <legend class="{{ vi_class('sectionTitle') }}">
                                    {{ 'account.registerAddressShippingHeader'|trans|sw_sanitize }}
                                </legend>
                                <twig:ViewsTheme:Address:Personal
                                    class="{{ vi_class('shippingPersonal') }}"
                                    {{ ...vi_attrs('shippingPersonal').defaults({
                                        data: shippingAddress,
                                        salutations: salutations,
                                        page: page,
                                        prefix: 'shippingAddress',
                                        accountType: shippingAccountType,
                                        showBirthdayField: false,
                                        showVat: false,
                                        formViolations: formViolations,
                                    }).all() }}
                                />
                                <twig:ViewsTheme:Address:Form
                                    class="{{ vi_class('shippingForm') }}"
                                    {{ ...vi_attrs('shippingForm').defaults({
                                        data: shippingAddress,
                                        countries: countries,
                                        page: page,
                                        prefix: 'shippingAddress',
                                        showNoShippingPostfix: true,
                                        disableNonShippableCountries: true,
                                        formViolations: formViolations,
                                    }).all() }}
                                />
                            </fieldset>
                        </twig:block>
                    </twig:ViewsTheme:Form:Toggle>
                {% endblock %}

                {% block captcha %}
                    {% sw_include '@Storefront/storefront/component/captcha/base.html.twig' %}
                {% endblock %}

                {% block footer %}
                    <div {{ vi_attrs('footer') }} class="{{ vi_class('footer') }}">
                        <twig:ViewsTheme:Privacy:Note
                            class="{{ vi_class('privacy') }}"
                            {{ ...vi_attrs('privacy').defaults({
                                formViolations: formViolations,
                            }).all() }}
                        />
                        <p class="{{ vi_class('requiredHint') }}">
                            {{ 'general.requiredFields'|trans|sw_sanitize }}
                        </p>
                    </div>
                {% endblock %}

                {% block submit %}
                    <twig:ViewsTheme:Button
                        class="{{ vi_class('submit') }}"
                        {{ ...vi_attrs('submit').defaults({
                            type: 'submit',
                            color: 'primary',
                            size: 'lg',
                            label: 'account.registerSubmit'|trans|sw_sanitize,
                        }).all() }}
                    />
                {% endblock %}
            </twig:block>
        </twig:ViewsTheme:Form:Handler>
    {% endblock %}
</div>
