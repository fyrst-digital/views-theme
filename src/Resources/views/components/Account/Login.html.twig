{% props
    loginRoute = 'frontend.account.login',
    description = 'account.loginFormDescription'|trans|sw_sanitize,
    redirectTo = null,
    redirectParameters = null,
    loginError = false,
    errorSnippet = null,
    waitTime = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<form
    {{ attributes.defaults({
        action: path(loginRoute),
        method: 'post',
        'data-form-handler': 'true',
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block redirect %}
        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
        <input
            type="hidden"
            name="redirectParameters"
            value="{{ redirectParameters is iterable ? redirectParameters|json_encode : redirectParameters }}"
        >
    {% endblock %}

    {% block error %}
        {% if loginError %}
            {% if errorSnippet != null %}
                <twig:ViewsTheme:Alert
                    type="danger"
                    content="{{ errorSnippet|trans|sw_sanitize({}, true) }}"
                    announceOnLoad
                    ariaLive="assertive"
                />
            {% elseif waitTime != null %}
                <twig:ViewsTheme:Alert
                    type="info"
                    content="{{ 'account.loginThrottled'|trans({'%seconds%': waitTime|number_format})|sw_sanitize }}"
                    announceOnLoad
                />
            {% else %}
                <twig:ViewsTheme:Alert
                    type="danger"
                    content="{{ 'account.loginBadCredentials'|trans|sw_sanitize }}"
                    announceOnLoad
                    ariaLive="assertive"
                />
            {% endif %}
        {% endif %}
    {% endblock %}

    {% block description %}
        {% if description is not empty %}
            <div
                {{ attributes.nested('description') }}
                class="{{ cx.description.apply() }}"
            >
                {{ description }}
            </div>
        {% endif %}
    {% endblock %}

    {% block username %}
        {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
            type: 'email',
            label: 'account.loginMailLabel'|trans|sw_sanitize,
            id: 'loginMail',
            name: 'username',
            autocomplete: 'username webauthn',
            error: loginError,
            validationRules: 'required,email',
            additionalClass: 'vi-account-login__email login-form-email flex-fill',
        } %}
    {% endblock %}

    {% block password %}
        {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
            type: 'password',
            label: 'account.loginPasswordLabel'|trans|sw_sanitize,
            id: 'loginPassword',
            name: 'password',
            autocomplete: 'current-password',
            error: loginError,
            validationRules: 'required',
            additionalClass: 'vi-account-login__password login-form-password flex-fill',
        } %}
    {% endblock %}

    {% block actions %}
        <twig:ViewsTheme:Account:Login:Actions />
    {% endblock %}
</form>
