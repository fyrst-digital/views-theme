{% props
    page,
    formViolations = __context.formViolations|default(null),
    passwordMinLength = config('core.loginRegistration.passwordMinLength'),
    cva = {},
%}

{% set passwordDescription = passwordMinLength != 0
    ? 'account.personalPasswordDescription'|trans({ '%minLength%': passwordMinLength })|sw_sanitize
    : null %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['form', 'title', 'password', 'confirm', 'submit']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block form %}
        <twig:ViewsTheme:Form:Handler
            class="{{ vi_class('form') }}"
            {{ ...vi_attrs('form').defaults({
                action: path('frontend.account.recover.password.reset'),
                method: 'post',
            }).all() }}
        >
            <twig:block name="content">
                {% block title %}
                    <h1
                        {{ vi_attrs('title') }}
                        class="{{ vi_class('title') }}"
                    >
                        {{ 'account.profileRecoverPasswordTitle'|trans|sw_sanitize }}
                    </h1>
                {% endblock %}

                <twig:ViewsTheme:Form:Input
                    class="{{ vi_class('password') }}"
                    {{ ...vi_attrs('password').defaults({
                        type: 'password',
                        id: 'newPassword',
                        name: 'password[newPassword]',
                        description: passwordDescription,
                        autocomplete: 'new-password',
                        violationPath: '/newPassword',
                        formViolations: formViolations,
                        validationRules: 'required,minLength',
                        minlength: passwordMinLength,
                        label: 'account.profilePasswordCreateNew'|trans|sw_sanitize,
                    }).all() }}
                />
                <twig:ViewsTheme:Form:Input
                    class="{{ vi_class('confirm') }}"
                    {{ ...vi_attrs('confirm').defaults({
                        type: 'password',
                        id: 'newPasswordConfirmation',
                        name: 'password[newPasswordConfirm]',
                        autocomplete: 'new-password',
                        violationPath: '/newPasswordConfirm',
                        formViolations: formViolations,
                        validationRules: 'required',
                        confirmFor: 'newPassword',
                        label: 'account.personalPasswordConfirmationLabel'|trans|sw_sanitize,
                    }).all() }}
                />

                <input type="hidden" id="passwordHash" name="password[hash]" value="{{ page.hash }}" required>

                {% vi_block submit %}
                    <twig:ViewsTheme:Button
                        class="{{ vi_class('submit') }}"
                        {{ ...vi_attrs('submit').defaults({
                            type: 'submit',
                            color: 'primary',
                            label: 'account.profileChangePassword'|trans|sw_sanitize,
                        }).all() }}
                    />
                {% endvi_block %}
            </twig:block>
        </twig:ViewsTheme:Form:Handler>
    {% endblock %}
</div>
