{% props
    active = null,
    label = null,
    param = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['list', 'panels']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Tabs',
        'data-component-options': {
            active: active,
            param: param,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block list %}
        <twig:ViewsTheme:Tabs:List
            class="{{ vi_class('list') }}"
            {{ ...vi_attrs('list').defaults({
                label: label,
            }).all() }}
        >
            <twig:block name="content">{% vi_block tabs %}{% endvi_block %}</twig:block>
        </twig:ViewsTheme:Tabs:List>
    {% endblock %}

    {% block panels %}
        <div {{ vi_attrs('panels') }} class="{{ vi_class('panels') }}">
            {% block panel %}{% endblock %}
        </div>
    {% endblock %}
</div>
