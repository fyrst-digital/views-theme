{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['container', 'row', 'shop', 'services', 'bottom']) %}

<footer
    {{ attributes.without('data-component-template') }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% if footer %}
            {% block container %}
                <div {{ vi_attrs('container') }} class="{{ vi_class('container') }}">
                    {% block row %}
                        <div {{ vi_attrs('row') }} class="{{ vi_class('row') }}">
                            {% block shop %}
                                <div {{ vi_attrs('shop') }} class="{{ vi_class('shop') }}">
                                    {{ 'viewsTheme.shopCopyright'|trans({
                                        '%year%': 'now'|date('Y'),
                                        '%shop%': config('core.basicInformation.shopName')|default(context.salesChannel.translated.name|default(''), true),
                                    })|sw_sanitize }}
                                </div>
                            {% endblock %}

                            {% block services %}
                                <twig:ViewsTheme:Page:Footer:Services
                                    class="{{ vi_class('services') }}"
                                    {{ ...vi_attrs('services').defaults({
                                        serviceMenu: footer.serviceMenu,
                                    }).all() }}
                                />
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block bottom %}
                        <twig:ViewsTheme:Page:Footer:Bottom
                            {{ ...vi_attrs('bottom').defaults({
                                shippingUrl: shippingUrl,
                                brand: brand,
                            }).all() }}
                        />
                    {% endblock %}
                </div>
            {% endblock %}
        {% endif %}
    {% endblock %}
</footer>
