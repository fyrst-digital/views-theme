{% props
    collapsible = true,
    id = 'vi-footer-column-' ~ random(),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['headline', 'title', 'toggle', 'content']) %}

{% set titleId = id ~ '-title' %}
{% set contentId = id ~ '-content' %}

<div
    {{ attributes.defaults({
        role: 'listitem',
        'data-component': collapsible ? 'ViewsTheme:Page:Footer:Column' : false,
    }) }}
    class="{{ vi_class('root') }}"
>
    <div {{ vi_attrs('headline') }} class="{{ vi_class('headline') }}">
        <div
            {{ vi_attrs('title').defaults({
                id: titleId,
            }) }}
            class="{{ vi_class('title') }}"
        >
            {% block headline %}{% endblock %}
        </div>

        {% if collapsible %}
            <button
                {{ vi_attrs('toggle').defaults({
                    type: 'button',
                    'aria-expanded': 'false',
                    'aria-controls': contentId,
                    'aria-labelledby': titleId,
                }) }}
                class="{{ vi_class('toggle') }}"
            >
                {{ vi_icon('caret-down', { class: vi_class('caret') }) }}
            </button>
        {% endif %}
    </div>

    <div
        {{ vi_attrs('content').defaults({
            id: contentId,
        }) }}
        class="{{ vi_class('content') }}"
    >
        {% block content %}{% endblock %}
    </div>
</div>
