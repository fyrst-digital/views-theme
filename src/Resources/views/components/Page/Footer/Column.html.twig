{% props
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'footer-column' },
    headline: { base: 'footer-column-headline footer-headline' },
    content: { base: 'footer-column-content-container' },
}|replace_recursive(cva)) %}

{% set attrs = {
    headline: attributes.nested('headline'),
    content: attributes.nested('content'),
} %}

{% block component_footer_column %}
    <div {{ attributes }} class="{{ cx.root.apply() }}">

        {% block component_footer_column_inner %}

            {% block component_footer_column_headline %}
                <div
                    {{ attrs.headline.defaults({
                        role: 'listitem',
                    }) }}
                    class="{{ cx.headline.apply() }}"
                >

                    {% block component_footer_column_headline_title %}
                    {% endblock %}
                </div>
            {% endblock %}

            {% block component_footer_column_content_container %}
                <div {{ attrs.content }} class="{{ cx.content.apply() }}">

                    {% block component_footer_column_content %}
                    {% endblock %}
                </div>
            {% endblock %}
        {% endblock %}
    </div>
{% endblock %}
