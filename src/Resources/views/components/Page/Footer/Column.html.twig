{% props
    collapsible = false,
    collapseUntil = 'md',
    id = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['headline', 'title', 'toggle', 'content']) %}

{% set columnId = collapsible ? (id ? id : 'vi-footer-column-' ~ random()) : null %}
{% set titleId = columnId ? columnId ~ '-title' : null %}
{% set contentId = columnId ? columnId ~ '-content' : null %}

<div
    {{ attributes.defaults({
        'data-component': collapsible ? 'ViewsTheme:Page:Footer:Column' : false,
        'data-collapse-until': collapsible ? collapseUntil : false,
    }) }}
    class="{{ vi_class('root', { collapsible: collapsible }) }}"
>
    <div {{ vi_attrs('headline') }} class="{{ vi_class('headline', { collapsible: collapsible }) }}">
        <div
            {{ vi_attrs('title').defaults({
                id: titleId ?? false,
            }) }}
            class="{{ vi_class('title') }}"
        >
            {% block headline %}{% endblock %}
        </div>

        {% if collapsible %}
            <button
                {{ vi_attrs('toggle').defaults({
                    type: 'button',
                    'aria-expanded': 'false',
                    'aria-controls': contentId,
                    'aria-labelledby': titleId,
                }) }}
                class="{{ vi_class('toggle', { collapseUntil: collapseUntil }) }}"
            >
                {{ vi_icon('caret-down', { class: vi_class('caret') }) }}
            </button>
        {% endif %}
    </div>

    <div
        {{ vi_attrs('content').defaults({
            id: contentId ?? false,
        }) }}
        class="{{ vi_class('content') }}"
    >
        {% if collapsible %}<div class="{{ vi_class('body', { collapseUntil: collapseUntil }) }}">{% endif %}
            {% block content %}{% endblock %}
        {% if collapsible %}</div>{% endif %}
    </div>
</div>
