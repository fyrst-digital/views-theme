{% props
    footer = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['item', 'paypal']) %}

{% set paypalBanner = footer ? footer.extensions.payPalInstallmentBannerData|default(null) : null %}
{% set paypalEnabled = paypalBanner and paypalBanner.footerEnabled %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {%- if paypalEnabled -%}
        <div
            {{ vi_attrs('paypal').defaults({
                'data-swag-paypal-installment-banner': true,
                'data-swag-pay-pal-installment-banner-options': paypalBanner|json_encode,
            }) }}
            class="{{ vi_class('paypal') }}"
        ></div>
    {%- endif -%}

    {%- if footer -%}
        {%- for paymentMethod in footer.paymentMethods -%}
            {%- if paymentMethod.media -%}
                <div {{ vi_attrs('item') }} class="{{ vi_class('item') }}">
                    {% sw_thumbnails 'footer-payment-image-thumbnails' with {
                        media: paymentMethod.media,
                        sizes: { default: '100px' },
                        attributes: {
                            class: vi_class('image'),
                            alt: (paymentMethod.media.translated.alt|default(paymentMethod.translated.name)),
                            title: (paymentMethod.media.translated.title|default(paymentMethod.translated.name)),
                        },
                    } %}
                </div>
            {%- endif -%}
        {%- endfor -%}

        {%- for shippingMethod in footer.shippingMethods -%}
            {%- if shippingMethod.media -%}
                <div {{ vi_attrs('item') }} class="{{ vi_class('item') }}">
                    {% sw_thumbnails 'footer-shipping-image-thumbnails' with {
                        media: shippingMethod.media,
                        sizes: { default: '100px' },
                        attributes: {
                            class: vi_class('image'),
                            alt: (shippingMethod.media.translated.alt|default(shippingMethod.translated.name)),
                            title: (shippingMethod.media.translated.title|default(shippingMethod.translated.name)),
                        },
                    } %}
                </div>
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
</div>
