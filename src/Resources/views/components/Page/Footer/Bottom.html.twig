{% props
    showVatNotice = true,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['container', 'serviceList', 'serviceItem', 'serviceLink', 'vat', 'copyright']) %}

{% block component_footer_bottom %}
    <div {{ attributes }} class="{{ vi_class('root') }}">
    
    {% block component_footer_bottom_container %}
        <div {{ vi_attrs('container') }} class="{{ vi_class('container') }}">

            {% block component_footer_bottom_service_list %}
                {% if page.header.serviceMenu %}
                    <ul {{ vi_attrs('serviceList') }} class="{{ vi_class('serviceList') }}">
                        {% for serviceMenuItem in page.header.serviceMenu %}
                            {% block component_footer_bottom_service_item %}
                                <li {{ vi_attrs('serviceItem') }} class="{{ vi_class('serviceItem') }}">
                                    {% block component_footer_bottom_service_link %}
                                        <a
                                            {{ vi_attrs('serviceLink').defaults({
                                                href: category_url(serviceMenuItem),
                                                title: serviceMenuItem.translated.name,
                                                target: category_linknewtab(serviceMenuItem) ? '_blank' : null,
                                            }) }}
                                            class="{{ vi_class('serviceLink') }}"
                                        >
                                            {{ serviceMenuItem.translated.name }}
                                        </a>
                                    {% endblock %}
                                </li>
                            {% endblock %}
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endblock %}

            {% block component_footer_bottom_vat_notice %}
                {% if showVatNotice is same as(true) %}
                    <div {{ vi_attrs('vat') }} class="{{ vi_class('vat') }}">
                        {% if context.taxState == 'gross' %}
                            {{ 'footer.includeVatText'|trans({
                                '%url%': path('frontend.cms.page', { id: config('core.basicInformation.shippingPaymentInfoPage') })
                            })|raw }}
                        {% else %}
                            {{ 'footer.excludeVatText'|trans({
                                '%url%': path('frontend.cms.page', { id: config('core.basicInformation.shippingPaymentInfoPage') })
                            })|raw }}
                        {% endif %}
                    </div>
                {% endif %}
            {% endblock %}

            {% block component_footer_bottom_copyright %}
                <div {{ vi_attrs('copyright') }} class="{{ vi_class('copyright') }}">
                    {{ 'footer.copyrightInfo'|trans|sw_sanitize }}
                </div>
            {% endblock %}

        </div>
    {% endblock %}

    </div>
{% endblock %}
