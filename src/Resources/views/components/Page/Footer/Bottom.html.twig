{% props
    shippingUrl = '#',
    showVatNotice = true,
    brand = '<a href="https://fyrst.dev" target="_blank" rel="noopener noreferrer" class="link-underline link-offset-1 link-underline-opacity-50 text-body-tertiary fw-semibold">fyrst.dev</a>',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['vat', 'copyright']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block vat %}
        {% if showVatNotice %}
            <div {{ vi_attrs('vat') }} class="{{ vi_class('vat') }}">
                {{ (context.taxState == 'gross' ? 'footer.includeVatTextPage' : 'footer.excludeVatTextPage')|trans({
                    '%url%': shippingUrl,
                    '%star%': '',
                })|raw }}
            </div>
        {% endif %}
    {% endblock %}

    {% block copyright %}
        <div {{ vi_attrs('copyright') }} class="{{ vi_class('copyright') }}">
            {{ 'viewsTheme.copyright'|trans({ '%brand%': brand })|raw }}
        </div>
    {% endblock %}
</div>
