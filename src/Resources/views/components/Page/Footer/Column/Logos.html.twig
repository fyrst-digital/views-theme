{% props
    paymentLogos = [],
    shippingLogos = [],
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['list', 'column', 'items']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        <div
            {{ vi_attrs('list').defaults({
                role: 'list',
            }) }}
            class="{{ vi_class('list') }}"
        >
            {% block prepend %}{% endblock %}

            {% block payment %}
                {% if paymentLogos|length > 0 %}
                    <twig:ViewsTheme:Page:Footer:Column
                        title:class="{{ vi_class('title') }}"
                        {{ ...vi_attrs('column').defaults({
                            role: 'listitem',
                            cva: { root: { base: vi_class('column') } },
                        }).all() }}
                    >
                        <twig:block name="headline">
                            {% vi_block paymentHeadline %}
                                {{ 'checkout.paymentMethod'|trans|sw_sanitize }}
                            {% endvi_block %}
                        </twig:block>

                        <twig:block name="content">
                            {% vi_block paymentContent %}
                                <div {{ vi_attrs('items') }} class="{{ vi_class('items') }}">
                                    {%- for item in paymentLogos -%}
                                        {% sw_thumbnails 'footer-payment-image-thumbnails' with {
                                            media: item.media,
                                            sizes: { default: '100px' },
                                            attributes: {
                                                class: vi_class('image'),
                                                alt: item.alt,
                                                title: item.title,
                                            },
                                        } %}
                                    {%- endfor -%}
                                </div>
                            {% endvi_block %}
                        </twig:block>
                    </twig:ViewsTheme:Page:Footer:Column>
                {% endif %}
            {% endblock %}

            {% block shipping %}
                {% if shippingLogos|length > 0 %}
                    <twig:ViewsTheme:Page:Footer:Column
                        title:class="{{ vi_class('title') }}"
                        {{ ...vi_attrs('column').defaults({
                            role: 'listitem',
                            cva: { root: { base: vi_class('column') } },
                        }).all() }}
                    >
                        <twig:block name="headline">
                            {% vi_block shippingHeadline %}
                                {{ 'checkout.shippingMethod'|trans|sw_sanitize }}
                            {% endvi_block %}
                        </twig:block>

                        <twig:block name="content">
                            {% vi_block shippingContent %}
                                <div {{ vi_attrs('items') }} class="{{ vi_class('items') }}">
                                    {%- for item in shippingLogos -%}
                                        {% sw_thumbnails 'footer-shipping-image-thumbnails' with {
                                            media: item.media,
                                            sizes: { default: '100px' },
                                            attributes: {
                                                class: vi_class('image'),
                                                alt: item.alt,
                                                title: item.title,
                                            },
                                        } %}
                                    {%- endfor -%}
                                </div>
                            {% endvi_block %}
                        </twig:block>
                    </twig:ViewsTheme:Page:Footer:Column>
                {% endif %}
            {% endblock %}

            {% block append %}{% endblock %}
        </div>
    {% endblock %}
</div>
