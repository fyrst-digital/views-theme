{% props
    contactUrl = '#',
    revocationUrl = '#',
    showRevocation = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['revocation']) %}

<twig:ViewsTheme:Page:Footer:Column
    class="{{ vi_class('root') }}"
    {{ ...attributes.all() }}
>
    <twig:block name="headline">
        {{ 'footer.serviceHotlineHeadline'|trans|sw_sanitize }}
    </twig:block>
    <twig:block name="content">
        <p class="{{ vi_class('hotline') }}">
            {{ 'footer.serviceHotline'|trans|sw_sanitize }}
        </p>
        <div class="{{ vi_class('contact') }}">
            {{ 'footer.serviceContactTextPage'|trans({
                '%url%': contactUrl,
            })|raw }}
        </div>
        <twig:ViewsTheme:Page:Footer:Revocation
            class="{{ vi_class('revocation') }}"
            {{ ...vi_attrs('revocation').defaults({
                url: revocationUrl,
                visible: showRevocation,
            }).all() }}
        />
    </twig:block>
</twig:ViewsTheme:Page:Footer:Column>
