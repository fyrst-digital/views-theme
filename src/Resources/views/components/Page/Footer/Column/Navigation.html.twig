{% sw_extends '@ViewsTheme/components/Page/Footer/Column.html.twig' %}

{% props
    navigation,
    cva = {},
%}

{# Child-only slots (parent Column exports root/headline/content) #}
{% do vi_define_cva({
    headlineLink: { base: 'footer-headline-link' },
    linkList: { base: 'footer-link-list' },
    linkItem: { base: 'footer-link-item' },
    link: { base: 'footer-link' },
}|replace_recursive(cva), ['headlineLink', 'linkList', 'linkItem', 'link']) %}
{% do vi_define_attrs(['headlineLink', 'linkList', 'linkItem', 'link']) %}

{% block component_footer_column_headline_title %}
  {% if navigation.category.type == 'folder' %}
    {{ navigation.category.translated.name }}
  {% else %}
    <a
      {{ vi_attrs('headlineLink').defaults({
          href: category_url(navigation.category),
          title: navigation.category.translated.name,
          target: category_linknewtab(navigation.category) ? '_blank' : null,
      }) }}
      class="{{ vi_class('headlineLink') }}"
    >
      {{ navigation.category.translated.name }}
    </a>
  {% endif %}
{% endblock %}

{% block component_footer_column_content %}
  <ul {{ vi_attrs('linkList') }} class="{{ vi_class('linkList') }}">
    {% for treeItem in navigation.children %}
      {% set category = treeItem.category %}
      {% set categoryName = category.translated.name %}

      <li {{ vi_attrs('linkItem') }} class="{{ vi_class('linkItem') }}">
        {% if category.type == 'folder' %}
          <div>{{ categoryName }}</div>
        {% else %}
          <a
            {{ vi_attrs('link').defaults({
                href: category_url(category),
                title: categoryName,
                target: category_linknewtab(category) ? '_blank' : null,
            }) }}
            class="{{ vi_class('link') }}"
          >
            {{ categoryName }}
          </a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endblock %}
