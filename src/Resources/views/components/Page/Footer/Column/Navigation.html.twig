{% props
    navigation,
    collapsible = null,
    collapseUntil = 'md', # sm | md | lg | xl | xxl
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['column', 'headlineLink', 'linkList', 'linkItem', 'link']) %}

<div
    {{ attributes.defaults({
        role: 'list',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% for root in navigation.tree %}
        <twig:ViewsTheme:Page:Footer:Column
            class="{{ vi_class('column') }}"
            {{ ...vi_attrs('column').defaults({
                role: 'listitem',
                collapsible: collapsible is not null ? collapsible : root.children|default([])|length > 0,
                collapseUntil: collapseUntil,
            }).all() }}
        >
            <twig:block name="headline">
                {% if root.category.type == 'folder' %}
                    {{ root.category.translated.name }}
                {% else %}
                    <twig:ViewsTheme:Button
                        class="{{ vi_class('headlineLink') }}"
                        {{ ...vi_attrs('headlineLink').defaults({
                            type: 'link',
                            href: category_url(root.category),
                            title: root.category.translated.name,
                            target: category_linknewtab(root.category) ? '_blank' : false,
                            rel: category_linknewtab(root.category) ? 'noopener noreferrer' : false,
                            color: 'dark',
                            size: 'md',
                            link: true,
                            label: root.category.translated.name,
                        }).all() }}
                    />
                {% endif %}
            </twig:block>

            <twig:block name="content">
                {% if root.children|default([])|length > 0 %}
                    <ul {{ vi_attrs('linkList') }} class="{{ vi_class('linkList') }}">
                        {% for treeItem in root.children %}
                            {% set category = treeItem.category %}
                            {% set categoryName = category.translated.name %}

                            <li {{ vi_attrs('linkItem') }} class="{{ vi_class('linkItem') }}">
                                {% if category.type == 'folder' %}
                                    <div>{{ categoryName }}</div>
                                {% else %}
                                    <twig:ViewsTheme:Button
                                        class="{{ vi_class('link') }}"
                                        {{ ...vi_attrs('link').defaults({
                                            type: 'link',
                                            href: category_url(category),
                                            title: categoryName,
                                            target: category_linknewtab(category) ? '_blank' : false,
                                            rel: category_linknewtab(category) ? 'noopener noreferrer' : false,
                                            color: 'dark',
                                            size: 'sm',
                                            link: true,
                                            label: categoryName,
                                        }).all() }}
                                    />
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </twig:block>
        </twig:ViewsTheme:Page:Footer:Column>
    {% endfor %}
</div>
