{% props
    footer = null,
    contactUrl = '#',
    revocationUrl = '#',
    showRevocation = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['wrapper', 'columns', 'company', 'navigation', 'column']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        <div {{ vi_attrs('wrapper') }} class="{{ vi_class('wrapper') }}">
            {% block columns %}
                <twig:ViewsTheme:Grid
                    class="{{ vi_class('columns') }}"
                    {{ ...vi_attrs('columns').defaults({
                        gap: 'custom',
                        columns: 'custom',
                    }).all() }}
                >
                    <twig:block name="content">

                        {% vi_block prepend %}{% endvi_block %}

                        {% vi_block company %}
                            <twig:ViewsTheme:Page:Footer:Column:Company
                                class="{{ vi_class('column') }}"
                                {{ ...vi_attrs('company').defaults({
                                    contactUrl: contactUrl,
                                    revocationUrl: revocationUrl,
                                    showRevocation: showRevocation,
                                }).all() }}
                            />
                        {% endvi_block %}

                        {% vi_block navigation %}
                            {% if footer and footer.navigation and footer.navigation.tree|default([])|length > 0 %}
                                <twig:ViewsTheme:Page:Footer:Column:Navigation
                                    class="{{ vi_class('column') }}"
                                    {{ ...vi_attrs('navigation').defaults({
                                        navigation: footer.navigation,
                                    }).all() }}
                                />
                            {% endif %}
                        {% endvi_block %}

                        {% vi_block append %}{% endvi_block %}
                    </twig:block>
                </twig:ViewsTheme:Grid>
            {% endblock %}
        </div>
    {% endblock %}
</div>
