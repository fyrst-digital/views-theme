{% do vi_define_cva({
    root: { base: 'd-inline-flex' },
    text: { base: '' },
    image: { base: 'img-fluid' },
}|replace_recursive(cva)) %}
{% do vi_define_attrs(['image', 'text']) %}

<{{ element|raw }}
    {{ attributes.defaults({
        href: element is same as('a') ? href : null,
        title: title ?? 'header.logoLink'|trans|striptags,
    }).without('data-component-template').without('class') }}
    class="{{ vi_class('root') }}"
>
    {% if textLogo is not empty %}
        {% block text %}
            <span
                {{ vi_attrs('text').without('class') }}
                class="{{ vi_class('text') }}"
            >
                {{ textLogo|raw }}
            </span>
        {% endblock %}
    {% else %}
        {% block picture %}
            <picture style="display: contents;">
                {% block image_tablet %}
                    {% if tabletLogoPath %}
                        <source
                            srcset="{{ tabletLogoPath|sw_encode_url }}"
                            media="(min-width: {{ theme_config('breakpoint.md') }}px) and (max-width: {{ theme_config('breakpoint.lg') - 1 }}px)"
                        >
                    {% endif %}
                {% endblock %}

                {% block image_mobile %}
                    {% if mobileLogoPath %}
                        <source
                            srcset="{{ mobileLogoPath|sw_encode_url }}"
                            media="(max-width: {{ theme_config('breakpoint.md') - 1 }}px)"
                        >
                    {% endif %}
                {% endblock %}

                {% block image %}
                    {% if logoPath %}
                        <img
                            {{ vi_attrs('image').defaults({
                                src: logoPath|sw_encode_url,
                                alt: title ?? 'header.logoLink'|trans|striptags,
                                style: 'width: var(--vi-logo-w, auto)',
                            }) }}
                            class="{{ vi_class('image') }}"
                        >
                    {% endif %}
                {% endblock %}
            </picture>
        {% endblock %}
    {% endif %}
</{{ element|raw }}>
