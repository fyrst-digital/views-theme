{% props
    offcanvasCartOptions = { autoFocus: true },
    defaultBaseClasses = 'vi-header-action-cart',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}

<button
    title="{{ 'checkout.cartTitle'|trans|striptags }}"
    aria-label="{{ 'checkout.cartTitle'|trans|striptags }}"
    data-off-canvas-cart="true"
    data-off-canvas-cart-options="{{ offcanvasCartOptions|json_encode }}"
    data-component="ViewsTheme:Page:Header:Action:Cart"
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {{ vi_icon('handbag') }}
</button>
