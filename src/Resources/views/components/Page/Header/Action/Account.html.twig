{% props
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-header-action-account dropdown' },
    toggle: { base: 'vi-header-action-account__toggle' },
}|replace_recursive(cva)) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block toggle %}
        <button
            type="button"
            id="accountWidget"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="{{ 'account.myAccount'|trans|striptags }}"
            title="{{ 'account.myAccount'|trans|striptags }}"
            {{ attributes.nested('toggle') }}
            class="{{ cx.toggle.apply() }}"
        >
            {{ vi_icon('user') }}
        </button>
    {% endblock %}

    {% block dropdown %}
        <twig:ViewsTheme:Account:Dropdown />
    {% endblock %}
</div>
