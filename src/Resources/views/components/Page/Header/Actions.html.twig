{% props
    wishlist = config('core.cart.wishlistEnabled'),
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'col d-flex justify-content-end align-items-center' },
}|replace_recursive(cva)) %}

<div
    {{ attributes.without('class').without('data-component-template') }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}

        {% block menu %}
            <twig:ViewsTheme:Navigation:Drawer:Action
                class="header-action icon-size-3 icon-size-lg-4 d-lg-none" />
        {% endblock %}

        {% block search %}
            <twig:ViewsTheme:Search:Action 
                class="header-action icon-size-3 icon-size-lg-4" />
        {% endblock %}

        {% block wishlist %}
            {% if wishlist %}
                <twig:ViewsTheme:Wishlist:Action
                    :label="false"
                    class="header-action icon-size-3 icon-size-lg-4 position-relative d-none d-lg-inline-flex" />
            {% endif %}
        {% endblock %}

        {% block account %}
            <twig:ViewsTheme:Account:Action
                :toggle:label="false"
                class="mt-2 p-0 vi-account__dropdown"
                host:class="vi-dropdown-host--lg-up"
                toggle:class="header-action icon-size-3 icon-size-lg-4" />
        {% endblock %}

        {% block cart %}
            <twig:ViewsTheme:Cart:Drawer:Action
                class="header-action icon-size-3 icon-size-lg-4 position-relative" />
        {% endblock %}

    {% endblock %}

    <twig:ViewsTheme:Cart />

    {% if wishlist %}
        <twig:ViewsTheme:Wishlist />
    {% endif %}
</div>
