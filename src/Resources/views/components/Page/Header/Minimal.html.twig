{% props
    supportDisplay = 'all',
    action = 'home',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['container', 'logo', 'support', 'back']) %}

{% set backTargets = {
    home: {
        href: path('frontend.home.page'),
        label: 'checkout.finishButtonBackToShop'|trans|striptags,
    },
    cart: {
        href: path('frontend.checkout.cart.page'),
        label: 'checkout.backToCart'|trans|striptags,
    },
} %}
{% set backTarget = backTargets[action]|default(backTargets.home) %}

<header
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block container %}
        <div {{ vi_attrs('container') }} class="{{ vi_class('container') }}">
            {% block logo %}
                <twig:ViewsTheme:Page:Logo
                    class="{{ vi_class('logo') }}"
                    {{ ...vi_attrs('logo').all() }}
                />
            {% endblock %}

            {% block support %}
                <twig:ViewsTheme:Page:Support
                    class="{{ vi_class('support', { supportDisplay: supportDisplay }) }}"
                    {{ ...vi_attrs('support').all() }}
                />
            {% endblock %}

            {% block back %}
                <twig:ViewsTheme:Button
                    class="{{ vi_class('back') }}"
                    {{ ...vi_attrs('back').defaults({
                        type: 'link',
                        href: backTarget.href,
                        color: 'light',
                        size: 'sm',
                        icon: 'arrow-left',
                        label: backTarget.label,
                        title: backTarget.label,
                    }).all() }}
                />
            {% endblock %}
        </div>
    {% endblock %}
</header>
