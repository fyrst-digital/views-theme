{% props
    action = 'home',
    cva = {},
%}

{% set backActions = {
    home: {
        href: path('frontend.home.page'),
        label: 'checkout.finishButtonBackToShop'|trans|striptags,
    },
    cart: {
        href: path('frontend.checkout.cart.page'),
        label: 'checkout.backToCart'|trans|striptags,
    },
} %}
{% set back = backActions[action] is defined ? backActions[action] : backActions.home %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['logo', 'support', 'back']) %}

<header
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block logo %}
        <twig:ViewsTheme:Page:Logo
            class="{{ vi_class('logo') }}"
            {{ ...vi_attrs('logo').all() }}
        />
    {% endblock %}

    {% block support %}
        <div
            {{ vi_attrs('support') }}
            class="{{ vi_class('support') }}"
        >
            {{ 'header.supportInfo'|trans|sw_sanitize }}
        </div>
    {% endblock %}

    {% block back %}
        <twig:ViewsTheme:Button
            class="{{ vi_class('back') }}"
            {{ ...vi_attrs('back').defaults({
                type: 'link',
                href: back.href,
                color: 'secondary',
                label: back.label,
                title: back.label,
            }).all() }}
        />
    {% endblock %}
</header>
