{% props
    navigation = null,
    widthAnchor = '--vi-header-main',
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-header-main d-flex flex-wrap flex-row align-items-center py-4 gap-3' },
    navigation: { base: 'order-lg-0 col' },
    actions: { base: 'col-lg-auto' },
}|replace_recursive(cva)) %}

<div
    {{ attributes.without('class').without('data-component-template') }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}

        {% block logo %}
            <twig:ViewsTheme:Page:Logo />
        {% endblock %}

        {% block navigation %}
            {% if navigation %}
                <twig:ViewsTheme:Navigation:Bar
                    class="{{ cx.navigation.apply() }}"
                    {{ ...attributes.nested('navigation').defaults({
                        navigation: navigation,
                        navigationDepth: context.salesChannel.navigationCategoryDepth,
                        widthAnchor: widthAnchor,
                    }).all() }}
                />
            {% endif %}
        {% endblock %}

        {% block actions %}
            <twig:ViewsTheme:Page:Header:Actions 
                class="{{ cx.actions.apply() }}" />
        {% endblock %}
    {% endblock %}
</div>
