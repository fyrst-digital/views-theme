{% props
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-header-main d-flex flex-wrap align-items-center gap-3 py-3 z-5' },
    menu: { base: 'vi-header-main__menu col d-flex justify-content-start align-items-center' },
}|replace_recursive(cva)) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block menu %}
        <div
            {{ attributes.nested('menu') }}
            class="{{ cx.menu.apply() }}"
            data-ref="menu"
        >
            <twig:ViewsTheme:Page:Header:Action:Menu />
        </div>
    {% endblock %}

    {% block logo %}
        <twig:ViewsTheme:Page:Header:Logo />
    {% endblock %}

    {% block actions %}
        <twig:ViewsTheme:Page:Header:Actions />
    {% endblock %}

    {% block search %}
        <twig:ViewsTheme:Page:Header:Search />
    {% endblock %}
</div>
