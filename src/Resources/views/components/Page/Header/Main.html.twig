{% props
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'd-flex flex-wrap flex-row align-items-center py-4' },
}|replace_recursive(cva)) %}

<div 
    {{ attributes.without('class').without('data-component-template') }}
    class="{{cx.root.apply()}}">
    {% block content %}

        {% block logo %}
            <twig:ViewsTheme:Page:Logo />
        {% endblock %}

        {% block actions %}
            <twig:ViewsTheme:Page:Header:Actions />
        {% endblock %}
    {% endblock %}
</div>
