{% props
    searchTerm = null,
    searchWidgetOptions = {},
    cva = {},
%}

{% set resolvedSearchTerm = searchTerm is not null ? searchTerm : page.searchTerm|default('') %}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults({
        id: 'searchCollapse',
    }) }}
    class="{{ cx.root.apply() }}"
>
    <div
        {{ attributes.nested('search') }}
        class="{{ cx.search.apply() }}"
    >
        {% block form %}
            <form
                {{ attributes.nested('form').defaults({
                    action: path('frontend.search.page'),
                    method: 'get',
                    'data-search-widget': 'true',
                    'data-search-widget-options': searchWidgetOptions|json_encode,
                    'data-url': path('frontend.search.suggest') ~ '?search=',
                }) }}
                class="{{ cx.form.apply() }}"
            >
                <div
                    {{ attributes.nested('container') }}
                    class="{{ cx.container.apply() }}"
                >
                    {% block input_group %}
                        <div
                            {{ attributes.nested('inputGroup') }}
                            class="{{ cx.inputGroup.apply() }}"
                        >
                            {% block input %}
                                <input
                                    {{ attributes.nested('input').defaults({
                                        type: 'search',
                                        name: 'search',
                                        autocomplete: 'off',
                                        autocapitalize: 'off',
                                        placeholder: 'header.searchPlaceholder'|trans|striptags,
                                        'aria-label': 'header.searchPlaceholder'|trans|striptags,
                                        value: resolvedSearchTerm,
                                    }) }}
                                    class="{{ cx.input.apply() }}"
                                >
                            {% endblock %}

                            {% block submit %}
                                <button
                                    {{ attributes.nested('submit').defaults({
                                        type: 'submit',
                                        'aria-label': 'header.searchButton'|trans|striptags,
                                    }) }}
                                    class="{{ cx.submit.apply() }}"
                                >
                                    {% block submit_icon %}
                                        {{ vi_icon('magnifying-glass') }}
                                    {% endblock %}
                                </button>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block close %}
                        <button
                            {{ attributes.nested('close').defaults({
                                type: 'button',
                                'data-header-search': 'close',
                            }) }}
                            class="{{ cx.close.apply() }}"
                        >
                            {% block close_icon %}
                                {{ vi_icon('x') }}
                            {% endblock %}
                        </button>
                    {% endblock %}
                </div>
            </form>
        {% endblock %}
    </div>
</div>
