{% props
    searchTerm = page.searchTerm|default(''),
    searchWidgetOptions = {},
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['search', 'form', 'container', 'inputGroup', 'input', 'submit', 'close']) %}

<div
    {{ attributes.defaults({
        id: 'searchCollapse',
    }) }}
    class="{{ vi_class('root') }}"
>
    <div
        {{ vi_attrs('search') }}
        class="{{ vi_class('search') }}"
    >
        {% block form %}
            <form
                {{ vi_attrs('form').defaults({
                    action: path('frontend.search.page'),
                    method: 'get',
                    'data-search-widget': 'true',
                    'data-search-widget-options': searchWidgetOptions|json_encode,
                    'data-url': path('frontend.search.suggest') ~ '?search=',
                }) }}
                class="{{ vi_class('form') }}"
            >
                <div
                    {{ vi_attrs('container') }}
                    class="{{ vi_class('container') }}"
                >
                    {% block input_group %}
                        <div
                            {{ vi_attrs('inputGroup') }}
                            class="{{ vi_class('inputGroup') }}"
                        >
                            {% block input %}
                                <input
                                    {{ vi_attrs('input').defaults({
                                        type: 'search',
                                        name: 'search',
                                        autocomplete: 'off',
                                        autocapitalize: 'off',
                                        placeholder: 'header.searchPlaceholder'|trans|striptags,
                                        'aria-label': 'header.searchPlaceholder'|trans|striptags,
                                        value: searchTerm,
                                    }) }}
                                    class="{{ vi_class('input') }}"
                                >
                            {% endblock %}

                            {% block submit %}
                                <button
                                    {{ vi_attrs('submit').defaults({
                                        type: 'submit',
                                        'aria-label': 'header.searchButton'|trans|striptags,
                                    }) }}
                                    class="{{ vi_class('submit') }}"
                                >
                                    {% block submit_icon %}
                                        {{ vi_icon('magnifying-glass') }}
                                    {% endblock %}
                                </button>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block close %}
                        <button
                            {{ vi_attrs('close').defaults({
                                type: 'button',
                                'data-header-search': 'close',
                            }) }}
                            class="{{ vi_class('close') }}"
                        >
                            {% block close_icon %}
                                {{ vi_icon('x') }}
                            {% endblock %}
                        </button>
                    {% endblock %}
                </div>
            </form>
        {% endblock %}
    </div>
</div>
