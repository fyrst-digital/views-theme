{% props
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    header: attributes.nested('header'),
    title: attributes.nested('title'),
    close: attributes.nested('close'),
    body: attributes.nested('body'),
} %}

{% block meta %}{% endblock %}

{% block root %}
    <div
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% block header %}
            <div {{ attrs.header }} class="{{ cx.header.apply() }}">
                {% block title %}
                    <div {{ attrs.title }} class="{{ cx.title.apply() }}">
                        {% block title_content %}{% endblock %}
                    </div>
                {% endblock %}

                {% block close %}
                    <button
                        {{ attrs.close.defaults({
                            type: 'button',
                            title: 'general.offcanvasCloseMenu'|trans|sw_sanitize,
                            'aria-label': 'general.offcanvasCloseMenu'|trans|sw_sanitize,
                        }) }}
                        class="{{ cx.close.apply() }}"
                    >
                        {% block close_icon %}
                            {{ vi_icon('x') }}
                        {% endblock %}
                    </button>
                {% endblock %}
            </div>
        {% endblock %}

        {% block body %}
            <div {{ attrs.body }} class="{{ cx.body.apply() }}">
                {% block content %}{% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
