{% props
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-offcanvas' },
    header: { base: 'vi-offcanvas__header offcanvas-header border-bottom' },
    title: { base: 'vi-offcanvas__title offcanvas-header-content fw-semibold fs-5' },
    close: { base: 'vi-offcanvas__close btn btn-light offcanvas-close js-offcanvas-close' },
    body: { base: 'vi-offcanvas__body offcanvas-body' },
}|replace_recursive(cva)) %}

{% set headerAttributes = attributes.nested('header') %}
{% set titleAttributes = attributes.nested('title') %}
{% set closeAttributes = attributes.nested('close') %}
{% set bodyAttributes = attributes.nested('body') %}

{% block meta %}{% endblock %}

{% block root %}
    <div
        {{ attributes }}
        class="{{ cx.root.apply() }}"
        data-ref="offcanvas"
    >
        {% block header %}
            <div {{ headerAttributes }} class="{{ cx.header.apply() }}">
                {% block title %}
                    <div {{ titleAttributes }} class="{{ cx.title.apply() }}">
                        {% block title_content %}{% endblock %}
                    </div>
                {% endblock %}

                {% block close %}
                    <button
                        type="button"
                        title="{{ 'general.offcanvasCloseMenu'|trans|sw_sanitize }}"
                        aria-label="{{ 'general.offcanvasCloseMenu'|trans|sw_sanitize }}"
                        {{ closeAttributes }}
                        class="{{ cx.close.apply() }}"
                    >
                        {% block close_icon %}
                            {{ vi_icon('x') }}
                        {% endblock %}
                    </button>
                {% endblock %}
            </div>
        {% endblock %}

        {% block body %}
            <div {{ bodyAttributes }} class="{{ cx.body.apply() }}">
                {% block content %}{% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
