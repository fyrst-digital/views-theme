{% props
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['header', 'title', 'close', 'body']) %}

{% block meta %}{% endblock %}

{% block root %}
    <div
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block header %}
            <div {{ vi_attrs('header') }} class="{{ vi_class('header') }}">
                {% block title %}
                    <div {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
                        {% block title_content %}{% endblock %}
                    </div>
                {% endblock %}

                {% block close %}
                    <button
                        {{ vi_attrs('close').defaults({
                            type: 'button',
                            title: 'general.offcanvasCloseMenu'|trans|sw_sanitize,
                            'aria-label': 'general.offcanvasCloseMenu'|trans|sw_sanitize,
                        }) }}
                        class="{{ vi_class('close') }}"
                    >
                        {% block close_icon %}
                            {{ vi_icon('x') }}
                        {% endblock %}
                    </button>
                {% endblock %}
            </div>
        {% endblock %}

        {% block body %}
            <div {{ vi_attrs('body') }} class="{{ vi_class('body') }}">
                {% block content %}{% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
