{% props
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% block meta %}{% endblock %}

{% block root %}
    <div
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% block header %}
            <div {{ attributes.nested('header') }} class="{{ cx.header.apply() }}">
                {% block title %}
                    <div {{ attributes.nested('title') }} class="{{ cx.title.apply() }}">
                        {% block title_content %}{% endblock %}
                    </div>
                {% endblock %}

                {% block close %}
                    <button
                        {{ attributes.nested('close').defaults({
                            type: 'button',
                            title: 'general.offcanvasCloseMenu'|trans|sw_sanitize,
                            'aria-label': 'general.offcanvasCloseMenu'|trans|sw_sanitize,
                        }) }}
                        class="{{ cx.close.apply() }}"
                    >
                        {% block close_icon %}
                            {{ vi_icon('x') }}
                        {% endblock %}
                    </button>
                {% endblock %}
            </div>
        {% endblock %}

        {% block body %}
            <div {{ attributes.nested('body') }} class="{{ cx.body.apply() }}">
                {% block content %}{% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
