{% props
    currencies = header.currencies|default(page.header.currencies|default([])),
    activeCurrencyId = context.currency.id|default(null),
    id = 'vi-currency-menu-' ~ random(),
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<form
    {{ attributes.defaults({
        method: 'post',
        action: path('frontend.checkout.configure'),
        'data-form-add-dynamic-redirect': 'true',
    }) }}
    class="{{ cx.root.apply() }}"
>
    <ul
        {{ attributes.nested('list').defaults({
            'aria-label': 'header.currencyList'|trans|striptags,
        }) }}
        class="{{ cx.list.apply() }}"
    >
        {% for currency in currencies %}
            {% set isActive = currency.id is same as(activeCurrencyId) %}

            <li {{ attributes.nested('item') }} class="{{ cx.item.apply() }}">
                <button
                    {{ attributes.nested('option').defaults({
                        type: 'submit',
                        name: 'currencyId',
                        id: id ~ '-' ~ currency.id,
                        value: currency.id,
                        'aria-current': isActive ? 'true' : null,
                    }) }}
                    class="{{ cx.option.apply({ active: isActive }) }}"
                >
                    <span {{ attributes.nested('symbol') }} class="{{ cx.symbol.apply() }}" aria-hidden="true">
                        {{ currency.symbol }}
                    </span>
                    {{ currency.translated.name }}
                </button>
            </li>
        {% endfor %}
    </ul>
</form>
