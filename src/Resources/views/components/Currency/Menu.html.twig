{% props
    currencies = header.currencies|default(page.header.currencies|default([])),
    activeCurrencyId = context.currency.id|default(null),
    id = 'vi-currency-menu-' ~ random(),
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['list', 'item', 'option', 'symbol']) %}

<form
    {{ attributes.defaults({
        method: 'post',
        action: path('frontend.checkout.configure'),
        'data-form-add-dynamic-redirect': 'true',
    }) }}
    class="{{ vi_class('root') }}"
>
    <ul
        {{ vi_attrs('list').defaults({
            'aria-label': 'header.currencyList'|trans|striptags,
        }) }}
        class="{{ vi_class('list') }}"
    >
        {% for currency in currencies %}
            {% set isActive = currency.id is same as(activeCurrencyId) %}

            <li {{ vi_attrs('item') }} class="{{ vi_class('item') }}">
                <button
                    {{ vi_attrs('option').defaults({
                        type: 'submit',
                        name: 'currencyId',
                        id: id ~ '-' ~ currency.id,
                        value: currency.id,
                        'aria-current': isActive ? 'true' : null,
                    }) }}
                    class="{{ vi_class('option', { active: isActive }) }}"
                >
                    <span {{ vi_attrs('symbol') }} class="{{ vi_class('symbol') }}" aria-hidden="true">
                        {{ currency.symbol }}
                    </span>
                    {{ currency.translated.name }}
                </button>
            </li>
        {% endfor %}
    </ul>
</form>
