{% if visible %}
    {% set cx = vi_cva_from_file(cva) %}
    {% set classes = {
        root: cx.root.apply(),
        toggle: cx.toggle.apply(),
        label: cx.label.apply(),
        symbol: cx.symbol.apply(),
        caret: cx.caret.apply(),
    } %}
    {% set attrs = {
        toggle: attributes.nested('toggle'),
    } %}
    {% set toggleAriaLabel = 'header.currencyTrigger'|trans({ '%currency%': ariaName })|striptags %}
    {% set anchorName = '--' ~ id %}

    <twig:ViewsTheme:Dropdown
        class="{{ classes.root }}"
        :id="id"
        {{ ...attributes.defaults({
            placement: placement,
        }).without('class').all() }}
    >
        <twig:block name="toggle">
            <twig:ViewsTheme:Button
                class="{{ classes.toggle }}"
                label:class="{{ classes.label }}"
                {{ ...attrs.toggle.defaults({
                    type: 'button',
                    color: 'none',
                    size: 'sm',
                    label: ariaName,
                    title: toggleAriaLabel,
                    'aria-label': toggleAriaLabel,
                    'aria-haspopup': 'listbox',
                    'aria-expanded': 'false',
                    'aria-controls': id,
                    popovertarget: id,
                    style: 'anchor-name: ' ~ anchorName,
                }).all() }}
            >
                <twig:block name="prepend">
                    {% if showSymbol and currencySymbol %}
                        <span class="{{ classes.symbol }}" aria-hidden="true">{{ currencySymbol }}</span>
                    {% endif %}
                </twig:block>

                <twig:block name="append">
                    {{ vi_icon('caret-down', { class: classes.caret }) }}
                </twig:block>
            </twig:ViewsTheme:Button>
        </twig:block>

        <twig:ViewsTheme:Currency:Menu
            :currencies="currencies"
            :activeCurrencyId="activeCurrencyId"
            :id="id"
        />
    </twig:ViewsTheme:Dropdown>
{% endif %}