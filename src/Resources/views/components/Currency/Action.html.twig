{% if visible %}
    {% do vi_define_cva(cva, ['root', 'toggle', 'label', 'symbol', 'caret']) %}
    {% do vi_define_attrs(['toggle']) %}
    {% set toggleAriaLabel = 'header.currencyTrigger'|trans({ '%currency%': ariaName })|striptags %}
    {% set anchorName = '--' ~ id %}

    <twig:ViewsTheme:Dropdown
        class="{{ vi_class('root') }}"
        :id="id"
        {{ ...attributes.defaults({
            placement: placement,
        }).without('class').all() }}
    >
        <twig:block name="toggle">
            <twig:ViewsTheme:Button
                class="{{ vi_class('toggle') }}"
                label:class="{{ vi_class('label') }}"
                {{ ...vi_attrs('toggle').defaults({
                    type: 'button',
                    color: 'none',
                    size: 'sm',
                    label: ariaName,
                    title: toggleAriaLabel,
                    'aria-label': toggleAriaLabel,
                    'aria-haspopup': 'listbox',
                    'aria-expanded': 'false',
                    'aria-controls': id,
                    popovertarget: id,
                    style: 'anchor-name: ' ~ anchorName,
                }).all() }}
            >
                <twig:block name="prepend">
                    {% if showSymbol and currencySymbol %}
                        <span class="{{ vi_class('symbol') }}" aria-hidden="true">{{ currencySymbol }}</span>
                    {% endif %}
                </twig:block>

                <twig:block name="append">
                    {{ vi_icon('caret-down', { class: vi_class('caret') }) }}
                </twig:block>
            </twig:ViewsTheme:Button>
        </twig:block>

        <twig:ViewsTheme:Currency:Menu
            :currencies="currencies"
            :activeCurrencyId="activeCurrencyId"
            :id="id"
        />
    </twig:ViewsTheme:Dropdown>
{% endif %}