{% sw_extends '@Storefront/storefront/component/listing/filter-panel.html.twig' %}

{% set iconOptions = iconOptions|default(themeParameters.icons|default({})) %}

{% block component_filter_panel_header %}
    <div class="vi-filter-panel__header">
        <div class="vi-filter-panel__title">
            {{ 'listing.filterTitleText'|trans }}
        </div>
        <div class="vi-filter-panel__close btn js-offcanvas-close">
            {{ vi_icon('x', iconOptions) }}
        </div>
    </div>
{% endblock %}

{% block component_filter_panel_items_container %}
    <div class="vi-filter-panel__container">
        {% block component_filter_panel_items %}
            {{ parent() }}
        {% endblock %}
    </div>
{% endblock %}
