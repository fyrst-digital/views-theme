{% sw_extends '@Storefront/storefront/component/listing/filter-panel.html.twig' %}

{% props
    cva = {},
%}

{% do vi_define_cva({
    header: { base: 'vi-filter-panel__header' },
    title: { base: 'vi-filter-panel__title' },
    close: { base: 'vi-filter-panel__close btn js-offcanvas-close' },
    container: { base: 'vi-filter-panel__container' },
}|replace_recursive(cva)) %}
{% do vi_define_attrs(['close', 'container', 'header', 'title']) %}

{% block component_filter_panel_header %}
    <div {{ vi_attrs('header') }} class="{{ vi_class('header') }}">
        <div {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
            {{ 'listing.filterTitleText'|trans }}
        </div>
        <div {{ vi_attrs('close') }} class="{{ vi_class('close') }}">
            {{ vi_icon('x') }}
        </div>
    </div>
{% endblock %}

{% block component_filter_panel_items_container %}
    <div {{ vi_attrs('container') }} class="{{ vi_class('container') }}">
        {% block component_filter_panel_items %}
            {{ parent() }}
        {% endblock %}
    </div>
{% endblock %}
