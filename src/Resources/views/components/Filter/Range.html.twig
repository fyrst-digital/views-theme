{% props
    displayName = null,
    minKey = 'min-price',
    maxKey = 'max-price',
    min = 0,
    max = null,
    layout = 'bar',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['fields', 'input', 'collapse']) %}

{% set groupId = 'vi-filter-group-' ~ random() %}
{% set options = {
    minKey: minKey,
    maxKey: maxKey,
    listingComponent: 'ViewsTheme:Product:Listing',
    debounce: 500,
} %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Filter:Range',
        'data-component-options': options|json_encode,
    }) }}
    class="{{ vi_class('root', { layout: layout }) }}"
>
    <twig:ViewsTheme:Filter:Group
        :label="displayName"
        :id="groupId"
        :layout="layout"
    />

    <twig:ViewsTheme:Filter:Group:Collapse
        {{ ...vi_attrs('collapse').defaults({
            id: groupId,
            layout: layout,
        }).all() }}
    >
        <div {{ vi_attrs('fields') }} class="{{ vi_class('fields') }}">
            <input
                type="number"
                inputmode="decimal"
                min="{{ min }}"
                {% if max is not null %}max="{{ max }}"{% endif %}
                placeholder="{{ min }}"
                data-range="min"
                class="{{ vi_class('input') }}"
                aria-label="{{ displayName }} min"
            >
            <input
                type="number"
                inputmode="decimal"
                min="{{ min }}"
                {% if max is not null %}max="{{ max }}"{% endif %}
                placeholder="{{ max }}"
                data-range="max"
                class="{{ vi_class('input') }}"
                aria-label="{{ displayName }} max"
            >
        </div>
    </twig:ViewsTheme:Filter:Group:Collapse>
</div>
