{% props
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['chip', 'swatch', 'reset']) %}

{% set options = {
    listingComponent: 'ViewsTheme:Product:Listing',
    changedEvent: 'ViewsTheme:Listing:Changed',
    syncedEvent: 'ViewsTheme:Listing:ControlsSynced',
    resetAllLabel: 'listing.filterPanelResetAll'|trans|sw_sanitize,
    removeLabel: 'listing.filterRemoveAriaLabel'|trans|sw_sanitize,
} %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Filter:Active',
        'data-component-options': options|json_encode,
        hidden: true,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block chip %}
        <template data-active-chip-template>
            <twig:ViewsTheme:Button
                class="{{ vi_class('chip') }}"
                {{ ...vi_attrs('chip').defaults({
                    type: 'button',
                    color: 'none',
                    size: 'sm',
                    title: false,
                    'data-filter-id': '',
                }).all() }}
            >
                <twig:block name="prepend">
                    {% vi_block swatch %}
                        <span
                            {{ vi_attrs('swatch').defaults({
                                'data-active-chip-swatch': true,
                                hidden: true,
                                'aria-hidden': 'true',
                            }) }}
                            class="{{ vi_class('swatch') }}"
                        ></span>
                    {% endvi_block %}
                </twig:block>

                <twig:block name="label">
                    {% vi_block label %}
                        <span
                            data-active-chip-label
                            class="{{ vi_class('label') }}"
                        ></span>
                    {% endvi_block %}
                </twig:block>
            </twig:ViewsTheme:Button>
        </template>
    {% endblock %}

    {% block reset %}
        <template data-active-reset-template>
            <twig:ViewsTheme:Button
                class="{{ vi_class('reset') }}"
                {{ ...vi_attrs('reset').defaults({
                    type: 'button',
                    color: 'link',
                    size: 'sm',
                    label: options.resetAllLabel,
                    'data-reset-all': true,
                }).all() }}
            />
        </template>
    {% endblock %}
</div>
