{% props
    label = null,
    count = null,
    open = false,
    id = 'vi-filter-group-' ~ random(),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['toggle']) %}

{% set anchorName = '--' ~ id %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Filter:Group',
        'data-component-options': { open: open }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block toggle %}
        <twig:ViewsTheme:Filter:Group:Toggle
            {{ ...vi_attrs('toggle').defaults({
                label: label,
                expanded: open,
                controls: id,
                count: count,
                style: 'anchor-name: ' ~ anchorName,
            }).all() }}
        />
    {% endblock %}
</div>
