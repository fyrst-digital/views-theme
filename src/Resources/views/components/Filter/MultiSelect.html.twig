{% props
    name,
    displayName = null,
    elements = [],
    propertyName = null,
    layout = 'bar',
    disabled = false,
    allowedIds = null,
    selectedIds = [],
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['list', 'item', 'chip', 'group']) %}

{% set options = {
    name: name,
    propertyName: propertyName,
    listingComponent: 'ViewsTheme:Product:Listing',
} %}

{% set facetDisabled = disabled or (allowedIds is not null and allowedIds|length == 0 and selectedIds|length == 0) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Filter:MultiSelect',
        'data-component-options': options|json_encode,
    }) }}
    class="{{ vi_class('root', { layout: layout }) }}"
>
    <twig:ViewsTheme:Filter:Group
        {{ ...vi_attrs('group').defaults({
            label: displayName,
            layout: layout,
            count: selectedIds|length > 0 ? selectedIds|length : null,
            disabled: facetDisabled,
        }).all() }}
    >
        <ul {{ vi_attrs('list') }} class="{{ vi_class('list') }}" aria-label="{{ displayName }}">
            {% for element in elements %}
                {% set elementId = element.id %}
                {% set elementLabel = element.translated.name|default(element.name)|default(elementId) %}
                {% set previewHex = element.colorHexCode|default(null) %}
                {% set previewImage = element.media.url|default(null) %}
                {% set isSelected = elementId in selectedIds %}
                {% set isDisabled = allowedIds is not null and not isSelected and elementId not in allowedIds %}
                <li {{ vi_attrs('item') }} class="{{ vi_class('item') }}">
                    <twig:ViewsTheme:Filter:Chip
                        type="checkbox"
                        :value="elementId"
                        :label="elementLabel"
                        :previewHex="previewHex"
                        :previewImageUrl="previewImage"
                        :checked="isSelected"
                        :disabled="isDisabled"
                        {{ ...vi_attrs('chip').all() }}
                    />
                </li>
            {% endfor %}
        </ul>
    </twig:ViewsTheme:Filter:Group>
</div>
