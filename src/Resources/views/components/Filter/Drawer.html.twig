{% props
    listing = null,
    showActive = true,
    label = 'listing.filterTitleText'|trans|sw_sanitize,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['panel']) %}

<twig:ViewsTheme:Drawer
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        id: 'vi-filter-drawer',
        side: 'end',
        label: label,
    }).all() }}
>
    <twig:block name="panel">
        <twig:ViewsTheme:Drawer:Panel
            {{ ...vi_attrs('panel').defaults({
                side: 'end',
                title: label,
            }).all() }}
        >
            <twig:ViewsTheme:Filter:Panel
                :listing="listing"
                :ariaLiveUpdates="true"
                :showHeader="false"
                :showActive="showActive"
                layout="stacked"
                class="p-6"
            />
        </twig:ViewsTheme:Drawer:Panel>
    </twig:block>
</twig:ViewsTheme:Drawer>
