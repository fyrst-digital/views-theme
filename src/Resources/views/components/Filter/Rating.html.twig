{% props
    displayName = null,
    name = 'rating',
    maxPoints = 5,
    id = 'vi-filter-rating-' ~ random(),
    inputName = id ~ '-input',
    layout = 'bar',
    disabled = false,
    allowedMax = null,
    selectedValue = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['list', 'item', 'chip', 'group', 'collapse', 'footer']) %}

{% set options = {
    name: name,
    listingComponent: 'ViewsTheme:Product:Listing',
} %}

{% set facetDisabled = disabled or (allowedMax is not null and allowedMax <= 0 and selectedValue is null) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Filter:Rating',
        'data-component-options': options|json_encode,
        'data-filter-key': name,
    }) }}
    class="{{ vi_class('root', { layout: layout }) }}"
>
    <twig:ViewsTheme:Filter:Group
        class="{{ vi_class('group') }}"
        {{ ...vi_attrs('group').defaults({
            id: id,
            label: displayName,
            layout: layout,
            count: selectedValue ? 1 : null,
            disabled: facetDisabled,
        }).all() }}
    >
        <twig:ViewsTheme:Filter:Group:Collapse
            class="{{ vi_class('collapse') }}"
            {{ ...vi_attrs('collapse').defaults({
                id: id,
                layout: layout,
            }).all() }}
        >
            <ul {{ vi_attrs('list') }} class="{{ vi_class('list') }}" aria-label="{{ displayName }}">
                {% for points in maxPoints..1 %}
                    {% set pointsLabel = points ~ '+' %}
                    {% set isSelected = selectedValue is not null and (points ~ '') == (selectedValue ~ '') %}
                    {% set isDisabled = facetDisabled or (allowedMax is not null and allowedMax > 0 and points > allowedMax and not isSelected) %}
                    <li {{ vi_attrs('item') }} class="{{ vi_class('item') }}">
                        <twig:ViewsTheme:Filter:Chip
                            class="{{ vi_class('chip') }}"
                            type="radio"
                            :name="inputName"
                            :value="points"
                            :label="pointsLabel"
                            :checked="isSelected"
                            :disabled="isDisabled"
                            {{ ...vi_attrs('chip').all() }}
                        />
                    </li>
                {% endfor %}
            </ul>
            <twig:ViewsTheme:Filter:Group:Footer
                class="{{ vi_class('footer') }}"
                {{ ...vi_attrs('footer').all() }}
            />
        </twig:ViewsTheme:Filter:Group:Collapse>
    </twig:ViewsTheme:Filter:Group>
</div>
