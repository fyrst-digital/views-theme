{% props
    keys = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['reset']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        <twig:ViewsTheme:Filter:Reset
            class="{{ vi_class('reset') }}"
            {{ ...vi_attrs('reset').defaults({
                keys: keys,
                icon: 'arrow-counter-clockwise',
                label: 'viewsTheme.filter.reset'|trans|sw_sanitize,
                color: 'link',
                size: 'sm',
            }).all() }}
        />
    {% endblock %}
</div>
