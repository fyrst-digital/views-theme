{% props
    id,
    layout = 'bar',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['content']) %}

{% set anchorName = '--' ~ id %}

{# Body shell for Filter:Group. Facets compose controls + Footer inside content. #}
<div
    {{ attributes.defaults({
        id: id,
    }|merge(layout == 'bar' ? {
        popover: 'auto',
        'data-placement': 'bottom-start',
        style: 'position-anchor: ' ~ anchorName,
    } : {
        hidden: true,
    })) }}
    class="{{ vi_class('root', { layout: layout }) }}"
>
    <div {{ vi_attrs('content') }} class="{{ vi_class('content') }}">
        {% block content %}{% endblock %}
    </div>
</div>
