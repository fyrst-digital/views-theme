{% props
    id,
    layout = 'bar',
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% set anchorName = '--' ~ id %}

{# Body shell for Filter:Group. Facets compose controls + Footer as direct children. #}
<div
    {{ attributes.defaults({
        id: id,
    }|merge(layout == 'bar' ? {
        popover: 'auto',
        'data-placement': 'bottom-start',
        style: 'position-anchor: ' ~ anchorName,
    } : {
        hidden: true,
    })) }}
    class="{{ vi_class('root', { layout: layout }) }}"
>
    {% block content %}{% endblock %}
</div>
