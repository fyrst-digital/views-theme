{% props
    count = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<span
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Filter:Group:Count',
        hidden: count ? false : true,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% if count %}{{ count }}{% endif %}
</span>
