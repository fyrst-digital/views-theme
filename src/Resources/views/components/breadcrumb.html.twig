{% sw_extends '@Storefront/storefront/layout/breadcrumb.html.twig' %}

{% set iconOptions = iconOptions|default(themeParameters.icons) %}

{%
  set classes = vi_define_classes({
    separator: ['breadcrumb-placeholder'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{# @deprecated tag:v6.8.0 - Block will be removed, the separator has been moved to a CSS only solution - Extend the `layout_breadcrumb_list_item` block if needed #}
{% block layout_breadcrumb_placeholder %}
  {% if key != breadcrumbKeys|last %}
    <div {{ classes.separator | vi_attr_classes }} aria-hidden="true">
      {{ vi_icon('arrow-right', iconOptions) }}
    </div>
  {% endif %}
{% endblock %}
