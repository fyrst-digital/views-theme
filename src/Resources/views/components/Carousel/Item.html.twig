{% props
    index = null, # 0-based position; with `total` sets the "N of M" label
    total = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<div
    {{ attributes.defaults({
        role: 'group',
        'aria-roledescription': 'slide',
        'aria-label': index is not null and total
            ? 'viewsTheme.carousel.slideLabel'|trans({
                '%index%': index + 1,
                '%total%': total,
            })|striptags
            : false,
        'data-component': 'ViewsTheme:Carousel:Item',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block content %}{% endblock %}
</div>
