{% sw_extends '@Storefront/storefront/component/address/address-form.html.twig' %}

{%
  set classes = vi_define_classes({
    streetField: ['field-street'],
    zipcodeField: ['field-city'],
    cityField: ['field-zipcode'],
    companyContainer: [],
    companyName: ['field-company-name'],
    companyDepartment: ['field-company-department'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_address_form_company %}
  {% if showFormCompany %}
    {% if config('core.loginRegistration.showAccountTypeSelection') %}
      {% set accountTypeRequired = true %}
    {% endif %}

    {% if config('core.loginRegistration.showAccountTypeSelection') or prefix == 'address' or prefix == 'shippingAddress' or hasSelectedBusiness %}
      <div {{ classes.companyContainer | vi_attr_classes }}>
        {% block component_address_form_company_fields %}
          {% block component_address_form_company_name %}
            {%
              sw_include '@Storefront/storefront/component/address/field/address-company-name-field.html.twig' with {
                additionalClass: classes.companyName|join(' ')
              }
            %}
          {% endblock %}

          {% block component_address_form_company_department %}
            {%
              sw_include '@Storefront/storefront/component/address/field/address-company-department-field.html.twig' with {
                additionalClass: classes.companyDepartment|join(' ')
              }
            %}
          {% endblock %}
        {% endblock %}
      </div>
    {% endif %}
  {% endif %}
{% endblock %}

{% block component_address_form_address_fields %}
  {%
    set options = {
        scopeElementSelector,
        prefix,
    }
  %}

  {% set arrangement = config('core.loginRegistration.addressInputFieldArrangement') %}

  {# @deprecated tag:v6.8.0 - Only condition will be removed #}
  {% if feature('v6.8.0.0') %}
    <div
      class="country-and-state-form-elements"
      data-country-state-select="true"
      data-country-state-select-options="{{ options|json_encode }}">
      {% block component_address_form_country_field %}
        {%
          sw_include '@Storefront/storefront/component/address/field/address-country-field.html.twig' with {
              additionalClass: 'col-md'
          }
        %}
      {% endblock %}
    </div>
  {% endif %}

  {% block component_address_form_street -%}
    {%
      sw_include '@Storefront/storefront/component/address/field/address-street-field.html.twig' with {
          additionalClass: classes.streetField | join(' ')
      }
    %}
  {% endblock %}

  {% block component_address_form_zipcode_city %}
    {% block component_address_form_zipcode_field %}
      {%
        sw_include '@Storefront/storefront/component/address/field/address-zipcode-field.html.twig' with {
          additionalClass: classes.zipcodeField | join(' ')
        }
      %}
    {% endblock %}

    {% block component_address_form_city_field %}
      {%
        sw_include '@Storefront/storefront/component/address/field/address-city-field.html.twig' with {
          additionalClass: classes.cityField | join(' ')
        }
      %}
    {% endblock %}
  {% endblock %}
{% endblock %}
