{% props
    type = 'button',
    tag = null,
    icon = null,
    label = null,
    href = null,
    target = null,
    title = null,
    color = 'primary',
    size = 'md',
    justify = 'center',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set element = tag is not empty ? tag : (type is same as('link') ? 'a' : 'button') %}

<{{ element }}
    {{ attributes.defaults({
        type: element is same as('button') ? type : false,
        href: element is same as('a') ? href : false,
        target: element is same as('a') and target ? target : false,
        title: title ?? label,
    }) }}
    class="{{ cx.root.apply({ color: color, size: size, justify: justify }) }}"
>
    {% block icon %}
        {% if icon %}
            {{ vi_icon(icon, {
                class: cx.icon.apply({ size: size })
            }) }}
        {% endif %}
    {% endblock %}

    {% block label %}
        {% if label %}
            <span {{ attributes.nested('label') }} class="{{ cx.label.apply({ size: size }) }}">
                {{ label }}
            </span>
        {% endif %}
    {% endblock %}
</{{ element }}>

