{% props
    type = 'button',
    icon = null,
    label = null,
    href = null,
    target = null,
    title = null,
    color = 'primary',
    size = 'md',
    justify = 'center', 
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set tag = type is same as('link') ? 'a' : 'button' %}

<{{ tag }}
    {{ attributes.defaults({
        type: type is same as('link') ? false : type,
        href: type is same as('link') ? href : false,
        target: type is same as('link') and target ? target : false,
        title: title ?? label,
    }) }}
    class="{{ cx.root.apply({ color: color, size: size, justify: justify }) }}"
>
    {% block icon %}
        {% if icon %}
            {{ vi_icon(icon, {
                class: cx.icon.apply({ size: size })
            }) }}
        {% endif %}
    {% endblock %}

    {% block label %}
        {% if label %}
            <span {{ attributes.nested('label') }} class="{{ cx.label.apply({ size: size }) }}">
                {{ label }}
            </span>
        {% endif %}
    {% endblock %}
</{{ tag }}>
