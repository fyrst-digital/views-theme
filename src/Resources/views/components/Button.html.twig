{% props
    type = 'button',
    tag = null,
    icon = null,
    label = null,
    href = null,
    target = null,
    title = null,
    color = 'primary',
    size = 'md',
    square = false,
    pill = false,
    full = false,
    justify = 'center',
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['label']) %}

{% set element = tag is not empty ? tag : (type is same as('link') ? 'a' : 'button') %}

<{{ element }}
    {{ attributes.defaults({
        type: element is same as('button') ? type : false,
        href: element is same as('a') ? href : false,
        target: element is same as('a') and target ? target : false,
        title: title ?? label,
    }) }}
    class="{{ vi_class('root', { color: color, size: size, justify: justify, pill: pill, square: square, full: full }) }}"
>
    {% block prepend %}{% endblock %}

    {% block icon %}
        {% if icon %}
            {{ vi_icon(icon, {
                class: vi_class('icon', { size: size })
            }) }}
        {% endif %}
    {% endblock %}

    {% block label %}
        {% if label %}
            <span {{ vi_attrs('label') }} class="{{ vi_class('label', { size: size }) }}">
                {{ label }}
            </span>
        {% endif %}
    {% endblock %}

    {% block append %}{% endblock %}
</{{ element }}>
