{% props
    page,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['country', 'payment', 'shipping']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block country %}
        <twig:ViewsTheme:Shipping:Calculation:Country
            class="{{ vi_class('country') }}"
            {{ ...vi_attrs('country').defaults({
                countries: page.countries,
                size: 'sm',
            }).all() }}
        />
    {% endblock %}

    {% block payment_method %}
        <twig:ViewsTheme:Shipping:Calculation:PaymentMethod
            class="{{ vi_class('payment') }}"
            {{ ...vi_attrs('payment').defaults({
                paymentMethods: page.paymentMethods,
                size: 'sm',
            }).all() }}
        />
    {% endblock %}

    {% block shipping_method %}
        <twig:ViewsTheme:Shipping:Calculation:ShippingMethod
            class="{{ vi_class('shipping') }}"
            {{ ...vi_attrs('shipping').defaults({
                shippingMethods: page.shippingMethods,
                size: 'sm',
            }).all() }}
        />
    {% endblock %}
</div>
