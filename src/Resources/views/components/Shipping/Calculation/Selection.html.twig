{% props
    page,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['country', 'payment', 'shipping']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block country %}
        {% if not context.customer %}
            <twig:ViewsTheme:Shipping:Calculation:Field
                class="{{ vi_class('country') }}"
                {{ ...vi_attrs('country').defaults({
                    field: 'countryId',
                    label: 'checkout.shippingCountry'|trans|sw_sanitize,
                    items: page.countries,
                    selectedId: context.shippingLocation.country.id,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block payment_method %}
        <twig:ViewsTheme:Shipping:Calculation:Field
            class="{{ vi_class('payment') }}"
            {{ ...vi_attrs('payment').defaults({
                field: 'paymentMethodId',
                label: 'checkout.paymentMethod'|trans|sw_sanitize,
                items: page.paymentMethods,
                selectedId: context.paymentMethod.id,
                selectedName: context.paymentMethod.translated.name,
                guardSelected: true,
            }).all() }}
        />
    {% endblock %}

    {% block shipping_method %}
        <twig:ViewsTheme:Shipping:Calculation:Field
            class="{{ vi_class('shipping') }}"
            {{ ...vi_attrs('shipping').defaults({
                field: 'shippingMethodId',
                label: 'checkout.shippingMethod'|trans|sw_sanitize,
                items: page.shippingMethods,
                selectedId: context.shippingMethod.id,
                selectedName: context.shippingMethod.translated.name,
                guardSelected: true,
            }).all() }}
        />
    {% endblock %}
</div>
