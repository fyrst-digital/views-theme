{% props
    field,
    label,
    items,
    selectedId = null,
    selectedName = null,
    guardSelected = false,
    id = 'vi-cart-' ~ field,
    size = 'sm',
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% set selectOptions = [] %}
{% if guardSelected and selectedId not in items.ids %}
    {% set selectOptions = selectOptions|merge([{
        value: selectedId,
        label: selectedName ~ ' ' ~ ('checkout.notAvailableSuffix'|trans|sw_sanitize),
        disabled: true,
    }]) %}
{% endif %}
{% for item in items %}
    {% set selectOptions = selectOptions|merge([{
        value: item.id,
        label: item.translated.name,
    }]) %}
{% endfor %}

<twig:ViewsTheme:Form:Select
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        'data-component': 'ViewsTheme:Shipping:Calculation:Field',
        'data-component-options': { field: field }|json_encode,
        id: id,
        name: field,
        label: label,
        size: size,
        options: selectOptions,
        value: selectedId,
    }).all() }}
/>
