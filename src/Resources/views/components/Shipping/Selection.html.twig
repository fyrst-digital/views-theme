{% props
    page,
    selectedId = context.shippingMethod.id,
    redirectTo = 'frontend.checkout.confirm.page',
    cva = {},
%}

{% set PHYSICAL_STATE = constant('Shopware\\Core\\Content\\Product\\State::IS_PHYSICAL') %}

{% if page.cart.lineItems.hasLineItemWithState(PHYSICAL_STATE) %}
    {% set titleId = 'vi-shipping-selection-' ~ random() %}

    {% do vi_define_cva(cva) %}
    {% do vi_define_attrs(['title', 'form', 'method']) %}

    <fieldset
        {{ attributes.defaults({
            'aria-labelledby': titleId,
        }) }}
        class="{{ vi_class('root') }}"
    >
        {% block title %}
            <div
                {{ vi_attrs('title').defaults({
                    id: titleId,
                }) }}
                class="{{ vi_class('title') }}"
            >
                {{ vi_icon('truck', { class: vi_class('icon') }) -}}
                {{- 'checkout.confirmShippingMethod'|trans|sw_sanitize }}
            </div>
        {% endblock %}

        {% block form %}
            <twig:ViewsTheme:Checkout:Method:Form
                class="{{ vi_class('form') }}"
                {{ ...vi_attrs('form').defaults({
                    name: 'changeShippingForm',
                    redirectTo: redirectTo,
                }).all() }}
            >
                <twig:block name="content">
                    {% for shipping in page.shippingMethods %}
                        {% set description = null %}
                        {% if shipping.translated.description %}
                            {% set plain = shipping.translated.description|striptags|trim %}
                            {% if plain %}
                                {% set description = plain|length > 75 ? plain[:75] ~ ' ...' : plain %}
                            {% endif %}
                        {% endif %}

                        {% set price = null %}
                        {% set viewsTheme = page.extensions.viewsTheme|default(null) %}
                        {% set quotes = viewsTheme ? viewsTheme.shippingPrices|default(null) : null %}
                        {% set amount = quotes ? quotes.get(shipping.id) : null %}
                        {% if amount is not null %}
                            {% set price = amount|currency %}
                        {% elseif shipping.id is same as(selectedId) and page.cart.deliveries is defined %}
                            {% set matchedDelivery = page.cart.deliveries|filter(delivery => delivery.shippingMethod.id|default(null) is same as(shipping.id))|first %}
                            {% if matchedDelivery and matchedDelivery.shippingCosts %}
                                {% set amount = matchedDelivery.shippingCosts.totalPrice %}
                                {% if amount is not null %}
                                    {% set price = amount|currency %}
                                {% endif %}
                            {% endif %}
                        {% endif %}

                        <twig:ViewsTheme:Form:Selection
                            type="radio"
                            id="{{ 'shippingMethod' ~ shipping.id }}"
                            name="shippingMethodId"
                            value="{{ shipping.id }}"
                            label="{{ shipping.translated.name }}"
                            label:class="fw-semibold"
                            :description="description"
                            :trailing="price"
                            :checked="shipping.id is same as(selectedId)"
                            class="{{ vi_class('method') }}"
                            {{ ...vi_attrs('method').all() }}
                        />
                    {% endfor %}
                </twig:block>
            </twig:ViewsTheme:Checkout:Method:Form>
        {% endblock %}
    </fieldset>
{% endif %}
