{% props
    componentName,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Backdrop',
        'data-component-options': {
            componentName: componentName,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
></div>
