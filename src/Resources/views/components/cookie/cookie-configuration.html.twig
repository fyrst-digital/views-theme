{% sw_extends '@Storefront/storefront/utilities/offcanvas.html.twig' %}

{%
  set classes = vi_define_classes({
    main: ['offcanvas-cookie'],
    description: ['offcanvas-cookie-description'],
    header: ['row', 'align-items-center', 'h6', 'offcanvas-cookie-header'],
    headerCol: ['col'],
    list: ['offcanvas-cookie-list'],
    acceptAllWrap: ['d-grid', 'mb-2'],
    acceptAllButton: ['btn', 'btn-primary', 'btn-block', 'js-offcanvas-cookie-accept-all'],
    submitWrap: ['d-flex', 'flex-wrap', 'py-3'],
    submitButton: ['btn', 'btn-lg', 'btn-success', 'js-offcanvas-cookie-submit'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block utilities_offcanvas_header %}
    <div class="vi-offcanvas__header offcanvas-header border-bottom">
        <div class="vi-offcanvas__title offcanvas-header-content fw-semibold fs-5">
            {{ 'cookie.headline'|trans|sw_sanitize }}
        </div>
        <button
            type="button"
            class="vi-offcanvas__close btn btn-light offcanvas-close js-offcanvas-close"
            title="{{ 'general.offcanvasCloseMenu'|trans|sw_sanitize }}"
            aria-label="{{ 'general.offcanvasCloseMenu'|trans|sw_sanitize }}">
            {{ vi_icon('x') }}
        </button>
    </div>
{% endblock %}

{% block utilities_offcanvas_content %}
    <div {{ classes.main | vi_attr_classes }}>
        <div {{ classes.description | vi_attr_classes }}>
            <p>
                {{ 'cookie.messageText'|trans({
                    '%url%': path('frontend.cms.page', { id: config('core.basicInformation.privacyPage') })
                })|raw }}
            </p>

            <div {{ classes.header | vi_attr_classes }}>
                <div {{ classes.headerCol | vi_attr_classes }}>
                    {{ 'cookie.configuration'|trans|sw_sanitize }}
                </div>
            </div>
        </div>

        <div {{ classes.list | vi_attr_classes }}>
            {% for cookieGroup in cookieGroups %}
                {% sw_include '@Storefront/components/cookie/cookie-configuration-group.html.twig' with {
                    themeIconConfig: themeIconConfig,
                    cookieGroup: cookieGroup
                } only %}
            {% endfor %}
        </div>

        {% if config('core.basicInformation.acceptAllCookies') %}
            {% block layout_cookie_configuration_allow_all_button %}
                <div {{ classes.acceptAllWrap | vi_attr_classes }}>
                    <button
                        type="submit"
                        {{ classes.acceptAllButton | vi_attr_classes }}>
                        {{ 'cookie.acceptAll'|trans|sw_sanitize }}
                    </button>
                </div>
            {% endblock %}
        {% endif %}

        {% block layout_cookie_configuration_button %}
            <div {{ classes.submitWrap | vi_attr_classes }}>
                <button
                    type="submit"
                    {{ classes.submitButton | vi_attr_classes }}>
                    {{ vi_icon('check') }}
                    {{ 'cookie.save'|trans|sw_sanitize }}
                </button>
            </div>
        {% endblock %}
    </div>
{% endblock %}
