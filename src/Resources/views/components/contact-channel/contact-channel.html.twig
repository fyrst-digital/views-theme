{%
  set classes = vi_define_classes({
    item: ['contact-channel'],
    label: ['contact-channel-label'],
    content: ['contact-channel-content'],
    value: ['contact-channel-value'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_footer_contact_channel %}
    <div {{ classes.item | vi_attr_classes }}>

        {% block component_footer_contact_channel_label %}
            {% if label %}
                <div {{ classes.label | vi_attr_classes }}>
                    {{label}}
                </div>
            {% endif %}
        {% endblock %}

        {% block component_footer_contact_channel_content %}
            <div {{ classes.content | vi_attr_classes }}>

                {% block component_footer_contact_channel_icon %}
                    {% if icon %}
                        {{vi_icon(icon)}}
                    {% endif %}
                {% endblock %}

                {% block component_footer_contact_channel_value %}

                    {% if url %}
                        <a href="{{url}}"
                            {{ classes.value | vi_attr_classes }}
                            {% if urlAttributes %}
                                {{urlAttributes|join(' ')|raw}}
                            {% endif %}
                            {% if openExternal %}
                                target="_blank"
                            {% endif %}
                            title="{{value}}">

                            {% block component_footer_contact_channel_link_value_content %}
                                {% if value %}
                                    {{value|raw}}
                                {% endif %}
                            {% endblock %}
                        </a>
                    {% else %}
                        <span {{ classes.value | vi_attr_classes }}>
                            {% block component_footer_contact_channel_value_content %}
                                {% if value %}
                                    {{value|raw}}
                                {% endif %}
                            {% endblock %}
                        </span>
                    {% endif %}
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
