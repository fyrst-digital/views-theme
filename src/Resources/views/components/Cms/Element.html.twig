{% props
    block,
    slotName = null,
    span = null, # md:3 | md:4 | md:6 | md:8 | md:9 | md:12 | md:12-lg:5 | md:12-lg:7
    includeVars = {},
    sidebar = block.sectionPosition == 'sidebar',
    element = slotName ? block.slots.getSlot(slotName) : null,
    elementId = element ? element.id : false,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% set body %}
    {% block content %}
        {% if element %}
            {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' ignore missing with includeVars %}
        {% endif %}
    {% endblock %}
{% endset %}

{% if body|trim is not empty %}
    <div
        {{ attributes.defaults({
            'data-cms-element-id': elementId,
        }) }}
        class="{{ vi_class('root', { span: span, sidebar: span is not null and sidebar }) }}"
    >
        {{ body }}
    </div>
{% endif %}
