{% props
    id = 'vi-drawer',
    side = 'start',
    label = null,
    title = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults({
        id: id,
        role: 'dialog',
        'aria-modal': 'true',
        'aria-label': label,
        'aria-hidden': 'true',
        inert: true,
        'data-side': side,
        'data-open': 'false',
        'data-component': 'ViewsTheme:Drawer',
        'data-component-options': {
            side: side,
        }|json_encode,
    }) }}
    class="{{ cx.root.apply({ side: side }) }}"
>
    {% block backdrop %}
        <twig:ViewsTheme:Backdrop componentName="ViewsTheme:Drawer" />
    {% endblock %}

    {% block panel %}
        <twig:ViewsTheme:Drawer:Panel
            {{ ...attributes.nested('panel').defaults({
                side: side,
                title: title,
            }).all() }}
        />
    {% endblock %}
</div>
