{% props
    id = 'vi-drawer',
    side = 'start', # start | end
    label = null,
    title = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['panel']) %}

<div
    {{ attributes.defaults({
        id: id,
        role: 'dialog',
        'aria-modal': 'true',
        'aria-label': label,
        'aria-hidden': 'true',
        inert: true,
        'data-side': side,
        'data-open': 'false',
        'data-component': 'ViewsTheme:Drawer',
        'data-component-options': {
            side: side,
        }|json_encode,
    }) }}
    class="{{ vi_class('root', { side: side }) }}"
>
    {% block backdrop %}
        <twig:ViewsTheme:Backdrop componentName="ViewsTheme:Drawer" />
    {% endblock %}

    {% block panel %}
        <twig:ViewsTheme:Drawer:Panel
            {{ ...vi_attrs('panel').defaults({
                side: side,
                title: title,
            }).all() }}
        >
            {# Panel body; a slot of this Drawer so callers write it one level deep (their own `vi_block`s still resolve) #}
            <twig:block name="content">{% vi_block content %}{% endvi_block %}</twig:block>
        </twig:ViewsTheme:Drawer:Panel>
    {% endblock %}
</div>
