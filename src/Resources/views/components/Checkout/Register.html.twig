{% props
    page,
    data = __context.data|default(null),
    redirectTo = __context.redirectTo|default('frontend.checkout.confirm.page'),
    redirectParameters = __context.redirectParameters|default(null),
    loginError = __context.loginError|default(false),
    errorSnippet = __context.errorSnippet|default(null),
    waitTime = __context.waitTime|default(null),
    formViolations = __context.formViolations|default(null),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['flashes', 'title', 'main', 'aside']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block flashes %}
        <twig:ViewsTheme:Cart:Flashes
            class="{{ vi_class('flashes') }}"
            {{ ...vi_attrs('flashes').all() }}
        />
    {% endblock %}

    {% block title %}
        <twig:ViewsTheme:Page:Title
            class="{{ vi_class('title') }}"
            {{ ...vi_attrs('title').defaults({
                heading: 'checkout.addressHeader'|trans|striptags,
            }).all() }}
        />
    {% endblock %}

    {% block main %}
        <twig:ViewsTheme:Account:LoginRegister
            class="{{ vi_class('main') }}"
            {{ ...vi_attrs('main').defaults({
                page: page,
                data: data,
                formViolations: formViolations,
                loginError: loginError,
                errorSnippet: errorSnippet,
                waitTime: waitTime,
                guestSelectable: true,
                redirectTo: redirectTo,
                redirectParameters: redirectParameters,
                registerErrorRoute: 'frontend.checkout.register.page',
            }).all() }}
        />
    {% endblock %}

    {% block aside %}
        <twig:ViewsTheme:Checkout:Register:Aside
            class="{{ vi_class('aside') }}"
            {{ ...vi_attrs('aside').defaults({
                page: page,
            }).all() }}
        />
    {% endblock %}
</div>
