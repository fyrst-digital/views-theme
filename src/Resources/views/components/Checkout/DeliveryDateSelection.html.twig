{% props
    deliveryDate = page.extensions.viewsTheme.deliveryDate|default({}),
    title = 'checkout.preferredDeliveryDate.title'|trans|sw_sanitize,
    label = 'checkout.preferredDeliveryDate.label'|trans|sw_sanitize,
    helpText = 'checkout.preferredDeliveryDate.helpText'|trans|sw_sanitize,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    title: attributes.nested('title'),
    control: attributes.nested('control'),
    label: attributes.nested('label'),
    input: attributes.nested('input'),
    help: attributes.nested('help'),
} %}

{% if deliveryDate.active|default(false) %}
    <div
        {{ attributes.defaults({
            'data-component': 'ViewsTheme:Checkout:DeliveryDateSelection',
        }) }}
        class="{{ cx.root.apply() }}"
    >
        {% block title %}
            {% if title is not same as(false) %}
                <div {{ attrs.title }} class="{{ cx.title.apply() }}">
                    {{ title }}
                </div>
            {% endif %}
        {% endblock %}

        {% block control %}
            <div {{ attrs.control }} class="{{ cx.control.apply() }}">
                {% block label %}
                    {% if label is not same as(false) %}
                        <label
                            {{ attrs.label.defaults({
                                for: 'PreferredDeliveryDate',
                            }) }}
                            class="{{ cx.label.apply() }}"
                        >
                            {{ label }}
                        </label>
                    {% endif %}
                {% endblock %}

                {% block input %}
                    <input
                        {{ attrs.input.defaults({
                            type: 'date',
                            id: 'PreferredDeliveryDate',
                            form: 'confirmOrderForm',
                            name: 'viewsThemeDeliveryDate',
                            min: deliveryDate.min|default(''),
                            max: deliveryDate.max|default(''),
                            value: '',
                        }) }}
                        class="{{ cx.input.apply() }}"
                    >
                {% endblock %}

                {% block help %}
                    {% if helpText is not same as(false) %}
                        <div {{ attrs.help }} class="{{ cx.help.apply() }}">
                            {{ helpText }}
                        </div>
                    {% endif %}
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endif %}
