{% props
    deliveryDate = null,
    title = 'checkout.preferredDeliveryDate.title'|trans|sw_sanitize,
    label = 'checkout.preferredDeliveryDate.label'|trans|sw_sanitize,
    helpText = 'checkout.preferredDeliveryDate.helpText'|trans|sw_sanitize,
    cva = {},
%}

{% set resolvedDeliveryDate = deliveryDate is not null
    ? deliveryDate
    : page.extensions.viewsTheme.deliveryDate|default({}) %}
{% set cx = vi_cva({
    root: { base: 'vi-checkout-delivery-date' },
    title: { base: 'vi-checkout-delivery-date__title' },
    control: { base: 'vi-checkout-delivery-date__control' },
    label: { base: 'vi-checkout-delivery-date__label form-label' },
    input: { base: 'vi-checkout-delivery-date__input form-control' },
    help: { base: 'vi-checkout-delivery-date__help form-text' },
}|replace_recursive(cva)) %}

{% if resolvedDeliveryDate.active|default(false) %}
    <div
        {{ attributes.defaults({
            'data-component': 'ViewsTheme:Checkout:DeliveryDateSelection',
        }) }}
        class="{{ cx.root.apply() }}"
    >
        {% block title %}
            {% if title is not same as(false) %}
                <div {{ attributes.nested('title') }} class="{{ cx.title.apply() }}">
                    {{ title }}
                </div>
            {% endif %}
        {% endblock %}

        {% block control %}
            <div {{ attributes.nested('control') }} class="{{ cx.control.apply() }}">
                {% block label %}
                    {% if label is not same as(false) %}
                        <label
                            for="PreferredDeliveryDate"
                            {{ attributes.nested('label') }}
                            class="{{ cx.label.apply() }}"
                        >
                            {{ label }}
                        </label>
                    {% endif %}
                {% endblock %}

                {% block input %}
                    <input
                        type="date"
                        id="PreferredDeliveryDate"
                        form="confirmOrderForm"
                        name="viewsThemeDeliveryDate"
                        min="{{ resolvedDeliveryDate.min|default('') }}"
                        max="{{ resolvedDeliveryDate.max|default('') }}"
                        value=""
                        {{ attributes.nested('input') }}
                        class="{{ cx.input.apply() }}"
                    >
                {% endblock %}

                {% block help %}
                    {% if helpText is not same as(false) %}
                        <div {{ attributes.nested('help') }} class="{{ cx.help.apply() }}">
                            {{ helpText }}
                        </div>
                    {% endif %}
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endif %}
