{% props
    formId = 'confirmOrderForm',
    showTosOptin = true,
    tosSnippet = 'checkout.confirmTermsText'|trans({
        '%url%': path('frontend.cms.page', { id: config('core.basicInformation.tosPage') }),
    }),
    formViolations = __context.formViolations|default(null),
    page = __context.page|default(null),
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set attrs = {
    title: attributes.nested('title'),
    revocationNotice: attributes.nested('revocationNotice'),
    control: attributes.nested('control'),
    tosCheckbox: attributes.nested('tosCheckbox'),
    tosLabel: attributes.nested('tosLabel'),
    revocationCheckbox: attributes.nested('revocationCheckbox'),
    revocationLabel: attributes.nested('revocationLabel'),
} %}

{% set tosInvalid = formViolations and formViolations.getViolations('/tos') is not empty %}
{% set revocationInvalid = formViolations and formViolations.getViolations('/revocation') is not empty %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block header %}
        <div {{ attrs.title }} class="{{ cx.title.apply() }}">
            {{ 'checkout.confirmTermsHeader'|trans|sw_sanitize }}
        </div>
    {% endblock %}

    {% block revocation_notice %}
        <div {{ attrs.revocationNotice }} class="{{ cx.revocationNotice.apply() }}">
            {{ 'checkout.confirmRevocationNotice'|trans({
                '%url%': path('frontend.cms.page', { id: config('core.basicInformation.revocationPage') }),
            })|raw }}
        </div>
    {% endblock %}

    {% block tos_control %}
        {% if showTosOptin is same as(true) %}
            <div {{ attrs.control }} class="{{ cx.control.apply() }}">
                <input
                    {{ attrs.tosCheckbox.defaults({
                        type: 'checkbox',
                        required: 'required',
                        id: 'tos',
                        form: formId,
                        name: 'tos',
                    }) }}
                    class="{{ cx.tosCheckbox.apply() }}{{ tosInvalid ? ' is-invalid' : '' }}"
                >
                <label
                    {{ attrs.tosLabel.defaults({
                        for: 'tos',
                    }) }}
                    class="{{ cx.tosLabel.apply() }}"
                >
                    {{ tosSnippet|raw }}
                </label>
            </div>
        {% else %}
            {{ tosSnippet|raw }}
            <input type="hidden" id="tos" form="{{ formId }}" name="tos" value="1">
        {% endif %}
    {% endblock %}

    {% block revocation_control %}
        {% if page and page.showRevocation() %}
            <div {{ attrs.control }} class="{{ cx.control.apply() }}">
                <input
                    {{ attrs.revocationCheckbox.defaults({
                        type: 'checkbox',
                        required: 'required',
                        id: 'revocation',
                        form: formId,
                        name: 'revocation',
                    }) }}
                    class="{{ cx.revocationCheckbox.apply() }}{{ revocationInvalid ? ' is-invalid' : '' }}"
                >
                <label
                    {{ attrs.revocationLabel.defaults({
                        for: 'revocation',
                    }) }}
                    class="{{ cx.revocationLabel.apply() }}"
                >
                    {{ 'checkout.confirmRevocationTerms'|trans() }}
                </label>
            </div>
        {% endif %}
    {% endblock %}
</div>
