{% props
    formId = 'confirmOrderForm',
    showTosOptin = true,
    tosSnippet = 'checkout.confirmTermsText'|trans({
        '%url%': path('frontend.cms.page', { id: config('core.basicInformation.tosPage') }),
    }),
    formViolations = __context.formViolations|default(null),
    page = __context.page|default(null),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'revocationNotice', 'control', 'tosCheckbox', 'tosLabel', 'revocationCheckbox', 'revocationLabel']) %}

{% set tosInvalid = formViolations and formViolations.getViolations('/tos') is not empty %}
{% set revocationInvalid = formViolations and formViolations.getViolations('/revocation') is not empty %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block header %}
        <div {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
            {{ 'checkout.confirmTermsHeader'|trans|sw_sanitize }}
        </div>
    {% endblock %}

    {% block revocation_notice %}
        <div {{ vi_attrs('revocationNotice') }} class="{{ vi_class('revocationNotice') }}">
            {{ 'checkout.confirmRevocationNotice'|trans({
                '%url%': path('frontend.cms.page', { id: config('core.basicInformation.revocationPage') }),
            })|raw }}
        </div>
    {% endblock %}

    {% block tos_control %}
        {% if showTosOptin is same as(true) %}
            <div {{ vi_attrs('control') }} class="{{ vi_class('control') }}">
                <input
                    {{ vi_attrs('tosCheckbox').defaults({
                        type: 'checkbox',
                        required: 'required',
                        id: 'tos',
                        form: formId,
                        name: 'tos',
                    }) }}
                    class="{{ vi_class('tosCheckbox') }}{{ tosInvalid ? ' is-invalid' : '' }}"
                >
                <label
                    {{ vi_attrs('tosLabel').defaults({
                        for: 'tos',
                    }) }}
                    class="{{ vi_class('tosLabel') }}"
                >
                    {{ tosSnippet|raw }}
                </label>
            </div>
        {% else %}
            {{ tosSnippet|raw }}
            <input type="hidden" id="tos" form="{{ formId }}" name="tos" value="1">
        {% endif %}
    {% endblock %}

    {% block revocation_control %}
        {% if page and page.showRevocation() %}
            <div {{ vi_attrs('control') }} class="{{ vi_class('control') }}">
                <input
                    {{ vi_attrs('revocationCheckbox').defaults({
                        type: 'checkbox',
                        required: 'required',
                        id: 'revocation',
                        form: formId,
                        name: 'revocation',
                    }) }}
                    class="{{ vi_class('revocationCheckbox') }}{{ revocationInvalid ? ' is-invalid' : '' }}"
                >
                <label
                    {{ vi_attrs('revocationLabel').defaults({
                        for: 'revocation',
                    }) }}
                    class="{{ vi_class('revocationLabel') }}"
                >
                    {{ 'checkout.confirmRevocationTerms'|trans() }}
                </label>
            </div>
        {% endif %}
    {% endblock %}
</div>
