{% props
    formId = 'confirmOrderForm',
    showTosOptin = true,
    tosSnippet = 'checkout.confirmTermsText'|trans({
        '%url%': path('frontend.cms.page', { id: config('core.basicInformation.tosPage') }),
    }),
    formViolations = null,
    page = null,
    cva = {},
%}

{% set pageEntity = page is not null ? page : (_context.page|default(null)) %}
{% set violations = formViolations is not null ? formViolations : (_context.formViolations|default(null)) %}
{% set cx = vi_cva_from_file(cva) %}
{% set tosInvalid = violations and violations.getViolations('/tos') is not empty %}
{% set revocationInvalid = violations and violations.getViolations('/revocation') is not empty %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block header %}
        <div {{ attributes.nested('title') }} class="{{ cx.title.apply() }}">
            {{ 'checkout.confirmTermsHeader'|trans|sw_sanitize }}
        </div>
    {% endblock %}

    {% block revocation_notice %}
        <div {{ attributes.nested('revocationNotice') }} class="{{ cx.revocationNotice.apply() }}">
            {{ 'checkout.confirmRevocationNotice'|trans({
                '%url%': path('frontend.cms.page', { id: config('core.basicInformation.revocationPage') }),
            })|raw }}
        </div>
    {% endblock %}

    {% block tos_control %}
        {% if showTosOptin is same as(true) %}
            <div {{ attributes.nested('control') }} class="{{ cx.control.apply() }}">
                <input
                    {{ attributes.nested('tosCheckbox').defaults({
                        type: 'checkbox',
                        required: 'required',
                        id: 'tos',
                        form: formId,
                        name: 'tos',
                    }) }}
                    class="{{ cx.tosCheckbox.apply() }}{{ tosInvalid ? ' is-invalid' : '' }}"
                >
                <label
                    {{ attributes.nested('tosLabel').defaults({
                        for: 'tos',
                    }) }}
                    class="{{ cx.tosLabel.apply() }}"
                >
                    {{ tosSnippet|raw }}
                </label>
            </div>
        {% else %}
            {{ tosSnippet|raw }}
            <input type="hidden" id="tos" form="{{ formId }}" name="tos" value="1">
        {% endif %}
    {% endblock %}

    {% block revocation_control %}
        {% if pageEntity and pageEntity.showRevocation() %}
            <div {{ attributes.nested('control') }} class="{{ cx.control.apply() }}">
                <input
                    {{ attributes.nested('revocationCheckbox').defaults({
                        type: 'checkbox',
                        required: 'required',
                        id: 'revocation',
                        form: formId,
                        name: 'revocation',
                    }) }}
                    class="{{ cx.revocationCheckbox.apply() }}{{ revocationInvalid ? ' is-invalid' : '' }}"
                >
                <label
                    {{ attributes.nested('revocationLabel').defaults({
                        for: 'revocation',
                    }) }}
                    class="{{ cx.revocationLabel.apply() }}"
                >
                    {{ 'checkout.confirmRevocationTerms'|trans() }}
                </label>
            </div>
        {% endif %}
    {% endblock %}
</div>
