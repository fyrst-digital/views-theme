{% props
    formId = 'confirmOrderForm',
    showTosOptin = true,
    tosSnippet = null,
    formViolations = null,
    page = null,
    defaultBaseClasses = 'vi-checkout-confirm-tos confirm-tos',
    defaultVariants = {},
%}

{% set pageEntity = page is not null ? page : (_context.page|default(null)) %}
{% set violations = formViolations is not null ? formViolations : (_context.formViolations|default(null)) %}
{% set tosSnippet = tosSnippet is not null
    ? tosSnippet
    : 'checkout.confirmTermsText'|trans({
        '%url%': path('frontend.cms.page', { id: config('core.basicInformation.tosPage') }),
    }) %}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set titleAttributes = attributes.nested('title') %}
{% set revocationNoticeAttributes = attributes.nested('revocationNotice') %}
{% set controlAttributes = attributes.nested('control') %}
{% set tosCheckboxAttributes = attributes.nested('tosCheckbox') %}
{% set tosLabelAttributes = attributes.nested('tosLabel') %}
{% set revocationCheckboxAttributes = attributes.nested('revocationCheckbox') %}
{% set revocationLabelAttributes = attributes.nested('revocationLabel') %}

{% set tosInvalid = violations and violations.getViolations('/tos') is not empty %}
{% set revocationInvalid = violations and violations.getViolations('/revocation') is not empty %}

<div
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block header %}
        <div
            {{ titleAttributes.defaults({
                class: 'vi-checkout-confirm-tos__title confirm-tos-title',
            }) }}
        >
            {{ 'checkout.confirmTermsHeader'|trans|sw_sanitize }}
        </div>
    {% endblock %}

    {% block revocation_notice %}
        <div
            {{ revocationNoticeAttributes.defaults({
                class: 'vi-checkout-confirm-tos__revocation-notice revocation-notice',
            }) }}
        >
            {{ 'checkout.confirmRevocationNotice'|trans({
                '%url%': path('frontend.cms.page', { id: config('core.basicInformation.revocationPage') }),
            })|raw }}
        </div>
    {% endblock %}

    {% block tos_control %}
        {% if showTosOptin is same as(true) %}
            <div
                {{ controlAttributes.defaults({
                    class: 'vi-checkout-confirm-tos__control form-check',
                }) }}
            >
                <input
                    type="checkbox"
                    required="required"
                    id="tos"
                    form="{{ formId }}"
                    name="tos"
                    {{ tosCheckboxAttributes.defaults({
                        class: 'vi-checkout-confirm-tos__checkbox checkout-confirm-tos-checkbox form-check-input'
                            ~ (tosInvalid ? ' is-invalid' : ''),
                    }) }}
                >
                <label
                    for="tos"
                    {{ tosLabelAttributes.defaults({
                        class: 'vi-checkout-confirm-tos__label checkout-confirm-tos-label custom-control-label',
                    }) }}
                >
                    {{ tosSnippet|raw }}
                </label>
            </div>
        {% else %}
            {{ tosSnippet|raw }}
            <input type="hidden" id="tos" form="{{ formId }}" name="tos" value="1">
        {% endif %}
    {% endblock %}

    {% block revocation_control %}
        {% if pageEntity and pageEntity.showRevocation() %}
            <div
                {{ controlAttributes.defaults({
                    class: 'vi-checkout-confirm-tos__control form-check',
                }) }}
            >
                <input
                    type="checkbox"
                    required="required"
                    id="revocation"
                    form="{{ formId }}"
                    name="revocation"
                    {{ revocationCheckboxAttributes.defaults({
                        class: 'vi-checkout-confirm-tos__revocation-checkbox checkout-confirm-revocation-checkbox form-check-input'
                            ~ (revocationInvalid ? ' is-invalid' : ''),
                    }) }}
                >
                <label
                    for="revocation"
                    {{ revocationLabelAttributes.defaults({
                        class: 'vi-checkout-confirm-tos__revocation-label checkout-confirm-revocation-label custom-control-label',
                    }) }}
                >
                    {{ 'checkout.confirmRevocationTerms'|trans() }}
                </label>
            </div>
        {% endif %}
    {% endblock %}
</div>
