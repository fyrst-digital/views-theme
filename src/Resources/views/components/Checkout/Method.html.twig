{% props
    methodType = 'payment',
    methodId,
    selectedMethodId = null,
    disabled = false,
    interactive = true,
    media = null,
    name = null,
    description = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['input', 'label', 'image', 'content', 'name', 'description']) %}

{% set inputId = methodType ~ 'Method' ~ methodId %}
{% set selected = methodId is same as(selectedMethodId) %}
{% set labelTag = interactive ? 'label' : 'div' %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% if interactive %}
        <input
            {{ vi_attrs('input').defaults({
                type: 'radio',
                id: inputId,
                name: methodType ~ 'MethodId',
                value: methodId,
                checked: selected ? true : false,
                disabled: disabled is same as(true) ? true : false,
            }) }}
            class="{{ vi_class('input') }}"
        >
    {% endif %}

    <{{ labelTag|raw }}
        {{ vi_attrs('label').defaults(interactive ? { for: inputId } : {}) }}
        class="{{ vi_class('label') }}"
    >
        {% if media %}
            <div {{ vi_attrs('image') }} class="{{ vi_class('image') }}">
                {% sw_thumbnails 'checkout-method-image-thumbnails' with {
                    media: media,
                    sizes: { default: '100px' },
                    attributes: {
                        class: vi_class('imageElement'),
                        alt: (media.translated.alt|default(name)),
                        title: (media.translated.title|default(name)),
                    },
                } %}
            </div>
        {% endif %}

        <div {{ vi_attrs('content') }} class="{{ vi_class('content') }}">
            <div {{ vi_attrs('name') }} class="{{ vi_class('name') }}">
                {{ name }}
            </div>
            {% if description %}
                <div
                    {{ vi_attrs('description').defaults({
                        title: description|striptags,
                    }) }}
                    class="{{ vi_class('description') }}"
                >
                    {{ description|raw }}
                </div>
            {% endif %}
        </div>
    </{{ labelTag|raw }}>
</div>
