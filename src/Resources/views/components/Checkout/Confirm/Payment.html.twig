{% props
    page,
    selectedId = context.paymentMethod.id,
    action = path('frontend.checkout.configure'),
    redirectTo = 'frontend.checkout.confirm.page',
    framed = true,
    cva = {},
%}

{% set titleId = 'vi-checkout-confirm-payment-' ~ random() %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'form', 'method']) %}

<fieldset
    {{ attributes.defaults({
        'aria-labelledby': titleId,
    }) }}
    class="{{ vi_class('root', { framed: framed }) }}"
>
    {% block title %}
        <div
            {{ vi_attrs('title').defaults({
                id: titleId,
            }) }}
            class="{{ vi_class('title') }}"
        >
            {{ vi_icon('credit-card', { class: vi_class('icon') }) -}}
            {{- 'checkout.confirmPaymentMethod'|trans|sw_sanitize }}
        </div>
    {% endblock %}

    {% block form %}
        <twig:ViewsTheme:Checkout:Method:Form
            class="{{ vi_class('form') }}"
            {{ ...vi_attrs('form').defaults({
                name: 'changePaymentForm',
                action: action,
                redirectTo: redirectTo,
            }).all() }}
        >
            <twig:block name="content">
                {% for payment in page.paymentMethods %}
                    {% set description = null %}
                    {% if payment.translated.description and payment.id is same as(selectedId) %}
                        {% set plain = payment.translated.description|striptags|trim %}
                        {% if plain %}
                            {% set description = plain|length > 75 ? plain[:75] ~ ' ...' : plain %}
                        {% endif %}
                    {% endif %}

                    <twig:ViewsTheme:Form:Selection
                        type="radio"
                        id="{{ 'paymentMethod' ~ payment.id }}"
                        name="paymentMethodId"
                        value="{{ payment.id }}"
                        label="{{ payment.translated.name }}"
                        :description="description"
                        :checked="payment.id is same as(selectedId)"
                        class="{{ vi_class('method') }}"
                        {{ ...vi_attrs('method').all() }}
                    />
                {% endfor %}
            </twig:block>
        </twig:ViewsTheme:Checkout:Method:Form>
    {% endblock %}
</fieldset>
