{% props
    formId = 'confirmOrderForm',
    title = 'checkout.confirmTermsHeader'|trans|sw_sanitize,
    tosUrl = path('frontend.cms.page', { id: config('core.basicInformation.tosPage') }),
    revocationUrl = path('frontend.cms.page', { id: config('core.basicInformation.revocationPage') }),
    formViolations = __context.formViolations|default(null),
    page = __context.page|default(null),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'revocationNotice', 'tosCheckbox', 'revocationCheckbox']) %}

{% set linkClass = vi_class('link') %}
{% set tosNotice = 'checkout.confirmTermsTextModal'|trans({
    '%tosModalTagOpen%': '<a href="' ~ tosUrl ~ '" class="' ~ linkClass ~ '" data-ajax-modal="true" data-url="' ~ tosUrl ~ '" aria-haspopup="dialog">',
    '%tosModalTagClose%': '</a>',
}) %}
{% set revocationNotice = 'checkout.confirmRevocationNoticeModal'|trans({
    '%revocationModalTagOpen%': '<a href="' ~ revocationUrl ~ '" class="' ~ linkClass ~ '" data-ajax-modal="true" data-url="' ~ revocationUrl ~ '" aria-haspopup="dialog">',
    '%revocationModalTagClose%': '</a>',
}) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block title %}
        {% if title is not empty %}
            <div {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
                {{ title }}
            </div>
        {% endif %}
    {% endblock %}

    {% block revocation_notice %}
        <div {{ vi_attrs('revocationNotice') }} class="{{ vi_class('revocationNotice') }}">
            {{ revocationNotice|raw }}
        </div>
    {% endblock %}

    {% block tos_control %}
        <twig:ViewsTheme:Form:Checkbox
            class="{{ vi_class('tosCheckbox') }}"
            {{ ...vi_attrs('tosCheckbox').defaults({
                id: 'tos',
                name: 'tos',
                label: tosNotice,
                validationRules: 'required',
                violationPath: '/tos',
                formViolations: formViolations,
                'input:form': formId,
            }).all() }}
        />
    {% endblock %}

    {% block revocation_control %}
        {% if page and page.showRevocation %}
            <twig:ViewsTheme:Form:Checkbox
                class="{{ vi_class('revocationCheckbox') }}"
                {{ ...vi_attrs('revocationCheckbox').defaults({
                    id: 'revocation',
                    name: 'revocation',
                    label: 'checkout.confirmRevocationTerms'|trans|sw_sanitize,
                    validationRules: 'required',
                    violationPath: '/revocation',
                    formViolations: formViolations,
                    'input:form': formId,
                }).all() }}
            />
        {% endif %}
    {% endblock %}
</div>
