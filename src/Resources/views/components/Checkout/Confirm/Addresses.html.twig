{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['shipping', 'billing', 'shippingChange', 'billingChange']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% for card in cards %}
            <section
                class="{{ vi_class('column') }}"
                {{ vi_attrs(card.nest).defaults({
                    'data-divided': card.divided ? 'true' : false,
                }) }}
            >
                <div class="{{ vi_class('head') }}">
                    <h2 class="{{ vi_class('label') }}">
                        {{ card.title }}
                    </h2>

                    <twig:ViewsTheme:Address:Manager:Action
                        class="{{ vi_class('change') }}"
                        {{ ...vi_attrs(card.changeNest).defaults({
                            tab: card.tab,
                            hideShipping: hideShippingAddress,
                            href: card.editHref,
                            color: 'none',
                            label: changeLabel,
                            title: card.changeTitle,
                            'aria-label': card.changeTitle,
                            link: true,
                        }).all() }}
                    />
                </div>

                {% if card.warn %}
                    {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                        type: 'warning',
                        content: 'address.countryNoShippingAlert'|trans|sw_sanitize,
                    } %}
                {% endif %}

                <div class="{{ vi_class('lines') }}">
                    {% if card.equal %}
                        <p class="{{ vi_class('name') }}">
                            {{ equalTitle }}
                        </p>
                        <p class="{{ vi_class('line') }}">
                            {{ equalText }}
                        </p>
                    {% else %}
                        {% for addressLine in card.lines %}
                            <p class="{{ vi_class(loop.first ? 'name' : 'line') }}">{{ addressLine|raw }}</p>
                        {% endfor %}
                    {% endif %}
                </div>
            </section>
        {% endfor %}
    {% endblock %}
</div>
