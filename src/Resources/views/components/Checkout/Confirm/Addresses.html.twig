{% props
    page,
    billingAddress = context.customer.activeBillingAddress,
    shippingAddress = context.customer.activeShippingAddress,
    hideShippingAddress = page.hideShippingAddress,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['shippingChange', 'billingChange']) %}

<twig:ViewsTheme:Address:List
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        billingAddress: billingAddress,
        shippingAddress: shippingAddress,
        hideShippingAddress: hideShippingAddress,
        showShippingWarning: true,
    }).all() }}
>
    <twig:block name="shippingActions">
        <twig:ViewsTheme:Address:Manager:Action
            class="{{ vi_class('change') }}"
            {{ ...vi_attrs('shippingChange').defaults({
                tab: 'shipping',
                hideShipping: hideShippingAddress,
                href: path('frontend.account.address.edit.page', { addressId: shippingAddress.id }),
                color: 'secondary',
                label: 'account.overviewChangeShipping'|trans|sw_sanitize,
                title: 'account.overviewChangeShipping'|trans|striptags,
            }).all() }}
        />
    </twig:block>

    <twig:block name="billingActions">
        <twig:ViewsTheme:Address:Manager:Action
            class="{{ vi_class('change') }}"
            {{ ...vi_attrs('billingChange').defaults({
                tab: 'billing',
                hideShipping: hideShippingAddress,
                href: path('frontend.account.address.edit.page', { addressId: billingAddress.id }),
                color: 'secondary',
                label: 'account.overviewChangeBilling'|trans|sw_sanitize,
                title: 'account.overviewChangeBilling'|trans|striptags,
            }).all() }}
        />
    </twig:block>
</twig:ViewsTheme:Address:List>
