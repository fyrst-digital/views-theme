{% props
    title = true,
    defaultBaseClasses = 'vi-checkout-user-comment',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set titleAttributes = attributes.nested('title') %}
{% set controlAttributes = attributes.nested('control') %}
{% set labelAttributes = attributes.nested('label') %}
{% set textareaAttributes = attributes.nested('textarea') %}
{% set commentKey = constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') %}

<div
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% if title %}
        {% block title %}
            <div
                {{ titleAttributes.defaults({
                    class: 'vi-checkout-user-comment__title checkout-user-comment-title',
                }) }}
            >
                {{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}
            </div>
        {% endblock %}
    {% endif %}

    {% block control %}
        <div
            {{ controlAttributes.defaults({
                class: 'vi-checkout-user-comment__control checkout-user-comment-control',
            }) }}
        >
            <label
                for="{{ commentKey }}"
                {{ labelAttributes.defaults({
                    class: 'vi-checkout-user-comment__label form-label',
                }) }}
            >
                {{ 'checkout.customerCommentLabel'|trans|sw_sanitize }}
            </label>
            <textarea
                placeholder="{{ 'checkout.customerCommentPlaceholder'|trans|sw_sanitize }}"
                id="{{ commentKey }}"
                form="confirmOrderForm"
                name="{{ commentKey }}"
                {{ textareaAttributes.defaults({
                    class: 'vi-checkout-user-comment__textarea form-control',
                }) }}
            ></textarea>
        </div>
    {% endblock %}
</div>
