{% props
    title = true,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}
{% set attrs = {
    title: attributes.nested('title'),
    control: attributes.nested('control'),
    label: attributes.nested('label'),
    textarea: attributes.nested('textarea'),
} %}

{% set commentKey = constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% if title %}
        {% block title %}
            <div {{ attrs.title }} class="{{ cx.title.apply() }}">
                {{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}
            </div>
        {% endblock %}
    {% endif %}

    {% block control %}
        <div {{ attrs.control }} class="{{ cx.control.apply() }}">
            <label
                {{ attrs.label.defaults({
                    for: commentKey,
                }) }}
                class="{{ cx.label.apply() }}"
            >
                {{ 'checkout.customerCommentLabel'|trans|sw_sanitize }}
            </label>
            <textarea
                {{ attrs.textarea.defaults({
                    placeholder: 'checkout.customerCommentPlaceholder'|trans|sw_sanitize,
                    id: commentKey,
                    form: 'confirmOrderForm',
                    name: commentKey,
                }) }}
                class="{{ cx.textarea.apply() }}"
            ></textarea>
        </div>
    {% endblock %}
</div>
