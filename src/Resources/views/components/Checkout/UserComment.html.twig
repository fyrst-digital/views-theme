{% props
    title = true,
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-checkout-user-comment' },
    title: { base: 'vi-checkout-user-comment__title checkout-user-comment-title' },
    control: { base: 'vi-checkout-user-comment__control checkout-user-comment-control' },
    label: { base: 'vi-checkout-user-comment__label form-label' },
    textarea: { base: 'vi-checkout-user-comment__textarea form-control' },
}|replace_recursive(cva)) %}
{% set commentKey = constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% if title %}
        {% block title %}
            <div {{ attributes.nested('title') }} class="{{ cx.title.apply() }}">
                {{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}
            </div>
        {% endblock %}
    {% endif %}

    {% block control %}
        <div {{ attributes.nested('control') }} class="{{ cx.control.apply() }}">
            <label
                {{ attributes.nested('label').defaults({
                    for: commentKey,
                }) }}
                class="{{ cx.label.apply() }}"
            >
                {{ 'checkout.customerCommentLabel'|trans|sw_sanitize }}
            </label>
            <textarea
                {{ attributes.nested('textarea').defaults({
                    placeholder: 'checkout.customerCommentPlaceholder'|trans|sw_sanitize,
                    id: commentKey,
                    form: 'confirmOrderForm',
                    name: commentKey,
                }) }}
                class="{{ cx.textarea.apply() }}"
            ></textarea>
        </div>
    {% endblock %}
</div>
