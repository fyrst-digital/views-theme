{% props
    title = true,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'control', 'label', 'textarea']) %}

{% set commentKey = constant('Shopware\\Core\\Checkout\\Order\\SalesChannel\\OrderService::CUSTOMER_COMMENT_KEY') %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% if title %}
        {% block title %}
            <div {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
                {{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}
            </div>
        {% endblock %}
    {% endif %}

    {% block control %}
        <div {{ vi_attrs('control') }} class="{{ vi_class('control') }}">
            <label
                {{ vi_attrs('label').defaults({
                    for: commentKey,
                }) }}
                class="{{ vi_class('label') }}"
            >
                {{ 'checkout.customerCommentLabel'|trans|sw_sanitize }}
            </label>
            <textarea
                {{ vi_attrs('textarea').defaults({
                    placeholder: 'checkout.customerCommentPlaceholder'|trans|sw_sanitize,
                    id: commentKey,
                    form: 'confirmOrderForm',
                    name: commentKey,
                }) }}
                class="{{ vi_class('textarea') }}"
            ></textarea>
        </div>
    {% endblock %}
</div>
