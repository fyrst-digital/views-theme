{% props
    page,
    comment = page.order.customerComment,
    customFieldKey = config('ViewsTheme.config.deliveryDateCustomFieldKey')|default('preferred_delivery_date'),
    date = page.order.customFields[customFieldKey]|default(null),
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['additions', 'orderComment', 'orderDeliveryDate', 'box', 'heading', 'summary']) %}

<aside
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block additions %}
        <twig:ViewsTheme:Checkout:Additions
            class="{{ vi_class('additions') }}"
            :visible="comment or date ? true : false"
            {{ ...vi_attrs('additions').defaults({
                page: page,
            }).all() }}
        >
            <twig:block name="title"></twig:block>

            <twig:block name="comment">
                {% if comment %}
                    <twig:ViewsTheme:Checkout:Success:Comment
                        class="{{ vi_class('orderComment') }}"
                        {{ ...vi_attrs('orderComment').defaults({
                            page: page,
                            comment: comment,
                        }).all() }}
                    />
                {% endif %}
            </twig:block>

            <twig:block name="delivery_date">
                {% if date %}
                    <twig:ViewsTheme:Checkout:Success:DeliveryDate
                        class="{{ vi_class('orderDeliveryDate') }}"
                        {{ ...vi_attrs('orderDeliveryDate').defaults({
                            page: page,
                            date: date,
                        }).all() }}
                    />
                {% endif %}
            </twig:block>
        </twig:ViewsTheme:Checkout:Additions>
    {% endblock %}

    {% block box %}
        <twig:ViewsTheme:Summary:Box
            class="{{ vi_class('box') }}"
            {{ ...vi_attrs('box').all() }}
        >
            <twig:block name="content">
                {% vi_block heading %}
                    <h2
                        {{ vi_attrs('heading') }}
                        class="{{ vi_class('heading') }}"
                    >
                        {{ 'checkout.summaryHeader'|trans|sw_sanitize }}
                    </h2>
                {% endvi_block %}

                {% vi_block summary %}
                    <twig:ViewsTheme:Cart:Summary
                        class="{{ vi_class('summary') }}"
                        {{ ...vi_attrs('summary').defaults({
                            summary: page.order,
                        }).all() }}
                    />
                {% endvi_block %}
            </twig:block>
        </twig:ViewsTheme:Summary:Box>
    {% endblock %}
</aside>
