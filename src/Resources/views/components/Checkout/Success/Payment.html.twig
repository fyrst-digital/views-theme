{% if visible %}
    {% set titleId = 'vi-success-payment-' ~ random() %}

    {% do vi_define_cva(cva) %}
    {% do vi_define_attrs(['title', 'method']) %}

    <section
        {{ attributes.defaults({
            'aria-labelledby': titleId,
        }) }}
        class="{{ vi_class('root', { framed: framed }) }}"
    >
        {% block title %}
            <div
                {{ vi_attrs('title').defaults({
                    id: titleId,
                }) }}
                class="{{ vi_class('title') }}"
            >
                {{ vi_icon('credit-card', { class: vi_class('icon') }) -}}
                {{- 'checkout.confirmPaymentMethod'|trans|sw_sanitize }}
            </div>
        {% endblock %}

        {% block method %}
            <twig:ViewsTheme:Form:Selection
                type="radio"
                id="{{ 'paymentMethod' ~ methodId }}"
                label="{{ name }}"
                label:class="fw-semibold"
                :description="description"
                :checked="true"
                class="{{ vi_class('method') }}"
                {{ ...vi_attrs('method').all() }}
            />
        {% endblock %}
    </section>
{% endif %}
