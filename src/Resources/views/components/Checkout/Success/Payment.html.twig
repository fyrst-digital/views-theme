{% if visible %}
    {% do vi_define_cva(cva) %}
    {% do vi_define_attrs(['title', 'method']) %}

    <section
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block title %}
            <h2
                {{ vi_attrs('title') }}
                class="{{ vi_class('title') }}"
            >
                {{ vi_icon('credit-card', { class: vi_class('icon') }) -}}
                {{- 'checkout.confirmPaymentMethod'|trans|sw_sanitize }}
            </h2>
        {% endblock %}

        {% block method %}
            <twig:ViewsTheme:Form:Selection
                type="radio"
                id="{{ 'paymentMethod' ~ methodId }}"
                label="{{ name }}"
                :description="description"
                :checked="true"
                class="{{ vi_class('method') }}"
                {{ ...vi_attrs('method').all() }}
            />
        {% endblock %}
    </section>
{% endif %}
