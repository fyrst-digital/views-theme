{% props
    page,
    comment = page.order.customerComment,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'body']) %}

{% if comment %}
    <div
        {{ attributes }}
        class="{{ vi_class('root') }}"
    >
        {% block title %}
            <div {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
                {{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}
            </div>
        {% endblock %}

        {% block body %}
            <div {{ vi_attrs('body') }} class="{{ vi_class('body') }}">
                {{ comment|sw_sanitize|nl2br }}
            </div>
        {% endblock %}
    </div>
{% endif %}
