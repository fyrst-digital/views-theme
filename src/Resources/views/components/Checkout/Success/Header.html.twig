{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['description']) %}

<twig:ViewsTheme:Page:Title
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        heading: heading,
        meta: meta,
        'data-order-number': orderNumber,
    }).all() }}
>
    <twig:block name="description">
        {% if description %}
            <div
                {{ vi_attrs('description') }}
                class="{{ vi_class('description') }}"
            >
                {{ description|sw_sanitize }}
            </div>
        {% endif %}

        <twig:ViewsTheme:Page:Support class="d-xl-none" />
    </twig:block>
</twig:ViewsTheme:Page:Title>
