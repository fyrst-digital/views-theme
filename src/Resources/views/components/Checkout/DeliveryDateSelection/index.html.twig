{% props
    deliveryDate = null,
    title = null,
    label = null,
    helpText = null,
    defaultBaseClasses = 'vi-checkout-delivery-date',
    defaultVariants = {},
%}

{% set deliveryDate = deliveryDate is not null
    ? deliveryDate
    : page.extensions.viewsTheme.deliveryDate|default({}) %}
{% set title = title is not null
    ? title
    : 'checkout.preferredDeliveryDate.title'|trans|sw_sanitize %}
{% set label = label is not null
    ? label
    : 'checkout.preferredDeliveryDate.label'|trans|sw_sanitize %}
{% set helpText = helpText is not null
    ? helpText
    : 'checkout.preferredDeliveryDate.helpText'|trans|sw_sanitize %}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set titleAttributes = attributes.nested('title') %}
{% set controlAttributes = attributes.nested('control') %}
{% set labelAttributes = attributes.nested('label') %}
{% set inputAttributes = attributes.nested('input') %}
{% set helpAttributes = attributes.nested('help') %}

{% if deliveryDate.active|default(false) %}
    <div
        data-component="ViewsTheme:Checkout:DeliveryDateSelection"
        {{ attributes }}
        class="{{ rootCVA.apply({}, rootClass) }}"
    >
        {% block title %}
            {% if title is not same as(false) %}
                <div
                    {{ titleAttributes.defaults({
                        class: 'vi-checkout-delivery-date__title',
                    }) }}
                >
                    {{ title }}
                </div>
            {% endif %}
        {% endblock %}

        {% block control %}
            <div
                {{ controlAttributes.defaults({
                    class: 'vi-checkout-delivery-date__control',
                }) }}
            >
                {% block label %}
                    {% if label is not same as(false) %}
                        <label
                            for="PreferredDeliveryDate"
                            {{ labelAttributes.defaults({
                                class: 'vi-checkout-delivery-date__label form-label',
                            }) }}
                        >
                            {{ label }}
                        </label>
                    {% endif %}
                {% endblock %}

                {% block input %}
                    <input
                        type="date"
                        id="PreferredDeliveryDate"
                        form="confirmOrderForm"
                        name="viewsThemeDeliveryDate"
                        min="{{ deliveryDate.min|default('') }}"
                        max="{{ deliveryDate.max|default('') }}"
                        value=""
                        {{ inputAttributes.defaults({
                            class: 'vi-checkout-delivery-date__input form-control',
                        }) }}
                    >
                {% endblock %}

                {% block help %}
                    {% if helpText is not same as(false) %}
                        <div
                            {{ helpAttributes.defaults({
                                class: 'vi-checkout-delivery-date__help form-text',
                            }) }}
                        >
                            {{ helpText }}
                        </div>
                    {% endif %}
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endif %}
