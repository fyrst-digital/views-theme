{
    root: { base: 'vi-privacy-note d-flex flex-column gap-3' },
    title: { base: 'vi-privacy-note__title fw-semibold mb-0' },
    text: { base: 'vi-privacy-note__text mb-0' },
    link: { base: 'vi-privacy-note__link fw-semibold text-body text-decoration-none' },
    control: { base: 'vi-privacy-note__control form-check' },
    checkbox: {
        base: 'vi-privacy-note__checkbox form-check-input',
        variants: {
            invalid: {
                true: 'is-invalid',
            },
        },
    },
    label: { base: 'vi-privacy-note__label form-check-label' },
    feedback: { base: 'vi-privacy-note__feedback form-field-feedback' },
}
