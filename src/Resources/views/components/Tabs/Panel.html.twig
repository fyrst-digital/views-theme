{% props
    id = null,
    tab = null,
    active = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<div
    {{ attributes.defaults({
        id: id,
        role: 'tabpanel',
        'aria-labelledby': tab,
        hidden: not active,
        'data-component': 'ViewsTheme:Tabs:Panel',
        'data-component-options': {
            tab: tab,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block content %}{% endblock %}
</div>
