{% block component_variants_grid_rows %}
    {% for variant in variants %}
        {% set isAvailable = variant.available and variant.calculatedMaxPurchase > 0 %}
        {% set showQuantitySelect = not variant.type is defined or variant.type != constant('Shopware\\Core\\Content\\Product\\ProductDefinition::TYPE_DIGITAL') or (variant.type == constant('Shopware\\Core\\Content\\Product\\ProductDefinition::TYPE_DIGITAL') and variant.maxPurchase !== 1) %}

        <tr class="variants-grid-row{% if not isAvailable %} variants-grid-row--unavailable bg-light{% endif %}">
            {% block component_variants_grid_row_preview %}
                {% sw_include '@Storefront/components/variants-grid/columns/preview.html.twig' with {
                    variant: variant,
                } only %}
            {% endblock %}

            {% block component_variants_grid_row_number %}
                {% sw_include '@Storefront/components/variants-grid/columns/product-number.html.twig' with {
                    variant: variant,
                } only %}
            {% endblock %}

            {% block component_variants_grid_row_options %}
                {% sw_include '@Storefront/components/variants-grid/columns/options.html.twig' with {
                    variant: variant,
                    groups: groups,
                } only %}
            {% endblock %}

            {% block component_variants_grid_row_price %}
                {% sw_include '@Storefront/components/variants-grid/columns/unit-price.html.twig' with {
                    variant: variant,
                } only %}
            {% endblock %}

            {% block component_variants_grid_row_quantity %}
                {% sw_include '@Storefront/components/variants-grid/columns/quantity.html.twig' with {
                    variant: variant,
                    isAvailable: isAvailable,
                    showQuantitySelect: showQuantitySelect,
                } only %}
            {% endblock %}
        </tr>
    {% endfor %}
{% endblock %}
