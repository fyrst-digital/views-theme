{%
  set classes = vi_define_classes({
    cell: ['variants-grid-column-option'],
    swatch: ['variants-grid-option-swatch', 'd-inline-block', 'rounded-circle', 'border', 'align-middle'],
    swatchColor: ['variants-grid-option-swatch', 'variants-grid-option-swatch--color', 'd-inline-block', 'rounded-circle', 'border', 'align-middle'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_variants_grid_column_options_cells %}
  {% for group in groups %}
    {% block component_variants_grid_column_option_cell %}
      <td {{ classes.cell | vi_attr_classes }}>
        {% set option = variant.options.filterByProperty('groupId', group.id).first %}
        {% if option %}
          {% block component_variants_grid_column_option_value %}
            {% if option.media %}
              <img
                src="{{ option.media|sw_encode_media_url }}"
                alt="{{ option.translated.name|e('html_attr') }}"
                class="{{ classes.swatch|join(' ') }}"
                width="24"
                height="24"
                loading="lazy">
            {% elseif option.colorHexCode %}
              <span
                class="{{ classes.swatchColor|join(' ') }}"
                style="background-color: {{ option.colorHexCode }};"
                title="{{ option.translated.name|e('html_attr') }}">
              </span>
            {% else %}
              {{ option.translated.name }}
            {% endif %}
          {% endblock %}
        {% endif %}
      </td>
    {% endblock %}
  {% endfor %}
{% endblock %}
