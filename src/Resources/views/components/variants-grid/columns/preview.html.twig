{% block component_variants_grid_column_preview_cell %}
    <td class="variants-grid-column-preview">
        {% if variant.cover %}
            {% block component_variants_grid_column_preview_image %}
                <img src="{{ variant.cover.media|sw_encode_media_url }}"
                     alt="{{ variant.translated.name|e('html_attr') }}"
                     class="variants-grid-preview-image object-fit-cover"
                     loading="lazy"
                     width="50"
                     height="50">
            {% endblock %}
        {% endif %}
    </td>
{% endblock %}
