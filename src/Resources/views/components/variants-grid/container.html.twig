{% set formAction = path('frontend.checkout.variants-grid.add') %}

{%
  set classes = vi_define_classes({
    container: ['variants-grid-container'],
    liveRegion: ['visually-hidden'],
    form: ['variants-grid-form'],
    tableWrapper: ['table-responsive'],
    table: ['table', 'table-striped', 'variants-grid-table'],
    headPreview: ['variants-grid-column-preview'],
    headNumber: ['variants-grid-column-number'],
    headOption: ['variants-grid-column-option'],
    headPrice: ['variants-grid-column-price'],
    headQuantity: ['variants-grid-column-quantity'],
    actions: ['variants-grid-actions', 'd-flex', 'justify-content-between', 'align-items-center'],
    buyButton: ['btn', 'btn-primary', 'variants-grid-buy-button'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_variants_grid %}
  {% set showPreviewColumn = config('ViewsTheme.config.variantsGridShowPreviewColumn') %}
  {% set showProductNumberColumn = config('ViewsTheme.config.variantsGridShowProductNumberColumn') %}
  <div
    {{ classes.container | vi_attr_classes }}
    data-component="variants-grid"
    data-load-url="{{ path('frontend.checkout.variants-grid.load') }}"
    data-parent-id="{{ parentId }}">
    {% block component_variants_grid_error %}
      {% sw_include '@Storefront/components/variants-grid/alert.html.twig' %}
    {% endblock %}

    {% block component_variants_grid_live_region %}
      <div
        {{ classes.liveRegion | vi_attr_classes }}
        aria-live="polite"
        aria-atomic="true"
        data-component="live-region"
        data-page-loaded-template="{{ 'variantsGrid.pagination.pageLoaded'|trans|sw_sanitize }}"></div>
    {% endblock %}

    {% block component_variants_grid_form %}
      <form
        action="{{ formAction }}"
        method="post"
        {{ classes.form | vi_attr_classes }}
        data-variants-grid-form="true"
        data-add-to-cart="true">

        {% block component_variants_grid_table %}
          <div {{ classes.tableWrapper | vi_attr_classes }}>
            <table {{ classes.table | vi_attr_classes }}>
              {% block component_variants_grid_head %}
                <thead>
                  <tr>
                    {% block component_variants_grid_head_preview %}
                      {% if showPreviewColumn %}
                        <th {{ classes.headPreview | vi_attr_classes }} scope="col">
                          {{ 'variantsGrid.table.preview'|trans|sw_sanitize }}
                        </th>
                      {% endif %}
                    {% endblock %}

                    {% block component_variants_grid_head_number %}
                      {% if showProductNumberColumn %}
                        <th {{ classes.headNumber | vi_attr_classes }} scope="col">
                          {{ 'checkout.addProductLabel'|trans|sw_sanitize }}
                        </th>
                      {% endif %}
                    {% endblock %}

                    {% block component_variants_grid_head_options %}
                      {% for group in groups %}
                        <th {{ classes.headOption | vi_attr_classes }} scope="col">
                          {{ group.translated.name }}
                        </th>
                      {% endfor %}
                    {% endblock %}

                    {% block component_variants_grid_head_price %}
                      <th {{ classes.headPrice | vi_attr_classes }} scope="col">
                        {{ 'checkout.cartHeaderUnitPrice'|trans|sw_sanitize }}
                      </th>
                    {% endblock %}

                    {% block component_variants_grid_head_quantity %}
                      <th {{ classes.headQuantity | vi_attr_classes }} scope="col">
                        {{ 'checkout.cartHeaderQuantity'|trans|sw_sanitize }}
                      </th>
                    {% endblock %}
                  </tr>
                </thead>
              {% endblock %}

              {% block component_variants_grid_body %}
                <tbody data-component="grid-body">
                  {% sw_include '@Storefront/components/variants-grid/rows.html.twig' with {
                    variants: variants,
                    groups: groups,
                  } %}
                </tbody>
              {% endblock %}
            </table>
          </div>
        {% endblock %}

        {% block component_variants_grid_hidden_redirect %}
          <input type="hidden"
            name="redirectTo"
            value="frontend.detail.page">

          <input type="hidden"
            name="redirectParameters"
            value="{{ {productId: parentId}|json_encode }}">

          <div data-component="grid-memory" style="display:none;"></div>
        {% endblock %}

        {% block component_variants_grid_actions %}
          <div {{ classes.actions | vi_attr_classes }}>
            {% block component_variants_grid_pagination %}
              <div data-component="pagination">
                {% sw_include '@Storefront/components/variants-grid/pagination.html.twig' with {
                  pagination: pagination,
                  pageParameter: pageParameter,
                } %}
              </div>
            {% endblock %}

            {% block component_variants_grid_buy_button %}
              <button
                type="submit"
                {{ classes.buyButton | vi_attr_classes }}
                data-component="buy-button">
                {% block component_variants_grid_buy_button_label %}
                  {{ 'detail.addProduct'|trans|sw_sanitize }}
                {% endblock %}
              </button>
            {% endblock %}
          </div>
        {% endblock %}
      </form>
    {% endblock %}
  </div>
{% endblock %}
