{%
  set classes = vi_define_classes({
    alert: ['alert', 'alert-danger', 'd-none'],
  }, classes|default({}), replaceClasses|default(false))
%}

{% block component_variants_grid_alert %}
  <div
    {{ classes.alert | vi_attr_classes }}
    role="alert"
    data-component="error-message"></div>
{% endblock %}
