{% props
    searchTerm = null,
    iconOptions = null,
    minSearchLength = null,
    defaultBaseClasses = 'vi-search-bar position-relative header-search-form js-search-form',
    defaultVariants = {},
%}

{% set searchTerm = searchTerm is not null ? searchTerm : page.searchTerm|default('') %}
{% set iconOptions = iconOptions|default(themeParameters.icons|default({})) %}
{% set minSearchLength = minSearchLength is not null ? minSearchLength : shopware.minSearchLength %}
{% set searchWidgetOptions = { searchWidgetMinChars: minSearchLength } %}
{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set submitAttributes = attributes.nested('submit') %}
{% set inputAttributes = attributes.nested('input') %}

<form
    action="{{ path('frontend.search.page') }}"
    method="get"
    data-search-widget="true"
    data-search-widget-options="{{ searchWidgetOptions|json_encode }}"
    data-url="{{ path('frontend.search.suggest') }}?search="
    data-ref="search-bar"
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block submit %}
        <button
            type="submit"
            aria-label="{{ 'header.searchButton'|trans|striptags }}"
            data-ref="submit"
            {{ submitAttributes.defaults({
                class: 'vi-search-bar__submit btn header-search-btn border-0',
            }) }}
        >
            {{ vi_icon('magnifying-glass', iconOptions) }}
        </button>
    {% endblock %}

    {% block input %}
        <input
            type="search"
            id="header-main-search-input"
            name="search"
            autocomplete="off"
            autocapitalize="off"
            placeholder="{{ 'header.searchPlaceholder'|trans|striptags }}"
            aria-label="{{ 'header.searchPlaceholder'|trans|striptags }}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            value="{{ searchTerm }}"
            data-ref="input"
            {{ inputAttributes.defaults({
                class: 'vi-search-bar__input rounded form-control header-search-input',
            }) }}
        >
    {% endblock %}

    {% block clear %}{% endblock %}
</form>
