{% props
    searchTerm = page.searchTerm|default(''),
    minSearchLength = shopware.minSearchLength,
    suggestUrl = path('frontend.views-theme.search.suggest'),
    delay = 250,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    input: attributes.nested('input'),
    submit: attributes.nested('submit'),
} %}

<form
    {{ attributes.defaults({
        action: path('frontend.search.page'),
        method: 'get',
        'data-component': 'ViewsTheme:Search:Bar',
        'data-component-options': {
            suggestUrl: suggestUrl,
            minChars: minSearchLength,
            delay: delay,
        }|json_encode,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        {% block input %}
            <input
                {{ attrs.input.defaults({
                    type: 'search',
                    id: 'SearchOverlayInput',
                    name: 'search',
                    autocomplete: 'off',
                    autocapitalize: 'off',
                    placeholder: 'header.searchPlaceholder'|trans|striptags,
                    'aria-label': 'header.searchPlaceholder'|trans|striptags,
                    role: 'combobox',
                    'aria-autocomplete': 'list',
                    'aria-expanded': 'false',
                    value: searchTerm,
                }) }}
                class="{{ cx.input.apply() }}"
            >
        {% endblock %}

        {% block submit %}
            <button
                {{ attrs.submit.defaults({
                    type: 'submit',
                    'aria-label': 'header.searchButton'|trans|striptags,
                }) }}
                class="{{ cx.submit.apply() }}"
            >
                {{ vi_icon('magnifying-glass') }}
            </button>
        {% endblock %}
    {% endblock %}
</form>
