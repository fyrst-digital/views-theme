{% props
    product,
    metaProperty = product.manufacturer.translated.name|default(product.seoCategory.translated.name|default('')),
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['body', 'metaProperty']) %}

<a
    {{ attributes.defaults({
        href: seoUrl('frontend.detail.page', { productId: product.id }),
        title: product.translated.name,
        role: 'option',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% block image %}
            <twig:ViewsTheme:Product:Cover
                :id="product.id"
                :name="product.translated.name"
                :cover="product.cover.media"
                :showLink="false"
                tag="span"
                :sizes="{
                    'xs': '64px',
                    'sm': '80px',
                    'xl': '100px'
                }"
            />
        {% endblock %}

        {% block body %}
            <span
                {{ vi_attrs('body') }}
                class="{{ vi_class('body') }}"
            >
                {% block meta %}
                    {% if metaProperty %}
                        <span
                            {{ vi_attrs('metaProperty') }}
                            class="{{ vi_class('metaProperty') }}"
                        >
                            {{ metaProperty }}
                        </span>
                    {% endif %}
                {% endblock %}

                {% block name %}
                    <twig:ViewsTheme:Product:Name
                        :product="product"
                        :showLink="false"
                        tag="span"
                        class="fw-medium"
                    />
                {% endblock %}

                {% block pricing %}
                    <twig:ViewsTheme:Product:Price
                        :product="product"
                        class="fs-5"
                        unit:class="fw-bold"
                    />
                {% endblock %}
            </span>
        {% endblock %}
    {% endblock %}
</a>
