{% props
    title = 'viewsTheme.search.productsHeading'|trans|sw_sanitize,
    total = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['total']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {{ title }}
    {% if total %}
        <span
            {{ vi_attrs('total') }}
            class="{{ vi_class('total') }}"
        >
            ({{ total }})
        </span>
    {% endif %}
</div>
