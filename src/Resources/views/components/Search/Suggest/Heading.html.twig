{% props
    title = 'viewsTheme.search.productsHeading'|trans|sw_sanitize,
    total = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    total: attributes.nested('total'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {{ title }}
    {% if total %}
        <span
            {{ attrs.total }}
            class="{{ cx.total.apply() }}"
        >
            ({{ total }})
        </span>
    {% endif %}
</div>
