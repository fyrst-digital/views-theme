{% props
    searchResult,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<twig:ViewsTheme:Scroll:Area class="{{ vi_class('root') }}">
    {% for product in searchResult %}
        <twig:ViewsTheme:Search:Suggest:Item
            :product="product"
            class="g-col-4 g-col-lg-2" />
    {% endfor %}
</twig:ViewsTheme:Scroll:Area>
