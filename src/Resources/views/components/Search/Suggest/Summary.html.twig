{% props
    total = 0,
    searchTerm = '',
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% if total > 0 %}
    <div
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% block action %}
            <twig:ViewsTheme:Button
                class="{{ cx.action.apply() }}"
                {{ ...attributes.nested('action').defaults({
                    type: 'link',
                    color: 'light',
                    href: path('frontend.search.page') ~ '?search=' ~ searchTerm|url_encode,
                    title: 'header.searchAllResults'|trans|striptags,
                    label: 'header.searchAllResults'|trans|sw_sanitize,
                    'data-action': 'view-all',
                }).all() }}
            />
        {% endblock %}
    </div>
{% endif %}
