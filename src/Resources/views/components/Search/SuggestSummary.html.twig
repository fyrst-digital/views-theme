{% props
    total = 0,
    searchTerm = '',
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-search-suggest-summary js-result p-4 border-top' },
    action: { base: 'vi-search-suggest-summary__action btn btn-primary' },
    badge: { base: 'vi-search-suggest-summary__badge badge rounded-pill text-bg-light' },
}|replace_recursive(cva)) %}

{% if total > 0 %}
    <div
        data-ref="summary"
        {{ attributes }}
        class="{{ cx.root.apply() }}"
    >
        {% block action %}
            <a
                href="{{ path('frontend.search.page') }}?search={{ searchTerm }}"
                title="{{ 'header.searchAllResults'|trans|striptags }}"
                {{ attributes.nested('action') }}
                class="{{ cx.action.apply() }}"
            >
                {{ 'header.searchAllResults'|trans|sw_sanitize }}
                {% block badge %}
                    <span
                        {{ attributes.nested('badge') }}
                        class="{{ cx.badge.apply() }}"
                    >
                        {{ total }}
                    </span>
                {% endblock %}
            </a>
        {% endblock %}
    </div>
{% endif %}
