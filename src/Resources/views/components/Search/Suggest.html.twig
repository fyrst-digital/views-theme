{% props
    searchResult = null,
    searchTerm = null,
    defaultBaseClasses = 'vi-search-suggest position-absolute op-100 start-50 translate-middle-x bg-white border border-1 rounded-3 shadow-lg js-search-result',
    defaultVariants = {},
%}

{% set searchResult = searchResult is not null ? searchResult : page.searchResult %}
{% set searchTerm = searchTerm is not null ? searchTerm : page.searchTerm|default('') %}
{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set resultsAttributes = attributes.nested('results') %}

<div
    data-ref="suggest"
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block container %}
        {% if searchResult.total > 0 %}
            {% block results %}
                <div
                    data-ref="results"
                    {{ resultsAttributes.defaults({
                        class: 'vi-search-suggest__results grid gap-4 p-4',
                    }) }}
                >
                    {% for product in searchResult %}
                        {% block result_item %}
                            <twig:ViewsTheme:Search:SuggestItem :product="product" />
                        {% endblock %}
                    {% endfor %}
                </div>
            {% endblock %}

            {% block summary %}
                <twig:ViewsTheme:Search:SuggestSummary
                    :total="searchResult.total"
                    :searchTerm="searchTerm"
                />
            {% endblock %}
        {% else %}
            {% block empty %}
                <twig:ViewsTheme:Search:SuggestEmpty />
            {% endblock %}
        {% endif %}
    {% endblock %}
</div>
