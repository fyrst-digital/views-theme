{% props
    searchResult = null,
    searchTerm = null,
    cva = {},
%}

{% set searchResult = searchResult is not null ? searchResult : page.searchResult %}
{% set searchTerm = searchTerm is not null ? searchTerm : page.searchTerm|default('') %}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults({
        id: 'search-suggest-listbox',
        role: 'listbox',
        'aria-label': 'header.searchDropdownTitle'|trans|striptags,
    }) }}
    class="{{ cx.root.apply() }}"
>
    {% block container %}
        {% if searchResult.total > 0 %}
            {% block heading %}
                <twig:ViewsTheme:Search:Suggest:Heading
                    total="{{searchResult.total}}"
                    class="fs-4 fw-semibold p-4" />
            {% endblock %}

            {% block results %}
                <div
                    {{ attributes.nested('results') }}
                    class="{{ cx.results.apply() }}"
                >
                    {% for product in searchResult %}
                        {% block result_item %}
                            <twig:ViewsTheme:Search:Suggest:Item 
                                :product="product"
                                class="g-col-4 g-col-lg-2" />
                        {% endblock %}
                    {% endfor %}
                </div>
            {% endblock %}

            {% block summary %}
                <twig:ViewsTheme:Search:Suggest:Summary
                    :total="searchResult.total"
                    :searchTerm="searchTerm"
                />
            {% endblock %}
        {% else %}
            {% block empty %}
                <twig:ViewsTheme:Search:Suggest:Empty />
            {% endblock %}
        {% endif %}
    {% endblock %}
</div>
