{% props
    searchResult = null,
    searchTerm = null,
    cva = {},
%}

{% set searchResult = searchResult is not null ? searchResult : page.searchResult %}
{% set searchTerm = searchTerm is not null ? searchTerm : page.searchTerm|default('') %}

{% set cx = vi_cva_from_file(cva) %}

<div
    id="search-suggest-listbox"
    role="listbox"
    aria-label="{{ 'header.searchDropdownTitle'|trans|striptags }}"
    data-ref="suggest"
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block container %}
        {% if searchResult.total > 0 %}
            {% block heading %}
                <div
                    data-ref="heading"
                    {{ attributes.nested('heading') }}
                    class="{{ cx.heading.apply() }}"
                >
                    Products
                </div>
            {% endblock %}

            {% block results %}
                <div
                    data-ref="results"
                    {{ attributes.nested('results') }}
                    class="{{ cx.results.apply() }}"
                >
                    {% for product in searchResult %}
                        {% block result_item %}
                            <twig:ViewsTheme:Search:SuggestItem :product="product" />
                        {% endblock %}
                    {% endfor %}
                </div>
            {% endblock %}

            {% block summary %}
                <twig:ViewsTheme:Search:SuggestSummary
                    :total="searchResult.total"
                    :searchTerm="searchTerm"
                />
            {% endblock %}
        {% else %}
            {% block empty %}
                <twig:ViewsTheme:Search:SuggestEmpty />
            {% endblock %}
        {% endif %}
    {% endblock %}
</div>
