{% props
    searchResult = page.searchResult,
    searchTerm = page.searchTerm|default(''),
    cva = {},
%}

{% do vi_define_cva(cva) %}

<div
    {{ attributes.defaults({
        id: 'search-suggest-listbox',
        role: 'listbox',
        'aria-label': 'header.searchDropdownTitle'|trans|striptags,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% if searchResult.total > 0 %}
            {% block heading %}
                <twig:ViewsTheme:Search:Suggest:Heading
                    total="{{searchResult.total}}"
                    class="fs-4 fw-semibold p-4" />
            {% endblock %}

            {% block results %}
                <twig:ViewsTheme:Search:Suggest:Results
                    :searchResult="searchResult" />
            {% endblock %}

            {% block summary %}
                <twig:ViewsTheme:Search:Suggest:Summary
                    :total="searchResult.total"
                    :searchTerm="searchTerm"
                />
            {% endblock %}
        {% else %}
            {% block empty %}
                <twig:ViewsTheme:Search:Suggest:Empty />
            {% endblock %}
        {% endif %}
    {% endblock %}
</div>
