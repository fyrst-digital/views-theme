{% props
    product,
    defaultBaseClasses = 'vi-search-suggest-item g-col-4 d-flex flex-wrap',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set imageAttributes = attributes.nested('image') %}
{% set contentAttributes = attributes.nested('content') %}
{% set nameAttributes = attributes.nested('name') %}

<a
    href="{{ seoUrl('frontend.detail.page', { productId: product.id }) }}"
    title="{{ product.translated.name }}"
    data-ref="item"
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block image %}
        {% set imageClass = imageAttributes.render('class') %}
        {% set mediaAttrs = {
            class: imageClass ?: 'vi-search-suggest-item__image d-block col-auto',
            title: (product.cover.media.translated.title ?: ''),
        } %}

        {% if product.cover.media.url and product.cover.media.isSpatialObject() == false %}
            {% if product.cover.media.getMediaType().getName() === 'VIDEO' %}
                {% sw_include '@Storefront/storefront/utilities/video.html.twig' with {
                    media: product.cover.media,
                    attributes: mediaAttrs,
                } %}
            {% else %}
                {% set mediaAttrs = mediaAttrs|merge({
                    alt: (product.cover.media.translated.alt ?: ''),
                }) %}
                {% sw_thumbnails 'search-suggest-product-image-thumbnails' with {
                    media: product.cover.media,
                    sizes: { default: '100px' },
                    attributes: mediaAttrs,
                } %}
            {% endif %}
        {% else %}
            {% sw_icon 'placeholder' style { size: 'lg' } %}
        {% endif %}
    {% endblock %}

    {% block content %}
        <div
            {{ contentAttributes.defaults({
                class: 'vi-search-suggest-item__content col',
            }) }}
        >
            {% block name %}
                <div
                    data-ref="name"
                    {{ nameAttributes.defaults({
                        class: 'vi-search-suggest-item__name',
                    }) }}
                >
                    {{ product.translated.name }}
                </div>
            {% endblock %}

            {% block pricing %}
                {% sw_include '@Storefront/components/product/price.html.twig' with {
                    product: product,
                } %}
            {% endblock %}
        </div>
    {% endblock %}
</a>
