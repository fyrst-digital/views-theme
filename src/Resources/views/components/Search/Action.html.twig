{% props
    size = 'md', # md
    templateId = 'vi-search-overlay-template',
    cva = {},
%}

{% do vi_define_cva(cva) %}

<twig:ViewsTheme:Button
    class="{{ vi_class('root', { size: size }) }}"
    {{ ...attributes.defaults({
        type: 'button',
        icon: 'magnifying-glass',
        color: 'none',
        size: size,
        'aria-label': 'header.searchButton'|trans|striptags,
        'aria-haspopup': 'dialog',
        'aria-controls': 'vi-search-overlay',
        'aria-expanded': 'false',
        'data-component': 'ViewsTheme:Search:Action',
        'data-component-options': {
            templateId: templateId,
        }|json_encode,
    }).all() }}
/>

{# Static overlay shell: the Action clones it on open (no request) #}
<template id="{{ templateId }}">
    <twig:ViewsTheme:Search:Overlay />
</template>
