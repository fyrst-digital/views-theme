{% props
    size = 'md',
    overlayUrl = path('frontend.views-theme.search.overlay'),
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<button
    {{ attributes.defaults({
        type: 'button',
        'aria-label': 'header.searchButton'|trans|striptags,
        'aria-haspopup': 'dialog',
        'aria-controls': 'vi-search-overlay',
        'aria-expanded': 'false',
        'data-component': 'ViewsTheme:Search:Action',
        'data-component-options': {
            overlayUrl: overlayUrl,
        }|json_encode,
    }) }}
    class="{{ cx.root.apply({ size: size }) }}"
>
    {{ vi_icon('magnifying-glass') }}
</button>
