{% sw_extends '@Storefront/storefront/page/search/search-pagelet.html.twig' %}

{#
  Search pagelet composition. Lives under components/ only —
  not a storefront layout override. Include explicitly when needed.
#}

{% block element_product_listing_wrapper %}
    {% sw_include '@Storefront/components/element/cms-element-sidebar-filter.html.twig' with {
        listing: page.listing,
        sidebar: false,
    } %}

    {% sw_include '@Storefront/components/product/listing.html.twig' with {
        searchResult: page.listing,
        dataUrl: path('widgets.search.pagelet.v2'),
        filterUrl: path('widgets.search.filter'),
        params: { search: page.searchTerm },
        sidebar: 0,
    } %}
{% endblock %}
