{% props
    searchTerm = null,
    minSearchLength = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['panel']) %}

<div
    {{ attributes.defaults({
        id: 'vi-search-overlay',
        role: 'dialog',
        'aria-modal': 'true',
        'aria-label': 'header.searchButton'|trans|striptags,
        'aria-hidden': 'true',
        inert: true,
        'data-component': 'ViewsTheme:Search:Overlay',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block backdrop %}
        <twig:ViewsTheme:Backdrop componentName="ViewsTheme:Search:Overlay" />
    {% endblock %}

    {% block close %}
        <twig:ViewsTheme:Search:Overlay:Close />
    {% endblock %}

    {% block panel %}
        <div
            {{ vi_attrs('panel') }}
            class="{{ vi_class('panel') }}"
        >
            {% block bar %}
                <twig:ViewsTheme:Search:Bar
                    :searchTerm="searchTerm"
                    :minSearchLength="minSearchLength"
                    input:class="fs-lg-4 fw-semibold"
                />
            {% endblock %}
        </div>
    {% endblock %}
</div>
