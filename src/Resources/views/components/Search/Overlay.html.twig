{% props
    searchTerm = null,
    minSearchLength = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<div
    id="vi-search-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'header.searchButton'|trans|striptags }}"
    aria-hidden="true"
    data-component="ViewsTheme:Search:Overlay"
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block backdrop %}
        <div
            {{ attributes.nested('backdrop') }}
            class="{{ cx.backdrop.apply() }}"
        ></div>
    {% endblock %}

    {% block panel %}
        <div
            {{ attributes.nested('panel') }}
            class="{{ cx.panel.apply() }}"
        >
            {% block close %}
                <button
                    type="button"
                    aria-label="{{ 'header.searchCloseButton'|trans|striptags }}"
                    {{ attributes.nested('close') }}
                    class="{{ cx.close.apply() }}"
                >
                    {{ vi_icon('x') }}
                </button>
            {% endblock %}

            {% block body %}
                <div
                    {{ attributes.nested('body') }}
                    class="{{ cx.body.apply() }}"
                >
                    {% block bar %}
                        <twig:ViewsTheme:Search:Bar
                            :searchTerm="searchTerm"
                            :minSearchLength="minSearchLength"
                        />
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
</div>
