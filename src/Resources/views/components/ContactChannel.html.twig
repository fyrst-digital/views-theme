{% props
    label = null,
    value = null,
    icon = null,
    url = null,
    urlAttributes = [],
    openExternal = false,
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-contact-channel contact-channel' },
    label: { base: 'vi-contact-channel__label contact-channel-label' },
    content: { base: 'vi-contact-channel__content contact-channel-content' },
    value: { base: 'vi-contact-channel__value contact-channel-value' },
}|replace_recursive(cva)) %}

{% set attrs = {
    label: attributes.nested('label'),
    content: attributes.nested('content'),
    value: attributes.nested('value'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% if label %}
        <div {{ attrs.label }} class="{{ cx.label.apply() }}">
            {{ label }}
        </div>
    {% endif %}

    <div {{ attrs.content }} class="{{ cx.content.apply() }}">
        {% if icon %}
            {{ vi_icon(icon) }}
        {% endif %}

        {% if url %}
            <a
                {% if urlAttributes %}{{ urlAttributes|join(' ')|raw }}{% endif %}
                {{ attrs.value.defaults({
                    href: url,
                    title: value,
                    target: openExternal ? '_blank' : null,
                }) }}
                class="{{ cx.value.apply() }}"
            >
                {% if value %}{{ value|raw }}{% endif %}
            </a>
        {% else %}
            <span {{ attrs.value }} class="{{ cx.value.apply() }}">
                {% if value %}{{ value|raw }}{% endif %}
            </span>
        {% endif %}
    </div>
</div>
