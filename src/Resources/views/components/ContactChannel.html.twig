{% props
    label = null,
    value = null,
    icon = null,
    url = null,
    urlAttributes = [],
    openExternal = false,
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-contact-channel contact-channel' },
    label: { base: 'vi-contact-channel__label contact-channel-label' },
    content: { base: 'vi-contact-channel__content contact-channel-content' },
    value: { base: 'vi-contact-channel__value contact-channel-value' },
}|replace_recursive(cva)) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% if label %}
        <div {{ attributes.nested('label') }} class="{{ cx.label.apply() }}">
            {{ label }}
        </div>
    {% endif %}

    <div {{ attributes.nested('content') }} class="{{ cx.content.apply() }}">
        {% if icon %}
            {{ vi_icon(icon) }}
        {% endif %}

        {% if url %}
            <a
                href="{{ url }}"
                {% if urlAttributes %}{{ urlAttributes|join(' ')|raw }}{% endif %}
                {% if openExternal %}target="_blank"{% endif %}
                title="{{ value }}"
                {{ attributes.nested('value') }}
                class="{{ cx.value.apply() }}"
            >
                {% if value %}{{ value|raw }}{% endif %}
            </a>
        {% else %}
            <span {{ attributes.nested('value') }} class="{{ cx.value.apply() }}">
                {% if value %}{{ value|raw }}{% endif %}
            </span>
        {% endif %}
    </div>
</div>
