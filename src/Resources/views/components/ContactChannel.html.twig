{% props
    label = null,
    value = null,
    icon = null,
    url = null,
    urlAttributes = [],
    openExternal = false,
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-contact-channel contact-channel' },
    label: { base: 'vi-contact-channel__label contact-channel-label' },
    content: { base: 'vi-contact-channel__content contact-channel-content' },
    value: { base: 'vi-contact-channel__value contact-channel-value' },
}|replace_recursive(cva)) %}
{% do vi_define_attrs(['content', 'label', 'value']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% if label %}
        <div {{ vi_attrs('label') }} class="{{ vi_class('label') }}">
            {{ label }}
        </div>
    {% endif %}

    <div {{ vi_attrs('content') }} class="{{ vi_class('content') }}">
        {% if icon %}
            {{ vi_icon(icon) }}
        {% endif %}

        {% if url %}
            <a
                {% if urlAttributes %}{{ urlAttributes|join(' ')|raw }}{% endif %}
                {{ vi_attrs('value').defaults({
                    href: url,
                    title: value,
                    target: openExternal ? '_blank' : null,
                }) }}
                class="{{ vi_class('value') }}"
            >
                {% if value %}{{ value|raw }}{% endif %}
            </a>
        {% else %}
            <span {{ vi_attrs('value') }} class="{{ vi_class('value') }}">
                {% if value %}{{ value|raw }}{% endif %}
            </span>
        {% endif %}
    </div>
</div>
