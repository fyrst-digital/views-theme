{% props
    variant,
    groups = [],
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-variants-grid-column-option variants-grid-column-option' },
}|replace_recursive(cva)) %}

{% for group in groups %}
    <td {{ attributes }} class="{{ vi_class('root') }}">
        {% set option = variant.options.filterByProperty('groupId', group.id).first %}
        {% if option %}
            {% if option.media %}
                <img
                    src="{{ option.media|sw_encode_media_url }}"
                    alt="{{ option.translated.name|e('html_attr') }}"
                    class="variants-grid-option-swatch d-inline-block rounded-circle border align-middle"
                    width="24"
                    height="24"
                    loading="lazy"
                >
            {% elseif option.colorHexCode %}
                <span
                    class="variants-grid-option-swatch variants-grid-option-swatch--color d-inline-block rounded-circle border align-middle"
                    style="background-color: {{ option.colorHexCode }};"
                    title="{{ option.translated.name|e('html_attr') }}"
                ></span>
            {% else %}
                {{ option.translated.name }}
            {% endif %}
        {% endif %}
    </td>
{% endfor %}
