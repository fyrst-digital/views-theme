{% props
    variant,
    defaultBaseClasses = 'vi-variants-grid-column-preview variants-grid-column-preview',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}

<td {{ attributes }} class="{{ rootCVA.apply({}, rootClass) }}">
    {% if variant.cover %}
        <img
            src="{{ variant.cover.media|sw_encode_media_url }}"
            alt="{{ variant.translated.name|e('html_attr') }}"
            class="vi-variants-grid-preview-image variants-grid-preview-image object-fit-cover"
            loading="lazy"
            width="50"
            height="50"
        >
    {% endif %}
</td>
