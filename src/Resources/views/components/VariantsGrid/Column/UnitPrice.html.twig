{% props
    variant,
    defaultBaseClasses = 'vi-variants-grid-column-price variants-grid-column-price',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}

<td {{ attributes }} class="{{ rootCVA.apply({}, rootClass) }}">
    {{ variant.calculatedPrice.unitPrice|currency }}
</td>
