{% props
    side = 'start',
    title = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    header: attributes.nested('header'),
    body: attributes.nested('body'),
} %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Drawer:Panel',
        'data-component-options': {
            side: side,
        }|json_encode,
    }) }}
    class="{{ cx.root.apply({ side: side }) }}"
>
    {% block header %}
        <twig:ViewsTheme:Drawer:Header
            {{ ...attrs.header.defaults({
                title: title,
            }).all() }}
        />
    {% endblock %}

    {% block body %}
        <div
            {{ attrs.body }}
            class="{{ cx.body.apply() }}"
        >
            {% block content %}{% endblock %}
        </div>
    {% endblock %}

    {% block footer %}
    {% endblock %}
</div>
