{% props
    side = 'start',
    title = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['header', 'body']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Drawer:Panel',
        'data-component-options': {
            side: side,
        }|json_encode,
    }) }}
    class="{{ vi_class('root', { side: side }) }}"
>
    {% block header %}
        <twig:ViewsTheme:Drawer:Header
            {{ ...vi_attrs('header').defaults({
                title: title,
            }).all() }}
        />
    {% endblock %}

    {% block body %}
        <div
            {{ vi_attrs('body') }}
            class="{{ vi_class('body') }}"
        >
            {% block content %}{% endblock %}
        </div>
    {% endblock %}

    {% block footer %}
    {% endblock %}
</div>
