{% props
    title = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['title', 'close']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% block title %}
            <div
                {{ vi_attrs('title') }}
                class="{{ vi_class('title') }}"
            >
                {% if title %}
                    {{ title }}
                {% endif %}
            </div>
        {% endblock %}

        {% block close %}
            <twig:ViewsTheme:Close
                class="{{ vi_class('close') }}"
                {{ ...vi_attrs('close').defaults({
                    target: 'ViewsTheme:Drawer',
                    label: 'general.offcanvasCloseMenu'|trans|striptags,
                }).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
