{% props
    title = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    title: attributes.nested('title'),
    close: attributes.nested('close'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block content %}
        {% block title %}
            <div
                {{ attrs.title }}
                class="{{ cx.title.apply() }}"
            >
                {% if title %}
                    {{ title }}
                {% endif %}
            </div>
        {% endblock %}

        {% block close %}
            <twig:ViewsTheme:Drawer:Close
                {{ ...attrs.close.defaults({}).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
