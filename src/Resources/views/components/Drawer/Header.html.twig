{% props
    title = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['title', 'close']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block content %}
        {% block title %}
            <div
                {{ vi_attrs('title') }}
                class="{{ vi_class('title') }}"
            >
                {% if title %}
                    {{ title }}
                {% endif %}
            </div>
        {% endblock %}

        {% block close %}
            <twig:ViewsTheme:Drawer:Close
                {{ ...vi_attrs('close').defaults({}).all() }}
            />
        {% endblock %}
    {% endblock %}
</div>
