{% props
    title = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    {% block title %}
        <div
            {{ attributes.nested('title') }}
            class="{{ cx.title.apply() }}"
        >
            {% if title %}
                {{ title }}
            {% endif %}
        </div>
    {% endblock %}

    {% block close %}
        <twig:ViewsTheme:Drawer:Close
            {{ ...attributes.nested('close').defaults({}).all() }}
        />
    {% endblock %}
</div>
