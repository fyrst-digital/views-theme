{% props
    inputName = 'quantity',
    quantity = 1,
    minQuantity = 1,
    maxQuantity = 99,
    purchaseSteps = 1,
    unit = null,
    size = 'md',
    disabled = false,
    formName = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['decrease', 'input', 'unit', 'increase']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:QuantityInput',
        'data-quantity-selector': 'true',
    }) }}
    class="{{ vi_class('root', { size: size }) }}"
>
    {% block decrease %}
        <twig:ViewsTheme:Button
            class="{{ vi_class('decrease') }}"
            icon:class="{{ vi_class('icon', { size: size }) }}"
            {{ ...vi_attrs('decrease').defaults({
                type: 'button',
                icon: 'minus',
                color: 'light',
                size: size,
                square: true,
                disabled: disabled is same as(true) ? 'disabled' : false,
                'aria-label': 'component.product.quantitySelect.decrease'|trans|striptags,
            }).all() }}
        />
    {% endblock %}

    {% block field %}
        <input
            {{ vi_attrs('input').defaults({
                type: 'number',
                name: inputName,
                min: minQuantity,
                max: maxQuantity,
                step: purchaseSteps,
                value: quantity,
                disabled: disabled is same as(true) ? 'disabled' : false,
                form: formName ?: false,
                'aria-label': 'component.product.quantitySelect.label'|trans|striptags,
            }) }}
            class="{{ vi_class('input') }}"
        >
    {% endblock %}

    {% if unit %}
        {% block unit %}
            <span {{ vi_attrs('unit') }} class="{{ vi_class('unit') }}">
                {{ unit }}
            </span>
        {% endblock %}
    {% endif %}

    {% block increase %}
        <twig:ViewsTheme:Button
            class="{{ vi_class('increase') }}"
            icon:class="{{ vi_class('icon', { size: size }) }}"
            {{ ...vi_attrs('increase').defaults({
                type: 'button',
                icon: 'plus',
                color: 'light',
                size: size,
                square: true,
                disabled: disabled is same as(true) ? 'disabled' : false,
                'aria-label': 'component.product.quantitySelect.increase'|trans|striptags,
            }).all() }}
        />
    {% endblock %}
</div>
