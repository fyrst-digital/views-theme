{% props
    inputName = 'quantity',
    quantity = 1,
    minQuantity = 1,
    maxQuantity = 99,
    purchaseSteps = 1,
    unit = null,
    size = null,
    disabled = false,
    formName = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:QuantityInput',
        'data-quantity-selector': 'true',
    }) }}
    class="{{ cx.root.apply({ size: size }) }}"
>
    {% block decrease %}
        <button
            {{ attributes.nested('decrease').defaults({
                type: 'button',
                disabled: disabled is same as(true) ? 'disabled' : null,
                'aria-label': 'component.product.quantitySelect.decrease'|trans|striptags,
            }) }}
            class="{{ cx.decrease.apply() }}"
        >
            {{ vi_icon('minus') }}
        </button>
    {% endblock %}

    {% block field %}
        <input
            {{ attributes.nested('input').defaults({
                type: 'number',
                name: inputName,
                min: minQuantity,
                max: maxQuantity,
                step: purchaseSteps,
                value: quantity,
                disabled: disabled is same as(true) ? 'disabled' : null,
                form: formName ?: null,
                'aria-label': 'component.product.quantitySelect.label'|trans|striptags,
            }) }}
            class="{{ cx.input.apply() }}"
        >
    {% endblock %}

    {% if unit %}
        {% block unit %}
            <span {{ attributes.nested('unit') }} class="{{ cx.unit.apply() }}">
                {{ unit }}
            </span>
        {% endblock %}
    {% endif %}

    {% block increase %}
        <button
            {{ attributes.nested('increase').defaults({
                type: 'button',
                disabled: disabled is same as(true) ? 'disabled' : null,
                'aria-label': 'component.product.quantitySelect.increase'|trans|striptags,
            }) }}
            class="{{ cx.increase.apply() }}"
        >
            {{ vi_icon('plus') }}
        </button>
    {% endblock %}
</div>
