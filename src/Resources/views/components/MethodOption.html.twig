{% props
    methodType = 'payment',
    methodId,
    methodDisabled = false,
    methodMedia = null,
    methodMeta = {},
    selectedMethodId = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    <input
        {{ attributes.nested('input').defaults({
            type: 'radio',
            id: methodType ~ 'Method' ~ methodId,
            name: methodType ~ 'MethodId',
            value: methodId,
            checked: methodId is same as(selectedMethodId) ? 'checked' : null,
            disabled: methodDisabled is same as(true) ? 'disabled' : null,
        }) }}
        class="{{ cx.input.apply() }}"
    >

    <label
        {{ attributes.nested('label').defaults({
            for: methodType ~ 'Method' ~ methodId,
        }) }}
        class="{{ cx.label.apply() }}"
    >
        {% if methodMedia %}
            <div {{ attributes.nested('image') }} class="{{ cx.image.apply() }}">
                {% sw_thumbnails 'method-option-image-thumbnails' with {
                    media: methodMedia,
                    sizes: { default: '100px' },
                    attributes: {
                        class: cx.imageElement.apply(),
                        alt: (methodMeta.name|default('')),
                        title: (methodMeta.name|default('')),
                    },
                } %}
            </div>
        {% endif %}

        <div {{ attributes.nested('content') }} class="{{ cx.content.apply() }}">
            <div {{ attributes.nested('name') }} class="{{ cx.name.apply() }}">
                {{ methodMeta.name }}
            </div>
            {% if methodMeta.description %}
                <div {{ attributes.nested('description') }} class="{{ cx.description.apply() }}">
                    {{ methodMeta.description }}
                </div>
            {% endif %}
        </div>
    </label>
</div>
