{% props
    methodType = 'payment',
    methodId,
    methodDisabled = false,
    methodMedia = null,
    methodMeta = {},
    selectedMethodId = null,
    cva = {},
%}

{% set cx = vi_cva_from_file(cva) %}

{% set attrs = {
    input: attributes.nested('input'),
    label: attributes.nested('label'),
    image: attributes.nested('image'),
    content: attributes.nested('content'),
    name: attributes.nested('name'),
    description: attributes.nested('description'),
} %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    <input
        {{ attrs.input.defaults({
            type: 'radio',
            id: methodType ~ 'Method' ~ methodId,
            name: methodType ~ 'MethodId',
            value: methodId,
            checked: methodId is same as(selectedMethodId) ? 'checked' : null,
            disabled: methodDisabled is same as(true) ? 'disabled' : null,
        }) }}
        class="{{ cx.input.apply() }}"
    >

    <label
        {{ attrs.label.defaults({
            for: methodType ~ 'Method' ~ methodId,
        }) }}
        class="{{ cx.label.apply() }}"
    >
        {% if methodMedia %}
            <div {{ attrs.image }} class="{{ cx.image.apply() }}">
                {% sw_thumbnails 'method-option-image-thumbnails' with {
                    media: methodMedia,
                    sizes: { default: '100px' },
                    attributes: {
                        class: cx.imageElement.apply(),
                        alt: (methodMeta.name|default('')),
                        title: (methodMeta.name|default('')),
                    },
                } %}
            </div>
        {% endif %}

        <div {{ attrs.content }} class="{{ cx.content.apply() }}">
            <div {{ attrs.name }} class="{{ cx.name.apply() }}">
                {{ methodMeta.name }}
            </div>
            {% if methodMeta.description %}
                <div {{ attrs.description }} class="{{ cx.description.apply() }}">
                    {{ methodMeta.description }}
                </div>
            {% endif %}
        </div>
    </label>
</div>
