{% props
    methodType = 'payment',
    methodId,
    methodDisabled = false,
    methodMedia = null,
    methodMeta = {},
    selectedMethodId = null,
    defaultBaseClasses = null,
    defaultVariants = {},
%}

{% set defaultBaseClasses = defaultBaseClasses is not null
    ? defaultBaseClasses
    : 'vi-method-option method-option ' ~ methodType ~ '-method' %}
{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set inputAttributes = attributes.nested('input') %}
{% set labelAttributes = attributes.nested('label') %}
{% set imageAttributes = attributes.nested('image') %}
{% set imageElementAttributes = attributes.nested('imageElement') %}
{% set contentAttributes = attributes.nested('content') %}
{% set nameAttributes = attributes.nested('name') %}
{% set descriptionAttributes = attributes.nested('description') %}

<div
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    <input
        type="radio"
        id="{{ methodType }}Method{{ methodId }}"
        name="{{ methodType }}MethodId"
        value="{{ methodId }}"
        {% if methodId is same as(selectedMethodId) %}checked="checked"{% endif %}
        {% if methodDisabled is same as(true) %}disabled="disabled"{% endif %}
        {{ inputAttributes.defaults({
            class: 'vi-method-option__input method-option-input ' ~ methodType ~ '-method-input',
        }) }}
    >

    <label
        for="{{ methodType }}Method{{ methodId }}"
        {{ labelAttributes.defaults({
            class: 'vi-method-option__label method-option-label ' ~ methodType ~ '-method-label',
        }) }}
    >
        {% if methodMedia %}
            <div
                {{ imageAttributes.defaults({
                    class: 'vi-method-option__image method-option-image',
                }) }}
            >
                {% set imageClass = imageElementAttributes.render('class') ?: 'vi-method-option__image-element method-option-image-element' %}
                {% sw_thumbnails 'method-option-image-thumbnails' with {
                    media: methodMedia,
                    sizes: { default: '100px' },
                    attributes: {
                        class: imageClass,
                        alt: (methodMeta.name|default('')),
                        title: (methodMeta.name|default('')),
                    },
                } %}
            </div>
        {% endif %}

        <div
            {{ contentAttributes.defaults({
                class: 'vi-method-option__content method-option-content',
            }) }}
        >
            <div
                {{ nameAttributes.defaults({
                    class: 'vi-method-option__name method-option-name',
                }) }}
            >
                {{ methodMeta.name }}
            </div>
            {% if methodMeta.description %}
                <div
                    {{ descriptionAttributes.defaults({
                        class: 'vi-method-option__description method-option-description',
                    }) }}
                >
                    {{ methodMeta.description }}
                </div>
            {% endif %}
        </div>
    </label>
</div>
