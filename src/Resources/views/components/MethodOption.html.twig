{% props
    methodType = 'payment',
    methodId,
    methodDisabled = false,
    methodMedia = null,
    methodMeta = {},
    selectedMethodId = null,
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-method-option method-option ' ~ methodType ~ '-method' },
    input: { base: 'vi-method-option__input method-option-input ' ~ methodType ~ '-method-input' },
    label: { base: 'vi-method-option__label method-option-label ' ~ methodType ~ '-method-label' },
    image: { base: 'vi-method-option__image method-option-image' },
    imageElement: { base: 'vi-method-option__image-element method-option-image-element' },
    content: { base: 'vi-method-option__content method-option-content' },
    name: { base: 'vi-method-option__name method-option-name' },
    description: { base: 'vi-method-option__description method-option-description' },
}|replace_recursive(cva)) %}

{% set inputAttributes = attributes.nested('input') %}
{% set labelAttributes = attributes.nested('label') %}
{% set imageAttributes = attributes.nested('image') %}
{% set contentAttributes = attributes.nested('content') %}
{% set nameAttributes = attributes.nested('name') %}
{% set descriptionAttributes = attributes.nested('description') %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    <input
        type="radio"
        id="{{ methodType }}Method{{ methodId }}"
        name="{{ methodType }}MethodId"
        value="{{ methodId }}"
        {% if methodId is same as(selectedMethodId) %}checked="checked"{% endif %}
        {% if methodDisabled is same as(true) %}disabled="disabled"{% endif %}
        {{ inputAttributes }}
        class="{{ cx.input.apply() }}"
    >

    <label
        for="{{ methodType }}Method{{ methodId }}"
        {{ labelAttributes }}
        class="{{ cx.label.apply() }}"
    >
        {% if methodMedia %}
            <div {{ imageAttributes }} class="{{ cx.image.apply() }}">
                {% sw_thumbnails 'method-option-image-thumbnails' with {
                    media: methodMedia,
                    sizes: { default: '100px' },
                    attributes: {
                        class: cx.imageElement.apply(),
                        alt: (methodMeta.name|default('')),
                        title: (methodMeta.name|default('')),
                    },
                } %}
            </div>
        {% endif %}

        <div {{ contentAttributes }} class="{{ cx.content.apply() }}">
            <div {{ nameAttributes }} class="{{ cx.name.apply() }}">
                {{ methodMeta.name }}
            </div>
            {% if methodMeta.description %}
                <div {{ descriptionAttributes }} class="{{ cx.description.apply() }}">
                    {{ methodMeta.description }}
                </div>
            {% endif %}
        </div>
    </label>
</div>
