{% props
    methodType = 'payment',
    methodId,
    methodDisabled = false,
    methodMedia = null,
    methodMeta = {},
    selectedMethodId = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

{% do vi_define_attrs(['input', 'label', 'image', 'content', 'name', 'description']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    <input
        {{ vi_attrs('input').defaults({
            type: 'radio',
            id: methodType ~ 'Method' ~ methodId,
            name: methodType ~ 'MethodId',
            value: methodId,
            checked: methodId is same as(selectedMethodId) ? 'checked' : null,
            disabled: methodDisabled is same as(true) ? 'disabled' : null,
        }) }}
        class="{{ vi_class('input') }}"
    >

    <label
        {{ vi_attrs('label').defaults({
            for: methodType ~ 'Method' ~ methodId,
        }) }}
        class="{{ vi_class('label') }}"
    >
        {% if methodMedia %}
            <div {{ vi_attrs('image') }} class="{{ vi_class('image') }}">
                {% sw_thumbnails 'method-option-image-thumbnails' with {
                    media: methodMedia,
                    sizes: { default: '100px' },
                    attributes: {
                        class: vi_class('imageElement'),
                        alt: (methodMeta.name|default('')),
                        title: (methodMeta.name|default('')),
                    },
                } %}
            </div>
        {% endif %}

        <div {{ vi_attrs('content') }} class="{{ vi_class('content') }}">
            <div {{ vi_attrs('name') }} class="{{ vi_class('name') }}">
                {{ methodMeta.name }}
            </div>
            {% if methodMeta.description %}
                <div {{ vi_attrs('description') }} class="{{ vi_class('description') }}">
                    {{ methodMeta.description }}
                </div>
            {% endif %}
        </div>
    </label>
</div>
