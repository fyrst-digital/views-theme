{% if visible %}
    {% set cx = vi_cva_from_file(cva) %}
    {% set classes = {
        root: cx.root.apply(),
        toggle: cx.toggle.apply(),
        flagIcon: cx.flagIcon.apply(),
        label: cx.label.apply(),
        code: cx.code.apply(),
        caret: cx.caret.apply(),
    } %}
    {% set toggleAriaLabel = 'header.languageTrigger'|trans({ '%lang%': ariaName })|striptags %}
    {% set anchorName = '--' ~ id %}

    <twig:ViewsTheme:Dropdown
        class="{{ classes.root }}"
        :id="id"
        {{ ...attributes.defaults({
            placement: placement,
        }).without('class').all() }}
    >
        <twig:block name="toggle">
            <twig:ViewsTheme:Button
                class="{{ classes.toggle }}"
                label:class="{{ classes.label }}"
                type="button"
                color="none"
                size="sm"
                :label="toggleLabel"
                title="{{ toggleAriaLabel }}"
                aria-label="{{ toggleAriaLabel }}"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="{{ id }}"
                popovertarget="{{ id }}"
                style="anchor-name: {{ anchorName }}"
            >
                <twig:block name="prepend">
                    {% if showFlag and flagCode %}
                        {% set flagSrc = asset('bundles/viewstheme/flags/' ~ flagCode ~ '.svg', 'asset') %}
                        {% set flagFallbackSrc = flagCodeFallback and flagCodeFallback is not same as(flagCode)
                            ? asset('bundles/viewstheme/flags/' ~ flagCodeFallback ~ '.svg', 'asset')
                            : null %}
                        <twig:ViewsTheme:Language:Flag
                            class="{{ classes.flagIcon }}"
                            :src="flagSrc"
                            :fallbackSrc="flagFallbackSrc"
                        />
                    {% endif %}

                    {% if showCode and languageCode %}
                        <span class="{{ classes.code }}" aria-hidden="true">{{ languageCode }}</span>
                    {% endif %}
                </twig:block>

                <twig:block name="append">
                    {{ vi_icon('caret-down', { class: classes.caret }) }}
                </twig:block>
            </twig:ViewsTheme:Button>
        </twig:block>

        <twig:ViewsTheme:Language:Menu
            :languages="languages"
            :activeLanguageId="activeLanguageId"
            :id="id"
            :showFlag="showFlag"
        />
    </twig:ViewsTheme:Dropdown>
{% endif %}
