{%
  set classes = vi_define_classes({
    suggest: ['position-absolute', 'op-100', 'start-50', 'translate-middle-x', 'bg-white border', 'border-1', 'rounded-3', 'shadow-lg', 'js-search-result'],
    results: ['grid', 'gap-4', 'p-4'],
    item: {}
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_search_suggest %}
  <div
    {{ classes.suggest | vi_attr_classes }}
    data-component="search-suggest">
    {% block component_suggest_container %}
      {% if page.searchResult.total > 0 %}
        {% block component_suggest_results %}
          <div
            {{ classes.results | vi_attr_classes }}
            data-component="search-suggest-results">
            {% for product in page.searchResult %}
              {% block component_suggest_result_product %}
                {%
                  sw_include '@Storefront/components/search/suggest-item.html.twig' with {
                    classes: classes.item|default({})
                  }
                %}
              {% endblock %}
            {% endfor %}
          </div>
        {% endblock %}

        {% block component_suggest_result_total %}
          {% sw_include '@Storefront/components/search/suggest-summary.html.twig' %}
        {% endblock %}
      {% else %}
        {% sw_include '@Storefront/components/search/suggest-empty.html.twig' %}
      {% endif %}
    {% endblock %}
  </div>
{% endblock %}
