{%
  set classes = vi_define_classes({
    container: ['d-flex', 'p-6', 'justify-content-center'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_search_suggest_empty %}
  <div {{ classes.container | vi_attr_classes }}>
    {% block component_search_suggest_empty_title %}
      {{ 'header.searchNoResult' | trans | sw_sanitize }}
    {% endblock %}
  </div>
{% endblock %}
