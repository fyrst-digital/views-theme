{% import '@ViewsTheme/components/icon/icon.html.twig' as Icon %}

{% set searchWidgetOptions = { searchWidgetMinChars: shopware.minSearchLength } %}

{%
  set classes = vi_define_classes({
    form: [
      'position-relative',
      'header-search-form',
      'js-search-form',
    ],
    input : [
      'rounded',
      'form-control',
      'header-search-input',
    ],
    submit: [
      'btn',
      'header-search-btn',
      'border-0',
    ],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_search_bar %}
  <form
    {{ classes.form | vi_attr_classes }}
    action="{{ path('frontend.search.page') }}"
    method="get"
    data-component="search-bar"
    data-search-widget="true"
    data-search-widget-options="{{ searchWidgetOptions|json_encode }}"
    data-url="{{ path('frontend.search.suggest') }}?search=">
    {% block component_search_bar_submit %}
      <button
        {{ classes.submit | vi_attr_classes }}
        data-component="search-bar-submit"
        type="submit"
        aria-label="{{ 'header.searchButton'|trans|striptags }}">
        {{ Icon.render('magnifying-glass', iconStyle) }}
      </button>
    {% endblock %}
    {% block component_search_bar_input %}
      <input
        {{ classes.input | vi_attr_classes }}
        data-component="search-bar-input"
        type="search"
        id="header-main-search-input"
        name="search"
        autocomplete="off"
        autocapitalize="off"
        placeholder="{{ 'header.searchPlaceholder'|trans|striptags }}"
        aria-label="{{ 'header.searchPlaceholder'|trans|striptags }}"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        value="{{ page.searchTerm }}">
    {% endblock %}
    {% block component_search_bar_clear %}{% endblock %}
  </form>
{% endblock %}
