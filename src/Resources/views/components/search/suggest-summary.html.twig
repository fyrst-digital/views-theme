{%
  set classes = vi_define_classes({
    container: ['js-result', 'p-4', 'border-top'],
    allResultsAction: ['btn', 'btn-primary'],
    noResult: ['search-suggest-no-result'],
    countBadge: ['badge', 'rounded-pill', 'text-bg-light'],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_search_suggest_summary %}
  {#
    {% block component_search_suggest_no_result %}
    <div {{ classes.noResult | vi_attr_classes }}>
    {{ 'header.searchNoResult' | trans | sw_sanitize }}
    </div>
    {% endblock %}
  #}
  {% if page.searchResult.total > 0 %}
    <div
      {{ classes.container | vi_attr_classes }}
      data-component="search-suggest-summary">
      {% block component_suggest_summary_all_results_action %}
        <a
          href="{{ path('frontend.search.page') }}?search={{ page.searchTerm }}"
          title="{{ 'header.searchAllResults'|trans|striptags }}"
          {{ classes.allResultsAction | vi_attr_classes }}>
          {{ 'header.searchAllResults' | trans | sw_sanitize }}
          {% block component_suggest_summary_all_results_action_badgee %}
            <span {{ classes.countBadge | vi_attr_classes }}>
              {{ page.searchResult.total }}
            </span>
          {% endblock %}
        </a>
      {% endblock %}
    </div>
  {% endif %}
{% endblock %}
