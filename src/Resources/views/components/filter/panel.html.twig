{% sw_extends '@Storefront/storefront/component/listing/filter-panel.html.twig' %}

{% set iconOptions = iconOptions|default(themeParameters.icons) %}

{%
  set classes = vi_define_classes({
    header: [],
    title: [],
    closeButton: ['btn', 'js-offcanvas-close'],
    container: [],
  }, classes|default({}), {
    replace: replaceClasses|default([]),
  })
%}

{% block component_filter_panel_header %}
  <div {{ classes.header | vi_attr_classes }}>
    <div {{ classes.title | vi_attr_classes }}>
      {{ 'listing.filterTitleText' | trans }}
    </div>

    <div {{ classes.closeButton | vi_attr_classes }}>
      {{ vi_icon('x', iconOptions) }}
    </div>
  </div>
{% endblock %}

{% block component_filter_panel_items_container %}
  <div {{ classes.container | vi_attr_classes }}>
    {% block component_filter_panel_items %}
      {{ parent() }}
    {% endblock %}
  </div>
{% endblock %}
