{% props
    color = 'default', # default | light | dark | danger
    size = 'md', # sm | md
    pill = false,
    label = null,
    cva = {},
%}

{% do vi_define_cva(cva) %}

<span
    {{ attributes }}
    class="{{ vi_class('root', { color: color, size: size, pill: pill }) }}"
>
    {% block content %}
        {% if label is not null %}
            {{ label }}
        {% endif %}
    {% endblock %}
</span>
