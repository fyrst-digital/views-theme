{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['header', 'title', 'status', 'number', 'menu', 'summary', 'details']) %}

{% set headerId = 'vi-order-' ~ order.id ~ '-header' %}
{% set panelId = 'vi-order-' ~ order.id ~ '-panel' %}
{% set menuId = 'vi-order-' ~ order.id ~ '-menu' %}

<article
    {{ attributes.defaults({
        'aria-label': 'account.orderItemAriaLabel'|trans({ '%order_number%': order.orderNumber })|striptags,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block header %}
        <div
            {{ vi_attrs('header') }}
            class="{{ vi_class('header') }}"
        >
            {% block title %}
                <h2
                    {{ vi_attrs('title') }}
                    class="{{ vi_class('title') }}"
                >
                    {{ 'account.orderHeadline'|trans|sw_sanitize }}
                    {{ order.orderDateTime|format_date('medium', locale=app.request.locale) }}
                </h2>
            {% endblock %}

            {% block status %}
                {% if isPaymentNeeded %}
                    <twig:ViewsTheme:Button
                        class="{{ vi_class('status') }}"
                        {{ ...vi_attrs('status').defaults({
                            type: 'link',
                            href: path('frontend.account.edit-order.page', { orderId: order.id }),
                            color: 'danger',
                            size: 'sm',
                            label: 'account.orderStatusActionCompletePayment'|trans|sw_sanitize,
                        }).all() }}
                    />
                {% else %}
                    <twig:ViewsTheme:Badge
                        class="{{ vi_class('status') }}"
                        {{ ...vi_attrs('status').defaults({
                            color: 'light',
                            pill: true,
                            label: order.stateMachineState.translated.name,
                        }).all() }}
                    />
                {% endif %}
            {% endblock %}

            {% block number %}
                <p
                    {{ vi_attrs('number') }}
                    class="{{ vi_class('number') }}"
                >
                    {{ 'account.orderNumber'|trans|sw_sanitize }}
                    {{ order.orderNumber|sw_sanitize }}
                </p>
            {% endblock %}

            {% block menu %}
                <div class="{{ vi_class('menu') }}">
                    <twig:ViewsTheme:Dropdown
                        {{ ...vi_attrs('menu').defaults({
                            id: menuId,
                            placement: 'bottom-end',
                            'toggle:icon': 'dots-three',
                            'toggle:label': false,
                            'toggle:size': 'sm',
                            'toggle:color': 'light',
                            'toggle:title': 'account.orderActions'|trans|striptags,
                            'toggle:aria-label': 'account.orderActions'|trans|striptags,
                        }).all() }}
                    >
                        <twig:block name="content">
                            {% if allowChangePayment %}
                                <twig:ViewsTheme:Button
                                    type="link"
                                    href="{{ path('frontend.account.edit-order.page', { orderId: order.id }) }}"
                                    color="none"
                                    size="sm"
                                    justify="start"
                                    icon="{{ isPaymentNeeded ? 'check' : 'pencil-simple-line' }}"
                                    label="{{ (isPaymentNeeded ? 'account.orderStatusActionCompletePayment' : 'account.orderContextMenuChangePayment')|trans|sw_sanitize }}"
                                />
                            {% endif %}

                            <twig:ViewsTheme:Form:Handler
                                action="{{ path('frontend.checkout.line-item.add') }}"
                                method="post"
                            >
                                <twig:block name="content">
                                    <input type="hidden" name="redirectTo" value="frontend.cart.offcanvas">
                                    {% for lineItem in order.lineItems %}
                                        {% if lineItem.type == productLineItemType %}
                                            <input type="hidden" name="lineItems[{{ lineItem.identifier }}][id]" value="{{ lineItem.identifier }}">
                                            <input type="hidden" name="lineItems[{{ lineItem.identifier }}][referencedId]" value="{{ lineItem.referencedId }}">
                                            <input type="hidden" name="lineItems[{{ lineItem.identifier }}][type]" value="{{ lineItem.type }}">
                                            <input type="hidden" name="lineItems[{{ lineItem.identifier }}][stackable]" value="1">
                                            <input type="hidden" name="lineItems[{{ lineItem.identifier }}][removable]" value="1">
                                            <input type="hidden" name="lineItems[{{ lineItem.identifier }}][quantity]" value="{{ lineItem.quantity }}">
                                        {% endif %}
                                    {% endfor %}
                                    <twig:ViewsTheme:Button
                                        type="submit"
                                        color="none"
                                        size="sm"
                                        justify="start"
                                        icon="arrows-clockwise"
                                        label="{{ 'account.orderContextMenuReorder'|trans|sw_sanitize }}"
                                    />
                                </twig:block>
                            </twig:ViewsTheme:Form:Handler>

                            {% if allowOrderCancellation %}
                                <twig:ViewsTheme:Modal:Open
                                    modalId="vi-order-cancel-{{ order.id }}"
                                    color="none"
                                    size="sm"
                                    justify="start"
                                    icon="x"
                                    label="{{ 'account.editOrderCancelOrderButton'|trans|sw_sanitize }}"
                                />
                            {% endif %}
                        </twig:block>
                    </twig:ViewsTheme:Dropdown>
                    {% if allowOrderCancellation %}
                        <twig:ViewsTheme:Order:Cancel :order="order" />
                    {% endif %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}

    {% block summary %}
        <div
            {{ vi_attrs('summary') }}
            class="{{ vi_class('summary') }}"
        >
            {% if hasShipping %}
                <twig:ViewsTheme:Order:SummaryItem
                    label="{{ 'account.orderShippingStatus'|trans|sw_sanitize }}"
                    value="{{ shippingStatus }}"
                />
            {% endif %}
            <twig:ViewsTheme:Order:SummaryItem
                label="{{ 'account.orderPaymentStatus'|trans|sw_sanitize }}"
                value="{{ paymentStatus }}"
            />
            <twig:ViewsTheme:Order:SummaryItem
                label="{{ 'account.orderPaymentMethod'|trans|sw_sanitize }}"
                value="{{ paymentMethodName }}"
            />
            {% if hasShipping %}
                <twig:ViewsTheme:Order:SummaryItem
                    label="{{ 'account.orderShippingMethod'|trans|sw_sanitize }}"
                    value="{{ shippingMethodName }}"
                />
            {% endif %}
            {% if order.customerComment %}
                <twig:ViewsTheme:Order:SummaryItem
                    label="{{ 'checkout.customerCommentHeader'|trans|sw_sanitize }}"
                    value="{{ order.customerComment|sw_sanitize|nl2br }}"
                />
            {% endif %}
        </div>
    {% endblock %}

    {% block details %}
        <twig:ViewsTheme:Accordion
            class="{{ vi_class('details') }}"
            {{ ...vi_attrs('details').defaults({
                collapsible: true,
                multiple: false,
            }).all() }}
        >
            <twig:block name="items">
                <twig:ViewsTheme:Accordion:Item>
                    <twig:block name="header">
                        <twig:ViewsTheme:Accordion:Header
                            id="{{ headerId }}"
                            panel="{{ panelId }}"
                        >
                            <twig:block name="content">
                                {{ 'account.orderActionView'|trans|sw_sanitize }}
                            </twig:block>
                        </twig:ViewsTheme:Accordion:Header>
                    </twig:block>
                    <twig:block name="panel">
                        <twig:ViewsTheme:Accordion:Panel id="{{ panelId }}" header="{{ headerId }}">
                            <twig:block name="content">
                                <twig:ViewsTheme:Order:ItemDetails :order="order" />
                            </twig:block>
                        </twig:ViewsTheme:Accordion:Panel>
                    </twig:block>
                </twig:ViewsTheme:Accordion:Item>
            </twig:block>
        </twig:ViewsTheme:Accordion>
    {% endblock %}
</article>
