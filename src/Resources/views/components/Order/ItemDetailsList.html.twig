{% props
    order,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['item']) %}

<twig:ViewsTheme:Cart:Items
    class="{{ vi_class('root') }}"
    {{ ...attributes.defaults({
        cart: order,
        lineItems: order.nestedLineItems,
        layout: 'grid',
        showRemoveButton: false,
        showQuantitySelect: false,
    }).all() }}
/>
