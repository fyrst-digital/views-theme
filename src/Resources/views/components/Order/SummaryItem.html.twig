{% props
    label,
    value,
    cva = {},
%}

{% do vi_define_cva({
    root: { base: 'vi-order-summary-item order-item-summary-item' },
    label: { base: 'vi-order-summary-item__label order-item-summary-item-label' },
    value: { base: 'vi-order-summary-item__value order-item-summary-item-value' },
}|replace_recursive(cva)) %}
{% do vi_define_attrs(['label', 'value']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block label %}
        <div {{ vi_attrs('label') }} class="{{ vi_class('label') }}">
            {{ label|raw }}
        </div>
    {% endblock %}

    {% block value %}
        <div {{ vi_attrs('value') }} class="{{ vi_class('value') }}">
            {{ value|raw }}
        </div>
    {% endblock %}
</div>
