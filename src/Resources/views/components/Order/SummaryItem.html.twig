{% props
    label,
    value,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['label', 'value']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block label %}
        <div {{ vi_attrs('label') }} class="{{ vi_class('label') }}">
            {{ label|raw }}
        </div>
    {% endblock %}

    {% block value %}
        <div {{ vi_attrs('value') }} class="{{ vi_class('value') }}">
            {{ value|raw }}
        </div>
    {% endblock %}
</div>
