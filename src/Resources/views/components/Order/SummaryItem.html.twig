{% props
    label,
    value,
    defaultBaseClasses = 'vi-order-summary-item order-item-summary-item',
    defaultVariants = {},
%}

{% set rootCVA = cva(defaultVariants|merge({ base: defaultBaseClasses })) %}
{% set rootClass = attributes.render('class') %}
{% set labelAttributes = attributes.nested('label') %}
{% set valueAttributes = attributes.nested('value') %}

<div
    {{ attributes }}
    class="{{ rootCVA.apply({}, rootClass) }}"
>
    {% block label %}
        <div
            {{ labelAttributes.defaults({
                class: 'vi-order-summary-item__label order-item-summary-item-label',
            }) }}
        >
            {{ label|raw }}
        </div>
    {% endblock %}

    {% block value %}
        <div
            {{ valueAttributes.defaults({
                class: 'vi-order-summary-item__value order-item-summary-item-value',
            }) }}
        >
            {{ value|raw }}
        </div>
    {% endblock %}
</div>
