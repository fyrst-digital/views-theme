{% props
    order,
    cva = {},
%}

{% set taxFree = order.isTaxFree|default(order.taxStatus is same as(constant('Shopware\\Core\\Checkout\\Cart\\Price\\Struct\\CartPrice::TAX_STATE_FREE'))) %}
{% set totalLabel = taxFree ? 'account.orderItemNetTotal' : 'account.orderItemTotal' %}
{% set totalValue = taxFree ? order.amountNet : order.amountTotal %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['documents', 'items', 'footer', 'comment', 'summary']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block documents %}
        {% if order.documents|length %}
            <twig:ViewsTheme:Order:Documents
                class="{{ vi_class('documents') }}"
                {{ ...vi_attrs('documents').defaults({
                    order: order,
                }).all() }}
            />
        {% endif %}
    {% endblock %}

    {% block items %}
        <twig:ViewsTheme:Order:ItemDetailsList
            class="{{ vi_class('items') }}"
            {{ ...vi_attrs('items').defaults({
                order: order,
            }).all() }}
        />
    {% endblock %}

    {% block footer %}
        <div
            {{ vi_attrs('footer') }}
            class="{{ vi_class('footer') }}"
        >
            {% block comment %}
                {% if order.customerComment %}
                    <twig:ViewsTheme:Order:SummaryItem
                        class="{{ vi_class('comment') }}"
                        {{ ...vi_attrs('comment').defaults({
                            label: 'checkout.customerCommentHeader'|trans|sw_sanitize,
                            value: order.customerComment|sw_sanitize|nl2br,
                        }).all() }}
                    />
                {% endif %}
            {% endblock %}

            <div
                {{ vi_attrs('summary') }}
                class="{{ vi_class('summary') }}"
            >
                {% if order.deliveries|length > 0 or order.primaryOrderDelivery %}
                    <twig:ViewsTheme:Cart:Summary:Item
                        label="{{ 'account.orderItemShippingcosts'|trans|sw_sanitize }}"
                        value="{{ order.shippingTotal|currency(order.currency.isoCode) }}"
                    />
                {% endif %}

                {% if not taxFree %}
                    {% for calculatedTax in order.price.calculatedTaxes %}
                        <twig:ViewsTheme:Cart:Summary:Item
                            label="{{ 'checkout.summaryTax'|trans({ '%rate%': calculatedTax.taxRate })|sw_sanitize }}"
                            value="{{ calculatedTax.tax|currency(order.currency.isoCode) }}"
                        />
                    {% endfor %}
                {% endif %}

                <twig:ViewsTheme:Cart:Summary:Item
                    label="{{ totalLabel|trans|sw_sanitize }}"
                    value="{{ totalValue|currency(order.currency.isoCode) }}"
                />
            </div>
        </div>
    {% endblock %}
</div>
