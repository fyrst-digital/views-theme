{% sw_extends '@Storefront/storefront/page/account/order-history/order-detail.html.twig' %}

{% props
    cva = {},
%}

{% set cx = vi_cva({
    body: { base: 'order-detail-content-body' },
    footer: { base: 'order-item-detail-footer' },
    summaryList: { base: 'order-item-summary-list cart-summary-list' },
}|replace_recursive(cva)) %}

{% set attrs = {
    body: attributes.nested('body'),
    footer: attributes.nested('footer'),
    summaryList: attributes.nested('summaryList'),
} %}

{% block page_account_order_documents_table %}
{% endblock %}

{% block page_account_order_item_detail_table_header %}
{% endblock %}

{% block page_account_order_item_detail_table_body_customer_comment %}
{% endblock %}

{% block page_account_order_item_detail_table_body %}
    <div {{ attrs.body }} class="{{ cx.body.apply() }}">
        {% component 'ViewsTheme:Order:ItemDetailsList' %}{% endcomponent %}
    </div>
{% endblock %}

{% block page_account_order_item_detail_table_footer %}

    {% block page_account_order_item_detail_table_labels_summary %}
        <div {{ attrs.footer }} class="{{ cx.footer.apply() }}">

            {% block page_account_order_item_detail_summary %}
                <div {{ attrs.summaryList }} class="{{ cx.summaryList.apply() }}">
                    {% block page_account_order_item_detail_shipping_costs %}
                        {% if order.deliveries|length > 0 %}
                            <twig:ViewsTheme:Cart:Summary:Item
                                label="{{ 'account.orderItemShippingcosts'|trans|sw_sanitize }}"
                                value="{{ order.shippingTotal|currency(order.currency.isoCode) }}"
                                class="summary-item-shipping"
                            />
                        {% endif %}
                    {% endblock %}

                    {% block page_account_order_item_detail_amount %}
                        {% set totalAmountLabel = 'account.orderItemTotal'|trans|sw_sanitize %}
                        {% set totalAmountValue = order.amountTotal|currency(order.currency.isoCode) %}

                        {% if order.isTaxFree %}
                            {% set totalAmountLabel = 'account.orderItemNetTotal'|trans|sw_sanitize %}
                            {% set totalAmountValue = order.amountNet|currency(order.currency.isoCode) %}
                        {% endif %}

                        <twig:ViewsTheme:Cart:Summary:Item
                            label="{{ totalAmountLabel }}"
                            value="{{ totalAmountValue }}"
                            class="summary-item-grand-total"
                        />
                    {% endblock %}

                    {% block page_account_order_item_detail_vat %}
                        {% if not order.isTaxFree %}
                            {% for calculatedTax in order.price.calculatedTaxes %}
                                <twig:ViewsTheme:Cart:Summary:Item
                                    label="{{ 'checkout.summaryTax'|trans({
                                        '%rate%': calculatedTax.taxRate
                                    })|sw_sanitize }}"
                                    value="{{ calculatedTax.tax|currency(order.currency.isoCode) }}"
                                    class="summary-item-tax-total"
                                />
                            {% endfor %}
                        {% endif %}
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
