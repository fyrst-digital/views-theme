{% sw_extends '@Storefront/storefront/component/review/rating.html.twig' %}

{% block component_review_rating_output %}
    <div class="vi-review-rating product-review-rating d-flex flex-wrap flex-row">
        {% if full > 0 %}
            {% for star in range(1, full) %}
                <div class="vi-review-rating__star review-star full">
                    {{ vi_icon('star-fill') }}
                </div>
            {% endfor %}
        {% endif %}

        {% if half %}
            <div class="vi-review-rating__star review-star half">
                {{ vi_icon('star-half-fill') }}
            </div>
        {% endif %}

        {% if blank > 0 %}
            {% for star in range(1, blank) %}
                <div class="vi-review-rating__star review-star blank">
                    {{ vi_icon('star') }}
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
