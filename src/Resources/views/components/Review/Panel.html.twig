{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['sidebar', 'main', 'alerts', 'form', 'results']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Review:Panel',
        'data-component-options': componentOptions|json_encode,
        'data-review-mode': mode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block sidebar %}
        <twig:ViewsTheme:Review:Sidebar
            class="{{ vi_class('sidebar') }}"
            {{ ...vi_attrs('sidebar').defaults({
                productReviewCount: productReviewCount,
                totalReviewCount: totalReviewCount,
                productAvgRating: productAvgRating,
                maxPoints: reviews.matrix.maxPoints,
                reviews: reviews,
                hasCustomerReview: hasCustomerReview,
            }).all() }}
        />
    {% endblock %}

    {% block main %}
        <div {{ vi_attrs('main') }} class="{{ vi_class('main') }}">
            {% block alerts %}
                <twig:ViewsTheme:Review:Alerts
                    class="{{ vi_class('alerts') }}"
                    {{ ...vi_attrs('alerts').defaults({
                        ratingSuccess: ratingSuccess,
                        formViolations: formViolations,
                    }).all() }}
                />
            {% endblock %}

            {% block form %}
                <twig:ViewsTheme:Review:Form
                    class="{{ vi_class('form') }}"
                    {{ ...vi_attrs('form').defaults({
                        reviews: reviews,
                        formValues: formValues,
                        formViolations: formViolations,
                        productId: productId,
                        parentId: parentId,
                        saveUrl: saveUrl,
                        hidden: not showForm,
                    }).all() }}
                />
            {% endblock %}

            {% block results %}
                <twig:ViewsTheme:Review:Results
                    class="{{ vi_class('results') }}"
                    {{ ...vi_attrs('results').defaults({
                        reviews: reviews,
                        productId: productId,
                        parentId: parentId,
                        hidden: showForm,
                    }).all() }}
                />
            {% endblock %}
        </div>
    {% endblock %}
</div>
