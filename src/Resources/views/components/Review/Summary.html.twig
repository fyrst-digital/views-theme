{% props
    productReviewCount = 0,
    totalReviewCount = 0,
    productAvgRating = 0,
    maxPoints = 5,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'rating', 'stars', 'average']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block title %}
        <div {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
            {{ 'detail.reviewTitle'|trans({
                '%count%': productReviewCount,
                '%total%': totalReviewCount,
            })|sw_sanitize }}
        </div>
    {% endblock %}

    {% block rating %}
        <div {{ vi_attrs('rating') }} class="{{ vi_class('rating') }}">
            {% block stars %}
                <twig:ViewsTheme:Review:Rating
                    class="{{ vi_class('stars') }}"
                    {{ ...vi_attrs('stars').defaults({
                        points: productAvgRating,
                        maxPoints: maxPoints,
                    }).all() }}
                />
            {% endblock %}

            {% block average %}
                {% if totalReviewCount > 0 %}
                    <twig:ViewsTheme:Review:Average
                        class="{{ vi_class('average') }}"
                        {{ ...vi_attrs('average').defaults({
                            points: productAvgRating,
                            maxPoints: maxPoints,
                        }).all() }}
                    />
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}
</div>
