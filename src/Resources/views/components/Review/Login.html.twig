{% props
    productId = null,
    parentId = null,
    cva = {},
%}

{% set redirectParameters = {
    productId: productId,
} %}
{% if cmsPage is defined and cmsPage.id %}
    {% set redirectParameters = redirectParameters|merge({ id: cmsPage.id }) %}
{% endif %}
{% if shopware.navigation.id is defined %}
    {% set redirectParameters = redirectParameters|merge({ navigationId: shopware.navigation.id }) %}
{% endif %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['login']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block login %}
        <twig:ViewsTheme:Account:Login
            class="{{ vi_class('login') }}"
            {{ ...vi_attrs('login').defaults({
                description: 'detail.reviewLoginDescription'|trans|sw_sanitize,
                redirectTo: app.request.attributes.get('_route'),
                redirectParameters: redirectParameters,
            }).all() }}
        />
    {% endblock %}
</div>
