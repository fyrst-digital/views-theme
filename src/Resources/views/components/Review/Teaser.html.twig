{% props
    hasCustomerReview = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['title', 'text', 'actions']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Review:Teaser',
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block title %}
        <p {{ vi_attrs('title') }} class="{{ vi_class('title') }}">
            {% if hasCustomerReview %}
                {{ 'detail.reviewExistsTeaserTitle'|trans|sw_sanitize }}
            {% else %}
                {{ 'detail.reviewTeaserTitle'|trans|sw_sanitize }}
            {% endif %}
        </p>
    {% endblock %}

    {% block text %}
        <p {{ vi_attrs('text') }} class="{{ vi_class('text') }}">
            {% if hasCustomerReview %}
                {{ 'detail.reviewExistsTeaserText'|trans|sw_sanitize }}
            {% else %}
                {{ 'detail.reviewTeaserText'|trans|sw_sanitize }}
            {% endif %}
        </p>
    {% endblock %}

    {% block actions %}
        <div {{ vi_attrs('actions') }} class="{{ vi_class('actions') }}">
            <twig:ViewsTheme:Button
                type="button"
                color="primary"
                label="{{ hasCustomerReview
                    ? 'detail.reviewExistsTeaserButton'|trans|striptags
                    : 'detail.reviewTeaserButton'|trans|striptags }}"
                data-review-teaser-action="open"
            />
            <twig:ViewsTheme:Button
                type="button"
                color="outline-secondary"
                label="{{ 'detail.reviewTeaserButtonHide'|trans|striptags }}"
                data-review-teaser-action="close"
                hidden
            />
        </div>
    {% endblock %}
</div>
