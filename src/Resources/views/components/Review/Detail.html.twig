{% sw_extends '@Storefront/storefront/component/review/review.html.twig' %}

{% set formCollapseClass = ratingSuccess == -1
    ? 'collapse multi-collapse show product-detail-review-form'
    : 'collapse multi-collapse' %}

{% block component_review_alert %}
    {% if ratingSuccess == 1 %}
        <twig:ViewsTheme:Alert type="success" content="{{ 'detail.reviewFormSuccessAlert'|trans|sw_sanitize }}" />
    {% elseif ratingSuccess == 2 %}
        <twig:ViewsTheme:Alert type="success" content="{{ 'detail.reviewFormSuccessUpdateAlert'|trans|sw_sanitize }}" />
    {% elseif ratingSuccess == -1 %}
        <twig:ViewsTheme:Alert type="danger" content="{{ 'detail.reviewFormErrorAlert'|trans|sw_sanitize }}" />
    {% endif %}
{% endblock %}

{% block component_review_list_empty %}
    <twig:ViewsTheme:Alert type="info" content="{{ 'detail.reviewListEmpty'|trans|sw_sanitize }}" />
{% endblock %}

{% block utilities_offcanvas_meta %}{% endblock %}
{% block utilities_offcanvas %}{{ block('component_review_container') }}{% endblock %}

{% block component_review_widget_container %}
    {% sw_include '@ViewsTheme/components/Review/Widget.html.twig' %}
{% endblock %}

{% block component_review_list_content %}
    {% for review in reviews %}
        <div class="product-detail-review-list-content">
            {% sw_include '@ViewsTheme/components/Review/Item.html.twig' %}
        </div>
    {% endfor %}
{% endblock %}

{% block component_review_form_container %}
    <div class="{{ formCollapseClass }}" id="review-form">
        {% if context.customer and not context.customer.guest %}
            <div class="product-detail-review-form">
                {% sw_include '@ViewsTheme/components/Review/Form.html.twig' %}
            </div>
        {% else %}
            <div class="product-detail-review-login">
                {% sw_include '@Storefront/storefront/component/review/review-login.html.twig' %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block component_review_list_action_language %}{% endblock %}
