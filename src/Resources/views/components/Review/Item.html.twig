{% props
    review = null,
    editable = false,
    cva = {},
%}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['meta', 'date', 'points', 'title', 'content', 'comment', 'actions']) %}

<article
    {{ attributes.defaults({
        'data-component': editable ? 'ViewsTheme:Review:Item' : false,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block meta %}
        <div {{ vi_attrs('meta') }} class="{{ vi_class('meta') }}">
            {% block date %}
                <p {{ vi_attrs('date') }} class="{{ vi_class('date') }}">
                    <small>
                        {{ review.createdAt|format_date('long') }}
                        {{ review.createdAt|format_time('short') }}
                    </small>
                </p>
            {% endblock %}

            {% block points %}
                <div {{ vi_attrs('points') }} class="{{ vi_class('points') }}">
                    <twig:ViewsTheme:Review:Rating
                        :points="review.points"
                        altText="{{ 'detail.reviewRatingAltText'|trans({
                            '%points%': review.points,
                            '%maxPoints%': 5,
                        }) }}"
                    />
                </div>
            {% endblock %}

            {% block title %}
                <p
                    {{ vi_attrs('title').defaults({
                        lang: review.language ? review.language.translationCode.code : false,
                    }) }}
                    class="{{ vi_class('title') }}"
                >
                    {{ review.title }}
                </p>
            {% endblock %}
        </div>
    {% endblock %}

    {% block content %}
        <p
            {{ vi_attrs('content').defaults({
                lang: review.language ? review.language.translationCode.code : false,
            }) }}
            class="{{ vi_class('content') }}"
        >
            {{ review.content|nl2br }}
        </p>
    {% endblock %}

    {% block comment %}
        {% if review.comment %}
            <blockquote {{ vi_attrs('comment') }} class="{{ vi_class('comment') }}">
                <footer>
                    {{ 'detail.reviewCommentLabel'|trans|sw_sanitize }}{{ review.comment }}
                </footer>
            </blockquote>
        {% endif %}
    {% endblock %}

    {% block actions %}
        {% if editable %}
            <div {{ vi_attrs('actions') }} class="{{ vi_class('actions') }}">
                <twig:ViewsTheme:Button
                    type="button"
                    color="link"
                    size="sm"
                    label="{{ 'detail.reviewExistsTeaserButton'|trans|striptags }}"
                    data-review-item-action="edit"
                />
            </div>
        {% endif %}
    {% endblock %}
</article>
