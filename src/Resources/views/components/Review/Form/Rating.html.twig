{% props
    currentPoints = 5,
    maxPoints = 5,
    labels = [],
    cva = {},
%}

{% set ratingId = 'vi-review-form-rating-' ~ random() %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['label', 'stars', 'star', 'text']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Review:Form:Rating',
        'data-component-options': {
            currentPoints: currentPoints,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block label %}
        <span {{ vi_attrs('label') }} class="{{ vi_class('label') }}" id="{{ ratingId }}-label">
            {{ 'detail.reviewFormRatingLabel'|trans|sw_sanitize }}{{ 'general.required'|trans|sw_sanitize }}
        </span>
    {% endblock %}

    {% block stars %}
        <div
            {{ vi_attrs('stars').defaults({
                role: 'radiogroup',
                'aria-labelledby': ratingId ~ '-label',
            }) }}
            class="{{ vi_class('stars') }}"
        >
            {% for point in 1..maxPoints %}
                <label
                    {{ vi_attrs('star').defaults({
                        'data-review-form-point': point,
                    }) }}
                    class="{{ vi_class('star', { active: currentPoints >= point }) }}"
                >
                    <input
                        type="radio"
                        name="points"
                        value="{{ point }}"
                        class="visually-hidden"
                        aria-label="{{ ("detail.review#{point}PointRatingText")|trans|striptags }}"
                        {% if currentPoints == point %}checked{% endif %}
                    >
                    {{ vi_icon(currentPoints >= point ? 'star-fill' : 'star') }}
                </label>
            {% endfor %}
        </div>
    {% endblock %}

    {% block texts %}
        {% for point in 1..maxPoints %}
            <p
                {{ vi_attrs('text').defaults({
                    'data-rating-text': point,
                    hidden: currentPoints != point,
                }) }}
                class="{{ vi_class('text') }}"
            >
                {{ ("detail.review#{point}PointRatingText")|trans|sw_sanitize }}
            </p>
        {% endfor %}
    {% endblock %}
</div>
