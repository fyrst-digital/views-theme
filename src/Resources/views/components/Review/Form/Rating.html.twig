{% props
    currentPoints = 5,
    maxPoints = 5,
    iconFull = 'star-fill',
    iconEmpty = 'star',
    cva = {},
%}

{% set pointLabels = {} %}
{% for point in 1..maxPoints %}
    {% set pointLabels = pointLabels|merge({
        ('p' ~ point): ("detail.review#{point}PointRatingText")|trans|striptags,
    }) %}
{% endfor %}

{% do vi_define_cva(cva) %}
{% do vi_define_attrs(['label', 'stars', 'star', 'text']) %}

<div
    {{ attributes.defaults({
        'data-component': 'ViewsTheme:Review:Form:Rating',
        'data-component-options': {
            currentPoints: currentPoints,
            pointLabels: pointLabels,
            iconFull: iconFull,
            iconEmpty: iconEmpty,
        }|json_encode,
    }) }}
    class="{{ vi_class('root') }}"
>
    {% block label %}
        <div {{ vi_attrs('label') }} class="{{ vi_class('label') }}">
            {{ 'detail.reviewFormRatingLabel'|trans|sw_sanitize }}{{ 'general.required'|trans|sw_sanitize }}
        </div>
    {% endblock %}

    {% block value %}
        <input type="hidden" name="points" value="{{ currentPoints }}">
    {% endblock %}

    {% block stars %}
        <div
            {{ vi_attrs('stars').defaults({
                'data-rating-stars': true,
            }) }}
            class="{{ vi_class('stars') }}"
        >
            {% for point in 1..maxPoints %}
                {{ vi_icon(currentPoints >= point ? iconFull : iconEmpty, {
                    class: vi_class('star', { active: currentPoints >= point }),
                    attr: {
                        'data-points': point,
                    },
                }) }}
            {% endfor %}
        </div>
    {% endblock %}

    {% block text %}
        <div
            {{ vi_attrs('text').defaults({
                'data-rating-text': true,
            }) }}
            class="{{ vi_class('text') }}"
        >
            {{ pointLabels['p' ~ currentPoints]|default('') }}
        </div>
    {% endblock %}
</div>
