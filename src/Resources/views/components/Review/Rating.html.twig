{% sw_extends '@Storefront/storefront/component/review/rating.html.twig' %}

{% props
    points = 0,
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-review-rating product-review-rating d-flex flex-wrap flex-row' },
    star: { base: 'vi-review-rating__star review-star' },
}|replace_recursive(cva)) %}

{% block component_review_rating_output %}
    <div {{ attributes }} class="{{ cx.root.apply() }}">
        {% if full > 0 %}
            {% for star in range(1, full) %}
                <div {{ attributes.nested('star') }} class="{{ cx.star.apply() }} full">
                    {{ vi_icon('star-fill') }}
                </div>
            {% endfor %}
        {% endif %}

        {% if half %}
            <div {{ attributes.nested('star') }} class="{{ cx.star.apply() }} half">
                {{ vi_icon('star-half-fill') }}
            </div>
        {% endif %}

        {% if blank > 0 %}
            {% for star in range(1, blank) %}
                <div {{ attributes.nested('star') }} class="{{ cx.star.apply() }} blank">
                    {{ vi_icon('star') }}
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
