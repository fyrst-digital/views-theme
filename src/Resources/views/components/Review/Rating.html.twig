{% do vi_define_cva(cva, ['root', 'star', 'alt']) %}
{% do vi_define_attrs(['star', 'alt']) %}

<div
    {{ attributes }}
    class="{{ vi_class('root') }}"
>
    {% block stars %}
        {% for name in starIcons %}
            {{ vi_icon(name, {
                class: vi_class('star', { size: size }),
                ariaHidden: false,
                attr: vi_attrs('star').defaults({ 'aria-hidden': 'true' }).all(),
            }) }}
        {% endfor %}
    {% endblock %}

    {% block alt %}
        <div {{ vi_attrs('alt') }} class="{{ vi_class('alt') }}">
            {{ altText ?? 'detail.reviewAvgRatingAltText'|trans({
                '%points%': points|round(2),
                '%maxPoints%': maxPoints,
            }) }}
        </div>
    {% endblock %}
</div>
