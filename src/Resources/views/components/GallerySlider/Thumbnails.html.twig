{% props
    medias = [],
    cva = {},
%}

{% set cx = vi_cva({
    root: { base: 'vi-gallery-slider-thumbnails-container gallery-slider-thumbnails-container' },
}|replace_recursive(cva)) %}

<div
    {{ attributes }}
    class="{{ cx.root.apply() }}"
>
    <div class="vi-gallery-slider-thumbnails gallery-slider-thumbnails splide">
        <div class="splide__track">
            <ul class="splide__list">
                {% for media in medias %}
                    <li class="vi-gallery-slider-thumbnail gallery-slider-thumbnail splide__slide">
                        {% sw_thumbnails 'gallery-slider-thumbnail' with {
                            media: media,
                            attributes: { class: 'vi-gallery-slider-thumbnail-image gallery-slider-thumbnail-image' },
                            sizes: { default: '200px' },
                        } %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
