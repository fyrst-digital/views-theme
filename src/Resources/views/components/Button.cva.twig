{
    root: {
        base: 'btn',
        variants: {
            color: {
                none: '',
                primary: 'btn-primary',
                secondary: 'btn-secondary',
                light: 'btn-light',
                white: 'btn-white',
                link: 'btn-link',
                success: 'btn-success',
                danger: 'btn-danger',
                'outline-primary': 'btn-outline-primary',
                'outline-secondary': 'btn-outline-secondary',
            },
            size: {
                sm: 'btn-sm gap-2',
                md: 'btn-md gap-4',
                lg: 'btn-lg gap-4',
            },
            justify: {
                start: 'justify-content-start',
                center: 'justify-content-center',
                end: 'justify-content-end',
            },
            pill: {
                true: 'rounded-pill'
            }
        },
        compoundVariants: [{
            square: [true],
            size: ['sm'],
            class: 'p-2',
        }, {
            square: [true],
            size: ['md'],
            class: 'p-3',
        }, {
            square: [true],
            size: ['lg'],
            class: 'p-4',
        }],
    },
    icon: { 
        base: '',
        variants: {
            size: {
                sm: 'icon-size-2'
            }
        }
    },
    label: { base: '' },
}
