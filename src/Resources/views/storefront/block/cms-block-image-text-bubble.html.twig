    <twig:ViewsTheme:Cms:Element :block="block" span="md:4">
        <twig:ViewsTheme:Cms:Element :block="block" slotName="right-image" />
        <twig:ViewsTheme:Cms:Element :block="block" slotName="right-text" />
    </twig:ViewsTheme:Cms:Element>
