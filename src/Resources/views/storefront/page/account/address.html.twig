{% sw_extends '@Storefront/storefront/page/account/address.html.twig' %}

{% block page_account_overview_addresses %}
    <twig:ViewsTheme:Address:List
        :billingAddress="context.customer.defaultBillingAddress"
        :shippingAddress="context.customer.defaultShippingAddress"
        :shippingFirst="false"
        :showShippingWarning="true"
        shippingTitle="{{ 'account.overviewShippingHeader'|trans|sw_sanitize }}"
        billingTitle="{{ 'account.overviewBillingHeader'|trans|sw_sanitize }}"
        equalText="{{ 'account.overviewAddressEqual'|trans|sw_sanitize }}"
    >
        <twig:block name="billingActions">
            <twig:ViewsTheme:Button
                type="link"
                href="{{ path('frontend.account.address.edit.page', { addressId: context.customer.defaultBillingAddress.id }) }}"
                color="link"
                size="sm"
                icon="pencil-simple-line"
                label="{{ 'account.addressesContentItemActionEdit'|trans|sw_sanitize }}"
            />
        </twig:block>
        <twig:block name="shippingActions">
            <twig:ViewsTheme:Button
                type="link"
                href="{{ path('frontend.account.address.edit.page', { addressId: context.customer.defaultShippingAddress.id }) }}"
                color="link"
                size="sm"
                icon="pencil-simple-line"
                label="{{ 'account.addressesContentItemActionEdit'|trans|sw_sanitize }}"
            />
        </twig:block>
    </twig:ViewsTheme:Address:List>
{% endblock %}
