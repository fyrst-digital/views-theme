{% sw_extends '@Storefront/storefront/page/account/addressbook/edit.html.twig' %}

{% block page_account %}
    <twig:ViewsTheme:Account:Page>
        <twig:block name="content">
            <twig:ViewsTheme:Account:Addressbook:Form
                title="{{ 'account.addressEditMetaTitle'|trans|sw_sanitize }}"
                :action="path('frontend.account.address.edit.save', { addressId: page.address.id })"
                :data="page.address"
                :page="page"
                :formViolations="formViolations|default(null)"
                :showNoShippingPostfix="true"
                :redirectTo="redirectTo|default(null)"
                vatInputId="address-vatIds"
            />
        </twig:block>
    </twig:ViewsTheme:Account:Page>
{% endblock %}
