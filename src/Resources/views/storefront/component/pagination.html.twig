{% sw_extends '@Storefront/storefront/component/pagination.html.twig' %}

{% block component_pagination_nav %}
    {% set searchQuery = '' %}
    {% if searchResult is defined and searchResult.currentFilters.search is defined and searchResult.currentFilters.search %}
        {% set searchQuery = '&search=' ~ searchResult.currentFilters.search|url_encode %}
    {% endif %}

    <twig:ViewsTheme:Pagination
        :entities="entities|default(null)"
        :currentPage="currentPage|default(null)"
        :totalPages="totalPages|default(null)"
        :location="paginationLocation|default(null)"
        :href="href is defined ? href : true"
        :pageParameter="pageParameter|default('p')"
        :searchQuery="searchQuery"
    />
{% endblock %}
