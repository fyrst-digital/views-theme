{% sw_extends '@Storefront/storefront/element/cms-element-sidebar-filter.html.twig' %}

{% block element_sidebar_filter %}
    {% if listing is not defined or listing is null %}
        {% if cmsPage is defined %}
            {% set slot = cmsPage.getFirstElementOfType('product-listing') %}
            {% set listing = slot.data.listing %}
        {% endif %}
    {% endif %}

    {% if listing and listing.aggregations.elements|length > 0 %}
        {% set filterLabel = 'listing.filterTitleText'|trans|sw_sanitize %}
        {% set filterDrawerUrl = null %}
        {% set listingNavigationId = null %}

        {% if listing.currentFilters.navigationId is defined and listing.currentFilters.navigationId %}
            {% set listingNavigationId = listing.currentFilters.navigationId %}
        {% elseif app.request.attributes.get('navigationId') %}
            {% set listingNavigationId = app.request.attributes.get('navigationId') %}
        {% endif %}

        {% if listingNavigationId %}
            {% set filterDrawerUrl = path('frontend.views-theme.filter.drawer.category', { navigationId: listingNavigationId }) %}
        {% elseif app.request.get('search') %}
            {% set filterDrawerUrl = path('frontend.views-theme.filter.drawer.search') %}
        {% endif %}

        {% if filterDrawerUrl %}
            <twig:ViewsTheme:Filter:Drawer:Action
                drawerUrl="{{ filterDrawerUrl }}"
                label="{{ filterLabel }}"
            />
        {% endif %}

        <twig:ViewsTheme:Filter:Panel
            class="d-none d-lg-block"
            :listing="listing"
            :ariaLiveUpdates="true"
            :showHeader="false"
        />
    {% endif %}
{% endblock %}
