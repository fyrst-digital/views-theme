{% sw_extends '@Storefront/storefront/layout/meta.html.twig' %}

{% block layout_head_stylesheet %}
  {{ parent() }}

  {% block views_theme_additional_stylesheet %}
    {% if themeParameters.icons and themeParameters.icons.mode is same as('css') and themeParameters.icons.pack is not empty %}
      <link
      rel="stylesheet"
      href="{{ asset('bundles/viewstheme/css/icons/' ~ themeParameters.icons.pack ~ '.css') }}">
    {% endif %}
    {#
      <link
      rel="stylesheet"
      href="{{ asset('bundles/viewstheme/css/theme.css') }}">
    #}
  {% endblock %}
{% endblock %}

{% block layout_head_javascript_router %}
  {{ parent() }}

  {% block layout_head_javascript_cart_count %}
    <script>
      {% set cart = context.extensions.cart ?? null %}
      window.cartCount = {{ cart ? cart.lineItems|length : 0 }};
    </script>
  {% endblock %}
{% endblock %}
