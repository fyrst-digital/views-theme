{% sw_extends '@Storefront/storefront/layout/meta.html.twig' %}

{% block layout_head_theme_css_vars %}
  {%- set themeCssVars = views_theme_css_vars() -%}
  {%- if themeCssVars is not empty -%}
    <style>
      :root {
      {%- for key, value in themeCssVars -%}
        --{{ key|raw }}: {{ value|raw }};
      {%- endfor -%}
      }
    </style>
  {%- endif -%}

  <style>
    .vi-header-main { --vi-logo-w: {{ theme_config('logo-width-mobile')|default(80)|round }}px; }
    @media (min-width: {{ theme_config('breakpoint.lg') }}px) { .vi-header-main { --vi-logo-w: {{ theme_config('logo-width-tablet')|default(100)|round }}px; } }
    @media (min-width: {{ theme_config('breakpoint.xxl') }}px) { .vi-header-main { --vi-logo-w: {{ theme_config('logo-width-desktop')|default(120)|round }}px; } }
  </style>
{% endblock %}

{% block layout_head_stylesheet %}
  {% block views_theme_font_preload %}
    {# Figtree normal (scss/_fonts.scss) is otherwise discovered only after all.css is parsed.
       href must equal the URL the @font-face resolves to (theme package, no version query) so the
       preloaded response is reused. Prod only: the Vite dev server serves fonts from another URL. #}
    {% if not (importmapData.isDevServer ?? false) %}
      <link
        rel="preload"
        href="{{ asset('assets/fonts/figtree-var.woff2', 'theme')|split('?')|first }}"
        as="font"
        type="font/woff2"
        crossorigin>
    {% endif %}
  {% endblock %}

  {{ parent() }}

  {% block views_theme_additional_stylesheet %}
    {# Prod: theme asset package (copied by theme:compile). Dev (Vite): source via /@fs from ViewsTheme main.js URL. #}
    {% set isDevServer = importmapData.isDevServer ?? false %}
    {% set themeAssetCssBase = null %}
    {% if isDevServer %}
      {% set themeScript = (importmapData.scripts ?? [])|filter(s => s ends with '/app/storefront/src/main.js' and ('/views-theme/' in s or '/ViewsTheme/' in s))|first %}
      {% if themeScript %}
        {% set themeAssetCssBase = themeScript|replace({'/src/main.js': '/src/assets/css'}) %}
      {% endif %}
    {% endif %}

    {% block views_theme_icons_stylesheet %}
      {% if themeParameters.icons and themeParameters.icons.mode is same as('css') and themeParameters.icons.pack is not empty %}
        <link
          rel="stylesheet"
          href="{{ themeAssetCssBase ? themeAssetCssBase ~ '/icons/' ~ themeParameters.icons.pack ~ '.css' : asset('assets/css/icons/' ~ themeParameters.icons.pack ~ '.css', 'theme') }}">
      {% endif %}
    {% endblock %}
  {% endblock %}
{% endblock %}

{% block layout_head_javascript_router %}
  {{ parent() }}

  {% block layout_head_javascript_cart_count %}
    <script>
      {% set cart = context.extensions.cart ?? null %}
      window.cartCount = {{ cart ? cart.lineItems|length : 0 }};
    </script>
  {% endblock %}
{% endblock %}
