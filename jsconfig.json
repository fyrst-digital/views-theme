{
  "compilerOptions": {
    "paths": {
      "@views-theme/modules/*": ["./src/Resources/app/storefront/src/modules/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "checkJs": false
  },
  "include": [
    "src/Resources/views/components/**/*.js",
    "src/Resources/app/storefront/src/modules/**/*.js",
    "src/Resources/app/storefront/src/modules/**/*.d.ts"
  ]
}
