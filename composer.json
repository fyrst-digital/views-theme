{
  "name": "webflare/views-theme",
  "description": "ViewsTheme - Shopware 6 storefront theme",
  "version": "1.1.5",
  "type": "shopware-platform-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Webflare",
      "homepage": "https://webflare.sh"
    }
  ],
  "require": {
    "shopware/core": "^6.7.11",
    "shopware/storefront": "^6.7.11",
    "twig/html-extra": "^3.12"
  },
  "replace": {
    "fyrst/views-theme": "self.version"
  },
  "extra": {
    "shopware-plugin-class": "Webflare\\ViewsTheme\\ViewsTheme",
    "plugin-icon": "src/Resources/config/plugin.png",
    "label": {
      "de-DE": "ViewsTheme",
      "en-GB": "ViewsTheme"
    }
  },
  "autoload": {
    "psr-4": {
      "Webflare\\ViewsTheme\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webflare\\ViewsTheme\\Tests\\": "tests/"
    }
  }
}
